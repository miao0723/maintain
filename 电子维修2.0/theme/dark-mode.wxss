@media (prefers-color-scheme: dark) {
  :root {
    --ui-bg: #111827;
    --ui-surface: #1f2937;
    --ui-text-primary: #f3f4f6;
    --ui-text-secondary: #d1d5db;
    --ui-primary: #7c8ff0;
    --ui-primary-pressed: #6b7edc;
    --ui-danger: #ff6b78;
    --ui-border: #374151;
    --ui-shadow: rgba(0, 0, 0, 0.35);
  }

  page {
    background: var(--ui-bg) !important;
    color: var(--ui-text-primary) !important;
  }

  .section,
  .card,
  .agreement-box,
  .order-item,
  .menu-item,
  .form-section,
  .modal-container,
  .unit-item,
  .address-item,
  .bottom-action,
  .input-area {
    background-color: var(--ui-surface) !important;
    box-shadow: 0 2px 12rpx var(--ui-shadow) !important;
  }

  .menu-title,
  .section-title,
  .title,
  .order-title,
  .info-value,
  .form-label,
  .address-text {
    color: var(--ui-text-primary) !important;
  }

  .menu-desc,
  .sub-title,
  .time-text,
  .order-time,
  .info-label,
  .form-tip,
  .empty-desc {
    color: var(--ui-text-secondary) !important;
  }

  input,
  textarea {
    background-color: #111827 !important;
    color: var(--ui-text-primary) !important;
    border-color: var(--ui-border) !important;
  }
}
