/* pages/address-edit/address-edit.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

.form-section {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 150rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.form-textarea {
  flex: 1;
  min-height: 100rpx;
  padding: 15rpx 0;
  font-size: 28rpx;
  color: #333333;
}

.char-count {
  position: absolute;
  right: 0;
  bottom: 25rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 地区选择器 */
.region-selector {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.region-text {
  font-size: 28rpx;
  color: #333333;
}

.region-text.placeholder {
  color: #999999;
}

.region-arrow {
  font-size: 28rpx;
  color: #cccccc;
}

/* 地图选择按钮 */
.map-picker-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 30rpx 0;
  padding: 25rpx;
  border-radius: 10rpx;
  border-bottom: none;
  flex-direction: column;
  align-items: flex-start;
}

.map-picker-btn .form-label {
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.map-picker-content {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.map-icon {
  font-size: 36rpx;
}

.map-text {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-arrow {
  font-size: 24rpx;
  color: #ffffff;
}

/* 标题 */
.section-title {
  font-size: 26rpx;
  color: #666666;
  padding: 30rpx 0 20rpx;
}

/* 标签选择 */
.tags-container {
  display: flex;
  gap: 15rpx;
  padding-bottom: 30rpx;
}

.tag-option {
  padding: 15rpx 40rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.tag-option.active {
  background-color: #f0f4ff;
  border-color: #667eea;
}

.tag-text {
  font-size: 26rpx;
  color: #666666;
}

.tag-option.active .tag-text {
  color: #667eea;
  font-weight: bold;
}

/* 默认地址 */
.default-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
}

.default-left {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.default-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e0e0e0;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 24rpx;
  transition: all 0.3s;
}

.default-icon.checked {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.default-text {
  font-size: 28rpx;
  color: #333333;
}

.default-switch {
  width: 90rpx;
  height: 50rpx;
  background-color: #e0e0e0;
  border-radius: 25rpx;
  position: relative;
  transition: all 0.3s;
}

.default-switch.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.switch-dot {
  width: 42rpx;
  height: 42rpx;
  background-color: #ffffff;
  border-radius: 21rpx;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: all 0.3s;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.2);
}

.default-switch.active .switch-dot {
  left: 44rpx;
}

/* 底部操作 */
.bottom-action {
  padding: 30rpx;
}

.save-btn {
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 45rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.save-btn::after {
  border: none;
}

/* 底部间距 */
.bottom-space {
  height: 20rpx;
}
