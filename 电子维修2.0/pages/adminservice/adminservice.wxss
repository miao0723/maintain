.admin-service-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef3f8 0%, #e6edf5 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.hero-card,
.list-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 138, 0.1);
}

.list-card {
  margin-top: 20rpx;
}

.hero-title,
.list-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #223446;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.list-refresh {
  font-size: 24rpx;
  color: #5a6e8a;
}

.conversation-item {
  padding: 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #eef3f8 100%);
  border: 1rpx solid rgba(90, 110, 138, 0.08);
  margin-bottom: 14rpx;
}

.conversation-top {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  align-items: center;
}

.conversation-summary {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.conversation-status {
  font-size: 22rpx;
  color: #ffffff;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.conversation-status.waiting {
  background: #f59e0b;
}

.conversation-status.connected {
  background: #10b981;
}

.conversation-status.completed {
  background: #6b7280;
}

.conversation-status.cancelled {
  background: #9ca3af;
}

.conversation-meta,
.conversation-last,
.conversation-enter,
.empty-text,
.loading-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
}

.conversation-enter {
  color: #4f46e5;
  font-weight: 600;
}

.empty-state,
.loading-state {
  padding: 60rpx 20rpx;
  text-align: center;
}

.empty-icon {
  font-size: 60rpx;
}

/* 查看历史会话切换按钮 */
.toggle-all-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
  margin-top: 10rpx;
  border-radius: 16rpx;
  background: rgba(90, 110, 138, 0.06);
  gap: 8rpx;
}

.toggle-all-text {
  font-size: 24rpx;
  color: #5a6e8a;
  font-weight: 500;
}

.toggle-all-arrow {
  font-size: 20rpx;
  color: #5a6e8a;
}

.sub-header {
  margin-top: 20rpx;
  margin-bottom: 14rpx;
}

.history-list .conversation-item {
  opacity: 0.7;
}
