<view class="chat-page">
  <scroll-view class="message-list" scroll-y>
    <view class="status-banner" wx:if="{{humanConnected}}">
      <text class="status-text">人工客服服务中</text>
    </view>
    <view class="status-banner ended" wx:else>
      <text class="status-text">人工会话已结束，用户将恢复智能客服</text>
    </view>

    <!-- 客服侧：该用户售后信息 -->
    <view class="aftersales-panel" wx:if="{{customerSummary}}">
      <view class="as-header" bindtap="toggleAfterSales">
        <text class="as-title">🛠️ 该用户售后信息</text>
        <text class="as-toggle">{{showAfterSales ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{showAfterSales}}">
        <view class="as-section-title">设备（{{customerSummary.devices.length}}）</view>
        <view class="as-device" wx:for="{{customerSummary.devices}}" wx:key="id">
          <text class="as-device-name">{{item.device_nickname || item.device_model}}</text>
          <text class="as-warranty {{item.warranty.status}}">{{item.warranty.status === 'in' ? '质保中' : (item.warranty.status === 'out' ? '已过保' : '无质保')}}</text>
        </view>
        <view class="as-section-title">近期维修（{{customerSummary.recentOrders.length}}）</view>
        <view class="as-order" wx:for="{{customerSummary.recentOrders}}" wx:key="id">
          <text class="as-order-no">{{item.order_id}}</text>
          <text class="as-order-status">{{item.status}}</text>
          <text class="as-order-warranty" wx:if="{{item.is_warranty}}">质保单</text>
        </view>
      </view>
    </view>

    <view class="message-row {{item.sender_type === 'user' ? 'left' : 'right'}}" wx:for="{{messages}}" wx:key="id">
      <view class="message-bubble {{item.sender_type === 'user' ? 'user-bubble' : item.sender_type === 'human' ? 'admin-bubble' : 'system-bubble'}}">
        <text class="message-role">{{item.sender_type === 'user' ? '用户' : item.sender_type === 'human' ? '管理员' : '系统'}}</text>
        <text class="message-text">{{item.content}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="composer" wx:if="{{humanConnected}}">
    <input class="composer-input" placeholder="输入回复内容" value="{{inputText}}" bindinput="onInputChange" confirm-type="send" bindconfirm="sendMessage" />
    <view class="voice-trigger {{voiceRecording ? 'recording' : ''}}" bindtap="toggleVoiceInput">
      <text class="voice-trigger-icon">{{voiceRecording ? '■' : '🎤'}}</text>
    </view>
    <button class="composer-btn" bindtap="sendMessage">发送</button>
  </view>
  <text class="voice-hint {{voiceRecognizing || voiceRecording ? 'active' : ''}}" wx:if="{{humanConnected && voiceHint}}">{{voiceHint}}</text>

  <button class="complete-btn" wx:if="{{humanConnected}}" bindtap="completeConversation">结束人工对话</button>
</view>
