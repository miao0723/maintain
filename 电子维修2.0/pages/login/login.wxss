/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(123, 154, 190, 0.18), transparent 28%),
    linear-gradient(180deg, #eff4f8 0%, #e7eef5 34%, #f8fbfd 100%);
  padding: 42rpx 20rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  padding: 24rpx 22rpx 24rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #203349 0%, #314b67 55%, #5f7d9a 100%);
  box-shadow: 0 22rpx 54rpx rgba(32, 51, 73, 0.22);
}

.hero-bg {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  filter: blur(8rpx);
}

.hero-bg-left {
  width: 220rpx;
  height: 220rpx;
  top: 120rpx;
  left: -70rpx;
}

.hero-bg-right {
  width: 280rpx;
  height: 280rpx;
  right: -80rpx;
  top: -50rpx;
}

.brand-header,
.hero-copy,
.metrics-grid {
  position: relative;
  z-index: 1;
}

.brand-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.brand-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.logo-box {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  flex-shrink: 0;
}

.logo-icon {
  font-size: 42rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.app-title {
  font-size: 34rpx;
  line-height: 1.25;
  color: #ffffff;
  font-weight: 700;
}

.welcome-text {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.72);
}

.brand-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 20rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  flex-shrink: 0;
}

.hero-copy {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 36rpx;
  line-height: 1.26;
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.58;
  color: rgba(255, 255, 255, 0.82);
}

.metrics-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.metric-card {
  padding: 14rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.metric-value {
  display: block;
  font-size: 28rpx;
  line-height: 1.25;
  color: #ffffff;
  font-weight: 700;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.72);
}

.feature-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.feature-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.content-box {
  margin-top: 10rpx;
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.auth-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(216, 225, 234, 0.82);
  border-radius: 30rpx;
  box-shadow: 0 16rpx 36rpx rgba(72, 96, 122, 0.08);
  backdrop-filter: blur(8rpx);
}

.auth-card {
  margin-top: 0;
  padding: 24rpx 20rpx 22rpx;
}

.card-head {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 32rpx;
  line-height: 1.3;
  color: #142132;
  font-weight: 700;
}

.card-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #66798d;
}

.flow-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.flow-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 14rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f8fbfe 0%, #eef4f9 100%);
  border: 1rpx solid rgba(211, 221, 230, 0.82);
}

.flow-step {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #304a66 0%, #5c7e9f 100%);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.flow-text {
  font-size: 23rpx;
  line-height: 1.45;
  color: #34485c;
}

.auth-notice {
  margin-top: 14rpx;
  padding: 16rpx 16rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.notice-item:last-child {
  margin-bottom: 0;
}

.notice-icon {
  width: 36rpx;
  text-align: center;
  font-size: 22rpx;
  flex-shrink: 0;
  color: #41576f;
}

.notice-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.55;
  color: #516578;
}

.notice-text-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
}

.inline-link {
  color: #46698a;
  font-weight: 700;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  margin-top: 16rpx;
  border: none;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(40, 62, 86, 0.24);
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: translateY(2rpx);
}

.btn-text {
  position: relative;
  z-index: 1;
}

.footer {
  display: flex;
  justify-content: center;
  padding: 14rpx 0 8rpx;
}

.footer-text {
  font-size: 20rpx;
  line-height: 1.5;
  color: #8a99a8;
  text-align: center;
}

@media (max-height: 760px) {
  .login-container {
    padding-top: 28rpx;
  }

  .hero-panel {
    padding-top: 20rpx;
    padding-bottom: 20rpx;
  }

  .hero-title {
    font-size: 32rpx;
  }

  .content-box {
    margin-top: 8rpx;
  }
}

@media (max-width: 420px) {
  .metrics-grid {
    grid-template-columns: 1fr;
  }

  .brand-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title {
    font-size: 32rpx;
  }
}
