<!-- pages/login/login.wxml -->
<view class="login-container {{compactLayout ? 'compact' : ''}}">
  <view class="hero-panel">
    <view class="hero-bg hero-bg-left"></view>
    <view class="hero-bg hero-bg-right"></view>

    <view class="brand-header">
      <view class="brand-main">
        <view class="logo-box">
          <text class="logo-icon">🔧</text>
        </view>
        <view class="brand-copy">
          <text class="app-title">电子维修服务</text>
          <text class="welcome-text">维修、自检、回收、进度同步一体化处理</text>
        </view>
      </view>
      <view class="brand-badge">微信授权登录</view>
    </view>

    <view class="hero-copy">
      <text class="hero-title">微信授权后直接进入维修系统</text>
      <text class="hero-desc">接入故障自检、报价确认、进度反馈和设备回收，授权一次即可开始使用。</text>
    </view>

    <view class="metrics-grid">
      <view class="metric-card" wx:for="{{serviceMetrics}}" wx:key="id">
        <text class="metric-value">{{item.value}}</text>
        <text class="metric-label">{{item.label}}</text>
      </view>
    </view>

    <view class="feature-tags">
      <text class="feature-tag" wx:for="{{featureTags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="content-box">
    <view class="auth-card">
      <view class="card-head">
        <text class="card-title">微信一键授权登录</text>
        <text class="card-subtitle">点击按钮后自动获取头像、昵称、用户标识，并直接进入系统首页</text>
      </view>

      <view class="flow-list">
        <view class="flow-item" wx:for="{{flowSteps}}" wx:key="id">
          <view class="flow-step">{{item.step}}</view>
          <text class="flow-text">{{item.title}}</text>
        </view>
      </view>

      <view class="auth-notice">
        <view class="notice-item">
          <text class="notice-icon">✓</text>
          <text class="notice-text">自动获取微信头像、昵称并绑定当前账号</text>
        </view>
        <view class="notice-item">
          <text class="notice-icon">🔒</text>
          <text class="notice-text">自动获取用户ID并进入首页，无需手动填写资料</text>
        </view>
        <view class="notice-item">
          <text class="notice-icon">📄</text>
          <view class="notice-text notice-text-row">
            <text>登录即表示您同意</text>
            <text class="inline-link" bindtap="viewAgreement" catchtap="viewAgreement">《免责协议》</text>
            <text>和</text>
            <text class="inline-link" bindtap="viewPrivacyPolicy" catchtap="viewPrivacyPolicy">《隐私政策》</text>
          </view>
        </view>
      </view>

      <button
        class="login-btn"
        bindtap="handleLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        <text class="btn-text">{{loading ? '授权登录中...' : '微信授权并进入系统'}}</text>
      </button>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">授权一次即可自动保持登录，后续可直接进入维修系统</text>
  </view>
</view>
