/* pages/scan/scan.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f2f5 0%, #e8ebef 100%);
  padding-bottom: 60rpx;
}

/* ========== Phase 1: 选择图片 ========== */
.phase-select {
  padding: 40rpx 30rpx;
  animation: fadeIn 0.5s ease;
}

.select-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.select-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2d3748;
  margin-bottom: 12rpx;
}

.select-subtitle {
  display: block;
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

/* 选择卡片 */
.select-cards {
  display: flex;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.select-card {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 44rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.select-card:active {
  border-color: #5a6e8a;
  transform: scale(0.96);
  background: #f0f3ff;
}

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(90,110,138,0.12) 0%, rgba(110,133,165,0.08) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-emoji {
  font-size: 48rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d3748;
}

.card-desc {
  font-size: 22rpx;
  color: #a0aec0;
}

/* 预览区域 */
.preview-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 36rpx;
}

.preview-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: #f0f2f5;
}

.preview-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn:active {
  transform: scale(0.95);
}

.btn-primary {
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(90,110,138,0.26);
}

.btn-outline {
  background: #ffffff;
  color: #5a6e8a;
  border: 2rpx solid #dce0e5;
}

/* 使用提示 */
.tips-section {
  background: rgba(90,110,138,0.06);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #5a6e8a;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.8;
}

/* ========== Phase 2: 识别中 ========== */
.phase-identifying {
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeIn 0.5s ease;
}

.identifying-card {
  width: 100%;
  background: #1a1f2e;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.18);
}

.identifying-image {
  width: 100%;
  height: 460rpx;
  opacity: 0.6;
}

.identifying-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 扫描线动画 */
.scan-line {
  position: absolute;
  top: 0;
  left: 8%;
  right: 8%;
  height: 3rpx;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(110, 200, 255, 0.8) 20%,
    rgba(110, 200, 255, 0.9) 50%,
    rgba(110, 200, 255, 0.8) 80%,
    transparent 100%
  );
  box-shadow: 0 0 20rpx rgba(110, 200, 255, 0.4);
  animation: scanDown 2s ease-in-out infinite;
  z-index: 2;
}

@keyframes scanDown {
  0% { top: 10%; }
  50% { top: 88%; }
  100% { top: 10%; }
}

.identifying-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  z-index: 3;
  background: rgba(26,31,46,0.75);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.spinner-ring {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(110,200,255,0.2);
  border-top-color: #5e9cf5;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.identifying-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.identifying-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

/* 识别步骤 */
.identifying-steps {
  display: flex;
  align-items: center;
  gap: 0;
  margin-top: 20rpx;
}

.identifying-steps .step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.5);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s ease;
}

.identifying-steps .step.done .step-dot {
  background: #48bb78;
  color: #ffffff;
}

.step-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  transition: color 0.4s ease;
}

.identifying-steps .step.done .step-label {
  color: rgba(255,255,255,0.8);
}

.step-line {
  width: 60rpx;
  height: 2rpx;
  background: rgba(255,255,255,0.15);
  margin-bottom: 20rpx;
  transition: background 0.4s ease;
}

.step-line.active {
  background: #48bb78;
}

.cancel-btn {
  width: 240rpx;
  margin-top: 10rpx;
}

/* ========== Phase 3: 识别结果 ========== */
.phase-result {
  padding: 30rpx 30rpx 60rpx;
  animation: fadeIn 0.5s ease;
}

.result-header {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.result-badge {
  font-size: 26rpx;
  font-weight: 600;
  color: #48bb78;
  background: rgba(72,187,120,0.1);
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

/* 设备卡片 */
.result-device-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.06);
  margin-bottom: 32rpx;
}

.device-img-section {
  width: 100%;
  height: 260rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  background: #f0f2f5;
}

.device-img {
  width: 100%;
  height: 100%;
}

.device-main-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 28rpx;
}

.device-icon-large {
  font-size: 64rpx;
}

.device-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.device-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2d3748;
}

/* 系列标签 */
.series-tag {
  background: linear-gradient(135deg, #5a6e8a, #6e85a5);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.series-tag-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.5;
}

.device-model {
  font-size: 26rpx;
  color: #718096;
  background: #f0f2f5;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

/* 置信度 */
.confidence-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 10rpx;
  margin-bottom: 24rpx;
}

.confidence-label {
  font-size: 24rpx;
  color: #718096;
  white-space: nowrap;
}

.confidence-track {
  flex: 1;
  height: 10rpx;
  background: #e5e8eb;
  border-radius: 5rpx;
  overflow: hidden;
}

.confidence-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #48bb78 0%, #5e9cf5 100%);
  transition: width 1s ease;
}

.confidence-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #5a6e8a;
  min-width: 60rpx;
  text-align: right;
}

/* 详细信息 */
.device-detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-label {
  font-size: 24rpx;
  color: #718096;
}

.detail-value {
  font-size: 26rpx;
  font-weight: 500;
  color: #2d3748;
}

/* 高亮详情行（识别系列） */
.detail-highlight {
  background: rgba(90,110,138,0.08);
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
}

.detail-highlight .detail-label {
  color: #5a6e8a;
  font-weight: 600;
}

.detail-highlight .detail-value {
  color: #4a5568;
  font-weight: 700;
}

/* 次要详情行（特征判断） */
.detail-secondary {
  background: rgba(245,158,11,0.06);
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
}

.detail-secondary .detail-label {
  color: #b45309;
  font-size: 22rpx;
}

.detail-secondary .detail-value {
  color: #92400e;
  font-size: 23rpx;
  font-style: italic;
}

/* 候选设备型号触发条 */
.model-select-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: rgba(94,156,245,0.06);
  border: 2rpx solid rgba(94,156,245,0.18);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.model-select-trigger:active {
  background: rgba(94,156,245,0.12);
}

.trigger-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.trigger-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.trigger-texts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.trigger-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2d3748;
}

.trigger-current {
  font-size: 24rpx;
  color: #5a6e8a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trigger-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5e9cf5;
}

.trigger-action.done {
  color: #5a6e8a;
}

.trigger-arrow {
  font-size: 32rpx;
  line-height: 1;
}

/* ========== 设备型号选择抽屉 ========== */
.model-drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.model-drawer-mask.show {
  opacity: 1;
  visibility: visible;
}

.model-drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0 30rpx calc(30rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.12);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.model-drawer.show {
  transform: translateY(0);
}

.drawer-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d6dbe3;
  margin: 18rpx auto 8rpx;
  flex-shrink: 0;
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx 20rpx;
  flex-shrink: 0;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d3748;
}

.drawer-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #a0aec0;
  background: #f1f3f6;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.drawer-close:active {
  background: #e2e8f0;
  transform: scale(0.9);
}

.drawer-tip {
  display: block;
  font-size: 22rpx;
  color: #718096;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.drawer-list {
  flex: 1;
  overflow-y: auto;
}

.drawer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 14rpx;
  background: #f8f9fb;
  border: 2rpx solid #eef1f5;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.drawer-item:active {
  background: #eef3ff;
  transform: scale(0.99);
}

.drawer-item.active {
  background: linear-gradient(135deg, #5e9cf5, #4a7fe0);
  border-color: #4a7fe0;
  box-shadow: 0 6rpx 16rpx rgba(94,156,245,0.28);
}

.drawer-item-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #2d3748;
}

.drawer-item.active .drawer-item-text {
  color: #ffffff;
}

.drawer-item-check {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

/* 类型匹配 */
.type-match {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: rgba(90,110,138,0.08);
  border-radius: 16rpx;
}

.match-icon {
  font-size: 24rpx;
}

.match-text {
  font-size: 24rpx;
  color: #5a6e8a;
  font-weight: 500;
}

.type-custom {
  background: rgba(245,158,11,0.1);
}

.type-custom .match-text {
  color: #b45309;
}

/* ========== 操作按钮 ========== */
.result-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.act-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #e8ecf1;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
  line-height: 1;
}

.act-btn::after {
  border: none;
}

.act-btn:active {
  transform: scale(0.98);
  opacity: 0.85;
}

.act-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.act-text {
  flex: 1;
  text-align: left;
}

/* 按钮颜色区分（浅色左边框 + 轻量图标色） */
.act-device {
  border-left: 6rpx solid #6366f1;
  background: linear-gradient(90deg, rgba(99,102,241,0.04) 0%, #fff 15%);
}

.act-repair {
  border-left: 6rpx solid #f59e0b;
  background: linear-gradient(90deg, rgba(245,158,11,0.04) 0%, #fff 15%);
}

.act-recycle {
  border-left: 6rpx solid #10b981;
  background: linear-gradient(90deg, rgba(16,185,129,0.04) 0%, #fff 15%);
}

/* 重新识别 */
.re-identify {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #5a6e8a;
  font-weight: 500;
}

/* ========== 错误页面 ========== */
.phase-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  animation: fadeIn 0.5s ease;
}

.error-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d3748;
  margin-bottom: 12rpx;
}

.error-msg {
  font-size: 26rpx;
  color: #718096;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.error-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

/* ========== 动画 ========== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
