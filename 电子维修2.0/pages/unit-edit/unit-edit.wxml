<!--pages/unit-edit/unit-edit.wxml-->
<view class="page-container">
  <!-- 单位信息表单 -->
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">单位名称</text>
      <input
        class="form-input"
        type="text"
        placeholder="请输入单位名称"
        value="{{formData.name}}"
        bindinput="onInput"
        data-field="name"
        maxlength="50"/>
    </view>

    <view class="form-item">
      <text class="form-label">联系人</text>
      <input
        class="form-input"
        type="text"
        placeholder="请输入联系人姓名"
        value="{{formData.contactName}}"
        bindinput="onInput"
        data-field="contactName"
        maxlength="20"/>
    </view>

    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入联系电话"
        value="{{formData.contactPhone}}"
        bindinput="onInput"
        data-field="contactPhone"
        maxlength="11"/>
    </view>

    <view class="form-item">
      <text class="form-label">单位地址</text>
      <textarea
        class="form-textarea"
        placeholder="请输入单位详细地址"
        value="{{formData.address}}"
        bindinput="onInput"
        data-field="address"
        maxlength="200"/>
    </view>

    <view class="form-item switch-item">
      <text class="form-label">设为默认</text>
      <switch checked="{{formData.isDefault}}" bindchange="toggleDefault"/>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="bottom-action">
    <button class="save-btn" bindtap="saveUnit">保存单位</button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>
</view>