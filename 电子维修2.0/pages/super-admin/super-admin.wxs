/**
 * 超级管理员页面 WXS 工具函数
 * WXS 运行在渲染层，可在 WXML 模板中直接调用
 */

// 设备类型映射（与 deviceData.js 保持一致）
var DEVICE_TYPE_MAP = {
  '1': '手机',
  '2': '电脑/笔记本',
  '3': '平板',
  '4': '手表/手环',
  '5': '耳机/音响',
  '6': '相机/摄像机',
  '7': '游戏机',
  '8': '传感器/仪器',
  '9': '无人机/航拍',
  '10': '智能家居',
  '11': '打印机/办公设备'
};

// 状态映射
var STATUS_MAP = {
  'pending': '待处理',
  'quoted': '待确认',
  'confirmed': '待处理',
  'processing': '处理中',
  'completed': '已完成',
  'cancelled': '已取消',
  'review': '待评价'
};

// 状态颜色映射
var STATUS_COLOR_MAP = {
  'pending': '#f39c12',
  'quoted': '#e67e22',
  'confirmed': '#3498db',
  'processing': '#3498db',
  'completed': '#27ae60',
  'cancelled': '#e74c3c',
  'review': '#9b59b6'
};

/**
 * 格式化价格
 */
function formatPrice(price) {
  if (price === null || price === undefined || price === '') return '0.00';
  var num = parseFloat(price);
  // NaN 检查
  if (num !== num) return '0.00';
  return num.toFixed(2);
}

/**
 * 获取状态文本
 */
function getStatusText(status) {
  if (!status) return '未知';
  return STATUS_MAP[status] || status;
}

/**
 * 获取状态颜色
 */
function getStatusColor(status) {
  if (!status) return '#999';
  return STATUS_COLOR_MAP[status] || '#999';
}

/**
 * 获取设备类型名称
 */
function getDeviceTypeName(typeId) {
  if (typeId === null || typeId === undefined || typeId === '') return '未知';
  var strId = '' + typeId;
  // 如果已经是字符串名称（非纯数字），直接返回
  var reg = getRegExp('[^0-9]');
  if (reg.test(strId)) return typeId;
  // 自定义类型（id=0）
  if (typeId === 0) return '自定义设备';
  return DEVICE_TYPE_MAP[strId] || ('设备(' + typeId + ')');
}

/**
 * 格式化日期
 */
function formatDate(dateStr) {
  if (!dateStr) return '';
  var d = getDate(dateStr);
  if (d.getTime() !== d.getTime()) return ''; // NaN check
  var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
    ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
}

/**
 * 获取价格差异样式类名
 */
function getPriceDiffClass(estimated, actual) {
  var e = parseFloat(estimated) || 0;
  var a = parseFloat(actual) || 0;
  var diff = a - e;
  if (diff > 0) return 'price-diff-positive';
  if (diff < 0) return 'price-diff-negative';
  return 'price-diff-zero';
}

module.exports = {
  formatPrice: formatPrice,
  getStatusText: getStatusText,
  getStatusColor: getStatusColor,
  getDeviceTypeName: getDeviceTypeName,
  formatDate: formatDate,
  getPriceDiffClass: getPriceDiffClass
};
