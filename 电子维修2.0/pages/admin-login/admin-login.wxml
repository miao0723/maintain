<view class="login-container">
  <view class="login-header">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="title">管理员登录</text>
    <text class="subtitle">电子维修后台管理系统</text>
  </view>

  <view class="login-form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入管理员手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        focus="{{true}}"
      />
    </view>

    <view class="form-item">
      <text class="label">权限说明</text>
      <view class="permission-tips">
        <text class="tip-item">• 只有管理员角色才能登录</text>
        <text class="tip-item">• 请确保用户角色已设置为admin</text>
        <text class="tip-item">• 如需设置管理员，请联系超级管理员</text>
      </view>
    </view>

    <button
      class="login-btn {{loading ? 'loading' : ''}}"
      bindtap="onLogin"
      loading="{{loading}}"
      disabled="{{loading}}">
      {{loading ? '登录中...' : '登录'}}
    </button>
  </view>

  <view class="login-footer">
    <text class="footer-text" bindtap="goBack">返回首页</text>
  </view>
</view>
