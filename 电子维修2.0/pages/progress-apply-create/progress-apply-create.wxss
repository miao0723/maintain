.page-container {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  padding: 26rpx 24rpx 30rpx;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 4rpx;
}

.page-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #5a6e8a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

.loading-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
  margin-bottom: 0;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #999;
  font-size: 26rpx;
}

/* 表单滚动 */
.form-scroll {
  height: calc(100vh - 136rpx);
  padding-bottom: 84rpx;
}

/* 审批状态 */
.status-section {
  margin: 16rpx 16rpx 0;
  padding: 18rpx 20rpx;
  background: #fff;
  border-radius: 14rpx;
  border-left: 8rpx solid;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.status-row:last-child {
  margin-bottom: 0;
}

.status-label {
  font-size: 26rpx;
  color: #999;
}

.status-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.status-value.time {
  font-weight: 400;
  color: #999;
  font-size: 24rpx;
}

/* 已选订单卡片 */
.order-card {
  margin: 16rpx 16rpx 0;
  padding: 18rpx;
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  border-radius: 14rpx;
  border: 2rpx solid #c7d2fe;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.order-card-icon {
  width: 54rpx;
  height: 54rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.order-card-body {
  flex: 1;
  min-width: 0;
}

.order-card-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.order-card-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.order-card-status {
  font-size: 20rpx;
  color: #3b82f6;
  background: #dbeafe;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.order-card-device {
  display: block;
  font-size: 24rpx;
  color: #555;
  margin-bottom: 2rpx;
}

.order-card-time {
  font-size: 20rpx;
  color: #999;
}

.order-card-arrow {
  font-size: 40rpx;
  color: #a5b4fc;
  flex-shrink: 0;
}

/* 表单区块 */
.form-section {
  margin: 16rpx 16rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  margin-bottom: 14rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-row {
  display: flex;
  align-items: center;
}

.order-select-row {
  justify-content: space-between;
  gap: 16rpx;
}

.inline-meta {
  flex: 1;
  min-width: 0;
}

.compact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.compact-col {
  min-width: 0;
}

.form-group {
  margin-bottom: 16rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #555;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 2rpx;
}

.required {
  color: #ef4444;
}

/* 选择按钮 */
.select-btn {
  padding: 12rpx 22rpx;
  background: #5a6e8a;
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.select-btn.disabled {
  background: #ccc;
}

/* 选择器样式 */
.order-picker, .type-picker, .date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  min-height: 38rpx;
}

.date-picker.filled {
  border-color: #c7d2fe;
  background: #eef2ff;
}

.picker-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.picker-placeholder {
  font-size: 26rpx;
  color: #bbb;
  flex: 1;
}

.picker-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 10rpx;
}

/* 进度类型选择网格 */
.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 8rpx 12rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s;
}

.type-item.active {
  background: #eef2ff;
  border-color: #5a6e8a;
  box-shadow: 0 4rpx 16rpx rgba(90,110,138,0.15);
}

.type-item-icon {
  font-size: 28rpx;
  margin-bottom: 6rpx;
}

.type-item-label {
  font-size: 22rpx;
  color: #555;
  font-weight: 500;
  line-height: 1.2;
}

.type-item.active .type-item-label {
  color: #5a6e8a;
  font-weight: 600;
}

/* 查看模式类型展示 */
.type-display {
  display: flex;
  align-items: center;
  padding: 16rpx 18rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  gap: 12rpx;
}

.type-display-icon {
  font-size: 36rpx;
}

.type-display-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 输入框 */
.form-input {
  width: 100%;
  padding: 16rpx 18rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 24rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 16rpx 18rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 24rpx;
  color: #333;
  min-height: 120rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

/* 提交按钮 */
.submit-area {
  margin: 20rpx 16rpx 0;
  text-align: center;
}

.submit-btn {
  width: 100%;
  height: 76rpx;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 25rpx rgba(90,110,138,0.35);
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.7;
}

.submit-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.bottom-space {
  height: 32rpx;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  max-height: 65vh;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
}

.modal-body {
  padding: 20rpx 30rpx;
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.order-list-scroll {
  max-height: 50vh;
}

/* 加载内联 */
.loading-more-inline {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 订单选项 */
.order-option {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  transition: background 0.2s;
}

.order-option:active {
  background: #f5f5f5;
}

.order-option.selected {
  background: #eef2ff;
  border: 2rpx solid #c7d2fe;
  padding: 22rpx;
}

.order-option-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.order-option-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.order-status.processing {
  font-size: 22rpx;
  color: #3b82f6;
  background: #dbeafe;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.order-checked {
  font-size: 32rpx;
  color: #5a6e8a;
  font-weight: bold;
}

.order-device {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.order-time {
  font-size: 22rpx;
  color: #bbb;
}

.empty-order {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.empty-order-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.empty-order-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 4rpx;
}
