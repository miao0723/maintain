.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 16rpx;
  padding-bottom: 100rpx;
}

/* 订单信息 */
.order-info {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.order-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.order-status.status-pending {
  background: #fef3c7;
  color: #f59e0b;
}

.order-status.status-processing {
  background: #dbeafe;
  color: #3b82f6;
}

.order-status.status-completed {
  background: #d1fae5;
  color: #10b981;
}

.order-status.status-cancelled {
  background: #fee2e2;
  color: #ef4444;
}

.order-details {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-item .label {
  color: #666;
  font-size: 28rpx;
}

.detail-item .value {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

/* 维修记录列表 */
.records-section {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-header .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.add-btn {
  background: #3b82f6;
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
}

.record-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding: 24rpx 0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-stage {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.record-stage.stage-jiedan {
  background: #e0f2fe;
  color: #0369d1;
}

.record-stage.stage-jiance {
  background: #fff3e0;
  color: #f57c00;
}

.record-stage.stage-weixiu {
  background: #e8f5e9;
  color: #2e7d32;
}

.record-stage.stage-ceshi {
  background: #f3e5f5;
  color: #7b1fa2;
}

.record-stage.stage-wancheng {
  background: #dcedc8;
  color: #689f38;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.record-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.record-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.record-image {
  width: 100%;
  height: 180rpx;
  border-radius: 8rpx;
}

.record-videos {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.record-video {
  position: relative;
  aspect-ratio: 16/9;
  border-radius: 8rpx;
  overflow: hidden;
  background: #000;
}

.video-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.video-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48rpx;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.record-parts {
  background: #f9f9f9;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.parts-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.parts-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.part-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
}

.part-name {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.part-qty {
  font-size: 24rpx;
  color: #666;
  margin: 0 16rpx;
}

.part-price {
  font-size: 26rpx;
  font-weight: 600;
  color: #f59e0b;
}

.parts-total {
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #f59e0b;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #e0e0e0;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.delete-btn {
  background: #fee;
  color: #dc2626;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  border: 1rpx solid #dc2626;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: #3b82f6;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  border: none;
}

/* 返回按钮 */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 16rpx;
  border-top: 1rpx solid #e0e0e0;
  display: flex;
  justify-content: center;
}

.back-btn {
  width: 90%;
  background: #3b82f6;
  color: white;
  padding: 20rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 24rpx;
  max-height: 60vh;
}

.form-section {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

/* 阶段选择 */
.stage-options {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
}

.stage-item {
  text-align: center;
  padding: 12rpx 8rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #666;
  transition: all 0.3s;
}

.stage-item.active {
  background: #3b82f6;
  color: white;
}

/* 表单输入 */
.form-input, .form-textarea {
  width: 100%;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 120rpx;
  resize: none;
}

/* 图片上传 */
.image-list, .video-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.image-item, .video-item {
  position: relative;
  aspect-ratio: 1;
}

.image-thumb, .video-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8rpx;
}

.image-remove, .video-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
}

.upload-btn {
  width: 100%;
  padding: 16rpx;
  background: #f0f0f0;
  color: #666;
  border: 1rpx dashed #999;
  border-radius: 8rpx;
  font-size: 26rpx;
}

/* 配件 */
.parts-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.parts-item {
  background: #f9f9f9;
  padding: 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
}

.parts-item:last-child {
  margin-bottom: 12rpx;
}

.part-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.part-name-input {
  flex: 1;
  padding: 8rpx 12rpx;
  background: white;
  border-radius: 6rpx;
  font-size: 24rpx;
  border: 1rpx solid #e0e0e0;
}

.part-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.part-detail {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #666;
  min-width: 100rpx;
}

.part-input {
  flex: 1;
  padding: 8rpx 12rpx;
  background: white;
  border-radius: 6rpx;
  font-size: 24rpx;
  border: 1rpx solid #e0e0e0;
}

.parts-total {
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: #f59e0b;
  padding: 16rpx;
  background: #fff3e0;
  border-radius: 8rpx;
}

/* 弹窗底部 */
.modal-footer {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #e0e0e0;
}

.cancel-btn {
  flex: 1;
  padding: 16rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 24rpx;
  font-size: 28rpx;
  border: none;
}

.submit-btn {
  flex: 1;
  padding: 16rpx;
  background: #3b82f6;
  color: white;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
