page {
  background: #f5f7fa;
  min-height: 100vh;
}

.container {
  padding: 24rpx 32rpx;
  padding-bottom: 160rpx;
}

/* 进度选择区域 */
.progress-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.progress-slider {
  margin: 24rpx 0;
}

/* 只读模式进度条 */
.progress-display-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 20rpx;
  background: #e5e7eb;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar-fill-display {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.progress-display-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #667eea;
  min-width: 80rpx;
  text-align: right;
}

.slider-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-value {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.progress-slider-bar {
  flex: 1;
}

.quick-progress {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.quick-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid #e5e7eb;
  transition: all 0.3s;
}

.quick-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-color: #667eea;
  font-weight: 600;
}

/* 描述输入区域 */
.description-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.description-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
  color: #333;
}

.description-input:focus {
  border-color: #667eea;
  outline: none;
}

.desc-count {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 8rpx;
}

/* 图片上传区域 */
.photos-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.photos-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.photos-count {
  font-size: 22rpx;
  color: #999;
}

.photos-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.photo-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.photo-delete-icon {
  font-size: 24rpx;
  color: #fff;
}

.photo-add {
  background: #f8f9fa;
  border: 2rpx dashed #d1d5db;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon {
  font-size: 48rpx;
  color: #9ca3af;
}

.photo-add-text {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.photos-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.upload-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  gap: 8rpx;
}

.upload-btn.camera {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

/* 视频上传区域 */
.video-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.video-card {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #000;
}

.video-preview {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.video-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.video-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.video-play-icon {
  font-size: 40rpx;
  color: #fff;
  margin-left: 4rpx;
}

.video-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  z-index: 2;
}

.video-title {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

.video-duration {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.video-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.video-upload-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  gap: 8rpx;
}

.video-upload-btn.camera {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.video-delete-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fee2e2;
  color: #dc2626;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: 2rpx solid #fecaca;
}

/* 视频标题输入 */
.video-title-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.video-title-input:focus {
  border-color: #667eea;
  outline: none;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-btn.loading {
  opacity: 0.6;
}

/* 历史记录 */
.history-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* 反馈卡片 */
.feedback-card {
  display: flex;
  gap: 20rpx;
  position: relative;
}

/* 时间轴 */
.history-timeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
  flex-shrink: 0;
  padding-top: 8rpx;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background: linear-gradient(to bottom, #667eea, #e5e7eb);
  margin-top: 8rpx;
  min-height: 40rpx;
}

.feedback-content {
  flex: 1;
  background: #f8f9fc;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s;
}

.feedback-content:active {
  background: #f0f1f5;
  transform: scale(0.99);
}

/* 反馈头部 */
.feedback-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.feedback-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.feedback-time {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.feedback-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 媒体预览 */
.feedback-media-preview {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
}

.preview-photos {
  display: flex;
  gap: 8rpx;
  flex-wrap: nowrap;
  flex: 1;
  overflow: hidden;
}

.preview-photo-item {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #eef2f7;
  border: 1rpx solid #dbe3ee;
}

.preview-photo-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #eef2f7;
}

.preview-photo-more {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.preview-video {
  position: relative;
  width: 160rpx;
  height: 100rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.preview-video-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.preview-video-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #2d2d2d 0%, #1a1a2e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 48rpx;
  opacity: 0.7;
}

.preview-video-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 4rpx;
}

/* 底部标签 */
.feedback-tags {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.fb-tag {
  font-size: 20rpx;
  color: #888;
  background: #f0f1f5;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.detail-tag {
  margin-left: auto;
  color: #667eea;
  background: rgba(102, 126, 234, 0.08);
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 600;
}

.empty-subtext {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  text-align: center;
  margin-top: 12rpx;
  padding: 0 40rpx;
}

.empty-action-btn {
  margin-top: 32rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 56rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 38rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.3);
}

.empty-action-btn::after {
  border: none;
}

.empty-action-btn:active {
  transform: scale(0.97);
}

/* 待上传标签 */
.photo-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 4rpx 0;
  background: rgba(102, 126, 234, 0.85);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  z-index: 2;
}

/* 视频卡片内删除按钮 */
.video-delete-btn-inline {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  font-size: 28rpx;
  color: #fff;
}

/* 订单信息 */
.order-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.order-device {
  font-size: 24rpx;
  color: #666;
}
