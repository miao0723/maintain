.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  padding: 40rpx 30rpx 50rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  gap: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.filter-tab {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f2f5;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.filter-tab.active {
  background: #5a6e8a;
  color: #fff;
  font-weight: 600;
}

.filter-count {
  background: rgba(255,255,255,0.3);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 新建按钮 */
.create-btn-wrap {
  padding: 24rpx 30rpx;
}

.create-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(90,110,138,0.3);
}

.create-btn::after {
  border: none;
}

/* 加载/空状态 */
.loading-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #5a6e8a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #999;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 列表 */
.apply-list {
  padding: 0 30rpx;
}

.apply-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.apply-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.info-row {
  display: flex;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.info-value.reason {
  color: #666;
}

.info-value.time {
  color: #999;
  font-size: 24rpx;
}

/* 审批信息 */
.approval-info {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  border-left: 6rpx solid;
}

.approval-remark {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 6rpx;
}

.approval-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* 加载更多 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}