/* pages/admin-orders/order-assign.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20px;
}

/* 统计卡片 */
.stats-container {
  display: flex;
  justify-content: space-around;
  padding: 20px 10px;
  background: white;
  margin-bottom: 10px;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15px;
  border-radius: 10px;
  background: #f8f9fa;
  min-width: 80px;
}

.stat-value {
  font-size: 28px;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 5px;
}

.stat-label {
  font-size: 12px;
  color: #666;
}

/* 筛选器 */
.filter-container {
  background: white;
  padding: 15px;
  margin-bottom: 10px;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 10px 15px;
  margin-bottom: 15px;
}

.search-input {
  flex: 1;
  font-size: 14px;
  background: transparent;
}

.search-icon {
  font-size: 18px;
  margin-left: 10px;
}

.filter-tabs {
  display: flex;
  gap: 10px;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 10px;
  border-radius: 8px;
  background: #f5f5f5;
  font-size: 14px;
  color: #666;
  transition: all 0.3s;
}

.filter-tab.active {
  background: #667eea;
  color: white;
}

/* 订单列表 */
.orders-list {
  padding: 0 10px;
}

.order-card {
  background: white;
  border-radius: 12px;
  padding: 15px;
  margin-bottom: 15px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid #f0f0f0;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.order-no {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.order-time {
  font-size: 12px;
  color: #999;
}

.order-status {
  padding: 5px 10px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: bold;
}

.status-pending {
  background: #fef3c7;
  color: #f59e0b;
}

.status-processing {
  background: #dbeafe;
  color: #3b82f6;
}

.status-completed {
  background: #d1fae5;
  color: #10b981;
}

.status-cancelled {
  background: #fee2e2;
  color: #ef4444;
}

.order-content {
  margin-bottom: 12px;
}

.device-info {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.device-model {
  font-size: 15px;
  font-weight: bold;
  color: #333;
}

.device-type {
  padding: 3px 8px;
  background: #f0f0f0;
  border-radius: 4px;
  font-size: 12px;
  color: #666;
}

.problem-desc {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
  line-height: 1.5;
}

.customer-info {
  display: flex;
  gap: 15px;
}

.customer-name,
.customer-phone {
  font-size: 13px;
  color: #666;
}

.price-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px;
  background: #f9fafb;
  border-radius: 8px;
  margin-bottom: 10px;
}

.price-label {
  font-size: 14px;
  color: #666;
}

.price-value {
  font-size: 18px;
  font-weight: bold;
  color: #ef4444;
}

.priority-tag {
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: bold;
}

.priority-high {
  background: #fee2e2;
  color: #ef4444;
}

.priority-medium {
  background: #fef3c7;
  color: #f59e0b;
}

.priority-low {
  background: #d1fae5;
  color: #10b981;
}

.assign-info {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 10px;
  background: #eff6ff;
  border-radius: 8px;
  margin-bottom: 10px;
}

.assign-label {
  font-size: 13px;
  color: #666;
}

.assign-name {
  font-size: 14px;
  font-weight: bold;
  color: #3b82f6;
}

.order-actions {
  display: flex;
  gap: 10px;
}

.action-btn {
  flex: 1;
  height: 36px;
  line-height: 36px;
  border-radius: 8px;
  font-size: 14px;
  border: none;
}

.btn-assign {
  background: #667eea;
  color: white;
}

.btn-reassign {
  background: #f59e0b;
  color: white;
}

.btn-detail {
  background: #e5e7eb;
  color: #333;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 10px;
}

.empty-text {
  font-size: 14px;
  color: #999;
}

/* 加载更多 */
.load-more {
  padding: 20px;
  text-align: center;
}

.load-btn {
  width: 200px;
  background: #667eea;
  color: white;
  border: none;
  border-radius: 8px;
}

/* 分配弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 400px;
  background: white;
  border-radius: 12px;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  border-bottom: 1px solid #f0f0f0;
}

.modal-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 24px;
  color: #999;
  cursor: pointer;
}

.modal-body {
  padding: 20px;
}

.form-group {
  margin-bottom: 15px;
}

.form-label {
  display: block;
  font-size: 14px;
  font-weight: bold;
  color: #333;
  margin-bottom: 8px;
}

.picker {
  padding: 12px;
  background: #f5f5f5;
  border-radius: 8px;
  font-size: 14px;
  color: #333;
}

.admin-info {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  background: #eff6ff;
  border-radius: 8px;
  margin-top: 10px;
}

.info-label {
  font-size: 13px;
  color: #666;
}

.modal-footer {
  display: flex;
  gap: 10px;
  padding: 15px 20px;
  border-top: 1px solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 40px;
  line-height: 40px;
  border-radius: 8px;
  font-size: 14px;
  border: none;
}

.btn-cancel {
  background: #e5e7eb;
  color: #333;
}

.btn-confirm {
  background: #667eea;
  color: white;
}

/* 进度反馈按钮 */
.action-btn.btn-progress {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #fff;
  border: none;
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 13px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
