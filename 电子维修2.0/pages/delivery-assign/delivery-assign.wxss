.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 16rpx;
  padding-bottom: 100rpx;
}

/* 订单信息 */
.order-info {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.info-header {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .label {
  color: #666;
  font-size: 28rpx;
}

.info-row .value {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

/* 区块 */
.section {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 配送员列表 */
.persons-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.person-item {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.person-item.active {
  border-color: #3b82f6;
  background: #eff6ff;
}

.person-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.person-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.person-rating {
  font-size: 24rpx;
  color: #f59e0b;
}

.person-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.person-phone {
  font-size: 26rpx;
  color: #666;
}

.person-orders {
  font-size: 24rpx;
  color: #999;
}

.person-vehicle {
  display: flex;
  gap: 12rpx;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.empty-state {
  text-align: center;
  padding: 40rpx 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 地址列表 */
.address-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.address-item {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.address-item.active {
  border-color: #3b82f6;
  background: #eff6ff;
}

.address-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.address-phone {
  font-size: 26rpx;
  color: #666;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.add-address-btn {
  width: 100%;
  padding: 16rpx;
  background: white;
  color: #3b82f6;
  border: 2rpx dashed #3b82f6;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 配送费用 */
.fee-input {
  display: flex;
  align-items: center;
  background: #f9f9f9;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.fee-input .currency {
  font-size: 32rpx;
  font-weight: 600;
  color: #f59e0b;
  margin-right: 12rpx;
}

.fee-input .input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  border: none;
}

/* 底部按钮 */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 16rpx;
  border-top: 1rpx solid #e0e0e0;
  display: flex;
  gap: 12rpx;
}

.back-btn {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 48rpx;
  font-size: 32rpx;
  border: none;
}

.submit-btn {
  flex: 1;
  padding: 20rpx;
  background: #3b82f6;
  color: white;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
