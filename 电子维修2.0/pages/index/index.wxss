/* pages/index/index.wxss */
.page-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(138, 168, 203, 0.18), transparent 32%),
    linear-gradient(180deg, #edf3f8 0%, #e5edf5 36%, #f6f9fc 100%);
  padding-bottom: 56rpx;
}

.hero-section {
  position: relative;
  overflow: hidden;
  padding: 34rpx 24rpx 30rpx;
  background: linear-gradient(145deg, #213449 0%, #344d68 52%, #5f7d9a 100%);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 22rpx 50rpx rgba(33, 52, 73, 0.24);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  filter: blur(6rpx);
}

.hero-orb-left {
  width: 240rpx;
  height: 240rpx;
  left: -50rpx;
  top: 120rpx;
}

.hero-orb-right {
  width: 300rpx;
  height: 300rpx;
  right: -90rpx;
  top: -30rpx;
}

.hero-topbar,
.hero-main,
.hero-highlights {
  position: relative;
  z-index: 1;
}

.hero-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-logo {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 42rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.hero-brand-copy {
  display: flex;
  flex-direction: column;
}

.hero-brand-title {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1.25;
}

.hero-brand-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-profile {
  width: 82rpx;
  height: 82rpx;
  padding: 6rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-sizing: border-box;
}

.hero-avatar {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  display: block;
}

.content-shell {
  padding: 18rpx 16rpx 0;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.action-card {
  position: relative;
  overflow: hidden;
  min-height: 310rpx;
  padding: 24rpx 22rpx;
  border-radius: 30rpx;
  color: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 18rpx 38rpx rgba(49, 73, 97, 0.16);
}

.action-card-diagnose {
  background: linear-gradient(145deg, #243d55 0%, #456989 100%);
}

.action-card-recycle {
  background: linear-gradient(145deg, #276447 0%, #44a06f 100%);
}

.action-badge {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #eff7ff;
  background: rgba(255, 255, 255, 0.14);
}

.recycle-badge {
  color: #ecfff4;
}

.action-icon {
  margin-top: 18rpx;
  font-size: 54rpx;
  line-height: 1;
}

.action-title {
  display: block;
  margin-top: 20rpx;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
}

.action-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.82);
}

.action-foot {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-metric {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.action-arrow {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 34rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
}

.section-card {
  margin-top: 14rpx;
  padding: 24rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(214, 224, 235, 0.8);
  box-shadow: 0 14rpx 34rpx rgba(72, 96, 122, 0.08);
  backdrop-filter: blur(8rpx);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-eyebrow {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 3rpx;
  color: #7d90a4;
}

.section-title {
  display: block;
  margin-top: 6rpx;
  font-size: 32rpx;
  line-height: 1.3;
  color: #243447;
  font-weight: 700;
}

.business-scope {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.scope-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 124rpx;
  padding: 16rpx 10rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #edf3f8 100%);
  border: 1rpx solid rgba(211, 221, 230, 0.86);
  box-sizing: border-box;
}

.scope-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: rgba(80, 109, 139, 0.1);
  padding: 6rpx;
}

.scope-icon-emoji {
  font-size: 42rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: rgba(80, 109, 139, 0.1);
  padding: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scope-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #40576f;
  text-align: center;
}

.cases-scroll {
  white-space: nowrap;
  margin-right: -10rpx;
}

.case-item {
  display: inline-block;
  vertical-align: top;
  width: 250rpx;
  min-height: 246rpx;
  margin-right: 14rpx;
  padding: 20rpx 18rpx;
  border-radius: 26rpx;
  background: linear-gradient(150deg, #2c4259 0%, #5f7d9c 100%);
  box-sizing: border-box;
  box-shadow: 0 16rpx 28rpx rgba(55, 77, 101, 0.16);
}

.case-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  font-size: 38rpx;
  background: rgba(255, 255, 255, 0.14);
}

.case-title {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #ffffff;
  font-weight: 700;
}

.case-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.82);
  min-height: 98rpx;
}

.case-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
}

.company-card-shell {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(244, 248, 252, 0.94) 100%);
}

.company-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #f7fbff 0%, #eef4f8 100%);
  border: 1rpx solid rgba(212, 223, 232, 0.82);
}

.company-name {
  display: block;
  font-size: 31rpx;
  line-height: 1.35;
  color: #23374b;
  font-weight: 700;
}

.company-intro {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4d647b;
}

.company-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: #617487;
}

.company-highlight-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.company-highlight-item {
  padding: 16rpx 14rpx;
  border-radius: 22rpx;
  background: rgba(231, 239, 247, 0.78);
}

.company-highlight-title {
  display: block;
  font-size: 20rpx;
  color: #7387a0;
}

.company-highlight-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #31485f;
  font-weight: 700;
}

.contact-section {
  background: linear-gradient(145deg, #23374b 0%, #486786 100%);
  box-shadow: 0 18rpx 38rpx rgba(35, 55, 75, 0.2);
}

.section-head-light .light {
  color: #ffffff;
}

.section-head-light .section-eyebrow {
  color: rgba(255, 255, 255, 0.66);
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.contact-label {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
}

.contact-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.7;
  color: #ffffff;
}

.contact-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  border: none;
  background: #ffffff;
  color: #2d445a;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.12);
}

.contact-btn::after {
  border: none;
}

@media (max-width: 420px) {
  .hero-highlights,
  .action-grid,
  .business-scope,
  .company-highlight-list {
    grid-template-columns: 1fr;
  }

  .hero-title {
    font-size: 40rpx;
  }

  .action-card {
    min-height: 280rpx;
  }
}
