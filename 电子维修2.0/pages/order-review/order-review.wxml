<!--pages/order-review/order-review.wxml-->
<view class="page-container">
  <!-- 头部导航 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
      <text class="back-text">返回</text>
    </view>
    <text class="header-title">订单评价</text>
    <view class="header-right"></view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 订单信息 -->
  <view wx:else class="order-info">
    <view class="order-info-title">订单信息</view>
    <view class="order-info-item">
      <text class="info-label">订单号:</text>
      <text class="info-value">{{orderInfo.orderId}}</text>
    </view>
    <view class="order-info-item">
      <text class="info-label">服务类型:</text>
      <text class="info-value">{{orderInfo.orderType === 'repair' ? '维修' : '回收'}}</text>
    </view>
    <view class="order-info-item">
      <text class="info-label">设备类型:</text>
      <text class="info-value">{{orderInfo.deviceType === 1 ? '手机' : ''}}{{orderInfo.deviceType === 2 ? '电脑' : ''}}{{orderInfo.deviceType === 3 ? '平板' : ''}}{{orderInfo.deviceType === 4 ? '手表' : ''}}{{orderInfo.deviceType === 5 ? '耳机' : ''}}{{orderInfo.deviceType === 6 ? '相机' : ''}}{{orderInfo.deviceType === 7 ? '游戏机' : ''}}<text wx:if="{{orderInfo.brandName}}"> - {{orderInfo.brandName}}</text><text wx:if="{{orderInfo.deviceModel && orderInfo.deviceModel !== '未知型号'}}"> {{orderInfo.deviceModel}}</text></text>
    </view>
    <view class="order-info-item" wx:if="{{orderInfo.hasPrice}}">
      <text class="info-label">订单金额:</text>
      <text class="info-value price">¥{{orderInfo.price}}</text>
    </view>
    <view class="order-info-item" wx:else>
      <text class="info-label">订单金额:</text>
      <text class="info-value">待确定</text>
    </view>
    <view class="order-info-item">
      <text class="info-label">问题描述:</text>
      <text class="info-value">{{orderInfo.problemDescription}}</text>
    </view>
    <view class="order-info-item" wx:if="{{orderInfo.createdAt}}">
      <text class="info-label">下单时间:</text>
      <text class="info-value">{{orderInfo.createdAt}}</text>
    </view>
    <view class="order-info-item" wx:if="{{orderInfo.serviceTypeText}}">
      <text class="info-label">服务方式:</text>
      <text class="info-value">{{orderInfo.serviceTypeText}}</text>
    </view>
  </view>

  <!-- 评分区域 -->
  <view class="rating-section">
    <view class="section-title">服务评分</view>
    <view class="rating-stars">
      <view
        class="star-item"
        wx:for="{{ratingStars}}"
        wx:key="index"
        data-rating="{{item}}"
        bindtap="selectRating">
        <text
          class="star-icon {{item <= rating ? 'active' : ''}}"
          style="font-size: {{starSize}}rpx; color: {{item <= rating ? activeStarColor : starColor}}">
          ★
        </text>
      </view>
    </view>
    <view class="rating-text">{{rating}} 星</view>
  </view>

  <!-- 评价内容 -->
  <view class="comment-section">
    <view class="section-title">评价内容</view>
    <textarea
      class="comment-textarea"
      placeholder="请输入您的评价内容（至少5个字）"
      maxlength="200"
      value="{{comment}}"
      bindinput="onCommentInput"
      show-confirm-bar="{{false}}"
      auto-height></textarea>
    <view class="char-count">{{comment.length}}/200</view>
  </view>

  <!-- 图片上传 -->
  <view class="image-section">
    <view class="section-title">
      <text>上传图片</text>
      <text class="image-count">{{selectedImages.length}}/{{maxImages}}</text>
    </view>
    <view class="image-list">
      <view
        class="image-item"
        wx:for="{{selectedImages}}"
        wx:key="index"
        bindtap="previewImage"
        data-index="{{index}}">
        <image class="image-preview" src="{{item}}" mode="aspectFill"></image>
        <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">
          <text class="delete-icon">×</text>
        </view>
      </view>
      <view
        class="image-item add-btn"
        wx:if="{{selectedImages.length < maxImages}}"
        bindtap="chooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button
      class="submit-btn"
      bindtap="submitReview"
      loading="{{isSubmitting}}"
      disabled="{{isSubmitting}}">
      {{isSubmitting ? '提交中...' : '提交评价'}}
    </button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>
</view>
