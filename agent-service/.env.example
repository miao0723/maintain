# agent-service 配置样例
# 实际运行时优先读取系统环境变量，其次 agent-service/.env，最后回退 ../backend/.env
# 注意：backend/.env 中用分号(;)开头的行不会被 python-dotenv 识别为注释，会产生解析告警

# --- 数据库（两个库都连远程 MySQL 时配置如下） ---
DATABASE_HOSTNAME=8.155.24.202
DATABASE_HOSTPORT=3306
DATABASE_DATABASE=cmms_db
DATABASE_USERNAME=root
DATABASE_PASSWORD=your-password

REPAIR_DB_HOSTNAME=8.155.24.202
REPAIR_DB_HOSTPORT=3306
REPAIR_DB_DATABASE=repair
REPAIR_DB_USERNAME=root
REPAIR_DB_PASSWORD=your-password

# Docker 内填写宿主机数据库地址时使用（服务名解析失败时的回退地址）
# AGENT_DB_HOST_FALLBACK=host.docker.internal

# --- LLM ---
DEEPSEEK_API_KEY=sk-xxxx
AGENT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_TIMEOUT=45
AGENT_LLM_RETRIES=1

# --- 服务 ---
AGENT_SERVICE_PORT=8001
