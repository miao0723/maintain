; ===== publisher-service 配置 =====
; 复制本文件为 .env 后按需修改

; 服务监听地址与端口
PUBLISHER_HOST=0.0.0.0
PUBLISHER_PORT=8899

; 与后端 PHP 之间的共享密钥，必须和 backend/.env 的 PUBLISHER_TOKEN 一致
PUBLISHER_TOKEN=change-me-to-a-long-random-string

; 数据目录（存放 SQLite、浏览器用户数据、日志、截图）
PUBLISHER_DATA_DIR=D:\maintain\publisher-service\data

; 浏览器模式：false = 有头（推荐，风控友好、可人工介入）；true = 无头
PUBLISHER_HEADLESS=false

; 优先使用本机已安装的真实浏览器内核（风控命中率远低于自带 Chromium）
; 可选值：msedge / chrome / chromium
; 启动失败会自动按 配置值 -> msedge -> chrome -> 内置 Chromium 降级
PUBLISHER_BROWSER_CHANNEL=msedge

; 单个发布任务的整体超时（秒）
PUBLISHER_TASK_TIMEOUT=1800

; 视频上传等待超时（秒），大文件可调大
PUBLISHER_UPLOAD_TIMEOUT=900

; 扫码登录会话有效期（秒）
PUBLISHER_LOGIN_TIMEOUT=300

; 每一步操作的默认等待超时（毫秒）
PUBLISHER_ACTION_TIMEOUT=20000

; 失败自动重试次数
PUBLISHER_MAX_RETRY=1

; 出错时是否保留浏览器窗口便于排查（true 时窗口不关闭）
PUBLISHER_KEEP_BROWSER_ON_ERROR=false

; 发布完成后回调后端的基础地址（PHP 传了 callback_url 时优先用传入的）
PUBLISHER_CALLBACK_BASE=http://localhost
