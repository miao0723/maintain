{
    "name": "cmms/backend",
    "description": "CMMS Backend Application",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "topthink/framework": "^8.1",
        "firebase/php-jwt": "^6.10",
        "predis/predis": "^2.2",
        "phpoffice/phpspreadsheet": "^5.5",
        "alibabacloud/dysmsapi-20170525": "^4.5",
        "tecnickcom/tcpdf": "^6.11"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-mock": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/",
            "Tests\\": "tests/"
        },
        "files": [
            "vendor/topthink/framework/src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage"
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "audit": {
            "ignore": {
                "firebase/php-jwt": {
                    "PKSA-y2cr-5h3j-g3ys": true
                }
            }
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "allow-plugins": {
        "pestphp/pest-plugin": false,
        "*": true
    }
}
