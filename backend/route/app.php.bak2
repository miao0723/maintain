use think\facade\Route;

// 诊断测试路由
Route::get('diagnose-api', function() {
    $data = [
        'status' => 'ok',
        'message' => 'API路由正常',
        'php_version' => PHP_VERSION,
        'time' => date('Y-m-d H:i:s'),
    ];
    return json($data);
});

