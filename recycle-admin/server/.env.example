# 回收后台服务配置（本地开发）
PORT=3005

# 数据库：与小程序后端共用同一个 MySQL 库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=repair
DB_CONNECTION_LIMIT=10

# JWT 密钥（生产环境务必修改）
JWT_SECRET=recycle-admin-jwt-secret-change-in-production
JWT_EXPIRES_IN=12h

# 初始管理员（仅首次建表时创建）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=系统管理员
