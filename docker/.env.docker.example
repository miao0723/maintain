# Docker 部署环境变量模板
# 使用方法：cp .env.docker.example .env.docker 并填入真实值
# 注意：.env.docker 已被 .gitignore 排除，切勿提交

# ---------- 应用 ----------
APP_DEBUG=false

# ---------- 主数据库 ----------
DATABASE_TYPE=mysql
DATABASE_HOSTNAME=mysql
DATABASE_DATABASE=your_database_name
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOSTPORT=3306
DATABASE_CHARSET=utf8mb4

# ---------- 维修业务库 ----------
REPAIR_DB_TYPE=mysql
REPAIR_DB_HOSTNAME=mysql
REPAIR_DB_DATABASE=your_repair_database
REPAIR_DB_USERNAME=your_db_user
REPAIR_DB_PASSWORD=your_db_password
REPAIR_DB_HOSTPORT=3306
REPAIR_DB_CHARSET=utf8mb4

# ---------- Redis ----------
REDIS_HOSTNAME=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SELECT=0

# ---------- JWT 鉴权 ----------
# 生产环境务必替换为高强度随机串，可用 openssl rand -base64 48 生成
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800

# ---------- AI 智能体服务 ----------
AGENT_SERVICE_URL=http://agent-service:8000
AGENT_MODEL=deepseek-chat
KIMI_API_KEY=your_kimi_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# ---------- 邮件通知 ----------
fromaddrs=your_email@example.com
password=your_email_auth_code
toaddrs=receiver@example.com

# ---------- 自动发布服务（publisher-service 容器） ----------
PUBLISHER_MODE=script
# 容器网络内直连，不要写 host.docker.internal
PUBLISHER_BASE_URL=http://publisher-service:8899
# 与 publisher-service 共享的接口密钥，openssl rand -hex 24 生成
PUBLISHER_TOKEN=change-this-to-a-long-random-string
# php 与 publisher-service 容器把 docker/rpa_files 挂到相同路径，视频路径两边一致
PUBLISHER_SHARED_VIDEO_DIR=/var/www/html/rpa_files/videos
PUBLISHER_SHARED_HOST_VIDEO_DIR=/var/www/html/rpa_files/videos
# 发布结果回调后端的外部地址（你的域名）
PUBLISHER_CALLBACK_BASE=https://your-domain.com

# ---------- 影刀 RPA 兼容路径（旧链路回退时也用 Linux 路径） ----------
RPA_TRIGGER_DIR=/var/www/html/rpa_files
RPA_SHARED_VIDEO_DIR=/var/www/html/rpa_files/videos
RPA_SHARED_HOST_VIDEO_DIR=/var/www/html/rpa_files/videos
