# 回收综合服务平台（recycle-admin 容器）环境变量模板
# 使用方法：cp .env.recycleadmin.example .env.recycleadmin 并填入真实值
# 注意：.env.recycleadmin 已被 .gitignore 排除，切勿提交

PORT=3005

# 数据库：与小程序后端共用同一个 MySQL（sqfe2 项目容器，经 sqfe2-net 网络访问）
DB_HOST=sqfe2-mysql-1
DB_PORT=3306
DB_USER=sqfe2_user
DB_PASSWORD=your_mysql_password
DB_NAME=repair
DB_CONNECTION_LIMIT=10

# JWT 密钥（生产环境务必替换，可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-strong-random-string
JWT_EXPIRES_IN=12h

# 初始管理员（仅首次建表时创建，之后可在后台“系统设置”中修改）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
DEFAULT_ADMIN_NAME=系统管理员
