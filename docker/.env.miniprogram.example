# ============================================================
# 小程序后端（miniprogram-backend）容器环境变量模板
# 使用方法：复制为 .env.miniprogram 并填入真实值
#   Copy-Item docker/.env.miniprogram.example docker/.env.miniprogram
# 注意：.env.miniprogram 含密钥，请勿提交到 Git
# ============================================================

# ---------- 服务配置 ----------
NODE_ENV=production
PORT=3001
SERVER_HOST=0.0.0.0
# 对外可访问地址，用于生成图片/文件的绝对 URL
HOST=http://your-server-ip:3001

# ---------- 主数据库（小程序业务库） ----------
# 容器内通过服务名 mysql 访问，不要写 localhost
DB_HOST=mysql
DB_PORT=3306
DB_USER=cmms_user
DB_PASSWORD=cmms_pass
DB_NAME=repair_system
DB_CONNECTION_LIMIT=10

# ---------- CMMS 数据库（与后台管理系统共用） ----------
CMMS_DB_HOST=mysql
CMMS_DB_PORT=3306
CMMS_DB_USER=cmms_user
CMMS_DB_PASSWORD=cmms_pass
CMMS_DB_NAME=cmms_db
CMMS_DB_CONNECTION_LIMIT=10

# ---------- JWT ----------
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- 微信小程序 ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- 微信支付 ----------
WECHAT_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
# 证书路径为容器内路径（/app 为代码根目录）
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_CERT_PATH=
# 或直接填证书文本，换行写成 \n
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_CERT=

# ---------- Deepseek ----------
# 代码中同时存在两种大小写写法，两个都填相同的值
DEEPSEEK_API_KEY=
Deepseek_api_key=

# ---------- 高德地图 ----------
AMAP_API_KEY=

# ---------- 通义语音转写（DashScope） ----------
VOICE_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=
VOICE_MODEL=
VOICE_API_BASE_URL=
