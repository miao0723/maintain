/* components/confirm-modal/confirm-modal.wxss */

.cm-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.cm-mask--show {
  animation: cmFadeIn 220ms ease-out;
}

.cm-mask--closing {
  animation: cmFadeOut 180ms ease-in forwards;
}

.cm-card {
  width: 600rpx;
  max-width: 86vw;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 56rpx 44rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 70rpx rgba(31, 41, 55, 0.22);
}

.cm-card--show {
  animation: cmPopIn 280ms cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.cm-card--closing {
  animation: cmPopOut 180ms ease-in forwards;
}

/* ===== 顶部图标 ===== */
.cm-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.12);
}

.cm-icon-text {
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.cm-icon--success { background: #22c55e; }
.cm-icon--warning { background: #f59e0b; }
.cm-icon--error { background: #ef4444; }
.cm-icon--question { background: #4f6b84; }

/* ===== 标题与正文 ===== */
.cm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  text-align: center;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.cm-content {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.6;
  margin-bottom: 40rpx;
  max-height: 56vh;
  overflow-y: auto;
}

/* ===== 操作按钮 ===== */
.cm-actions {
  display: flex;
  width: 100%;
  gap: 24rpx;
}

.cm-btn {
  flex: 1;
  height: 88rpx;
  min-width: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  box-sizing: border-box;
  transition: transform 120ms ease-out, background-color 160ms ease-out, opacity 160ms ease-out;
}

.cm-btn--cancel {
  background: #f1f5f9;
  color: #475569;
}

.cm-btn--cancel-hover {
  background: #e2e8f0;
  transform: scale(0.98);
}

.cm-btn--confirm {
  color: #ffffff;
}

.cm-btn--confirm-hover {
  opacity: 0.9;
  transform: scale(0.98);
  filter: brightness(0.96);
}

/* ===== 动画 ===== */
@keyframes cmFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes cmFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes cmPopIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.92); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes cmPopOut {
  from { opacity: 1; transform: translateY(0) scale(1); }
  to { opacity: 0; transform: translateY(12rpx) scale(0.96); }
}

/* ===== 暗黑模式（与 theme/dark-mode.wxss 变量保持一致） ===== */
@media (prefers-color-scheme: dark) {
  .cm-card {
    background: #1f2937;
    box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.55);
  }
  .cm-title {
    color: #f3f4f6;
  }
  .cm-content {
    color: #9ca3af;
  }
  .cm-btn--cancel {
    background: #374151;
    color: #d1d5db;
  }
  .cm-btn--cancel-hover {
    background: #2b3543;
  }
}
