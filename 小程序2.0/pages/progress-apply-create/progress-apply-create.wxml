<view class="page-container">
  <!-- 头部 -->
  <view class="header">
    <text class="page-title" wx:if="{{mode === 'create'}}">新建进度申请</text>
    <text class="page-title" wx:if="{{mode === 'view'}}">申请详情</text>
    <text class="page-desc" wx:if="{{mode === 'create'}}">关联维修中的订单，发起进度查询</text>
    <text class="page-desc" wx:if="{{mode === 'view'}}">申请编号: {{applyDetail.apply_no}}</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <scroll-view wx:else class="form-scroll" scroll-y>
    <!-- 审批状态 (查看模式) -->
    <view wx:if="{{mode === 'view' && approvalStatus}}" class="status-section" style="border-left-color: {{approvalStatusColor}}">
      <view class="status-row">
        <text class="status-label">审批状态</text>
        <text class="status-value" style="color: {{approvalStatusColor}}">{{approvalStatusText}}</text>
      </view>
      <view wx:if="{{approvalRemark}}" class="status-row">
        <text class="status-label">审批备注</text>
        <text class="status-value">{{approvalRemark}}</text>
      </view>
      <view wx:if="{{approvalAt}}" class="status-row">
        <text class="status-label">审批时间</text>
        <text class="status-value time">{{approvalAt}}</text>
      </view>
    </view>

    <!-- 步骤引导（仅创建模式） -->
    <view wx:if="{{mode === 'create'}}" class="guide">
      <view class="guide-step {{!selectedOrder ? 'active' : 'done'}}">
        <view class="guide-dot">1</view>
        <text class="guide-text">选订单</text>
      </view>
      <view class="guide-line {{selectedOrder ? 'filled' : ''}}"></view>
      <view class="guide-step {{selectedOrder ? 'active' : ''}}">
        <view class="guide-dot">2</view>
        <text class="guide-text">填申请</text>
      </view>
      <view class="guide-line"></view>
      <view class="guide-step">
        <view class="guide-dot">3</view>
        <text class="guide-text">提交</text>
      </view>
    </view>

    <!-- 已选订单卡片 (仅创建模式) -->
    <view wx:if="{{mode === 'create' && selectedOrder}}" class="order-card" bindtap="selectOrder">
      <view class="order-card-icon">📦</view>
      <view class="order-card-body">
        <view class="order-card-header">
          <text class="order-card-no">订单 #{{selectedOrder.id || selectedOrder.orderId}}</text>
          <text class="order-card-status processing">维修中</text>
        </view>
        <text class="order-card-device">{{selectedOrder.deviceTypeName || selectedOrder.device_name || selectedOrder.device_model || '未知设备'}}</text>
        <text class="order-card-model" wx:if="{{formData.device_model}}">型号：{{formData.device_model}}</text>
        <text class="order-card-time">创建时间: {{selectedOrder.createdAt || selectedOrder.created_at || ''}}</text>
      </view>
      <text class="order-card-arrow" wx:if="{{!editDisabled}}">›</text>
    </view>

    <!-- 选择订单按钮 (未选时显示) -->
    <view wx:if="{{mode === 'create' && !selectedOrder}}" class="form-section" bindtap="selectOrder">
      <view class="section-row order-select-row">
        <view class="inline-meta">
          <text class="form-label">关联订单 <text class="required">*</text></text>
          <text class="form-hint">仅可选择维修中的订单</text>
        </view>
        <view class="select-btn {{orderLoading ? 'disabled' : ''}}">
          <text wx:if="{{orderLoading}}">加载中...</text>
          <text wx:else>选择订单 ›</text>
        </view>
      </view>
    </view>

    <!-- 查看模式：设备信息卡 (订单与设备均来自系统，无需手填) -->
    <view wx:if="{{mode === 'view'}}" class="order-card view-only">
      <view class="order-card-icon">📦</view>
      <view class="order-card-body">
        <text class="order-card-device">{{formData.device_name || '未知设备'}}</text>
        <text class="order-card-model" wx:if="{{formData.device_model}}">型号：{{formData.device_model}}</text>
        <text class="order-card-time">关联订单 #{{formData.order_id}}</text>
      </view>
    </view>

    <!-- 联系信息 (姓名/电话来自登录资料，自动获取只读展示) -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-title">联系信息</text>
        <text class="section-tip" wx:if="{{autoName || autoPhone}}">已自动获取</text>
      </view>

      <view class="form-group">
        <text class="form-label">申请人</text>
        <view wx:if="{{autoName || editDisabled}}" class="auto-field">
          <text class="auto-field-value">{{formData.customer_name || '—'}}</text>
          <text wx:if="{{autoName}}" class="auto-pill">✓ 自动获取</text>
        </view>
        <input wx:else class="form-input" data-field="customer_name" value="{{formData.customer_name}}" placeholder="请输入姓名" bindinput="onInput"/>
      </view>

      <view class="form-group">
        <text class="form-label">联系电话</text>
        <view wx:if="{{autoPhone || editDisabled}}" class="auto-field">
          <text class="auto-field-value">{{formData.phone || '—'}}</text>
          <text wx:if="{{autoPhone}}" class="auto-pill">✓ 自动获取</text>
        </view>
        <input wx:else class="form-input" data-field="phone" type="number" value="{{formData.phone}}" placeholder="请输入电话" maxlength="11" bindinput="onInput"/>
      </view>
    </view>

    <!-- 申请信息 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-title">申请信息</text>
      </view>

      <!-- 进度类型 (卡片式选择) -->
      <view class="form-group">
        <text class="form-label">进度类型 <text class="required">*</text></text>
        <view wx:if="{{selectedType && editDisabled}}" class="type-display">
          <text class="type-display-icon">{{selectedType.icon}}</text>
          <text class="type-display-label">{{selectedType.label}}</text>
        </view>
        <view wx:elif="{{editDisabled}}" class="readonly-text">{{formData.progress_type || '—'}}</view>
        <view wx:else class="type-grid">
          <view class="type-item {{formData.progress_type === item.value ? 'active' : ''}}" wx:for="{{progressTypes}}" wx:key="value" data-value="{{item.value}}" bindtap="onTypeSelect">
            <text class="type-item-icon">{{item.icon}}</text>
            <text class="type-item-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 申请原因 -->
      <view class="form-group">
        <text class="form-label">申请原因 <text class="required">*</text></text>
        <textarea wx:if="{{!editDisabled}}" class="form-textarea" data-field="apply_reason" value="{{formData.apply_reason}}" placeholder="例如：配件是否到货、预计何时完成" maxlength="500" bindinput="onInput"/>
        <view wx:else class="readonly-text">{{formData.apply_reason || '—'}}</view>
        <text wx:if="{{!editDisabled}}" class="char-count">{{formData.apply_reason.length || 0}}/500</text>
      </view>

      <!-- 期望时间 -->
      <view class="form-group">
        <text class="form-label">期望反馈时间</text>
        <picker wx:if="{{!editDisabled}}" mode="date" data-field="expected_time" value="{{formData.expected_time}}" bindchange="onInput">
          <view class="date-picker {{formData.expected_time ? 'filled' : ''}}">
            <text wx:if="{{formData.expected_time}}" class="picker-value">{{formData.expected_time}}</text>
            <text wx:else class="picker-placeholder">请选择期望的反馈时间（选填）</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view wx:else class="readonly-text">{{formData.expected_time || '未填写'}}</view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view wx:if="{{mode === 'create'}}" class="submit-area">
      <button class="submit-btn" bindtap="submitApply" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交申请'}}
      </button>
      <text class="submit-hint">提交后将通知维修人员处理</text>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 订单选择弹窗 -->
  <view wx:if="{{showOrderPicker}}" class="modal-overlay" bindtap="closeOrderPicker">
    <view class="modal-content order-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">选择关联订单</text>
        <view class="modal-close" bindtap="closeOrderPicker">×</view>
      </view>
      <view class="modal-body">
        <view wx:if="{{orderLoading}}" class="loading-more-inline">
          <view class="loading-spinner small"></view>
          <text>加载中...</text>
        </view>
        <view wx:elif="{{orderList.length === 0}}" class="empty-order">
          <text class="empty-order-icon">📋</text>
          <text>暂无可申请进度的订单</text>
          <text class="empty-order-hint">仅维修中的订单可发起申请</text>
        </view>
        <scroll-view scroll-y class="order-list-scroll">
          <view class="order-option {{selectedOrder && (selectedOrder.id == item.id || selectedOrder.orderId == item.id || selectedOrder.id == item.orderId) ? 'selected' : ''}}" wx:for="{{orderList}}" wx:key="id" bindtap="onOrderSelect" data-id="{{item.id || item.orderId}}">
            <view class="order-option-header">
              <view class="order-option-info">
                <text class="order-no">订单 #{{item.id || item.orderId}}</text>
                <text class="order-status processing">维修中</text>
              </view>
              <text wx:if="{{selectedOrder && (selectedOrder.id == item.id || selectedOrder.orderId == item.id || selectedOrder.id == item.orderId)}}" class="order-checked">✓</text>
            </view>
            <text class="order-device">{{item.deviceTypeName || item.device_name || item.device_model || '未知设备'}}</text>
            <text class="order-time">{{item.createdAt || item.created_at || ''}}</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
