/* pages/admin-users/admin-users.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 8rpx 20rpx;
}
.head-title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.head-count { font-size: 26rpx; color: #8a96a3; }

.toolbar { margin-bottom: 16rpx; }
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(79,107,132,0.06);
}
.search-input { flex: 1; height: 64rpx; font-size: 28rpx; }
.search-btn {
  background: #4f6b84; color: #fff; font-size: 26rpx;
  padding: 0 28rpx; height: 60rpx; line-height: 60rpx; border-radius: 12rpx;
}
.filter-row { white-space: nowrap; margin-top: 16rpx; }
.filter-chip {
  display: inline-block; font-size: 26rpx; color: #5b6b7b;
  background: #fff; padding: 10rpx 26rpx; border-radius: 30rpx; margin-right: 16rpx;
  border: 1rpx solid #e6ecf2;
}
.filter-chip.active { background: #4f6b84; color: #fff; border-color: #4f6b84; }

.user-list { margin-top: 8rpx; }
.user-item {
  display: flex; align-items: center; background: #fff; border-radius: 20rpx;
  padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 6rpx 18rpx rgba(79,107,132,0.05);
}
.user-avatar { width: 84rpx; height: 84rpx; border-radius: 50%; background: #e6ecf2; flex-shrink: 0; }
.user-main { flex: 1; margin-left: 20rpx; min-width: 0; }
.user-top { display: flex; align-items: center; }
.user-name { font-size: 30rpx; font-weight: 600; color: #1f2937; margin-right: 12rpx; }
.role-badge {
  font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 20rpx; color: #fff;
}
.role-user { background: #8a96a3; }
.role-admin { background: #4f6b84; }
.role-super_admin { background: #1d4ed8; }
.user-sub { display: flex; align-items: center; flex-wrap: wrap; margin-top: 8rpx; font-size: 24rpx; color: #8a96a3; }
.user-sub text { margin-right: 18rpx; }
.status.normal { color: #2f8a5b; }
.status.disabled { color: #d14343; }

.user-actions { display: flex; flex-direction: column; gap: 10rpx; flex-shrink: 0; }
.mini-btn {
  font-size: 24rpx; color: #4f6b84; background: #eef2f7;
  padding: 8rpx 18rpx; border-radius: 10rpx; text-align: center;
}
.mini-btn.warn { color: #b7791f; background: #fdf3e0; }
.mini-btn.danger { color: #d14343; background: #fdecec; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.empty-icon { font-size: 96rpx; }
.empty-text { margin-top: 20rpx; color: #8a96a3; font-size: 28rpx; }
