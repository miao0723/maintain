<view class="page-container">
  <!-- 头部 -->
  <view class="header">
    <text class="page-title">进度申请</text>
    <text class="page-desc">查看我对维修订单的进度申请</text>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view class="filter-tab {{statusFilter === '' ? 'active' : ''}}" bindtap="switchFilter" data-status="">
      <text class="filter-text">全部</text>
      <text class="filter-count" wx:if="{{total > 0}}">{{total}}</text>
    </view>
    <view class="filter-tab {{statusFilter === 'pending' ? 'active' : ''}}" bindtap="switchFilter" data-status="pending">
      <text class="filter-text">待审核</text>
    </view>
    <view class="filter-tab {{statusFilter === 'approved' ? 'active' : ''}}" bindtap="switchFilter" data-status="approved">
      <text class="filter-text">已通过</text>
    </view>
    <view class="filter-tab {{statusFilter === 'rejected' ? 'active' : ''}}" bindtap="switchFilter" data-status="rejected">
      <text class="filter-text">已拒绝</text>
    </view>
  </view>

  <!-- 新建按钮 -->
  <view class="create-btn-wrap">
    <button class="create-btn" bindtap="goToCreate">+ 新建进度申请</button>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading && applyList.length === 0}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{applyList.length === 0 && !loading}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无进度申请</text>
    <text class="empty-hint">您可以基于维修中的订单发起进度申请</text>
  </view>

  <!-- 列表 -->
  <view wx:else class="apply-list">
    <view class="apply-card" wx:for="{{applyList}}" wx:key="id" bindtap="viewDetail" data-id="{{item.id}}">
      <!-- 头部 -->
      <view class="card-header">
        <view class="card-header-left">
          <text class="apply-no">{{item.apply_no}}</text>
          <text class="apply-device-sub" wx:if="{{item.device_model}}">型号 {{item.device_model}}</text>
        </view>
        <view class="status-badge" style="background: {{item.statusBg}}; color: {{item.statusColor}}">
          <text>{{item.statusIcon}}</text>
          <text>{{item.statusLabel}}</text>
        </view>
      </view>

      <!-- 信息行 -->
      <view class="info-row">
        <text class="info-label">设备</text>
        <text class="info-value">{{item.device_name || item.order_device_model || '未知设备'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">进度类型</text>
        <text class="info-value">{{item.progressTypeText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">申请原因</text>
        <text class="info-value reason">{{item.apply_reason}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">申请时间</text>
        <text class="info-value time">{{item.createdAt}}</text>
      </view>

      <!-- 审批信息 -->
      <view wx:if="{{item.approval_status !== 'pending'}}" class="approval-info" style="border-left-color: {{item.statusColor}}">
        <text class="approval-remark">{{item.approval_remark}}</text>
        <text class="approval-time" wx:if="{{item.approvedAt}}">审批时间: {{item.approvedAt}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loading && applyList.length > 0}}" class="loading-more">
      <text>加载中...</text>
    </view>
    <view wx:if="{{!hasMore && applyList.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
