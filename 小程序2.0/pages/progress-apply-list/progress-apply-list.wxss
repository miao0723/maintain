.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e9eef5 0%, #f4f7fb 360rpx, #f6f8fb 100%);
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #46627d 0%, #6a9abb 100%);
  padding: 48rpx 32rpx 56rpx;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

/* 筛选标签（分段式） */
.filter-tabs {
  display: flex;
  padding: 20rpx 24rpx;
  background: #fff;
  gap: 14rpx;
  border-radius: 0 0 28rpx 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(79, 107, 132, 0.07);
  margin: 0 16rpx;
  position: relative;
  top: -20rpx;
}

.filter-tab {
  flex: 1;
  padding: 14rpx 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #f1f4f8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s;
}

.filter-tab:active {
  transform: scale(0.97);
}

.filter-tab.active {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(79, 107, 132, 0.28);
}

.filter-count {
  background: rgba(255, 255, 255, 0.3);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 新建按钮 */
.create-btn-wrap {
  padding: 8rpx 32rpx 24rpx;
}

.create-btn {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #fff;
  font-size: 31rpx;
  font-weight: 700;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 12rpx 30rpx rgba(79, 107, 132, 0.3);
  letter-spacing: 2rpx;
}

.create-btn:active {
  transform: scale(0.985);
}

.create-btn::after {
  border: none;
}

/* 加载/空状态 */
.loading-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #dbe3ec;
  border-top-color: #4f6b84;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #9aa6b4;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 92rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #4b5563;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 25rpx;
  color: #9aa6b4;
  text-align: center;
  line-height: 1.5;
}

/* 列表 */
.apply-list {
  padding: 0 32rpx;
}

.apply-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 18rpx rgba(79, 107, 132, 0.07);
  border-left: 8rpx solid #4f6b84;
  transition: transform 0.2s, box-shadow 0.2s;
}

.apply-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 12rpx rgba(79, 107, 132, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f3f7;
}

.card-header-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.apply-no {
  font-size: 29rpx;
  font-weight: 700;
  color: #2b3440;
}

.apply-device-sub {
  font-size: 22rpx;
  color: #8a96a3;
  margin-top: 5rpx;
}

.status-badge {
  padding: 7rpx 20rpx;
  border-radius: 22rpx;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-weight: 500;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

.info-row + .info-row {
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f5f8;
}

.info-label {
  flex: 0 0 160rpx;
  font-size: 26rpx;
  color: #8a96a3;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #2b3440;
  font-weight: 500;
  word-break: break-word;
}

.info-value.reason {
  color: #4b5563;
  font-weight: 400;
}

.info-value.time {
  color: #9aa6b4;
  font-size: 24rpx;
  font-weight: 400;
}

/* 审批信息 */
.approval-info {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  border-left: 6rpx solid;
}

.approval-remark {
  display: block;
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.approval-time {
  display: block;
  font-size: 22rpx;
  color: #9aa6b4;
}

/* 加载更多 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #9aa6b4;
  font-size: 26rpx;
}
