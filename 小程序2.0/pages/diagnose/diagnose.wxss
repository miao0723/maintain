/* pages/diagnose/diagnose.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f2f5 0%, #e8ebef 50%, #dce0e5 100%);
  padding-bottom: 160rpx;
}

/* ========== 进度条 ========== */
.progress-section {
  padding: 24rpx 40rpx 16rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.progress-bar {
  height: 6rpx;
  background: #e5e8eb;
  border-radius: 3rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  border-radius: 3rpx;
  transition: width 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.progress-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-step {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e5e8eb;
  color: #a0aec0;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.progress-step.active {
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  color: #ffffff;
}

.progress-step.done {
  background: #48bb78;
  color: #ffffff;
}

.progress-line {
  flex: 1;
  height: 3rpx;
  background: #e5e8eb;
  margin: 0 4rpx;
  transition: background 0.3s ease;
}

.progress-line.active {
  background: #5a6e8a;
}

/* ========== 步骤内容 ========== */
.step-content {
  padding: 32rpx 30rpx;
  animation: fadeUpIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes fadeUpIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 机器人头像 + 问题气泡 */
.step-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.robot-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(90, 110, 138, 0.24);
}

.robot-avatar.large {
  width: 120rpx;
  height: 120rpx;
  font-size: 60rpx;
}

.step-bubble {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  border-bottom-left-radius: 6rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.step-question {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2d3748;
  margin-bottom: 10rpx;
}

.step-subtitle {
  display: block;
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

/* ========== 选项网格（步骤1-设备类型） ========== */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 10rpx;
}

.option-card {
  width: calc(50% - 10rpx);
  padding: 32rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 2rpx solid #e5e8eb;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.option-card:active {
  transform: scale(0.95);
  border-color: #5a6e8a;
  background: #f0f2ff;
  box-shadow: 0 4rpx 16rpx rgba(90, 110, 138, 0.12);
}

.option-card.selected {
  border-color: #5a6e8a;
  background: linear-gradient(135deg, rgba(90, 110, 138, 0.08) 0%, rgba(110, 133, 165, 0.05) 100%);
  box-shadow: 0 4rpx 16rpx rgba(90, 110, 138, 0.16);
}

.option-icon {
  width: 64rpx;
  height: 64rpx;
}

.option-icon-emoji {
  font-size: 52rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2d3748;
}

/* ========== 选项列表（步骤2/3-品牌/故障） ========== */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 10rpx;
}

.option-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #e5e8eb;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.option-item:active {
  border-color: #5a6e8a;
  background: #f0f2ff;
  transform: scale(0.98);
}

.option-item.selected {
  border-color: #5a6e8a;
  background: linear-gradient(135deg, rgba(90, 110, 138, 0.06) 0%, rgba(110, 133, 165, 0.03) 100%);
}

.option-label {
  font-size: 28rpx;
  color: #2d3748;
  font-weight: 500;
}

.option-check {
  font-size: 28rpx;
  color: #5a6e8a;
  font-weight: bold;
}

/* 已选标记 */
.selected-tag,
.selected-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 0 10rpx;
  flex-wrap: wrap;
}

.selected-tag-text {
  font-size: 24rpx;
  color: #5a6e8a;
  background: rgba(90, 110, 138, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.selected-tag-arrow {
  font-size: 22rpx;
  color: #a0aec0;
  font-weight: bold;
}

/* ========== 自定义输入区域 ========== */
.custom-input-area {
  padding: 0 10rpx;
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #5a6e8a;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input-row {
  display: flex;
  gap: 16rpx;
}

.custom-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 2rpx solid #e5e8eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #2d3748;
}

.custom-input:focus {
  border-color: #5a6e8a;
}

.confirm-btn {
  width: 120rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  flex-shrink: 0;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  transform: scale(0.95);
}

/* ========== 步骤4: 补充详情 ========== */
.info-summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 10rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.summary-tag {
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.summary-arrow {
  font-size: 22rpx;
  color: #a0aec0;
  font-weight: bold;
}

.detail-input {
  padding: 0 10rpx;
  position: relative;
}

.detail-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 2rpx solid #e5e8eb;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #2d3748;
  line-height: 1.7;
  box-sizing: border-box;
}

.detail-textarea:focus {
  border-color: #5a6e8a;
  box-shadow: 0 0 0 4rpx rgba(90, 110, 138, 0.08);
}

.char-count {
  position: absolute;
  bottom: 12rpx;
  right: 28rpx;
  font-size: 22rpx;
  color: #a0aec0;
}

.step-actions {
  display: flex;
  gap: 16rpx;
  padding: 32rpx 10rpx;
}

.back-btn {
  flex: 1;
  background: #f0f2f5;
  color: #718096;
  border: 2rpx solid #e5e8eb;
}

/* ========== 底部导航按钮 ========== */
.step-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  z-index: 20;
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.nav-btn:active {
  transform: scale(0.95);
}

.nav-prev {
  background: #ffffff;
  border: 2rpx solid #e5e8eb;
}

.nav-prev .nav-btn-text {
  font-size: 28rpx;
  color: #718096;
}

.nav-prev.single {
  flex: 1;
  max-width: 400rpx;
  margin: 0 auto;
}

.nav-next {
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
}

.nav-next.disabled {
  background: #c4c9d6;
  box-shadow: none;
  pointer-events: none;
}

.nav-next.disabled .nav-btn-text {
  color: rgba(255, 255, 255, 0.7);
}

.nav-next .nav-btn-text {
  font-size: 28rpx;
  color: #ffffff;
}

/* 通用按钮 */
.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  transition: all 0.2s ease;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.95);
}

.primary-btn {
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(90, 110, 138, 0.26);
}

.skip-btn {
  background: #f0f2f5;
  color: #718096;
  border: 2rpx solid #e5e8eb;
  white-space: nowrap;
  flex-shrink: 0;
  padding: 0 16rpx;
}

.outline-btn {
  background: #ffffff;
  color: #5a6e8a;
  border: 2rpx solid #5a6e8a;
}

/* ========== 步骤5: 分析中 ========== */
.analyzing-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  animation: fadeUpIn 0.5s ease;
}

.analyzing-indicator {
  display: flex;
  gap: 12rpx;
  margin: 36rpx 0 24rpx;
}

.analyzing-indicator .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  animation: dotPulse 1.4s ease-in-out infinite;
}

.analyzing-indicator .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.analyzing-indicator .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 80%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  40% {
    opacity: 1;
    transform: scale(1.2);
  }
}

.analyzing-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d3748;
  margin-bottom: 12rpx;
}

.analyzing-subtitle {
  font-size: 26rpx;
  color: #a0aec0;
  margin-bottom: 32rpx;
}

.analyzing-info {
  padding: 16rpx 28rpx;
  background: rgba(90, 110, 138, 0.08);
  border-radius: 20rpx;
}

.analyzing-item {
  font-size: 24rpx;
  color: #5a6e8a;
  font-weight: 500;
}

/* ========== 步骤6: 诊断结果 ========== */
.result-section {
  padding: 24rpx 30rpx 60rpx;
  animation: fadeUpIn 0.5s ease;
}

.result-header-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(90,110,138,0.3);
  margin-bottom: 24rpx;
}

.result-icon {
  font-size: 44rpx;
  flex-shrink: 0;
}

.result-summary {
  flex: 1;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1.6;
}

/* 结果卡片 */
.result-card {
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
}

.result-tip-card {
  border: 1rpx solid rgba(90, 110, 138, 0.12);
  background: linear-gradient(135deg, #ffffff 0%, #f4f7fa 100%);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2d3748;
}

.card-title-icon {
  font-size: 28rpx;
}

/* 原因列表 */
.cause-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cause-item {
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 14rpx;
  border-left: 6rpx solid #5a6e8a;
}

.cause-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.cause-rank {
  font-size: 24rpx;
  font-weight: 700;
  color: #5a6e8a;
  background: rgba(90, 110, 138, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.cause-probability {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  margin-left: 20rpx;
}

.prob-bar {
  flex: 1;
  height: 8rpx;
  background: #e5e8eb;
  border-radius: 4rpx;
  overflow: hidden;
}

.prob-fill {
  height: 100%;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  border-radius: 4rpx;
  transition: width 0.8s ease;
}

.prob-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #5a6e8a;
  min-width: 52rpx;
  text-align: right;
}

.cause-reason {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 8rpx;
}

.cause-explain {
  display: block;
  font-size: 24rpx;
  color: #718096;
  line-height: 1.6;
}

.result-text {
  font-size: 26rpx;
  color: #4a5568;
  line-height: 1.8;
}

.result-cost {
  font-size: 36rpx;
  font-weight: 700;
  color: #e53e3e;
  background: linear-gradient(135deg, #ff6b6b 0%, #e53e3e 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
  padding: 0 10rpx;
}

/* ========== 响应式 ========== */
@media (max-width: 375px) {
  .option-card {
    padding: 24rpx 16rpx;
  }
  .option-icon {
    font-size: 44rpx;
  }
  .option-name {
    font-size: 24rpx;
  }
  .step-bubble {
    padding: 20rpx 24rpx;
  }
  .step-question {
    font-size: 28rpx;
  }
}
