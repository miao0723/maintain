<!--pages/diagnose/diagnose.wxml-->
<view class="page-container">
  <!-- 顶部进度条 -->
  <view class="progress-section" wx:if="{{step <= 4}}">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{step / totalSteps * 100}}%"></view>
    </view>
    <view class="progress-steps">
      <view class="progress-step {{step >= 1 ? 'active' : ''}} {{step > 1 ? 'done' : ''}}">1</view>
      <view class="progress-line {{step >= 2 ? 'active' : ''}}"></view>
      <view class="progress-step {{step >= 2 ? 'active' : ''}} {{step > 2 ? 'done' : ''}}">2</view>
      <view class="progress-line {{step >= 3 ? 'active' : ''}}"></view>
      <view class="progress-step {{step >= 3 ? 'active' : ''}} {{step > 3 ? 'done' : ''}}">3</view>
      <view class="progress-line {{step >= 4 ? 'active' : ''}}"></view>
      <view class="progress-step {{step >= 4 ? 'active' : ''}}">4</view>
    </view>
  </view>

  <!-- ========== 步骤1: 选择设备类型 ========== -->
  <view class="step-content" wx:if="{{step === 1}}">
    <view class="step-header">
      <view class="robot-avatar">🤖</view>
      <view class="step-bubble">
        <text class="step-question">您好！我来帮您诊断设备故障。</text>
        <text class="step-subtitle">请选择您需要检修的设备类型：</text>
      </view>
    </view>
    <view class="option-grid">
      <view class="option-card {{deviceType === item.name ? 'selected' : ''}}" wx:for="{{deviceTypes}}" wx:key="name" bindtap="selectDeviceType" data-type="{{item.name}}">
        <image wx:if="{{item.imageUrl}}" class="option-icon" src="{{item.imageUrl}}" mode="aspectFit" binderror="onOptionImgError" data-index="{{index}}"></image>
        <view wx:else class="option-icon-emoji">{{item.icon}}</view>
        <text class="option-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- ========== 步骤2: 选择品牌 ========== -->
  <view class="step-content" wx:if="{{step === 2}}">
    <view class="step-header">
      <view class="robot-avatar">🤖</view>
      <view class="step-bubble">
        <text class="step-question">好的，{{deviceType}}的维修我们很擅长！</text>
        <text class="step-subtitle">请选择您的设备品牌：</text>
      </view>
    </view>
    <!-- 已选标记 -->
    <view class="selected-tag" wx:if="{{deviceType}}">
      <text class="selected-tag-text">{{deviceType}}</text>
    </view>
    <!-- 自定义品牌输入 -->
    <view class="custom-input-area" wx:if="{{showCustomBrand}}">
      <text class="input-label">请输入品牌名称：</text>
      <view class="input-row">
        <input class="custom-input" placeholder="例如：坚果、小霸王..." value="{{customBrand}}" bindinput="onCustomBrandInput" confirm-type="done" bindconfirm="confirmCustomBrand"/>
        <button class="confirm-btn" bindtap="confirmCustomBrand">确认</button>
      </view>
    </view>
    <view class="option-list" wx:else>
      <view class="option-item {{brand === item.display ? 'selected' : ''}}" wx:for="{{brands}}" wx:key="name" bindtap="selectBrand" data-brand="{{item.name}}">
        <text class="option-label">{{item.display || item.name}}</text>
        <text class="option-check" wx:if="{{brand === item.display}}">✓</text>
      </view>
    </view>
  </view>

  <!-- ========== 步骤3: 选择故障现象 ========== -->
  <view class="step-content" wx:if="{{step === 3}}">
    <view class="step-header">
      <view class="robot-avatar">🤖</view>
      <view class="step-bubble">
        <text class="step-question">了解！{{brand}}{{deviceType}}</text>
        <text class="step-subtitle">请告诉我设备出现了什么问题？</text>
      </view>
    </view>
    <!-- 已选标记 -->
    <view class="selected-tags">
      <text class="selected-tag-text">{{deviceType}}</text>
      <text class="selected-tag-arrow">></text>
      <text class="selected-tag-text">{{brand}}</text>
    </view>
    <!-- 自定义故障输入 -->
    <view class="custom-input-area" wx:if="{{showCustomSymptom}}">
      <text class="input-label">请描述具体的故障现象：</text>
      <view class="input-row">
        <input class="custom-input" placeholder="例如：屏幕中间有一条绿色竖线..." value="{{customSymptom}}" bindinput="onCustomSymptomInput" confirm-type="done" bindconfirm="confirmCustomSymptom"/>
        <button class="confirm-btn" bindtap="confirmCustomSymptom">确认</button>
      </view>
    </view>
    <view class="option-list" wx:else>
      <view class="option-item {{symptom === item.name ? 'selected' : ''}}" wx:for="{{symptoms}}" wx:key="name" bindtap="selectSymptom" data-symptom="{{item.name}}">
        <text class="option-label">{{item.name}}</text>
        <text class="option-check" wx:if="{{symptom === item.name}}">✓</text>
      </view>
    </view>
  </view>

  <!-- ========== 步骤4: 补充详情 ========== -->
  <view class="step-content" wx:if="{{step === 4}}">
    <view class="step-header">
      <view class="robot-avatar">🤖</view>
      <view class="step-bubble">
        <text class="step-question">马上为您分析</text>
        <text class="step-subtitle">在开始之前，请补充更多细节（可选），这些信息会让诊断更准确：</text>
      </view>
    </view>
    <!-- 已选信息摘要 -->
    <view class="info-summary">
      <view class="summary-tag">{{deviceType}}</view>
      <text class="summary-arrow">→</text>
      <view class="summary-tag">{{brand}}</view>
      <text class="summary-arrow">→</text>
      <view class="summary-tag">{{symptom}}</view>
    </view>
    <view class="detail-input">
      <textarea class="detail-textarea" placeholder="例如：设备使用了2年，昨天不小心摔了一下，现在右上角屏幕有一条裂缝，触屏有时候会失灵..." value="{{details}}" bindinput="onDetailsInput" maxlength="500" auto-height/>
      <text class="char-count">{{details.length}}/500</text>
    </view>
    <view class="step-actions">
      <button class="action-btn back-btn" bindtap="goBack">← 上一步</button>
      <button class="action-btn skip-btn" bindtap="skipDetails">跳过直接诊断</button>
      <button class="action-btn primary-btn" bindtap="startDiagnose">🔍 诊断</button>
    </view>
  </view>

  <!-- ========== 步骤5: 分析中 ========== -->
  <view class="step-content" wx:if="{{step === 5}}">
    <view class="analyzing-section">
      <view class="robot-avatar large">🤖</view>
      <view class="analyzing-indicator">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <text class="analyzing-title">正在诊断中...</text>
      <text class="analyzing-subtitle">AI正在分析您的设备故障信息</text>
      <view class="analyzing-info">
        <text class="analyzing-item">{{deviceType}} · {{brand}} · {{symptom}}</text>
      </view>
    </view>
  </view>

  <!-- ========== 步骤6: 诊断结果 ========== -->
  <view class="result-section" wx:if="{{step === 6 && result}}">
    <!-- 结论摘要卡片 -->
    <view class="result-header-card">
      <view class="result-icon">🔍</view>
      <text class="result-summary">{{result.summary || '诊断完成'}}</text>
    </view>

    <!-- 可能原因 -->
    <view class="result-card">
      <view class="card-title">
        <text class="card-title-icon">🎯</text>
        <text>可能原因分析</text>
      </view>
      <view class="cause-list">
        <view class="cause-item" wx:for="{{result.causes}}" wx:key="reason">
          <view class="cause-header">
            <text class="cause-rank">#{{index + 1}}</text>
            <view class="cause-probability">
              <view class="prob-bar">
                <view class="prob-fill" style="width: {{item.probability}}%"></view>
              </view>
              <text class="prob-text">{{item.probability}}%</text>
            </view>
          </view>
          <text class="cause-reason">{{item.reason}}</text>
          <text class="cause-explain">{{item.explanation}}</text>
        </view>
      </view>
    </view>

    <!-- 维修建议 -->
    <view class="result-card" wx:if="{{result.repairPlan}}">
      <view class="card-title">
        <text class="card-title-icon">🛠</text>
        <text>维修建议</text>
      </view>
      <text class="result-text">{{result.repairPlan}}</text>
    </view>

    <!-- 预估费用 -->
    <view class="result-card" wx:if="{{result.estimatedCost}}">
      <view class="card-title">
        <text class="card-title-icon">💰</text>
        <text>预估费用</text>
      </view>
      <text class="result-cost">{{result.estimatedCost}}</text>
    </view>

    <!-- 注意事项 -->
    <view class="result-card" wx:if="{{result.notes}}">
      <view class="card-title">
        <text class="card-title-icon">⚠️</text>
        <text>注意事项</text>
      </view>
      <text class="result-text">{{result.notes}}</text>
    </view>

    <view class="result-card result-tip-card">
      <view class="card-title">
        <text class="card-title-icon">➡️</text>
        <text>下一步</text>
      </view>
      <text class="result-text">把这份自检结果带去客服继续确认，客服会补充维修结论、费用预测，并在对话里直接提供维修下单入口。</text>
    </view>

    <!-- 底部操作 -->
    <view class="result-actions">
      <button class="action-btn outline-btn" bindtap="restartDiagnose">🔄 重新诊断</button>
      <button class="action-btn primary-btn" bindtap="goToService">💬 咨询客服</button>
    </view>
  </view>

  <!-- 底部导航按钮（步骤1-3显示） -->
  <view class="step-nav" wx:if="{{step >= 1 && step <= 3}}">
    <view class="nav-btn nav-prev" bindtap="goBack">
      <text class="nav-btn-text">{{step === 1 ? '← 返回首页' : '← 上一步'}}</text>
    </view>
    <view class="nav-btn nav-next {{canNext ? '' : 'disabled'}}" bindtap="goNext">
      <text class="nav-btn-text">下一步 →</text>
    </view>
  </view>

  <!-- 诊断中取消按钮 -->
  <view class="step-nav" wx:if="{{step === 5}}">
    <view class="nav-btn nav-prev single" bindtap="goBack">
      <text class="nav-btn-text">← 返回修改</text>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
