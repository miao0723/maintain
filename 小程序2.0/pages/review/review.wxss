/* pages/review/review.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* ====== 头部导航 ====== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 10rpx;
}

.back-icon {
  font-size: 36rpx;
  color: #333;
  margin-right: 10rpx;
}

.back-text {
  font-size: 28rpx;
  color: #333;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.header-right {
  width: 80rpx;
}

/* ====== 加载状态 ====== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #436f95;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ====== 评价表单 ====== */
.review-form {
  padding: 28rpx 28rpx 0;
}

/* ====== 订单信息卡片 ====== */
.order-info-card {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  color: white;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(102, 126, 234, 0.25);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
}

.order-id {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.order-type {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.order-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-icon {
  font-size: 28rpx;
  width: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.device-info {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.problem-info {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-info {
  font-size: 28rpx;
  font-weight: 600;
}

.service-info {
  font-size: 26rpx;
  opacity: 0.9;
}

.time-info {
  font-size: 24rpx;
  opacity: 0.8;
}

/* ====== 评分区域（重新设计） ====== */
.rating-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 40rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* 情绪表情 */
.mood-area {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff9e6 0%, #fff3cc 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 180, 0, 0.15);
  transition: all 0.3s ease;
}

.mood-emoji {
  font-size: 64rpx;
  line-height: 1;
  transition: transform 0.3s ease;
}

.rating-section .section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #999;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}

/* 星星容器 */
.stars-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.star {
  font-size: 0;
  padding: 8rpx;
  transition: transform 0.2s ease;
}

.star:active {
  transform: scale(0.85);
}

.star-icon {
  font-size: 72rpx;
  color: #e0e0e0;
  transition: color 0.25s ease, text-shadow 0.25s ease;
}

.star.active .star-icon {
  color: #ffb400;
  text-shadow: 0 2rpx 16rpx rgba(255, 180, 0, 0.4);
}

/* 底部装饰光晕 */
.rating-section::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  width: 300rpx;
  height: 120rpx;
  background: radial-gradient(ellipse, rgba(255, 180, 0, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* ====== 评分标签 ====== */
.rating-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 10rpx 28rpx;
  background: #f8f9fc;
  border-radius: 40rpx;
}

.badge-score {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ffb400, #ff8c00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.badge-divider {
  font-size: 28rpx;
  color: #ddd;
}

.badge-desc {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* ====== 评分进度条 ====== */
.rating-bar-wrapper {
  width: 60%;
  margin-bottom: 28rpx;
}

.rating-bar-bg {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.rating-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffb400, #ff8c00);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

/* ====== 快捷标签 ====== */
.quick-tags {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #f0f0f0;
}

.tag {
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f7fa;
  border: 2rpx solid #e8e8e8;
  transition: all 0.25s ease;
}

.tag:active {
  transform: scale(0.94);
}

.tag.active {
  color: #436f95;
  background: rgba(102, 126, 234, 0.08);
  border-color: #436f95;
  font-weight: 500;
}

.tag.active text {
  color: #436f95;
}

/* ====== 评价内容部分 ====== */
.comment-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.comment-section .section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.comment-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #f8f9fc;
  border-radius: 14rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
  line-height: 1.6;
  transition: border-color 0.2s;
}

.comment-input:focus {
  border-color: #436f95;
  background: #fff;
}

.comment-counter {
  text-align: right;
  margin-top: 12rpx;
}

.comment-counter text {
  font-size: 24rpx;
  color: #bbb;
}

/* ====== 图片上传部分 ====== */
.image-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title-with-count {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-with-count .section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin: 0;
}

.image-count {
  font-size: 24rpx;
  color: #bbb;
  font-weight: 500;
}

.image-uploader {
  margin-top: 0;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  position: relative;
  overflow: hidden;
  background-color: #f8f9fc;
  border: 2rpx solid #e8e8e8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

.add-image {
  color: #999;
  background: #f8f9fc;
  border: 2rpx dashed #d0d0d0;
}

.add-icon {
  font-size: 52rpx;
  font-weight: 300;
  color: #ccc;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #bbb;
}

.image-tips {
  margin-top: 20rpx;
}

.image-tips text {
  font-size: 24rpx;
  color: #bbb;
}

/* ====== 提交按钮 ====== */
.submit-wrapper {
  padding: 0 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  color: white;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.97);
}

.submit-btn.loading {
  opacity: 0.7;
}

.submit-btn[disabled] {
  opacity: 0.5;
}

.submit-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 20rpx;
}

/* ====== 底部间距 ====== */
.bottom-space {
  height: 60rpx;
}