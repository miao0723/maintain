      </view>
    </scroll-view>

    <view class="popup-footer">
      <button class="popup-btn cancel" bindtap="closeQuoteModal">取消</button>
      <button class="popup-btn primary" bindtap="submitQuote">确认报价</button>
    </view>
  </view>
</view>

