<!-- 引入 WXS 工具函数 -->
<wxs src="super-admin.wxs" module="utils" />

<!-- 超级管理员页面 -->
<view class="container">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="admin-card">
      <image class="admin-avatar" src="{{adminInfo.avatar_url || adminInfo.avatarUrl || '/images/avatar-repair.png'}}" mode="aspectFill" binderror="onAvatarError"></image>
      <view class="admin-meta">
        <text class="admin-name">{{adminInfo.nickname || adminInfo.real_name || '管理员'}}</text>
        <view class="admin-role-row">
          <text class="admin-role">{{isSuperAdmin ? '👑 超级管理员' : '🛠 管理员'}}</text>
          <text class="admin-time">{{currentTime || '--:--:--'}}</text>
        </view>
      </view>
      <text class="logout-btn" bindtap="logout">退出</text>
    </view>
  </view>

  <!-- 页面切换标签（可横向滑动） -->
  <view class="tabs-wrapper">
    <view class="tabs-fade tabs-fade-left {{!canScrollLeft ? 'is-hidden' : ''}}"></view>
    <scroll-view
      class="tabs"
      scroll-x
      scroll-into-view="{{activeTabScrollId}}"
      bindscroll="onTabsScroll"
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="tabs-inner">
        <view id="tab-dashboard" class="tab {{currentPage === 'dashboard' ? 'active' : ''}}" bindtap="switchPage" data-page="dashboard">
          <text class="tab-icon-emoji">📊</text>
          <text class="tab-label">仪表盘</text>
        </view>
        <view id="tab-orders" class="tab {{currentPage === 'orders' ? 'active' : ''}}" bindtap="switchPage" data-page="orders">
          <text class="tab-icon-emoji">📋</text>
          <text class="tab-label">工单管理</text>
        </view>
        <view id="tab-myOrders" class="tab {{currentPage === 'myOrders' ? 'active' : ''}}" bindtap="switchPage" data-page="myOrders">
          <text class="tab-icon-emoji">📝</text>
          <text class="tab-label">我的订单</text>
          <view wx:if="{{approvedApplyCount > 0}}" class="tab-badge my-orders-badge">!</view>
        </view>
        <view wx:if="{{isSuperAdmin}}" id="tab-device" class="tab {{currentPage === 'device' ? 'active' : ''}}" bindtap="switchPage" data-page="device">
          <text class="tab-icon-emoji">📱</text>
          <text class="tab-label">设备统计</text>
        </view>
        <view wx:if="{{isSuperAdmin}}" id="tab-inventory" class="tab {{currentPage === 'inventory' ? 'active' : ''}}" bindtap="switchPage" data-page="inventory">
          <text class="tab-icon-emoji">📦</text>
          <text class="tab-label">库存管理</text>
        </view>
        <view wx:if="{{isSuperAdmin}}" id="tab-technicians" class="tab {{currentPage === 'technicians' ? 'active' : ''}}" bindtap="switchPage" data-page="technicians">
          <text class="tab-icon-emoji">👨‍🔧</text>
          <text class="tab-label">维修人员</text>
        </view>
        <view wx:if="{{isSuperAdmin}}" id="tab-progressApply" class="tab {{currentPage === 'progressApply' ? 'active' : ''}}" bindtap="switchPage" data-page="progressApply">
          <text class="tab-icon-emoji">📝</text>
          <text class="tab-label">申请处理</text>
          <view wx:if="{{pendingApplyCount > 0}}" class="tab-badge">{{pendingApplyCount > 99 ? '99+' : pendingApplyCount}}</view>
        </view>
        <view id="tab-afterSales" class="tab {{currentPage === 'afterSales' ? 'active' : ''}}" bindtap="switchPage" data-page="afterSales">
          <text class="tab-icon-emoji">🛠</text>
          <text class="tab-label">售后管理</text>
          <view wx:if="{{pendingAfterSalesCount > 0}}" class="tab-badge">{{pendingAfterSalesCount > 99 ? '99+' : pendingAfterSalesCount}}</view>
        </view>
        <view id="tab-feedback" class="tab {{currentPage === 'feedback' ? 'active' : ''}}" bindtap="switchPage" data-page="feedback">
          <text class="tab-icon-emoji">💡</text>
          <text class="tab-label">反馈管理</text>
          <view wx:if="{{pendingFeedbackCount > 0}}" class="tab-badge">{{pendingFeedbackCount > 99 ? '99+' : pendingFeedbackCount}}</view>
        </view>
        <view wx:if="{{isSuperAdmin}}" id="tab-income" class="tab {{currentPage === 'income' ? 'active' : ''}}" bindtap="switchPage" data-page="income">
          <text class="tab-icon-emoji">💰</text>
          <text class="tab-label">收入</text>
        </view>
        <view wx:if="{{isSuperAdmin}}" id="tab-service" class="tab service-tab" bindtap="goToServiceManagement">
          <text class="tab-icon-emoji">💬</text>
          <text class="tab-label">客服管理</text>
          <view wx:if="{{pendingHumanServiceCount > 0}}" class="tab-badge human-service-badge">{{pendingHumanServiceCount > 99 ? '99+' : pendingHumanServiceCount}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="tabs-fade tabs-fade-right {{!canScrollRight ? 'is-hidden' : ''}}">
      <text class="fade-arrow">›</text>
    </view>
    <view class="tabs-scrollbar">
      <view class="tabs-scrollbar-thumb" style="width: {{scrollThumbWidth}}%; margin-left: {{scrollThumbLeft}}%;"></view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content">
    
    <!-- 仪表盘 -->
    <view class="dashboard" wx:if="{{currentPage === 'dashboard'}}">
      <view class="refresh-bar">
        <text>仪表盘数据</text>
        <text class="refresh-btn" bindtap="loadDashboardData">刷新</text>
      </view>

      <!-- 核心数据卡片 -->
      <view class="stats-grid">
        <view class="stat-card" bindtap="onOrderStatClick" data-status="all">
          <text class="stat-icon">📋</text>
          <view class="stat-info">
            <text class="stat-value">{{dashboardData.orders.total_orders || 0}}</text>
            <text class="stat-label">总工单</text>
            <text class="stat-sub">待处理 {{dashboardData.orders.pending_orders || 0}}</text>
          </view>
        </view>
        <view class="stat-card" bindtap="onUserStatClick">
          <text class="stat-icon">👥</text>
          <view class="stat-info">
            <text class="stat-value">{{dashboardData.users.total_users || 0}}</text>
            <text class="stat-label">用户数</text>
            <text class="stat-sub">管理员 {{dashboardData.users.admin_users || 0}}</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">💰</text>
          <view class="stat-info">
            <text class="stat-value">¥{{utils.formatPrice(dashboardData.revenue.total_revenue)}}</text>
            <text class="stat-label">总收入</text>
            <text class="stat-sub">本月 ¥{{utils.formatPrice(dashboardData.revenue.monthly_revenue)}}</text>
          </view>
        </view>
        <view class="stat-card" bindtap="switchPage" data-page="inventory">
          <text class="stat-icon">📦</text>
          <view class="stat-info">
            <text class="stat-value">{{dashboardData.parts.total_parts || 0}}</text>
            <text class="stat-label">备件数</text>
            <text class="stat-sub danger-text">预警 {{dashboardData.parts.low_stock_parts || 0}}</text>
          </view>
        </view>
      </view>

      <!-- 订单状态分布 -->
      <view class="section">
        <view class="section-title">订单状态</view>
        <view class="order-stats">
          <view class="order-stat-item" bindtap="onOrderStatClick" data-status="pending">
            <text class="stat-num pending">{{dashboardData.orders.pending_orders || 0}}</text>
            <text class="stat-text">待处理</text>
          </view>
          <view class="order-stat-item" bindtap="onOrderStatClick" data-status="processing">
            <text class="stat-num processing">{{dashboardData.orders.processing_orders || 0}}</text>
            <text class="stat-text">处理中</text>
          </view>
          <view class="order-stat-item" bindtap="onOrderStatClick" data-status="completed">
            <text class="stat-num completed">{{dashboardData.orders.completed_orders || 0}}</text>
            <text class="stat-text">已完成</text>
          </view>
          <view class="order-stat-item" bindtap="onOrderStatClick" data-status="cancelled">
            <text class="stat-num cancelled">{{dashboardData.orders.cancelled_orders || 0}}</text>
            <text class="stat-text">已取消</text>
          </view>
          <view class="order-stat-item" bindtap="onOrderStatClick" data-status="review">
            <text class="stat-num review">{{dashboardData.orders.review_orders || 0}}</text>
            <text class="stat-text">待评价</text>
          </view>
        </view>
      </view>

      <!-- 收入统计 -->
      <view class="section">
        <view class="section-title">收入统计</view>
        <view class="revenue-stats">
          <view class="revenue-stat-item">
            <text class="revenue-icon">💵</text>
            <view class="revenue-info">
              <text class="revenue-label">今日收入</text>
              <text class="revenue-value">¥{{utils.formatPrice(dashboardData.revenue.daily_revenue)}}</text>
            </view>
          </view>
          <view class="revenue-stat-item">
            <text class="revenue-icon">📅</text>
            <view class="revenue-info">
              <text class="revenue-label">本周收入</text>
              <text class="revenue-value">¥{{utils.formatPrice(dashboardData.revenue.weekly_revenue)}}</text>
            </view>
          </view>
          <view class="revenue-stat-item">
            <text class="revenue-icon">📆</text>
            <view class="revenue-info">
              <text class="revenue-label">本月收入</text>
              <text class="revenue-value highlight">¥{{utils.formatPrice(dashboardData.revenue.monthly_revenue)}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 库存预警 -->
      <view class="section" wx:if="{{dashboardData.parts.low_stock_parts > 0}}">
        <view class="section-title warning-title">⚠️ 库存预警</view>
        <view class="warning-tip">
          <text>有 {{dashboardData.parts.low_stock_parts}} 种备件库存不足，请及时补货</text>
          <text class="go-btn" bindtap="switchPage" data-page="inventory">去补货</text>
        </view>
      </view>

      <!-- 最近工单 -->
      <view class="section" wx:if="{{dashboardData.recentOrders && dashboardData.recentOrders.length > 0}}">
        <view class="section-title">最近工单</view>
        <view class="recent-orders">
          <view class="recent-order-item" wx:for="{{dashboardData.recentOrders}}" wx:key="id" bindtap="viewOrderDetail" data-order-id="{{item.id}}">
            <view class="ro-left">
              <text class="ro-device">{{item.device_model || '未知设备'}}</text>
              <text class="ro-customer">{{item.customer_name || item.nickname || '客户'}}</text>
            </view>
            <view class="ro-right">
              <text class="ro-price">¥{{utils.formatPrice(item.estimated_price)}}</text>
              <text class="ro-status" style="color: {{utils.getStatusColor(item.status)}}">{{utils.getStatusText(item.status)}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 最近用户 -->
      <view class="section" wx:if="{{dashboardData.recentUsers && dashboardData.recentUsers.length > 0}}">
        <view class="section-title">最近用户</view>
        <view class="recent-users">
          <view class="recent-user-item" wx:for="{{dashboardData.recentUsers}}" wx:key="id">
            <image class="ru-avatar" src="{{item.avatar_url || item.avatarUrl || '/images/avatar-repair.png'}}" mode="aspectFill" binderror="onRecentUserAvatarError" data-index="{{index}}"></image>
            <view class="ru-info">
              <text class="ru-name">{{item.nickname || item.real_name || '用户'}}</text>
              <text class="ru-time">{{utils.formatDate(item.created_at)}}</text>
            </view>
            <text class="ru-role {{item.role}}">{{item.role === 'super_admin' ? '超级管理员' : item.role === 'admin' ? '管理员' : item.role === 'repair' ? '维修人员' : '用户'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 工单管理 -->
    <view class="orders" wx:if="{{currentPage === 'orders'}}">
      <!-- 搜索栏 -->
      <view class="search-bar">
        <view class="search-input-wrap">
          <text class="search-icon">🔍</text>
          <input class="search-input" placeholder="搜索订单号、客户、手机号" value="{{keyword}}" bindinput="onOrderSearchInput" confirm-type="search" bindconfirm="onSearchOrder"></input>
          <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">✕</text>
        </view>
        <button class="search-btn" bindtap="onSearchOrder">搜索</button>
      </view>

      <!-- 状态筛选 -->
      <view class="filter-bar">
        <scroll-view class="filter-scroll" scroll-x>
          <view class="filter-chip {{!statusFilter ? 'active' : ''}}" bindtap="onStatusFilterChange" data-value="" data-label="全部">全部</view>
          <view class="filter-chip {{statusFilter === 'pending' ? 'active' : ''}}" bindtap="onStatusFilterChange" data-value="pending" data-label="待处理">待处理</view>
          <view class="filter-chip {{statusFilter === 'processing' ? 'active' : ''}}" bindtap="onStatusFilterChange" data-value="processing" data-label="处理中">处理中</view>
          <view class="filter-chip {{statusFilter === 'completed' ? 'active' : ''}}" bindtap="onStatusFilterChange" data-value="completed" data-label="已完成">已完成</view>
          <view class="filter-chip {{statusFilter === 'cancelled' ? 'active' : ''}}" bindtap="onStatusFilterChange" data-value="cancelled" data-label="已取消">已取消</view>
          <view class="filter-chip {{statusFilter === 'review' ? 'active' : ''}}" bindtap="onStatusFilterChange" data-value="review" data-label="待评价">待评价</view>
          <view class="filter-chip internal-chip {{statusFilter === 'internal_pending' ? 'active' : ''}}" bindtap="onStatusFilterChange" data-value="internal_pending" data-label="内部待确认">内部待确认</view>
        </scroll-view>
      </view>

      <!-- 设备类型筛选 -->
      <view class="filter-bar type-filter">
        <scroll-view class="filter-scroll" scroll-x>
          <view class="filter-chip type-chip {{!deviceTypeFilter ? 'active' : ''}}" bindtap="onDeviceTypeFilterChange" data-value="全部" data-label="全部">全部</view>
          <view class="filter-chip type-chip" wx:for="{{deviceTypeOptions}}" wx:key="*this" wx:for-item="type" bindtap="onDeviceTypeFilterChange" data-value="{{type}}" data-label="{{type}}">{{type}}</view>
        </scroll-view>
      </view>

      <!-- 结果提示 -->
      <view class="result-tip" wx:if="{{orderTotal > 0}}">
        <text>共 {{orderTotal}} 条记录</text>
      </view>

      <!-- 工单列表 -->
      <view class="order-list" wx:if="{{orders.length > 0}}">
        <view class="order-item" wx:for="{{orders}}" wx:key="id">
          <view class="order-header">
            <view class="oh-left">
              <text class="order-no">{{item.order_id || '未知订单号'}}</text>
              <text class="order-type-tag order-type-badge {{item.order_type === 'recycle' ? 'badge-recycle' : 'badge-repair'}}">{{item.order_type === 'recycle' ? '回收' : '维修'}}</text><text class="order-type-tag" wx:if="{{item.order_type === 'recycle'}}">{{utils.getDeviceTypeName(item.device_type)}}</text><text class="order-type-tag service-type" wx:if="{{item.service_type === 'home'}}">上门</text>
            </view>
            <view class="order-status-badge" style="background-color: {{utils.getStatusColor(item.status)}}; color: #fff;">
              {{utils.getStatusText(item.status)}}
            </view>
          </view>
          <view class="order-body">
            <view class="order-info-row">
              <text class="info-label">客户:</text>
              <text class="info-value">{{item.customer_name || item.nickname || '未知'}}</text>
              <text class="info-phone" bindtap="makeCall" data-phone="{{item.phone}}" wx:if="{{item.phone}}">📞</text>
            </view>
            <view class="order-info-row">
              <text class="info-label">设备:</text>
              <text class="info-value">{{item.device_model || '未知设备'}}</text>
              <text class="info-time">{{utils.formatDate(item.created_at)}}</text>
            </view>
            <view class="order-info-row">
              <text class="info-label">描述:</text>
              <text class="info-value desc" wx:if="{{!item.isRecycle || !item.recycleDescSummary}}">{{item.problem_description || item.custom_description || '无'}}</text>
              <text class="info-value desc" wx:else>{{item.recycleDescSummary}}...</text>
            </view>
            <view class="order-info-row">
              <text class="info-label">价格:</text>
              <!-- 优先显示实际价格,若无则显示预估价格 -->
              <text class="info-value price">¥{{utils.formatPrice(item.actual_price || item.estimated_price)}}</text>
            </view>
            <view class="order-info-row" wx:if="{{item.assigned_to}}">
              <text class="info-label">分配:</text>
              <text class="info-value">{{item.assigned_display_name || item.assigned_name || (item.order_type === 'recycle' ? '处理人员' : '维修人员')}}</text>
            </view>
            <!-- 管理员备注展示 -->
            <view class="order-remark-block" wx:if="{{item.admin_remark}}">
              <text class="remark-icon">📝</text>
              <text class="remark-text">{{item.admin_remark}}</text>
            </view>
          </view>
          <view class="order-footer">
            <view class="order-actions">
              <button class="action-btn remark-btn" size="mini" bindtap="openRemarkModal" data-order-id="{{item.id}}">备注</button>
              <button class="action-btn primary" size="mini" bindtap="viewOrderDetail" data-order-id="{{item.id}}">详情</button>
              <button class="action-btn success" size="mini" wx:if="{{item.status === 'pending'}}" bindtap="assignOrderToTechnician" data-order-id="{{item.id}}">分配</button>
              <button class="action-btn" size="mini" wx:if="{{item.status === 'pending'}}" bindtap="updateOrderStatus" data-order-id="{{item.id}}" data-current-status="{{item.status}}">状态</button>
              <button class="action-btn" size="mini" wx:if="{{item.status === 'quoted'}}" style="background: #436f95; color: #fff;">等待确认</button>
              <button class="action-btn success" size="mini" wx:if="{{item.status === 'confirmed'}}" bindtap="updateOrderStatus" data-order-id="{{item.id}}" data-current-status="{{item.status}}">开始处理</button>
              <button class="action-btn feedback" size="mini" wx:if="{{item.status === 'processing'}}" bindtap="uploadProgress" data-order-id="{{item.id}}">进度反馈</button>
              <button class="action-btn success" size="mini" wx:if="{{item.status === 'internal_pending'}}" bindtap="confirmInternalOrder" data-order-id="{{item.id}}">同意</button>
              <button class="action-btn danger" size="mini" wx:if="{{item.status === 'internal_pending'}}" bindtap="rejectInternalOrder" data-order-id="{{item.id}}">驳回</button>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!orderListLoading && orders.length === 0}}">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无工单</text>
      </view>

      <!-- 加载中 -->
      <view class="empty-state" wx:if="{{orderListLoading}}">
        <text class="empty-icon">⏳</text>
        <text class="empty-text">加载中...</text>
      </view>

      <!-- 分页 -->
      <view class="pagination" wx:if="{{orders.length > 0}}">
        <button class="page-btn {{orderPage <= 1 ? 'disabled' : ''}}" size="mini" bindtap="loadPrevPage">上一页</button>
        <text class="page-info">{{orderPage}} / {{Math.ceil(orderTotal / orderPageSize) || 1}}</text>
        <button class="page-btn {{orderPage >= Math.ceil(orderTotal / orderPageSize) ? 'disabled' : ''}}" size="mini" bindtap="loadNextPage">下一页</button>
      </view>
    </view>

    <!-- 我的订单（分配给当前管理员的订单） -->
    <view class="my-orders" wx:if="{{currentPage === 'myOrders'}}">
      <view class="order-stats-cards">
        <view class="order-stat-card pending" bindtap="onOrderStatClick" data-status="pending">
          <text class="osc-icon">⏳</text>
          <view class="osc-info">
            <text class="osc-value">{{dashboardData.orders.pending_orders || 0}}</text>
            <text class="osc-label">待处理</text>
          </view>
        </view>
        <view class="order-stat-card processing" bindtap="onOrderStatClick" data-status="processing">
          <text class="osc-icon">🔧</text>
          <view class="osc-info">
            <text class="osc-value">{{dashboardData.orders.processing_orders || 0}}</text>
            <text class="osc-label">处理中</text>
          </view>
        </view>
        <view class="order-stat-card completed" bindtap="onOrderStatClick" data-status="completed">
          <text class="osc-icon">✅</text>
          <view class="osc-info">
            <text class="osc-value">{{dashboardData.orders.completed_orders || 0}}</text>
            <text class="osc-label">已完成</text>
          </view>
        </view>
      </view>

      <!-- 加载我的订单 -->
      <view wx:if="{{!orderListLoading && orders.length === 0}}" class="empty-state">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无分配给我的订单</text>
      </view>

      <!-- 我的订单列表 -->
      <view class="my-order-list" wx:if="{{orders.length > 0}}">
        <view class="my-order-item" wx:for="{{orders}}" wx:key="id">
          <view class="myo-header">
            <view class="myo-left">
              <text class="myo-no">{{item.order_id || '未知订单号'}}</text>
              <text class="order-type-tag order-type-badge {{item.order_type === 'recycle' ? 'badge-recycle' : 'badge-repair'}}">{{item.order_type === 'recycle' ? '回收' : '维修'}}</text><text class="myo-type" wx:if="{{item.order_type === 'recycle'}}">{{utils.getDeviceTypeName(item.device_type)}}</text>
            </view>
            <view class="myo-right">
              <text class="myo-status" style="background-color: {{utils.getStatusColor(item.status)}}; color: #fff;">{{utils.getStatusText(item.status)}}</text>
            </view>
          </view>
          <!-- 已通过进度申请提醒 -->
          <view wx:if="{{item.hasApprovedPa}}" class="myo-pa-notice">
            <text class="myo-pa-icon">📢</text>
            <text class="myo-pa-text">该订单有已通过的进度申请，请及时反馈进度</text>
          </view>
          <view class="myo-body">
            <view class="myo-info-row">
              <text class="myo-label">客户:</text>
              <text class="myo-value">{{item.customer_name || item.nickname || '未知'}}</text>
              <text class="info-phone" bindtap="makeCall" data-phone="{{item.phone}}" wx:if="{{item.phone}}">📞</text>
            </view>
            <view class="myo-info-row">
              <text class="myo-label">设备:</text>
              <text class="myo-value">{{item.device_model || '未知设备'}}</text>
            </view>
            <view class="myo-info-row">
              <text class="myo-label">描述:</text>
              <text class="myo-value myo-desc" wx:if="{{!item.isRecycle || !item.recycleDescSummary}}">{{item.problem_description || item.custom_description || '无'}}</text>
              <text class="myo-value myo-desc" wx:else>{{item.recycleDescSummary}}...</text>
            </view>
            <view class="myo-info-row">
              <text class="myo-label">价格:</text>
              <!-- 优先显示实际价格,若无则显示预估价格 -->
              <text class="myo-value myo-price">¥{{utils.formatPrice(item.actual_price || item.estimated_price)}}</text>
            </view>

            <!-- 管理员备注展示 -->
            <view class="order-remark-block" wx:if="{{item.admin_remark}}">
              <text class="remark-icon">📝</text>
              <text class="remark-text">{{item.admin_remark}}</text>
            </view>

            <!-- 进度显示 -->
            <view class="myo-progress-section" wx:if="{{item.status === 'processing'}}">
              <view class="myo-progress-label">
                <text class="mpl-left">{{item.order_type === 'recycle' ? '回收进度' : '维修进度'}}</text>
                <text class="mpl-right">{{item.progress || 0}}%</text>
              </view>
              <view class="myo-progress-bar">
                <view class="myo-progress-fill" style="width: {{item.progress || 0}}%"></view>
              </view>
            </view>
          </view>
          <view class="myo-footer">
            <view class="myo-actions">
              <button class="myo-btn remark-btn" size="mini" bindtap="openRemarkModal" data-order-id="{{item.id}}">备注</button>
              <button class="myo-btn primary" size="mini" bindtap="viewOrderDetail" data-order-id="{{item.id}}">详情</button>
              <button class="myo-btn primary" size="mini" wx:if="{{item.status === 'pending'}}" bindtap="openQuoteModal" data-order-id="{{item.id}}">报价</button>
              <button class="myo-btn" size="mini" wx:if="{{item.status === 'quoted'}}" style="background: #436f95; color: #fff;">等待确认</button>
              <button class="myo-btn success" size="mini" wx:if="{{item.status === 'confirmed'}}" bindtap="doUpdateOrderStatus" data-order-id="{{item.id}}" data-status="processing">开始处理</button>
              <button class="myo-btn feedback" size="mini" wx:if="{{item.status === 'processing'}}" bindtap="uploadProgress" data-order-id="{{item.id}}">进度反馈</button>
              <button class="myo-btn success" size="mini" wx:if="{{item.status === 'internal_pending'}}" bindtap="confirmInternalOrder" data-order-id="{{item.id}}">同意</button>
              <button class="myo-btn danger" size="mini" wx:if="{{item.status === 'internal_pending'}}" bindtap="rejectInternalOrder" data-order-id="{{item.id}}">驳回</button>
              <button class="myo-btn success" size="mini" wx:if="{{item.status === 'processing'}}" bindtap="doUpdateOrderStatus" data-order-id="{{item.id}}" data-status="completed">完成</button>
              <button class="myo-btn danger" size="mini" wx:if="{{item.status !== 'completed' && item.status !== 'quoted' && item.status !== 'internal_pending'}}" bindtap="doUpdateOrderStatus" data-order-id="{{item.id}}" data-status="cancelled">取消</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 设备统计 -->
    <view class="device-stats" wx:if="{{currentPage === 'device'}}">
      <!-- 今日工单 -->
      <view class="section">
        <view class="section-title">今日工单</view>
        <view class="today-stats">
          <view class="today-stat-item">
            <text class="ts-num pending">{{deviceStats.todayStats.pending_today || 0}}</text>
            <text class="ts-label">待处理</text>
          </view>
          <view class="today-stat-item">
            <text class="ts-num processing">{{deviceStats.todayStats.processing_today || 0}}</text>
            <text class="ts-label">处理中</text>
          </view>
          <view class="today-stat-item">
            <text class="ts-num completed">{{deviceStats.todayStats.completed_today || 0}}</text>
            <text class="ts-label">已完成</text>
          </view>
        </view>
      </view>

      <!-- 本月统计 -->
      <view class="section">
        <view class="section-title">本月统计</view>
        <view class="month-stats">
          <view class="ms-item">
            <text class="ms-label">总工单</text>
            <text class="ms-value">{{deviceStats.monthStats.total_month || 0}}</text>
          </view>
          <view class="ms-item">
            <text class="ms-label">完成率</text>
            <text class="ms-value highlight">{{completionRate || 0}}%</text>
          </view>
          <view class="ms-item">
            <text class="ms-label">平均收入</text>
            <text class="ms-value">¥{{averageRevenue}}</text>
          </view>
        </view>
      </view>

      <!-- 设备类型分布 -->
      <view class="section" wx:if="{{deviceStats.deviceDistribution && deviceStats.deviceDistribution.length > 0}}">
        <view class="section-title">设备类型分布</view>
        <view class="device-list">
          <view class="device-item" wx:for="{{deviceStats.deviceDistribution}}" wx:key="device_type">
            <view class="device-item-header">
              <text class="device-name">{{item.device_type_name || '未知设备'}}</text>
              <text class="device-total">共 {{item.count || 0}} 台</text>
            </view>
            <view class="device-bar">
              <view class="bar-segment pending" style="width: {{(item.pending / item.count * 100) || 0}}%"></view>
              <view class="bar-segment processing" style="width: {{(item.processing / item.count * 100) || 0}}%"></view>
              <view class="bar-segment completed" style="width: {{(item.completed / item.count * 100) || 0}}%"></view>
              <view class="bar-segment cancelled" style="width: {{(item.cancelled / item.count * 100) || 0}}%"></view>
            </view>
            <view class="device-detail">
              <text class="dd-item pending">待:{{item.pending || 0}}</text>
              <text class="dd-item processing">中:{{item.processing || 0}}</text>
              <text class="dd-item completed">完:{{item.completed || 0}}</text>
              <text class="dd-item cancelled">取:{{item.cancelled || 0}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 常见故障 -->
      <view class="section" wx:if="{{deviceStats.faultStats && deviceStats.faultStats.length > 0}}">
        <view class="section-title">常见故障</view>
        <view class="fault-list">
          <view class="fault-item" wx:for="{{deviceStats.faultStats}}" wx:key="fault_short">
            <view class="fault-rank {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
            <text class="fault-desc">{{item.fault_short || '未知故障'}}</text>
            <text class="fault-count">{{item.count || 0}} 次</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 库存管理 -->
    <view class="inventory" wx:if="{{currentPage === 'inventory'}}">
      <view class="inventory-overview">
        <view class="io-item">
          <text class="io-num">{{partsTotal || 0}}</text>
          <text class="io-label">备件总数</text>
        </view>
        <view class="io-item warning">
          <text class="io-num">{{partsWarningCount || 0}}</text>
          <text class="io-label">库存预警</text>
        </view>
        <button class="add-btn-small" bindtap="addPart">+ 添加备件</button>
      </view>

      <!-- 备件列表 -->
      <view class="parts-list" wx:if="{{partsInventory.length > 0}}">
        <view class="part-item {{item.quantity <= item.min_quantity ? 'warning' : ''}}" wx:for="{{partsInventory}}" wx:key="id">
          <view class="part-header">
            <view class="part-name-wrap">
              <text class="part-name">{{item.name || '未知备件'}}</text>
              <text class="part-model">{{item.model || ''}}</text>
            </view>
            <text class="part-status-tag" wx:if="{{item.quantity <= item.min_quantity}}">⚠️ 库存不足</text>
          </view>
          <view class="part-body">
            <view class="part-grid">
              <view class="pg-item">
                <text class="pg-label">库存</text>
                <text class="pg-value {{item.quantity <= item.min_quantity ? 'danger' : ''}}">{{item.quantity || 0}}</text>
              </view>
              <view class="pg-item">
                <text class="pg-label">最低库存</text>
                <text class="pg-value">{{item.min_quantity || 5}}</text>
              </view>
              <view class="pg-item">
                <text class="pg-label">单价</text>
                <text class="pg-value">¥{{utils.formatPrice(item.unit_price)}}</text>
              </view>
              <view class="pg-item">
                <text class="pg-label">分类</text>
                <text class="pg-value">{{item.category || '未分类'}}</text>
              </view>
              <view class="pg-item">
                <text class="pg-label">供应商</text>
                <text class="pg-value">{{item.supplier || '未知'}}</text>
              </view>
              <view class="pg-item">
                <text class="pg-label">位置</text>
                <text class="pg-value">{{item.location || '未指定'}}</text>
              </view>
            </view>
          </view>
          <view class="part-footer">
            <button class="action-btn" size="mini" bindtap="editPart" data-part-id="{{item.id}}">编辑</button>
            <button class="action-btn danger" size="mini" bindtap="deletePart" data-part-id="{{item.id}}">删除</button>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!loading && partsInventory.length === 0}}">
        <text class="empty-icon">📦</text>
        <text class="empty-text">暂无备件</text>
        <text class="empty-sub">点击上方按钮添加备件</text>
      </view>

      <!-- 加载中 -->
      <view class="empty-state" wx:if="{{loading}}">
        <text class="empty-icon">⏳</text>
        <text class="empty-text">加载中...</text>
      </view>
    </view>

    <!-- 维修人员 -->
    <view class="technicians" wx:if="{{currentPage === 'technicians'}}">
      <view class="technician-summary">
        <text class="ts-text">共有 {{technicianTotal || 0}} 位维修人员</text>
      </view>

      <!-- 维修人员列表 -->
      <view class="technician-list" wx:if="{{technicians.length > 0}}">
        <view class="technician-item" wx:for="{{technicians}}" wx:key="id">
          <image class="tech-avatar" src="{{item.avatar_url || item.avatarUrl || '/images/avatar-repair.png'}}" mode="aspectFill" binderror="onTechnicianAvatarError" data-index="{{index}}"></image>
          <view class="tech-info">
            <view class="tech-name-row">
              <text class="tech-name">{{item.real_name || item.nickname || '维修人员'}}</text>
              <text class="tech-role-tag {{item.role}}">{{item.role === 'super_admin' ? '超级管理员' : item.role === 'admin' ? '管理员' : item.role === 'repair' ? '维修人员' : item.role === 'internal' ? '内部人员' : '普通用户'}}</text>
            </view>
            <text class="tech-phone" wx:if="{{item.phone}}">📞 {{item.phone}}</text>
            <text class="tech-email" wx:if="{{item.email}}">📧 {{item.email}}</text>
            <view class="tech-stats-card">
              <view class="tsc-item">
                <text class="tsc-num processing">{{item.processing_orders || 0}}</text>
                <text class="tsc-label">进行中</text>
              </view>
              <view class="tsc-item">
                <text class="tsc-num completed">{{item.completed_orders || 0}}</text>
                <text class="tsc-label">已完成</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!loading && technicians.length === 0}}">
        <text class="empty-icon">👨‍🔧</text>
        <text class="empty-text">暂无维修人员</text>
      </view>
    </view>

    <!-- 申请处理 -->
    <view class="progress-apply" wx:if="{{currentPage === 'progressApply'}}">
      <!-- 统计卡片 -->
      <view class="pa-stats-row">
        <view class="pa-stat-card" bindtap="onPaFilterChange" data-status="">
          <text class="pa-stat-value">{{paStats.total}}</text>
          <text class="pa-stat-label">全部</text>
        </view>
        <view class="pa-stat-card pending" bindtap="onPaFilterChange" data-status="pending">
          <text class="pa-stat-value pending-value">{{paStats.pending || 0}}</text>
          <text class="pa-stat-label">待审核</text>
        </view>
        <view class="pa-stat-card approved" bindtap="onPaFilterChange" data-status="approved">
          <text class="pa-stat-value approved-value">{{paStats.approved || 0}}</text>
          <text class="pa-stat-label">已通过</text>
        </view>
        <view class="pa-stat-card rejected" bindtap="onPaFilterChange" data-status="rejected">
          <text class="pa-stat-value rejected-value">{{paStats.rejected || 0}}</text>
          <text class="pa-stat-label">已拒绝</text>
        </view>
      </view>

      <!-- 筛选标签 -->
      <view class="pa-filter-tabs">
        <view class="pa-filter-tab {{paStatusFilter === '' ? 'active' : ''}}" bindtap="onPaFilterChange" data-status="">全部</view>
        <view class="pa-filter-tab {{paStatusFilter === 'pending' ? 'active' : ''}}" bindtap="onPaFilterChange" data-status="pending">待审核</view>
        <view class="pa-filter-tab {{paStatusFilter === 'approved' ? 'active' : ''}}" bindtap="onPaFilterChange" data-status="approved">已通过</view>
        <view class="pa-filter-tab {{paStatusFilter === 'rejected' ? 'active' : ''}}" bindtap="onPaFilterChange" data-status="rejected">已拒绝</view>
      </view>

      <!-- 加载状态 -->
      <view wx:if="{{paLoading && paList.length === 0}}" class="pa-loading-state">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{paList.length === 0 && !paLoading}}" class="pa-empty-state">
        <text class="pa-empty-icon">📋</text>
        <text class="pa-empty-text">暂无进度申请</text>
      </view>

      <!-- 申请列表 -->
      <view wx:else class="pa-list">
        <view class="pa-card" wx:for="{{paList}}" wx:key="id">
          <view class="pa-card-header">
            <view class="pa-card-header-left">
              <text class="pa-apply-no">{{item.apply_no}}</text>
              <text class="pa-apply-user">申请人: {{item.userName}}</text>
            </view>
            <view class="pa-status-badge" style="background: {{item.statusBg}}; color: {{item.statusColor}}">
              {{item.statusIcon}} {{item.statusLabel}}
            </view>
          </view>

          <view class="pa-info-grid">
            <view class="pa-info-item">
              <text class="pa-info-label">设备</text>
              <text class="pa-info-value">{{item.device_name || item.order_device_model || '未填写'}}</text>
            </view>
            <view class="pa-info-item">
              <text class="pa-info-label">进度类型</text>
              <text class="pa-info-value">{{item.progressTypeText}}</text>
            </view>
            <view class="pa-info-item">
              <text class="pa-info-label">联系方式</text>
              <text class="pa-info-value">{{item.phone}}</text>
            </view>
            <view class="pa-info-item">
              <text class="pa-info-label">申请时间</text>
              <text class="pa-info-value time">{{item.createdAt}}</text>
            </view>
          </view>

          <view class="pa-reason-box">
            <text class="pa-reason-label">申请原因:</text>
            <text class="pa-reason-text">{{item.apply_reason}}</text>
          </view>

          <view class="pa-order-link" bindtap="onPaViewOrder" data-orderid="{{item.order_id}}">
            <text class="pa-link-icon">📦</text>
            <text class="pa-link-text">查看关联订单 #{{item.order_id}}</text>
            <text class="pa-link-arrow">›</text>
          </view>

          <!-- 待审核显示操作按钮 -->
          <view wx:if="{{item.approval_status === 'pending'}}" class="pa-action-bar">
            <view class="pa-action-btn approve" bindtap="onPaOpenApprove" data-id="{{item.id}}">✅ 通过</view>
            <view class="pa-action-btn reject" bindtap="onPaOpenReject" data-id="{{item.id}}">❌ 拒绝</view>
            <view class="pa-action-btn detail" bindtap="onPaViewDetail" data-id="{{item.id}}">查看</view>
          </view>

          <!-- 已处理的显示审批备注 -->
          <view wx:if="{{item.approval_status !== 'pending' && item.approval_remark}}" class="pa-approval-note" style="border-left-color: {{item.statusColor}}">
            <text class="pa-note-label">{{item.approval_status === 'approved' ? '审批备注:' : '拒绝原因:'}}</text>
            <text class="pa-note-text">{{item.approval_remark}}</text>
          </view>
        </view>

        <!-- 加载更多 -->
        <view wx:if="{{paLoading && paList.length > 0}}" class="pa-loading-more">加载中...</view>
        <view wx:if="{{!paHasMore && paList.length > 0}}" class="pa-no-more">没有更多了</view>
      </view>

      <!-- 审批通过弹窗 -->
      <view wx:if="{{paShowApproveModal}}" class="pa-modal-overlay" bindtap="onPaCloseApprove">
        <view class="pa-modal-content" catchtap="noop">
          <view class="pa-modal-header">
            <text class="pa-modal-title">审批通过</text>
            <view class="pa-modal-close" bindtap="onPaCloseApprove">×</view>
          </view>
          <view class="pa-modal-body">
            <view class="pa-modal-info">
              <text class="pa-modal-info-label">申请编号: {{paCurrentApply.apply_no}}</text>
              <text class="pa-modal-info-label">申请人: {{paCurrentApply.userName}}</text>
            </view>
            <view class="pa-form-group">
              <text class="pa-form-label">审批备注 (选填)</text>
              <textarea class="pa-form-textarea" placeholder="输入审批意见..." value="{{paApproveRemark}}" bindinput="onPaApproveRemarkInput"/>
            </view>
          </view>
          <view class="pa-modal-footer">
            <view class="pa-modal-btn cancel" bindtap="onPaCloseApprove">取消</view>
            <view class="pa-modal-btn primary" bindtap="onPaSubmitApprove">确认通过</view>
          </view>
        </view>
      </view>

      <!-- 拒绝弹窗 -->
      <view wx:if="{{paShowRejectModal}}" class="pa-modal-overlay" bindtap="onPaCloseReject">
        <view class="pa-modal-content" catchtap="noop">
          <view class="pa-modal-header">
            <text class="pa-modal-title">拒绝申请</text>
            <view class="pa-modal-close" bindtap="onPaCloseReject">×</view>
          </view>
          <view class="pa-modal-body">
            <view class="pa-modal-info">
              <text class="pa-modal-info-label">申请编号: {{paCurrentApply.apply_no}}</text>
              <text class="pa-modal-info-label">申请人: {{paCurrentApply.userName}}</text>
            </view>
            <view class="pa-form-group">
              <text class="pa-form-label">拒绝原因 <text class="pa-required">*</text></text>
              <textarea class="pa-form-textarea" placeholder="请填写拒绝原因..." value="{{paRejectRemark}}" bindinput="onPaRejectRemarkInput"/>
            </view>
          </view>
          <view class="pa-modal-footer">
            <view class="pa-modal-btn cancel" bindtap="onPaCloseReject">取消</view>
            <view class="pa-modal-btn danger" bindtap="onPaSubmitReject">确认拒绝</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 售后管理 -->
    <view class="after-sales" wx:if="{{currentPage === 'afterSales'}}">
      <!-- 统计卡片 -->
      <view class="pa-stats-row">
        <view class="pa-stat-card" bindtap="onAsFilterChange" data-status="">
          <text class="pa-stat-value">{{asStats.total}}</text>
          <text class="pa-stat-label">全部</text>
        </view>
        <view class="pa-stat-card pending" bindtap="onAsFilterChange" data-status="pending">
          <text class="pa-stat-value pending-value">{{asStats.pending}}</text>
          <text class="pa-stat-label">待处理</text>
        </view>
        <view class="pa-stat-card approved" bindtap="onAsFilterChange" data-status="processing">
          <text class="pa-stat-value approved-value">{{asStats.processing}}</text>
          <text class="pa-stat-label">处理中</text>
        </view>
        <view class="pa-stat-card resolved" bindtap="onAsFilterChange" data-status="resolved">
          <text class="pa-stat-value resolved-value">{{asStats.resolved}}</text>
          <text class="pa-stat-label">已解决</text>
        </view>
        <view class="pa-stat-card rejected" bindtap="onAsFilterChange" data-status="rejected">
          <text class="pa-stat-value rejected-value">{{asStats.rejected}}</text>
          <text class="pa-stat-label">已拒绝</text>
        </view>
      </view>

      <!-- 筛选标签 -->
      <view class="pa-filter-tabs">
        <view class="pa-filter-tab {{asStatusFilter === '' ? 'active' : ''}}" bindtap="onAsFilterChange" data-status="">全部</view>
        <view class="pa-filter-tab {{asStatusFilter === 'pending' ? 'active' : ''}}" bindtap="onAsFilterChange" data-status="pending">待处理</view>
        <view class="pa-filter-tab {{asStatusFilter === 'processing' ? 'active' : ''}}" bindtap="onAsFilterChange" data-status="processing">处理中</view>
        <view class="pa-filter-tab {{asStatusFilter === 'resolved' ? 'active' : ''}}" bindtap="onAsFilterChange" data-status="resolved">已解决</view>
        <view class="pa-filter-tab {{asStatusFilter === 'rejected' ? 'active' : ''}}" bindtap="onAsFilterChange" data-status="rejected">已拒绝</view>
      </view>

      <!-- 加载状态 -->
      <view wx:if="{{asLoading && afterSalesList.length === 0}}" class="pa-loading-state">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{afterSalesList.length === 0 && !asLoading}}" class="pa-empty-state">
        <text class="pa-empty-icon">🛠️</text>
        <text class="pa-empty-text">暂无售后申请</text>
      </view>

      <!-- 列表 -->
      <view wx:else class="pa-list">
        <view class="pa-card" wx:for="{{afterSalesList}}" wx:key="id">
          <view class="pa-card-header">
            <view class="pa-card-header-left">
              <text class="pa-apply-no">售后单 #{{item.id}}</text>
              <text class="pa-apply-user">申请人: {{item.applicantName}}</text>
