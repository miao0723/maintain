              <text class="pa-info-value time">{{item.createdAt}}</text>
            </view>
          </view>

          <view class="pa-reason-box">
            <text class="pa-reason-label">问题描述:</text>
            <text class="pa-reason-text">{{item.description}}</text>
          </view>

          <!-- 图片凭证 -->
          <view wx:if="{{item.images.length > 0}}" class="as-images">
            <image wx:for="{{item.images}}" wx:key="*this" wx:for-item="img" class="as-image" src="{{img}}" mode="aspectFill" bindtap="previewImage" data-url="{{img}}" data-urls="{{item.images}}"></image>
          </view>

          <!-- 待处理/处理中 显示操作 -->
          <view wx:if="{{item.status === 'pending' || item.status === 'processing'}}" class="pa-action-bar">
            <view class="pa-action-btn approve" bindtap="onAsOpenResolve" data-id="{{item.id}}">✅ 解决</view>
            <view class="pa-action-btn reject" bindtap="onAsOpenReject" data-id="{{item.id}}">❌ 拒绝</view>
          </view>

          <!-- 已处理 显示备注 -->
          <view wx:if="{{item.status === 'resolved' || item.status === 'rejected'}}" class="pa-approval-note" style="border-left-color: {{item.statusColor}}">
            <text class="pa-note-label">{{item.status === 'resolved' ? '解决方案:' : '拒绝原因:'}}</text>
            <text class="pa-note-text">{{item.admin_remark || '无'}}</text>
            <text wx:if="{{item.resolvedAt}}" class="pa-note-time">{{item.resolvedAt}}</text>
          </view>
        </view>

        <view wx:if="{{asLoading && afterSalesList.length > 0}}" class="pa-loading-more">加载中...</view>
        <view wx:if="{{!asHasMore && afterSalesList.length > 0}}" class="pa-no-more">没有更多了</view>
      </view>
    </view>

    <!-- 意见反馈管理 -->
    <view class="after-sales" wx:if="{{currentPage === 'feedback'}}">
      <!-- 统计卡片 -->
      <view class="pa-stats-row">
        <view class="pa-stat-card" bindtap="onFbFilterChange" data-status="">
          <text class="pa-stat-value">{{fbStats.total}}</text>
          <text class="pa-stat-label">全部</text>
        </view>
        <view class="pa-stat-card pending" bindtap="onFbFilterChange" data-status="pending">
          <text class="pa-stat-value pending-value">{{fbStats.pending}}</text>
          <text class="pa-stat-label">待处理</text>
        </view>
        <view class="pa-stat-card approved" bindtap="onFbFilterChange" data-status="replied">
          <text class="pa-stat-value approved-value">{{fbStats.replied}}</text>
          <text class="pa-stat-label">已回复</text>
        </view>
        <view class="pa-stat-card resolved" bindtap="onFbFilterChange" data-status="closed">
          <text class="pa-stat-value resolved-value">{{fbStats.closed}}</text>
          <text class="pa-stat-label">已关闭</text>
        </view>
      </view>

      <!-- 筛选标签 -->
      <view class="pa-filter-tabs">
        <view class="pa-filter-tab {{fbStatusFilter === '' ? 'active' : ''}}" bindtap="onFbFilterChange" data-status="">全部</view>
        <view class="pa-filter-tab {{fbStatusFilter === 'pending' ? 'active' : ''}}" bindtap="onFbFilterChange" data-status="pending">待处理</view>
        <view class="pa-filter-tab {{fbStatusFilter === 'replied' ? 'active' : ''}}" bindtap="onFbFilterChange" data-status="replied">已回复</view>
        <view class="pa-filter-tab {{fbStatusFilter === 'closed' ? 'active' : ''}}" bindtap="onFbFilterChange" data-status="closed">已关闭</view>
      </view>

      <!-- 加载状态 -->
      <view wx:if="{{fbLoading && fbList.length === 0}}" class="pa-loading-state">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{fbList.length === 0 && !fbLoading}}" class="pa-empty-state">
        <text class="pa-empty-icon">💡</text>
        <text class="pa-empty-text">暂无反馈</text>
      </view>

      <!-- 列表 -->
      <view wx:else class="pa-list">
        <view class="pa-card" wx:for="{{fbList}}" wx:key="id">
          <view class="pa-card-header">
            <view class="pa-card-header-left">
              <text class="pa-apply-no">反馈 #{{item.id}}</text>
              <text class="pa-apply-user">提交人: {{item.submitterName}}</text>
            </view>
            <view class="pa-status-badge" style="background: {{item.statusBg}}; color: {{item.statusColor}}">
              {{item.statusIcon}} {{item.statusLabel}}
            </view>
          </view>

          <view class="pa-info-grid">
            <view class="pa-info-item">
              <text class="pa-info-label">类型</text>
              <text class="pa-info-value">{{item.typeText}}</text>
            </view>
            <view class="pa-info-item">
              <text class="pa-info-label">提交时间</text>
              <text class="pa-info-value time">{{item.createdAt}}</text>
            </view>
            <view class="pa-info-item">
              <text class="pa-info-label">联系方式</text>
              <text class="pa-info-value">{{item.contact || '无'}}</text>
            </view>
            <view class="pa-info-item">
              <text class="pa-info-label">用户电话</text>
              <text class="pa-info-value">{{item.user_phone || '无'}}</text>
            </view>
          </view>

          <view class="pa-reason-box">
            <text class="pa-reason-label">反馈内容:</text>
            <text class="pa-reason-text">{{item.content}}</text>
          </view>

          <!-- 已回复 显示回复内容 -->
          <view wx:if="{{item.admin_reply}}" class="pa-approval-note" style="border-left-color: {{item.statusColor}}">
            <text class="pa-note-label">管理员回复:</text>
            <text class="pa-note-text">{{item.admin_reply}}</text>
            <text wx:if="{{item.repliedAt}}" class="pa-note-time">{{item.repliedAt}}</text>
          </view>

          <!-- 操作：未关闭可回复/关闭 -->
          <view wx:if="{{item.status !== 'closed'}}" class="pa-action-bar">
            <view class="pa-action-btn approve" bindtap="onFbOpenReply" data-id="{{item.id}}">💬 回复</view>
            <view class="pa-action-btn reject" bindtap="onFbStatusChange" data-id="{{item.id}}" data-status="closed">🔒 关闭</view>
          </view>
          <view wx:if="{{item.status === 'closed'}}" class="pa-action-bar">
            <view class="pa-action-btn detail" bindtap="onFbStatusChange" data-id="{{item.id}}" data-status="pending">↩ 重新打开</view>
          </view>
        </view>

        <view wx:if="{{fbLoading && fbList.length > 0}}" class="pa-loading-more">加载中...</view>
        <view wx:if="{{!fbHasMore && fbList.length > 0}}" class="pa-no-more">没有更多了</view>
      </view>
    </view>

    <!-- 交易收入 -->
    <view class="income" wx:if="{{currentPage === 'income'}}">
      <view class="refresh-bar">
        <text>交易收入</text>
        <view class="refresh-actions">
          <text class="refresh-btn" bindtap="onIncomeBackfill">历史回填</text>
          <text class="refresh-btn" bindtap="loadIncomeData" data-reset="1">刷新</text>
        </view>
      </view>

      <!-- 汇总卡片 -->
      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-icon">💰</text>
          <view class="stat-info">
            <text class="stat-value">¥{{utils.formatPrice(incomeData.stats.total_income)}}</text>
            <text class="stat-label">累计收入</text>
            <text class="stat-sub">{{incomeData.stats.record_count || 0}} 笔</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">✅</text>
          <view class="stat-info">
            <text class="stat-value">¥{{utils.formatPrice(incomeData.stats.paid_income)}}</text>
            <text class="stat-label">已收款</text>
            <text class="stat-sub">退款 ¥{{utils.formatPrice(incomeData.stats.refunded_income)}}</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">🔧</text>
          <view class="stat-info">
            <text class="stat-value">¥{{utils.formatPrice(incomeData.stats.repair_income)}}</text>
            <text class="stat-label">维修收入</text>
            <text class="stat-sub">到店 ¥{{utils.formatPrice(incomeData.stats.shop_income)}}</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">♻️</text>
          <view class="stat-info">
            <text class="stat-value">¥{{utils.formatPrice(incomeData.stats.recycle_income)}}</text>
            <text class="stat-label">回收收入</text>
            <text class="stat-sub">上门 ¥{{utils.formatPrice(incomeData.stats.door_to_door_income)}}</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">📅</text>
          <view class="stat-info">
            <text class="stat-value">¥{{utils.formatPrice(incomeData.stats.monthly_income)}}</text>
            <text class="stat-label">近30天</text>
            <text class="stat-sub">今日 ¥{{utils.formatPrice(incomeData.stats.daily_income)}}</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">📊</text>
          <view class="stat-info">
            <text class="stat-value">¥{{utils.formatPrice(incomeData.stats.avg_amount)}}</text>
            <text class="stat-label">客单价</text>
          </view>
        </view>
      </view>

      <!-- 支付渠道分布 -->
      <view class="section" wx:if="{{incomeData.by_channel.length > 0}}">
        <view class="section-title">支付渠道分布</view>
        <view class="channel-list">
          <view class="channel-item" wx:for="{{incomeData.by_channel}}" wx:key="channel">
            <text class="channel-name">{{item.channel === 'wechat_miniapp' ? '微信小程序' : (item.channel === 'cash' ? '现金' : (item.channel === 'alipay' ? '支付宝' : item.channel))}}</text>
            <text class="channel-amount">¥{{item.amount}} · {{item.cnt}}笔</text>
          </view>
        </view>
      </view>

      <!-- 月度收入趋势（折线图） -->
      <view class="section" wx:if="{{incomeData.monthly_trend.length > 0 && !showOrderDetail}}">
        <view class="section-title">近6个月收入趋势</view>
        <view class="trend-chart-wrap">
          <canvas type="2d" id="incomeTrendChart" class="trend-canvas"></canvas>
        </view>
        <view class="trend-legend">
          <view class="trend-legend-item" wx:for="{{incomeData.monthly_trend}}" wx:key="month">
            <text class="trend-legend-month">{{item.month_label}}</text>
            <text class="trend-legend-amount">¥{{item.amount}}</text>
          </view>
        </view>
      </view>

      <!-- 搜索（全部/维修/回收 通用） -->
      <view class="income-search">
        <view class="income-search-box">
          <text class="income-search-icon">🔍</text>
          <input
            class="income-search-input"
            placeholder="搜索 订单ID / 维修产品 / 用户名"
            value="{{incomeKeyword}}"
            bindinput="onIncomeSearchInput"
            confirm-type="search"
            bindconfirm="onIncomeSearch"
          />
          <text class="income-search-clear" wx:if="{{incomeKeyword}}" bindtap="onIncomeClearSearch">✕</text>
        </view>
        <text class="income-search-btn" bindtap="onIncomeSearch">搜索</text>
      </view>

      <!-- 筛选 -->
      <view class="pa-filter-tabs">
        <view class="pa-filter-tab {{incomeFilter === '' ? 'active' : ''}}" bindtap="onIncomeFilterChange" data-type="">全部</view>
        <view class="pa-filter-tab {{incomeFilter === 'repair' ? 'active' : ''}}" bindtap="onIncomeFilterChange" data-type="repair">维修</view>
        <view class="pa-filter-tab {{incomeFilter === 'recycle' ? 'active' : ''}}" bindtap="onIncomeFilterChange" data-type="recycle">回收</view>
      </view>

      <!-- 列表 -->
      <scroll-view class="income-scroll" scroll-y bindscrolltolower="onIncomeReachBottom">
        <view class="income-card" wx:for="{{incomeList}}" wx:key="id" bindtap="onIncomeItemTap" data-order-id="{{item.order_id}}">
          <view class="income-card-left">
            <text class="income-order-no">订单 {{item.order_no || item.order_id}}</text>
            <text class="income-customer">{{item.customer_name}} · {{item.order_type === 'recycle' ? '回收' : '维修'}}{{item.service_type === 'door-to-door' ? '(上门)' : ''}}</text>
            <text class="income-time">{{item.paid_at || '-'}}</text>
          </view>
          <view class="income-card-right">
            <text class="income-amount">¥{{item.amount}}</text>
            <text class="income-status {{item.payment_status === 'partial_refunded' ? 'partial' : 'paid'}}">{{item.payment_status === 'partial_refunded' ? '部分退款' : '已收款'}}</text>
          </view>
          <text class="income-card-arrow">›</text>
        </view>

        <view wx:if="{{incomeLoading && incomeList.length === 0}}" class="pa-loading-state">
          <view class="loading-spinner"></view>
          <text>加载中...</text>
        </view>
        <view wx:elif="{{incomeList.length === 0 && !incomeLoading}}" class="pa-empty-state">
          <text class="pa-empty-icon">💰</text>
          <text class="pa-empty-text">暂无收入记录</text>
        </view>
        <view wx:else>
          <view wx:if="{{incomeLoading}}" class="pa-loading-more">加载中...</view>
          <view wx:if="{{!incomeHasMore && incomeList.length > 0}}" class="pa-no-more">没有更多了</view>
        </view>
      </scroll-view>
    </view>

  </view>
</view>

<!-- 用户管理弹窗 -->
<view class="popup-overlay" wx:if="{{showUserList}}">
  <view class="popup-mask" bindtap="closeUserList"></view>
  <view class="popup-content user-popup">
    <view class="popup-header user-popup-header">
      <view class="user-popup-title-wrap">
        <text class="popup-title">用户管理</text>
        <text class="user-popup-count">共 {{userTotal}} 位用户</text>
      </view>
      <view class="user-popup-header-actions">
        <view class="user-add-btn" bindtap="onAddUser">
          <text class="user-add-icon">＋</text>
          <text>添加</text>
        </view>
        <text class="popup-close" bindtap="closeUserList">✕</text>
      </view>
    </view>

    <view class="popup-search">
      <view class="popup-search-box">
        <text class="popup-search-icon">🔍</text>
        <input class="popup-search-input" placeholder="搜索用户名、手机号" value="{{userKeyword}}" bindinput="onUserSearchInput" bindconfirm="onUserSearch"></input>
        <text class="popup-search-clear" wx:if="{{userKeyword}}" bindtap="onClearUserSearch">✕</text>
      </view>
      <button class="popup-search-btn" bindtap="onUserSearch">搜索</button>
    </view>

    <!-- 角色筛选（分段控件） -->
    <view class="role-filter">
      <view class="role-filter-item {{!userRoleFilter ? 'active' : ''}}" bindtap="onUserRoleFilter" data-role="">全部</view>
      <view class="role-filter-item {{userRoleFilter === 'super_admin' ? 'active' : ''}}" bindtap="onUserRoleFilter" data-role="super_admin">超级管理员</view>
      <view class="role-filter-item {{userRoleFilter === 'admin' ? 'active' : ''}}" bindtap="onUserRoleFilter" data-role="admin">管理员</view>
      <view class="role-filter-item {{userRoleFilter === 'repair' ? 'active' : ''}}" bindtap="onUserRoleFilter" data-role="repair">维修人员</view>
      <view class="role-filter-item {{userRoleFilter === 'internal' ? 'active' : ''}}" bindtap="onUserRoleFilter" data-role="internal">内部人员</view>
      <view class="role-filter-item {{userRoleFilter === 'user' ? 'active' : ''}}" bindtap="onUserRoleFilter" data-role="user">普通用户</view>
    </view>

    <scroll-view class="popup-scroll" scroll-y>
      <view class="user-card" wx:for="{{users}}" wx:key="id">
        <view class="user-card-top">
          <image class="user-avatar" src="{{item.avatar_url || item.avatarUrl || '/images/avatar-repair.png'}}" mode="aspectFill" binderror="onUserAvatarError" data-index="{{index}}"></image>
          <view class="user-info">
            <view class="user-name-row">
              <text class="user-name">{{item.nickname || item.real_name || '用户'}}</text>
              <text class="user-role-tag {{item.role}}">{{item.role === 'super_admin' ? '超级管理员' : item.role === 'admin' ? '管理员' : item.role === 'repair' ? '维修人员' : item.role === 'internal' ? '内部人员' : '普通用户'}}</text>
            </view>
            <text class="user-phone">📱 {{item.phone || '无手机号'}}</text>
            <text class="user-join-time">🕒 注册于 {{utils.formatDate(item.created_at)}}</text>
          </view>
          <view class="user-status-badge {{item.status ? 'on' : 'off'}}">{{item.status ? '正常' : '已禁用'}}</view>
        </view>
        <view class="user-card-actions">
          <view class="uc-btn edit" bindtap="onEditUser" data-id="{{item.id}}">✏️ 修改信息</view>
          <block wx:if="{{item.role === 'super_admin'}}">
            <view class="uc-btn locked">🔒 超级管理员（受保护）</view>
          </block>
          <block wx:else>
            <view class="uc-btn {{item.status ? 'disable' : 'enable'}}" bindtap="onToggleUserStatus" data-id="{{item.id}}" data-status="{{item.status}}">{{item.status ? '🚫 禁用' : '✅ 启用'}}</view>
            <view class="uc-btn danger" bindtap="onDeleteUser" data-id="{{item.id}}" data-name="{{item.nickname || item.real_name || '该用户'}}">🗑 删除</view>
          </block>
        </view>
      </view>

      <view class="user-list-loading" wx:if="{{loading}}">
        <text class="empty-text">加载中...</text>
      </view>
      <view class="empty-state small" wx:if="{{!loading && users.length === 0}}">
        <text class="empty-icon">👥</text>
        <text class="empty-text">暂无符合条件的用户</text>
      </view>
    </scroll-view>

    <view class="popup-pagination">
      <button class="page-btn {{userPage <= 1 ? 'disabled' : ''}}" bindtap="loadPrevUserPage">上一页</button>
      <text class="page-info">{{userPage}} / {{Math.ceil(userTotal / userPageSize) || 1}}</text>
      <button class="page-btn {{userPage >= Math.ceil(userTotal / userPageSize) ? 'disabled' : ''}}" bindtap="loadNextUserPage">下一页</button>
    </view>
  </view>
</view>

<!-- 用户编辑/新增弹窗 -->
<view class="popup-overlay" wx:if="{{showUserForm}}">
  <view class="popup-mask" bindtap="closeUserForm"></view>
  <view class="popup-content form-popup">
    <view class="popup-header">
      <text class="popup-title">{{userFormMode === 'edit' ? '修改用户信息' : '新增用户'}}</text>
      <text class="popup-close" bindtap="closeUserForm">✕</text>
    </view>
    <scroll-view class="popup-scroll" scroll-y>
      <view class="form-group">
        <text class="form-label">昵称<text class="form-required">*</text></text>
        <input class="form-input" placeholder="请输入昵称" value="{{userForm.nickname}}" data-field="nickname" bindinput="onUserFormInput"></input>
      </view>
      <view class="form-group">
        <text class="form-label">真实姓名</text>
        <input class="form-input" placeholder="请输入真实姓名（选填）" value="{{userForm.real_name}}" data-field="real_name" bindinput="onUserFormInput"></input>
      </view>
      <view class="form-group">
        <text class="form-label">手机号<text class="form-required">*</text></text>
        <input class="form-input" type="number" placeholder="请输入手机号" value="{{userForm.phone}}" data-field="phone" bindinput="onUserFormInput"></input>
      </view>
      <view class="form-group">
        <text class="form-label">邮箱</text>
        <input class="form-input" placeholder="请输入邮箱（选填）" value="{{userForm.email}}" data-field="email" bindinput="onUserFormInput"></input>
      </view>
      <view class="form-group">
        <text class="form-label">角色</text>
        <block wx:if="{{userFormMode === 'edit' && userForm.role === 'super_admin'}}">
          <view class="form-role-readonly">超级管理员（系统最高权限，角色不可修改）</view>
        </block>
        <block wx:else>
          <view class="form-role-options">
            <view class="form-role-opt {{userForm.role === 'user' ? 'active' : ''}}" bindtap="onUserFormRole" data-role="user">普通用户</view>
            <view class="form-role-opt {{userForm.role === 'repair' ? 'active' : ''}}" bindtap="onUserFormRole" data-role="repair">维修人员</view>
            <view class="form-role-opt {{userForm.role === 'internal' ? 'active' : ''}}" bindtap="onUserFormRole" data-role="internal">内部人员</view>
            <view class="form-role-opt {{userForm.role === 'admin' ? 'active' : ''}}" bindtap="onUserFormRole" data-role="admin">管理员</view>
          </view>
        </block>
      </view>
      <view class="form-group" wx:if="{{userFormMode === 'edit'}}">
        <text class="form-label">状态</text>
        <block wx:if="{{userForm.role === 'super_admin'}}">
          <view class="form-role-readonly">正常（超级管理员不可被禁用）</view>
        </block>
        <block wx:else>
          <view class="form-role-options">
            <view class="form-role-opt {{userForm.status === 1 ? 'active' : ''}}" bindtap="onUserFormStatus" data-status="1">正常</view>
            <view class="form-role-opt {{userForm.status === 0 ? 'active' : ''}}" bindtap="onUserFormStatus" data-status="0">已禁用</view>
          </view>
        </block>
      </view>
    </scroll-view>
    <view class="form-footer">
      <button class="form-cancel-btn" bindtap="closeUserForm">取消</button>
      <button class="form-save-btn" loading="{{savingUser}}" bindtap="onSaveUser">{{userFormMode === 'edit' ? '保存修改' : '创建用户'}}</button>
    </view>
  </view>
</view>

<!-- 工单详情弹窗 -->
<view class="popup-overlay" wx:if="{{showOrderDetail && orderDetail}}">
  <view class="popup-mask" bindtap="closeOrderDetail"></view>
  <view class="popup-content detail-popup">
    <view class="popup-header">
      <text class="popup-title">工单详情</text>
      <text class="popup-close" bindtap="closeOrderDetail">✕</text>
    </view>
    <scroll-view class="popup-scroll" scroll-y>
      <!-- 基本信息 -->
      <view class="detail-section">
        <view class="detail-section-title">基本信息</view>
        <view class="detail-row">
          <text class="detail-label">订单号</text>
          <text class="detail-value order-id">{{orderDetail.order_id || orderDetail.id}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">状态</text>
          <text class="detail-value" style="color: {{utils.getStatusColor(orderDetail.status)}};">{{utils.getStatusText(orderDetail.status)}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">设备类型</text>
          <text class="detail-value">{{utils.getDeviceTypeName(orderDetail.device_type)}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">设备型号</text>
          <text class="detail-value">{{orderDetail.device_model || '未知设备'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">订单类型</text>
          <text class="detail-value">{{orderDetail.order_type === 'repair' ? '维修' : orderDetail.order_type === 'recycle' ? '回收' : '未知'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">服务方式</text>
          <text class="detail-value">{{orderDetail.service_type === 'shop' ? '到店' : orderDetail.service_type === 'home' ? '上门' : '未指定'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">客户姓名</text>
          <text class="detail-value">{{orderDetail.customer_name || orderDetail.nickname || '未知'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">联系电话</text>
          <text class="detail-value link" bindtap="makeCall" data-phone="{{orderDetail.phone}}">{{orderDetail.phone || '无'}}</text>
        </view>
        <view class="detail-row full">
          <text class="detail-label">描述</text>
          <!-- 回收订单：结构化展示 -->
          <block wx:if="{{orderDetail.isRecycle && orderDetail.recycleDescItems.length > 0}}">
            <view class="recycle-desc-cards">
              <view class="recycle-desc-item" wx:for="{{orderDetail.recycleDescItems}}" wx:key="index">
                <text class="recycle-desc-label">{{item.label}}</text>
                <text class="recycle-desc-value">{{item.value}}</text>
              </view>
            </view>
          </block>
          <text class="detail-value desc" wx:else>{{orderDetail.problem_description || orderDetail.custom_description || '无'}}</text>
        </view>
      </view>

      <!-- 价格信息 -->
      <view class="detail-section">
        <view class="detail-section-title">价格信息</view>
        <view class="detail-row">
          <text class="detail-label">预估价格</text>
          <text class="detail-value">¥{{utils.formatPrice(orderDetail.estimated_price)}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">实际价格</text>
          <view class="price-edit-wrapper">
            <text class="detail-value highlight">¥{{utils.formatPrice(orderDetail.actual_price || orderDetail.estimated_price)}}</text>
            <button class="edit-btn mini" size="mini" wx:if="{{orderDetail.status !== 'completed'}}" bindtap="showPriceEditor">修改</button>
          </view>
        </view>
        <view class="detail-row" wx:if="{{orderDetail.order_type === 'recycle'}}">
          <text class="detail-label">设备估值</text>
          <text class="detail-value">¥{{utils.formatPrice(orderDetail.estimated_price)}}</text>
        </view>
        <view class="detail-row" wx:if="{{orderDetail.status === 'completed' && orderDetail.actual_price}}">
          <text class="detail-label">价格差异</text>
          <text class="detail-value {{utils.getPriceDiffClass(orderDetail.estimated_price, orderDetail.actual_price)}}">
            {{utils.formatPrice(orderDetail.actual_price - orderDetail.estimated_price)}}
          </text>
        </view>
      </view>

      <!-- 进度信息（处理中订单） -->
      <view class="detail-section" wx:if="{{orderDetail.status === 'processing'}}">
        <view class="detail-section-title">{{orderDetail.order_type === 'recycle' ? '回收进度' : '维修进度'}}</view>
        <view class="progress-preview">
          <text class="progress-label">当前进度</text>
          <text class="progress-value">{{orderDetail.progress || 0}}%</text>
        </view>
        <view class="progress-bar-large">
          <view class="progress-fill-large" style="width: {{orderDetail.progress || 0}}%"></view>
        </view>
        <view class="quick-progress">
          <button class="quick-btn" size="mini" bindtap="updateProgress" data-progress="0">0%</button>
          <button class="quick-btn" size="mini" bindtap="updateProgress" data-progress="25">25%</button>
          <button class="quick-btn" size="mini" bindtap="updateProgress" data-progress="50">50%</button>
          <button class="quick-btn" size="mini" bindtap="updateProgress" data-progress="75">75%</button>
          <button class="quick-btn primary" size="mini" bindtap="updateProgress" data-progress="100">完成</button>
        </view>
      </view>

      <!-- 分配信息 -->
      <view class="detail-section" wx:if="{{orderDetail.assigned_to}}">
        <view class="detail-section-title">分配信息</view>
        <view class="detail-row">
          <text class="detail-label">{{orderDetail.order_type === 'recycle' ? '处理人员' : '维修人员'}}</text>
          <text class="detail-value">{{orderDetail.assigned_display_name || orderDetail.assigned_name || '未分配'}}</text>
        </view>
        <view class="detail-row" wx:if="{{orderDetail.assigned_at}}">
          <text class="detail-label">分配时间</text>
          <text class="detail-value time">{{utils.formatDate(orderDetail.assigned_at)}}</text>
        </view>
      </view>

      <!-- 产品照片 -->
      <view wx:if="{{orderDetail.images && orderDetail.images.length > 0}}" class="detail-section">
        <view class="detail-section-title">📷 产品照片（{{orderDetail.images.length}}）</view>
        <view class="detail-images-grid">
          <view wx:for="{{orderDetail.images}}" wx:key="index" class="detail-image-wrapper">
            <image class="detail-image" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" data-urls="{{orderDetail.images}}"></image>
          </view>
        </view>
        <view class="detail-image-tip" bindtap="previewImage" data-url="{{orderDetail.images[0]}}" data-urls="{{orderDetail.images}}">
          <text class="tip-icon">🔍</text>
          <text class="tip-text">点击查看大图</text>
        </view>
      </view>

      <!-- 时间信息 -->
      <view class="detail-section">
        <view class="detail-section-title">时间信息</view>
        <view class="detail-row">
          <text class="detail-label">创建时间</text>
          <text class="detail-value time">{{utils.formatDate(orderDetail.created_at)}}</text>
        </view>
        <view class="detail-row" wx:if="{{orderDetail.assigned_at}}">
          <text class="detail-label">分配时间</text>
          <text class="detail-value time">{{utils.formatDate(orderDetail.assigned_at)}}</text>
        </view>
        <view class="detail-row" wx:if="{{orderDetail.completed_at}}">
          <text class="detail-label">完成时间</text>
          <text class="detail-value time">{{utils.formatDate(orderDetail.completed_at)}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="detail-actions">
      <button class="detail-btn success" size="default" wx:if="{{orderDetail.status === 'pending'}}" bindtap="doUpdateOrderStatus" data-order-id="{{orderDetail.id}}" data-status="quoted">提交报价</button>
      <button class="detail-btn" size="default" wx:if="{{orderDetail.status === 'quoted'}}" style="background: #436f95; color: #fff;">等待用户确认报价</button>
      <button class="detail-btn success" size="default" wx:if="{{orderDetail.status === 'confirmed'}}" bindtap="doUpdateOrderStatus" data-order-id="{{orderDetail.id}}" data-status="processing">开始处理</button>
      <button class="detail-btn feedback" size="default" wx:if="{{orderDetail.status === 'processing'}}" bindtap="uploadProgress" data-order-id="{{orderDetail.id}}">进度反馈</button>
      <button class="detail-btn success" size="default" wx:if="{{orderDetail.status === 'processing'}}" bindtap="doUpdateOrderStatus" data-order-id="{{orderDetail.id}}" data-status="completed">完成工单</button>
      <button class="detail-btn internal-confirm" size="default" wx:if="{{orderDetail.status === 'internal_pending'}}" bindtap="confirmInternalOrder" data-order-id="{{orderDetail.id}}">同意（免付款）</button>
      <button class="detail-btn internal-reject" size="default" wx:if="{{orderDetail.status === 'internal_pending'}}" bindtap="rejectInternalOrder" data-order-id="{{orderDetail.id}}">驳回申请</button>
      <button class="detail-btn danger" size="default" wx:if="{{orderDetail.status !== 'completed' && orderDetail.status !== 'quoted' && orderDetail.status !== 'internal_pending'}}" bindtap="doUpdateOrderStatus" data-order-id="{{orderDetail.id}}" data-status="cancelled">取消工单</button>
    </view>
  </view>
</view>

<!-- 报价弹窗 -->
<view class="popup-overlay" wx:if="{{showQuoteModal}}">
  <view class="popup-mask" bindtap="closeQuoteModal"></view>
  <view class="popup-content">
    <view class="popup-header">
      <text class="popup-title">提交报价</text>
