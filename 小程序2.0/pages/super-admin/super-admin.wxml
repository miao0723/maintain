        <view class="quote-images-grid">
          <image wx:for="{{quoteOrderData.images}}" wx:key="index" class="quote-attach-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" data-urls="{{quoteOrderData.images}}"></image>
        </view>
      </view>

      <!-- 报价金额 -->
      <view class="quote-section">
        <text class="quote-section-title">报价金额 <text class="required">*</text></text>
        <view class="price-input-wrapper">
          <text class="currency-symbol">¥</text>
          <input
            class="price-input"
            type="digit"
            placeholder="0.00"
            value="{{quoteFormData.price}}"
            bindinput="onQuotePriceInput"
          />
        </view>
      </view>

      <!-- 报价说明 -->
