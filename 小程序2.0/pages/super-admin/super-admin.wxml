          <text class="form-label">设备型号</text>
          <input class="form-input modern" placeholder="请输入设备型号" value="{{partForm.model}}" data-field="model" bindinput="onPartFormInput"></input>
        </view>
        <view class="form-group">
          <text class="form-label">分类</text>
          <input class="form-input modern" placeholder="请输入分类" value="{{partForm.category}}" data-field="category" bindinput="onPartFormInput"></input>
        </view>
        <view class="form-row">
          <view class="form-group half">
            <text class="form-label">库存数量 <text class="required">*</text></text>
            <input class="form-input modern" type="number" placeholder="0" value="{{partForm.quantity}}" data-field="quantity" bindinput="onPartFormInput"></input>
          </view>
          <view class="form-group half">
            <text class="form-label">最低库存</text>
            <input class="form-input modern" type="number" placeholder="5" value="{{partForm.min_quantity}}" data-field="min_quantity" bindinput="onPartFormInput"></input>
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">单价（元） <text class="required">*</text></text>
          <input class="form-input modern" type="digit" placeholder="0.00" value="{{partForm.unit_price}}" data-field="unit_price" bindinput="onPartFormInput"></input>
        </view>
        <view class="form-group">
          <text class="form-label">供应商</text>
          <input class="form-input modern" placeholder="请输入供应商名称" value="{{partForm.supplier}}" data-field="supplier" bindinput="onPartFormInput"></input>
        </view>
        <view class="form-group">
          <text class="form-label">存放位置</text>
          <input class="form-input modern" placeholder="请输入存放位置" value="{{partForm.location}}" data-field="location" bindinput="onPartFormInput"></input>
        </view>
      </view>
    </scroll-view>
    <view class="popup-footer">
      <button class="popup-btn cancel" bindtap="closePartEditor">取消</button>
      <button class="popup-btn primary" bindtap="savePart">保存</button>
    </view>
  </view>
</view>

