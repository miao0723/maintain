  border-bottom: 1rpx solid var(--gray-100);
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--gray-700);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.form-required {
  color: var(--danger);
  margin-left: 6rpx;
}

.form-input {
  height: 76rpx;
  background: var(--gray-100);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--gray-800);
}

.form-role-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.form-role-opt {
  flex: 1 1 auto;
  min-width: 150rpx;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
  background: var(--gray-100);
  color: var(--gray-600);
  transition: all 0.2s;
}

.form-role-opt.active {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  color: #fff;
  font-weight: 600;
}

.form-role-readonly {
  padding: 18rpx 24rpx;
  font-size: 24rpx;
  color: var(--gray-500);
  background: var(--gray-100);
  border-radius: 16rpx;
  border: 1rpx dashed var(--gray-300);
}

.form-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid var(--gray-200);
}

.form-cancel-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--gray-100);
  color: var(--gray-700);
  border-radius: 20rpx;
  font-size: 28rpx;
  margin: 0;
}

.form-save-btn {
  flex: 2;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.25);
}

.form-cancel-btn::after,
.form-save-btn::after {
  border: none;
}


/* 弹窗分页 */
.popup-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid var(--gray-200);
}

/* 工单列表弹窗 */
.detail-popup {
  max-height: 90vh;
}

.detail-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gray-800);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.detail-row.full {
  flex-direction: column;
  align-items: flex-start;
}

.detail-label {
  font-size: 26rpx;
  color: var(--gray-500);
}

.detail-value {
  font-size: 26rpx;
  color: var(--gray-700);
}

.detail-value.order-id {
  font-weight: 500;
}

.detail-value.link {
  color: var(--primary);
}

.detail-value.highlight {
  color: var(--danger);
  font-weight: 600;
  font-size: 32rpx;
}

.detail-value.desc {
  margin-top: 8rpx;
  word-break: break-all;
}

/* 回收订单结构化描述卡片 */
.recycle-desc-cards {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recycle-desc-item {
  display: flex;
  background: #f0fdf4;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  border-left: 4rpx solid #10b981;
}

.recycle-desc-label {
  font-size: 24rpx;
  color: #065f46;
  font-weight: 500;
  white-space: nowrap;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.recycle-desc-value {
  font-size: 26rpx;
  color: #166534;
  font-weight: 600;
  line-height: 1.5;
}

/* 订单详情弹窗内 */
.order-item.compact {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.order-item.compact .order-header {
  padding: 12rpx 0;
  background: transparent;
  border-bottom: 1rpx solid var(--gray-100);
}

.order-no-sm {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gray-800);
}

.order-status-sm {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.order-body-compact {
  padding: 12rpx 0;
}

.oi-row {
  display: flex;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.oi-label {
  color: var(--gray-500);
  min-width: 80rpx;
}

.oi-value {
  color: var(--gray-700);
  flex: 1;
}

.oi-value.price {
  color: var(--danger);
  font-weight: 500;
}

.oi-value.time {
  color: var(--gray-400);
}

.order-actions-compact {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--gray-100);
}

.oa-btn {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.oa-btn.processing {
  background: var(--info);
  color: #fff;
}

.oa-btn.completed {
  background: var(--success);
  color: #fff;
}

.oa-btn.cancelled {
  background: var(--danger);
  color: #fff;
}

/* ==================== 确认弹窗 ==================== */
.confirm-dialog {
  position: relative;
  width: 580rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 44rpx 40rpx;
  margin: auto;
  box-shadow: 0 28rpx 80rpx rgba(17, 24, 39, 0.22);
  animation: confirmPop 0.26s cubic-bezier(0.22, 1, 0.36, 1);
  overflow: hidden;
}

/* 顶部类型装饰条 */
.confirm-dialog::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
}

.confirm-dialog--info::before {
  background: linear-gradient(135deg, #436f95, #6a9abb);
}

.confirm-dialog--success::before {
  background: linear-gradient(135deg, #10b981, #059669);
}

.confirm-dialog--danger::before {
  background: linear-gradient(135deg, #f43f5e, #ef4444);
}

@keyframes confirmPop {
  from {
    transform: scale(0.92) translateY(12rpx);
    opacity: 0;
  }
  to {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.confirm-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.16);
}

.confirm-icon-symbol {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
  color: #fff;
}

.confirm-icon--info {
  background: linear-gradient(135deg, #436f95, #6a9abb);
}

.confirm-icon--success {
  background: linear-gradient(135deg, #10b981, #059669);
}

.confirm-icon--danger {
  background: linear-gradient(135deg, #f43f5e, #ef4444);
}

.confirm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
  margin-bottom: 14rpx;
  letter-spacing: 0.5rpx;
}

.confirm-content {
  font-size: 27rpx;
  color: #6b7280;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.65;
  padding: 0 12rpx;
}

.confirm-actions {
  display: flex;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
}

.confirm-btn.cancel {
  background: #f3f4f6;
  color: #4b5563;
}

.confirm-btn.ok {
  background: linear-gradient(135deg, #436f95, #6a9abb);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.3);
}

.confirm-dialog--danger .confirm-btn.ok {
  background: linear-gradient(135deg, #f43f5e, #ef4444);
  box-shadow: 0 8rpx 20rpx rgba(239, 68, 68, 0.3);
}

.confirm-dialog--success .confirm-btn.ok {
  background: linear-gradient(135deg, #10b981, #059669);
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
}

.confirm-btn:active {
  transform: scale(0.96);
  opacity: 0.92;
}

.confirm-btn::after {
  border: none;
}

/* ==================== 加载中 ==================== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.loading-content {
  background: #fff;
  padding: 40rpx 60rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--gray-200);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: var(--gray-600);
  margin-top: 20rpx;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-500);
  text-align: center;
}

.empty-state.small {
  padding: 40rpx;
}

.empty-state.small .empty-icon {
  font-size: 48rpx;
}

.empty-state.small .empty-text {
  font-size: 24rpx;
}

/* ==================== 产品照片 ==================== */
.detail-images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-image-wrapper {
  width: calc(33.33% - 12rpx);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.detail-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.detail-image-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background: var(--gray-50);
  border-radius: 20rpx;
  border: 1rpx solid var(--gray-200);
}

.detail-image-tip .tip-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.detail-image-tip .tip-text {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.refresh-link {
  margin-top: 20rpx;
  color: var(--primary);
  font-size: 26rpx;
  background: transparent;
  border: 1rpx solid var(--primary);
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--gray-400);
  margin-top: 12rpx;
  text-align: center;
}

/* ==================== 表单样式 ==================== */

/* 表单容器 */
.form-section {
  padding: 24rpx;
}

/* 表单分栏 */
.form-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.form-row .form-group {
  flex: 1;
}

/* 表单组 */
.form-group {
  margin-bottom: 24rpx;
}

.form-group.half {
  flex: 1;
}

/* 表单标签 */
.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gray-700);
  margin-bottom: 12rpx;
}

.required {
  color: var(--danger);
  margin-left: 4rpx;
}

/* 表单输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--gray-800);
  background: #f8fafc;
  border: 2rpx solid var(--gray-200);
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.form-input:focus {
  background: #fff;
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(79, 70, 229, 0.1);
}

.form-input.modern {
  background: #fff;
  border-color: var(--gray-300);
}

.form-input.modern:focus {
  border-color: var(--primary);
}

/* 表单分组标题 */
.form-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0 16rpx;
  margin-bottom: 16rpx;
  border-bottom: 2rpx solid var(--gray-200);
}

.section-icon {
  font-size: 32rpx;
}

.section-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-800);
}

/* ==================== 弹窗底部按钮优化 ==================== */

.popup-footer {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 32rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid var(--gray-200);
  position: relative;
  z-index: 10;
}

.popup-footer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--gray-200) 20%,
    var(--gray-200) 80%,
    transparent 100%
  );
}

.popup-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 取消按钮 */
.popup-btn.cancel {
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  color: var(--gray-600);
  border: 2rpx solid var(--gray-200);
}

.popup-btn.cancel:active {
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 确认按钮 */
.popup-btn.primary {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.3);
}

.popup-btn.primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.2) 50%,
    transparent 100%
  );
  transition: left 0.5s ease;
}

.popup-btn.primary:active::before {
  left: 100%;
}

.popup-btn.primary:active {
  background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(79, 70, 229, 0.2);
}

/* 加载动画 */
.btn-loading {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 50%;
  animation: loading-bounce 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(1) {
  animation-delay: 0s;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes loading-bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.6;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ==================== 响应式调整 ==================== */
@media (max-width: 375px) {
  .stats-grid {
    gap: 12rpx;
  }

  .stat-card {
    padding: 20rpx;
  }

  .stat-value {
    font-size: 32rpx;
  }

  .stat-icon {
    font-size: 40rpx;
  }

  .order-stats {
    gap: 8rpx;
  }

  .stat-num {
    font-size: 32rpx;
  }
}

/* ==================== 价格编辑器样式 ==================== */
/* 价格输入框 */
.price-input-wrapper {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--gray-300);
  border-radius: 12rpx;
  padding: 0 24rpx;
  background: var(--gray-50);
}

.currency-symbol {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-800);
  margin-right: 12rpx;
}

.price-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  padding: 20rpx 0;
  color: var(--gray-800);
  background: transparent;
}

/* 价格参考信息 */
.price-reference {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: var(--gray-50);
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.ref-label {
  font-size: 26rpx;
  color: var(--gray-500);
}

.ref-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gray-800);
}

/* 价格差异显示 */
.price-diff-positive {
  color: var(--danger);
}

.price-diff-negative {
  color: var(--success);
}

.price-diff-zero {
  color: var(--gray-500);
}

/* 价格编辑按钮包装 */
.price-edit-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-btn {
  margin-left: 20rpx;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--primary);
  background: #fff;
  color: var(--primary);
  border-radius: 8rpx;
  transition: all 0.2s;
}

.edit-btn:active {
  background: var(--primary);
  color: #fff;
}

/* 订单详情弹窗增强样式 */
.detail-popup .detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--gray-100);
}

.detail-popup .detail-row:last-child {
  border-bottom: none;
}

.detail-popup .detail-label {
