  height: 68rpx;
  line-height: 68rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.25);
}

.popup-search-btn::after {
  border: none;
}

