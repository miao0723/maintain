}

/* ==================== 红点提醒 ==================== */
.tab-badge {
  position: absolute;
  top: 8rpx;
  right: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(239, 68, 68, 0.4);
  z-index: 10;
}

/* ==================== 进度申请管理 ==================== */

/* 统计卡片 */
.pa-stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pa-stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.pa-stat-card:active {
  transform: scale(0.96);
}

.pa-stat-card.pending { border-top: 6rpx solid #f59e0b; }
.pa-stat-card.approved { border-top: 6rpx solid #10b981; }
.pa-stat-card.rejected { border-top: 6rpx solid #ef4444; }

.pa-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.pa-stat-value.pending-value { color: #f59e0b; }
.pa-stat-value.approved-value { color: #10b981; }
.pa-stat-value.rejected-value { color: #ef4444; }

.pa-stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

/* 筛选标签 */
.pa-filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.pa-filter-tab {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 20rpx;
  transition: all 0.2s;
}

.pa-filter-tab.active {
  background: #436f95;
  color: #fff;
}

.pa-filter-tab:active:not(.active) {
  background: #e5e7eb;
}

/* 加载状态 */
.pa-loading-state, .pa-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.pa-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.pa-empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 申请列表 */
.pa-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pa-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.pa-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border-bottom: 1rpx solid #f3f4f6;
}

.pa-card-header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pa-apply-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.pa-apply-user {
  font-size: 22rpx;
  color: #6b7280;
}

.pa-status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.pa-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}

.pa-info-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pa-info-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.pa-info-value {
  font-size: 24rpx;
  color: #374151;
}

.pa-info-value.time {
  color: #9ca3af;
  font-size: 22rpx;
}

.pa-reason-box {
  margin: 0 24rpx 16rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.pa-reason-label {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 8rpx;
}

.pa-reason-text {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.5;
}

.pa-order-link {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f3f4f6;
  transition: all 0.2s;
}

.pa-order-link:active {
  background: #f9fafb;
}

.pa-link-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.pa-link-text {
  flex: 1;
  font-size: 24rpx;
  color: #436f95;
}

.pa-link-arrow {
  font-size: 32rpx;
  color: #9ca3af;
}

.pa-action-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f3f4f6;
}

.pa-action-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.pa-action-btn:active {
  transform: scale(0.96);
}

.pa-action-btn.approve {
  background: #d1fae5;
  color: #059669;
}

.pa-action-btn.reject {
  background: #fee2e2;
  color: #dc2626;
}

.pa-action-btn.detail {
  background: #f3f4f6;
  color: #374151;
}

.pa-approval-note {
  margin: 0 24rpx 16rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  border-left: 6rpx solid #10b981;
}

.pa-note-label {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 6rpx;
}

.pa-note-text {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.5;
}

.pa-loading-more, .pa-no-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* ==================== 申请处理弹窗 ==================== */
.pa-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.pa-modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  animation: paSlideUp 0.3s ease;
}

@keyframes paSlideUp {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.pa-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.pa-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.pa-modal-close {
  font-size: 48rpx;
  color: #9ca3af;
  padding: 8rpx;
  line-height: 1;
}

.pa-modal-body {
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.pa-modal-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.pa-modal-info-label {
  font-size: 26rpx;
  color: #374151;
}

.pa-form-group {
  margin-bottom: 20rpx;
}

.pa-form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
}

.pa-required {
  color: #ef4444;
}

.pa-form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #1f2937;
  background: #f9fafb;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
}

.pa-form-textarea:focus {
  border-color: #436f95;
  background: #fff;
}

.pa-modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e5e7eb;
}

.pa-modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.pa-modal-btn:active {
  transform: scale(0.97);
}

.pa-modal-btn.cancel {
  background: #f3f4f6;
  color: #6b7280;
}

.pa-modal-btn.primary {
  background: linear-gradient(135deg, #436f95, #6a9abb);
  color: #fff;
}

.pa-modal-btn.danger {
  background: #ef4444;
  color: #fff;
}

/* ==================== 报价弹窗 ==================== */
.quote-order-info {
  padding: 24rpx;
  background: var(--gray-50);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.quote-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.quote-info-label {
  font-size: 24rpx;
  color: var(--gray-500);
}

.quote-info-value {
  font-size: 26rpx;
  color: var(--gray-700);
  font-weight: 500;
}

.quote-section {
  margin-bottom: 28rpx;
}

.quote-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gray-800);
  margin-bottom: 16rpx;
  display: block;
}

.quote-desc-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--gray-800);
  background: var(--gray-50);
  border: 2rpx solid var(--gray-200);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.quote-desc-input:focus {
  border-color: var(--primary);
  background: #fff;
}

.quote-desc-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--gray-400);
  margin-top: 8rpx;
}

/* =================== 售后管理 =================== */
/* 统计卡片 - 已解决 */
.pa-stat-card.resolved {
  background: #d1fae5;
}

.pa-stat-value.resolved-value {
  color: #10b981;
}

/* 售后图片凭证 */
.as-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.as-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
}

.pa-note-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

/* ===================== 交易收入 ===================== */
.income {
  padding: 20rpx 24rpx 40rpx;
}

.income-scroll {
  margin-top: 20rpx;
  height: 68vh;
}

.income-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
  transition: background 0.15s, transform 0.05s;
}

.income-card:active {
  background: #f2f6fb;
  transform: scale(0.99);
}

.income-card-arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #cbd2dc;
  line-height: 1;
}

.income-card-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.income-order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.income-customer {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.income-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.income-card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.income-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #27ae60;
}

.income-status {
  margin-top: 8rpx;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

.income-status.paid {
  color: #27ae60;
  background: rgba(39, 174, 96, 0.12);
}

.income-status.partial {
  color: #f39c12;
  background: rgba(243, 156, 18, 0.12);
}

/* 支付渠道分布 */
.channel-list {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.channel-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.channel-item:last-child {
  border-bottom: none;
}

.channel-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.channel-amount {
  font-size: 26rpx;
  color: #27ae60;
  font-weight: 600;
}

/* 月度收入趋势 */
.trend-list {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 28rpx;
}

.trend-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.trend-month {
  width: 130rpx;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.trend-bar-wrap {
  flex: 1;
  height: 20rpx;
  background: #f0f2f5;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.trend-bar {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
  border-radius: 10rpx;
  min-width: 4rpx;
}

.trend-amount {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: #27ae60;
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 收入搜索 ===== */
.income-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 0 4rpx;
}

.income-search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f4f6fa;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 68rpx;
}

.income-search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.income-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  height: 68rpx;
  line-height: 68rpx;
}

.income-search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 0 8rpx;
}

.income-search-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #fff;
  background: #3498db;
  border-radius: 32rpx;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
}

/* ===== 收入趋势折线图 ===== */
.trend-chart-wrap {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}

.trend-canvas {
  width: 100%;
  height: 440rpx;
  display: block;
}

.trend-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.trend-legend-item {
  flex: 0 0 calc(33.33% - 8rpx);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #f7f9fc;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
}

.trend-legend-month {
  font-size: 22rpx;
  color: #8a94a6;
}

.trend-legend-amount {
  font-size: 24rpx;
  color: #2c3e50;
  font-weight: 600;
}
