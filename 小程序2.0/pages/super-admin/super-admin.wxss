  text-decoration: underline;
}

.detail-popup .detail-value.order-id {
  font-family: monospace;
  color: var(--danger);
  font-size: 24rpx;
}

.detail-popup .detail-row.full {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.detail-popup .detail-row.full .detail-label {
  width: 100%;
  margin-bottom: 10rpx;
}

/* 进度预览样式 */
.progress-preview {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-label {
  font-size: 26rpx;
  color: var(--gray-500);
}

.progress-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

/* 快速进度按钮 */
.quick-progress {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.quick-btn {
