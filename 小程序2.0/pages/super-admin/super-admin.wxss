  color: var(--gray-700);
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.detail-popup .detail-value.highlight {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary);
}

.detail-popup .detail-value.time {
  font-size: 24rpx;
  color: var(--gray-400);
}

.detail-popup .detail-value.desc {
  text-align: left;
  line-height: 1.6;
}

.detail-popup .detail-value.link {
