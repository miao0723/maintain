/* pages/super-admin/super-admin.wxss */
page {
  --primary: #436f95;
  --primary-light: #8fb8d4;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --info: #436f95;
  --gray-50: #f9fafb;
  --gray-100: #f3f4f6;
  --gray-200: #e5e7eb;
  --gray-300: #d1d5db;
  --gray-400: #9ca3af;
  --gray-500: #6b7280;
  --gray-600: #4b5563;
  --gray-700: #374151;
  --gray-800: #1f2937;
  --gray-900: #111827;
}

.container {
  min-height: 100vh;
  background: var(--gray-50);
}

/* 顶部导航 */
.header {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  padding: 0 24rpx 28rpx;
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.admin-card {
  display: flex;
  align-items: center;
  padding-top: 60rpx;
  position: relative;
  z-index: 1;
}

.admin-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  flex-shrink: 0;
}

.admin-meta {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.admin-name {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-role-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  gap: 20rpx;
}

.admin-role {
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(4rpx);
}

.admin-time {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.logout-btn {
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  backdrop-filter: blur(4rpx);
  flex-shrink: 0;
  transition: all 0.2s;
}

.logout-btn:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.95);
}

/* 页面切换标签（横向滑动） */
.tabs-wrapper {
  background: #fff;
  border-bottom: 1rpx solid var(--gray-200);
  position: relative;
}

.tabs {
  white-space: nowrap;
  width: 100%;
}

.tabs::-webkit-scrollbar {
  display: none;
}

.tabs-inner {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 0 8rpx;
}

/* 每个标签固定宽度，超出屏幕即可横向滑动（不再挤成一行） */
.tab {
  flex-shrink: 0;
  width: 156rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 8rpx;
  position: relative;
  transition: all 0.25s ease;
}

/* 左右渐隐遮罩：提示可滑动 */
.tabs-fade {
  position: absolute;
  top: 0;
  bottom: 12rpx;
  width: 64rpx;
  z-index: 5;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.tabs-fade.is-hidden {
  opacity: 0;
}

.tabs-fade-left {
  left: 0;
  background: linear-gradient(to right, #ffffff 35%, rgba(255, 255, 255, 0));
}

.tabs-fade-right {
  right: 0;
  background: linear-gradient(to left, #ffffff 35%, rgba(255, 255, 255, 0));
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 10rpx;
}

.fade-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--primary);
  font-weight: 700;
  animation: tabsArrow 1.3s ease-in-out infinite;
}

@keyframes tabsArrow {
  0%, 100% { transform: translateX(0); opacity: 0.55; }
  50% { transform: translateX(10rpx); opacity: 1; }
}

/* 底部滑动进度条，明确指示可滑动 */
.tabs-scrollbar {
  height: 6rpx;
  background: var(--gray-100);
  border-radius: 3rpx;
  margin: 0 24rpx 10rpx;
  overflow: hidden;
}

.tabs-scrollbar-thumb {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: 3rpx;
  transition: width 0.15s ease, margin-left 0.15s ease;
}

.tab .tab-icon-emoji {
  font-size: 44rpx;
  margin-bottom: 6rpx;
  transition: transform 0.25s ease;
}

.tab .tab-label {
  font-size: 22rpx;
  color: var(--gray-500);
  font-weight: 500;
  transition: all 0.25s ease;
}

.tab.active .tab-label {
  color: var(--primary);
  font-weight: 600;
}

.tab.active .tab-icon {
  transform: scale(1.1);
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: 3rpx;
}

.tab:active {
  background: var(--gray-50);
}

.service-tab .tab-icon,
.service-tab .tab-label {
  color: #436f95;
}

/* 内容区域 */
.content {
  padding: 24rpx;
}

/* 仪表盘 */
.dashboard {
}

.refresh-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.refresh-bar text {
  color: var(--gray-600);
  font-size: 26rpx;
}

.refresh-btn {
  background: #436f95;
  color: #ffffff;
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.refresh-btn:active {
  background: #3a6386;
  transform: scale(0.97);
}

.refresh-actions {
  display: flex;
  align-items: center;
}

.refresh-actions .refresh-btn {
  margin-left: 16rpx;
}

/* 核心数据卡片 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
}

.stat-card:nth-child(1)::before { background: var(--info); }
.stat-card:nth-child(2)::before { background: var(--warning); }
.stat-card:nth-child(3)::before { background: var(--primary); }
.stat-card:nth-child(4)::before { background: var(--success); }

.stat-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
}

.stat-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gray-800);
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--gray-500);
  margin-top: 4rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: var(--gray-400);
  margin-top: 8rpx;
}

/* 状态颜色 */
.warning-text { color: var(--warning); }
.success-text { color: var(--success); }
.info-text { color: var(--info); }

/* 区块样式 */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-800);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: var(--primary);
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.warning-title {
  color: var(--warning);
}

/* 订单状态分布 */
.order-stats {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.order-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: var(--gray-50);
  border-radius: 12rpx;
  transition: all 0.2s;
}

.order-stat-item:active {
  background: var(--gray-100);
  transform: scale(0.96);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gray-800);
}

.stat-text {
  font-size: 22rpx;
  color: var(--gray-500);
  margin-top: 8rpx;
}

.stat-num.pending { color: var(--warning); }
.stat-num.processing { color: var(--info); }
.stat-num.review { color: #436f95; }
.stat-num.completed { color: var(--success); }
.stat-num.cancelled { color: var(--danger); }

/* 收入统计 */
.revenue-stats {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.revenue-stat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--gray-50);
  border-radius: 12rpx;
  transition: all 0.2s;
}

.revenue-stat-item:active {
  background: var(--gray-100);
}

.revenue-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.revenue-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.revenue-label {
  font-size: 26rpx;
  color: var(--gray-600);
}

.revenue-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--success);
}

.revenue-value.highlight {
  color: var(--primary);
}

/* 库存预警 */
.warning-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fffbeb;
  border-radius: 12rpx;
  border: 1rpx solid #fcd34d;
}

.warning-tip text {
  font-size: 26rpx;
  color: #92400e;
  flex: 1;
}

.go-btn {
  background: var(--warning);
  color: #fff;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-left: 16rpx;
}

/* 最近工单 */
.recent-orders {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--gray-50);
  border-radius: 12rpx;
  transition: all 0.2s;
}

.recent-order-item:active {
  background: var(--gray-100);
}

.ro-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.ro-device {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gray-800);
}

.ro-customer {
  font-size: 24rpx;
  color: var(--gray-500);
  margin-top: 4rpx;
}

.ro-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.ro-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--danger);
}

.ro-status {
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 最近用户 */
.recent-users {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-user-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: var(--gray-50);
  border-radius: 12rpx;
}

.ru-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.ru-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ru-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gray-800);
}

.ru-time {
  font-size: 22rpx;
  color: var(--gray-400);
  margin-top: 4rpx;
}

.ru-role {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.ru-role.super_admin {
  background: #e8f1f8;
  color: #436f95;
}

.ru-role.admin {
  background: #dbeafe;
  color: #2563eb;
}

.ru-role.user {
  background: var(--gray-100);
  color: var(--gray-600);
}

/* ==================== 工单管理 ==================== */
.orders {
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--gray-50);
  border-radius: 24rpx;
  padding: 0 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  background: transparent;
}

.search-clear {
  font-size: 32rpx;
  color: var(--gray-400);
  padding: 8rpx;
}

.search-btn {
  background: var(--primary);
  color: #fff;
  padding: 0 32rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-scroll {
  white-space: nowrap;
  width: 100%;
}

.filter-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--gray-600);
  background: var(--gray-100);
  border-radius: 20rpx;
  margin-right: 12rpx;
  transition: all 0.2s;
}

.filter-chip.active {
  background: var(--primary);
  color: #fff;
}

.filter-chip:active:not(.active) {
  background: var(--gray-200);
}

.filter-chip.internal-chip.active {
  background: #f59e0b;
  color: #fff;
}

.type-filter .filter-chip {
  margin-right: 16rpx;
}

.type-chip {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
}

.result-tip {
  padding: 16rpx 0;
  text-align: center;
}

.result-tip text {
  font-size: 24rpx;
  color: var(--gray-500);
}

/* 工单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--gray-50);
  border-bottom: 1rpx solid var(--gray-100);
}

.oh-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-no {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gray-800);
}

.order-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: var(--primary-light);
  color: #fff;
  border-radius: 8rpx;
}

.order-status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.order-body {
  padding: 20rpx 24rpx;
}

.order-info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.order-info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 24rpx;
  color: var(--gray-500);
  min-width: 80rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--gray-700);
  flex: 1;
}

.info-value.desc {
  flex: 1;
  word-break: break-all;
}

.info-value.price {
  color: var(--danger);
  font-weight: 600;
}

.info-phone {
  color: var(--primary);
  font-size: 24rpx;
  margin-left: 16rpx;
}

.info-time {
  font-size: 22rpx;
  color: var(--gray-400);
  margin-left: auto;
}

.order-footer {
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--gray-100);
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.action-btn {
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: var(--gray-100);
  color: var(--gray-700);
}

.action-btn.primary {
  background: var(--primary);
  color: #fff;
}

.action-btn.success {
  background: var(--success);
  color: #fff;
}

.action-btn.danger {
  background: var(--danger);
  color: #fff;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 0;
}

.page-btn {
  background: #fff;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 24rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  margin: 0;
}

.page-btn::after {
  border: none;
}

.page-btn.disabled {
  opacity: 0.4;
  border-color: var(--gray-300);
  color: var(--gray-400);
}

.page-btn:not(.disabled):active {
  background: var(--primary);
  color: #fff;
}

.page-info {
  font-size: 26rpx;
  color: var(--gray-600);
}

/* ==================== 设备统计 ==================== */
.device-stats {
}

/* 今日工单 */
.today-stats {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.today-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--gray-50);
  border-radius: 12rpx;
}

.ts-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--gray-800);
}

.ts-label {
  font-size: 22rpx;
  color: var(--gray-500);
  margin-top: 8rpx;
}

.ts-num.pending { color: var(--warning); }
.ts-num.processing { color: var(--info); }
.ts-num.completed { color: var(--success); }

/* 本月统计 */
.month-stats {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ms-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--gray-50);
  border-radius: 12rpx;
}

.ms-label {
  font-size: 26rpx;
  color: var(--gray-600);
}

.ms-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-800);
}

.ms-value.highlight {
  color: var(--primary);
}

/* 设备类型分布 */
.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-item {
  background: var(--gray-50);
  border-radius: 12rpx;
  padding: 20rpx;
}

.device-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.device-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gray-800);
}

.device-total {
  font-size: 24rpx;
  color: var(--gray-500);
}

.device-bar {
  display: flex;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.bar-segment {
  height: 100%;
  transition: width 0.3s;
}

.bar-segment.pending { background: var(--warning); }
.bar-segment.processing { background: var(--info); }
.bar-segment.completed { background: var(--success); }
.bar-segment.cancelled { background: var(--danger); }

.device-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dd-item {
  font-size: 22rpx;
