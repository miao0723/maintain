<!--pages/mine/mine.wxml-->
<view class="page-container">
  <view class="page-refresh-tip" wx:if="{{summaryLoading || recentOrdersLoading || menuCountsLoading}}">
    <text class="page-refresh-text">页面数据正在静默更新</text>
  </view>

  <!-- 报价通知横幅（受通知设置控制） -->
  <view class="quote-notification" wx:if="{{quotedCount > 0}}" bindtap="goToUnreadQuotedOrders">
    <view class="notification-content">
      <view class="notification-icon-wrap">
        <text class="notification-icon">💰</text>
        <view class="notification-dot"></view>
      </view>
      <view class="notification-text-wrap">
        <text class="notification-title">您有 {{quotedCount}} 个报价待确认</text>
        <text class="notification-subtitle">点击前往待确认报价</text>
      </view>
      <view class="notification-arrow">
        <text class="arrow-text">›</text>
      </view>
    </view>
  </view>

  <!-- 进度更新通知横幅（受通知设置控制） -->
  <view class="progress-notification" wx:if="{{progressUnreadCount > 0}}" bindtap="goToProgressOrders">
    <view class="notification-content">
      <view class="notification-icon-wrap">
        <text class="notification-icon">🔧</text>
        <view class="notification-dot"></view>
      </view>
      <view class="notification-text-wrap">
        <text class="notification-title">您有 {{progressUnreadCount}} 个订单已返回进度</text>
        <text class="notification-subtitle">点击查看维修进度</text>
      </view>
      <view class="notification-arrow">
        <text class="arrow-text">›</text>
      </view>
    </view>
  </view>

  <!-- 用户信息头部 -->
  <view class="user-header" bindtap="editProfile">
    <view class="user-avatar-section">
      <view class="avatar-container">
        <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        <view class="avatar-shine"></view>
      </view>
      <view class="edit-badge">
        <text class="badge-icon">✎</text>
      </view>
    </view>
    <view class="user-info">
      <view class="user-name-row">
        <text class="user-name">{{userInfo.nickName}}</text>
        <!-- 角色以「中文 / 英文」标识映射展示 -->
        <view class="role-tag role-{{roleTheme}}" wx:if="{{roleText}}">
          <text class="role-icon">{{roleIcon}}</text>
          <text class="role-text">{{roleText}}</text>
        </view>
      </view>
      <text class="user-idline">维修进度、报价确认、账号资料统一在这里处理</text>
      <!-- 手机号中间四位掩码，保护隐私 -->
      <view class="user-phone-row" wx:if="{{hasPhone}}">
        <text class="phone-icon">📱</text>
        <text class="user-phone">{{maskedPhone}}</text>
        <text class="phone-mask-tip">已脱敏</text>
      </view>
      <view class="user-stats">
        <view class="stat-item">
          <text class="stat-icon">📋</text>
          <text class="stat-text">{{summaryLoading ? '加载中' : (orderCount.pending + orderCount.processing) + ' 待处理'}}</text>
        </view>
        <view class="stat-item quoted-stat" wx:if="{{quotedCount > 0}}" bindtap="goToQuotedOrders">
          <text class="stat-icon">💰</text>
          <text class="stat-text">{{quotedCount}} 待确认报价</text>
        </view>
        <view class="stat-item" wx:if="{{orderCount.review > 0}}">
          <text class="stat-icon">⭐</text>
          <text class="stat-text">{{orderCount.review}} 待评价</text>
        </view>
      </view>
      <text class="user-desc">点击编辑个人信息</text>
    </view>
    <view class="header-arrow">
      <text class="arrow-icon">></text>
    </view>
  </view>

  <view class="overview-panel">
    <view class="overview-strip">
      <view class="mini-overview primary" bindtap="goToOrders">
        <text class="mini-overview-label">全部订单</text>
        <text class="mini-overview-value {{summaryLoading ? 'is-loading' : ''}}">{{summaryLoading ? '--' : orderCount.pending + orderCount.processing + orderCount.completed + orderCount.review + quotedCount}}</text>
      </view>
      <view class="mini-overview warning" bindtap="goToOrders" data-status="pending">
        <text class="mini-overview-label">待处理</text>
        <text class="mini-overview-value {{summaryLoading ? 'is-loading' : ''}}">{{summaryLoading ? '--' : orderCount.pending}}</text>
      </view>
      <view class="mini-overview quote" bindtap="goToQuotedOrders">
        <text class="mini-overview-label">待确认报价</text>
        <text class="mini-overview-value">{{quotedCount}}</text>
      </view>
      <view class="mini-overview info" bindtap="goToProgressOrders">
        <text class="mini-overview-label">进度提醒</text>
        <text class="mini-overview-value">{{progressUnreadCount}}</text>
      </view>
      <view class="mini-overview success" bindtap="goToOrders" data-status="review">
        <text class="mini-overview-label">待评价</text>
        <text class="mini-overview-value {{summaryLoading ? 'is-loading' : ''}}">{{summaryLoading ? '--' : orderCount.review}}</text>
      </view>
    </view>
  </view>

  <!-- 订单管理 -->
  <view class="section order-section">
    <view class="section-header" bindtap="goToOrders">
      <view class="section-title-wrap">
        <text class="section-title">我的订单</text>
        <text class="section-subtitle">按状态快速进入对应订单</text>
      </view>
        <view class="section-more">
        <text class="order-total">{{summaryLoading ? '订单更新中' : '共' + (orderCount.pending + orderCount.processing + orderCount.completed + orderCount.review + quotedCount) + '单'}}</text>
        <text class="more-text">全部订单</text>
        <text class="more-arrow">></text>
      </view>
    </view>
    <view class="order-types">
      <view class="order-type-item pending-card" bindtap="goToOrders" data-status="pending">
        <view class="order-icon">📋</view>
        <text class="order-name">待处理</text>
        <view class="order-badge unread-badge" wx:if="{{statusBadges.pending > 0}}">{{statusBadges.pending}}</view>
      </view>
      <view class="order-type-item quoted-entry" bindtap="goToQuotedOrders">
        <view class="order-icon quoted-icon">💰</view>
        <text class="order-name">待确认</text>
        <view class="order-badge unread-badge" wx:if="{{statusBadges.quoted > 0}}">{{statusBadges.quoted}}</view>
      </view>
      <view class="order-type-item processing-card" bindtap="goToOrders" data-status="processing">
        <view class="order-icon">🔧</view>
        <text class="order-name">维修中</text>
        <view class="order-badge unread-badge" wx:if="{{statusBadges.processing > 0}}">{{statusBadges.processing}}</view>
      </view>
      <view class="order-type-item completed-card" bindtap="goToOrders" data-status="completed">
        <view class="order-icon">✅</view>
        <text class="order-name">已完成</text>
        <view class="order-badge unread-badge" wx:if="{{statusBadges.completed > 0}}">{{statusBadges.completed}}</view>
      </view>
      <view class="order-type-item review-card" bindtap="goToOrders" data-status="review">
        <view class="order-icon">⭐</view>
        <text class="order-name">待评价</text>
        <view class="order-badge unread-badge" wx:if="{{statusBadges.review > 0}}">{{statusBadges.review}}</view>
      </view>
    </view>

    <!-- 进度反馈动态通知卡片 -->
    <view class="progress-feed-card" wx:if="{{progressFeed.length > 0}}">
      <view class="feed-header">
        <view class="feed-header-left">
          <text class="feed-header-icon">📷</text>
          <text class="feed-header-title">进度动态</text>
          <view class="feed-count-pill">{{progressFeedTotal}} 条新反馈</view>
        </view>
        <text class="feed-read-all" bindtap="markAllProgressRead">全部已读</text>
      </view>
      <view class="feed-list">
        <view class="feed-item" wx:for="{{progressFeed}}" wx:key="order_id"
              data-order-id="{{item.order_id}}" data-feedback-at="{{item.feedback_at}}"
              bindtap="goToProgressDetail">
          <view class="feed-thumb">
            <image wx:if="{{item.thumbUrl}}" class="feed-thumb-img" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load="true"></image>
            <text wx:else class="feed-thumb-fallback">📷</text>
          </view>
          <view class="feed-body">
            <view class="feed-line1">
              <text class="feed-order-no">订单 #{{item.order_no}}</text>
              <text class="feed-status-tag">{{item.status_label}}</text>
            </view>
            <view class="feed-line2">
              <text class="feed-text">{{item.feedback_text}}</text>
            </view>
          </view>
          <view class="feed-meta">
            <view class="feed-unread-dot" wx:if="{{item.is_unread}}"></view>
            <text class="feed-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 最近订单 -->
    <view class="recent-orders recent-skeleton" wx:if="{{recentOrdersLoading && recentOrders.length === 0}}">
      <view class="recent-title">
        <text class="recent-title-icon">📋</text>
        <text class="recent-title-text">最近订单</text>
        <text class="recent-title-count">正在加载</text>
      </view>
      <scroll-view class="orders-scroll" scroll-x="true" enhanced show-scrollbar="{{false}}">
        <view class="orders-list">
          <view class="order-card skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
            <view class="skeleton-line skeleton-line-sm"></view>
            <view class="skeleton-body">
              <view class="skeleton-avatar"></view>
              <view class="skeleton-copy">
                <view class="skeleton-line skeleton-line-lg"></view>
                <view class="skeleton-line skeleton-line-md"></view>
              </view>
            </view>
            <view class="skeleton-line skeleton-line-md bottom"></view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="recent-orders" wx:if="{{recentOrders.length > 0}}">
      <view class="recent-title">
        <text class="recent-title-icon">📋</text>
        <text class="recent-title-text">最近订单</text>
        <text class="recent-title-count">共 {{recentOrders.length}} 单</text>
      </view>
      <scroll-view class="orders-scroll" scroll-x="true" enhanced show-scrollbar="{{false}}">
        <view class="orders-list">
          <view class="order-card" wx:for="{{recentOrders}}" wx:key="index" data-order-id="{{item.orderId}}" bindtap="viewOrderDetail">
            <!-- 卡片顶部：服务类型标签 + 状态 -->
            <view class="card-header">
              <view class="service-type-tag {{item.orderType}}">
                <text class="tag-text">{{item.orderTypeText}}</text>
              </view>
              <view class="status-indicator status-{{item.status}}">
                <text class="status-dot"></text>
                <text class="status-label">{{item.statusLabel}}</text>
              </view>
            </view>

            <!-- 卡片主体：设备信息 -->
            <view class="card-body">
              <view class="device-icon-wrap {{item.orderType}}">
                <text class="device-icon">{{item.deviceIcon}}</text>
              </view>
              <view class="device-info">
                <text class="device-name">{{item.deviceTypeName}}<text wx:if="{{item.brandName}}"> · {{item.brandName}}</text></text>
                <text class="problem-desc">{{item.problemDescription.length > 10 ? item.problemDescription.substring(0, 10) + '...' : item.problemDescription}}</text>
              </view>
            </view>

            <!-- 卡片底部：时间 + 订单金额 -->
            <view class="card-footer">
              <view class="footer-left">
                <text class="order-date">{{item.createdAtShort}}</text>
                <text class="footer-divider">|</text>
                <text class="price-label" wx:if="{{item.hasPrice}}">
                  <text class="price-prefix">订单金额</text>
                  <text class="price-symbol">¥</text>
                  <text class="price-value">{{item.price}}</text>
                </text>
                <text class="price-label pending-price" wx:else>订单金额待定</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="recent-empty" wx:else>
      <text class="recent-empty-icon">📦</text>
      <text class="recent-empty-title">还没有最近订单</text>
      <text class="recent-empty-desc">提交维修或回收订单后，会在这里显示最近记录</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="section">
    <view class="section-inline-title">常用管理</view>
    <!-- 地址管理 -->
    <view class="menu-item" bindtap="goToAddress">
      <view class="menu-item-left">
        <text class="menu-icon">📍</text>
        <text class="menu-title">地址管理</text>
      </view>
      <view class="menu-item-right">
        <view class="count-badge address-badge {{menuCountsLoading ? 'count-badge-loading' : ''}}">{{menuCountsLoading ? '--' : addressCount}}</view>
        <text class="menu-desc">个地址</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 单位管理 -->
    <view class="menu-item" bindtap="goToUnits">
      <view class="menu-item-left">
        <text class="menu-icon">🏢</text>
        <text class="menu-title">单位管理</text>
      </view>
      <view class="menu-item-right">
        <view class="count-badge unit-badge {{menuCountsLoading ? 'count-badge-loading' : ''}}">{{menuCountsLoading ? '--' : unitCount}}</view>
        <text class="menu-desc">个单位</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 设备管理 -->
    <view class="menu-item" bindtap="goToDevices">
      <view class="menu-item-left">
        <text class="menu-icon">🖥️</text>
        <text class="menu-title">设备管理</text>
      </view>
      <view class="menu-item-right">
        <view class="count-badge device-badge {{menuCountsLoading ? 'count-badge-loading' : ''}}">{{menuCountsLoading ? '--' : deviceCount}}</view>
        <text class="menu-desc">台设备</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 消息订阅（在设置中管理通知开关） -->
    <view class="menu-item" bindtap="showSettings">
      <view class="menu-item-left">
        <text class="menu-icon">🔔</text>
        <text class="menu-title">消息订阅</text>
      </view>
      <view class="menu-item-right">
        <text class="menu-desc">{{settings.orderNotify || settings.progressNotify || settings.quoteNotify ? '已订阅' : '未订阅'}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 其他功能 -->
  <view class="section">
    <view class="section-inline-title">服务与设置</view>

    <!-- 内部人员免付款维修申请入口 -->
    <view class="menu-item internal-entry" wx:if="{{isInternal}}" bindtap="goToInternalRepair">
      <view class="menu-item-left">
        <text class="menu-icon internal-icon">🏢</text>
        <view class="menu-title-wrap">
          <text class="menu-title">内部维修申请</text>
          <text class="menu-subtitle">填写信息即可申请，无需支付</text>
        </view>
      </view>
      <view class="menu-item-right">
        <view class="menu-corner-badge" wx:if="{{internalPending > 0}}">{{internalPending}}</view>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 内部人员免付款回收申请入口 -->
    <view class="menu-item internal-entry" wx:if="{{isInternal}}" bindtap="goToInternalRecycle">
      <view class="menu-item-left">
        <text class="menu-icon internal-icon">♻️</text>
        <view class="menu-title-wrap">
          <text class="menu-title">内部回收申请</text>
          <text class="menu-subtitle">闲置设备内部回收，无需支付</text>
        </view>
      </view>
      <view class="menu-item-right">
        <view class="menu-corner-badge" wx:if="{{internalPending > 0}}">{{internalPending}}</view>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="menu-item" bindtap="goToProgressApply">
      <view class="menu-item-left">
        <text class="menu-icon icon-progress">📝</text>
        <text class="menu-title">进度申请</text>
      </view>
      <view class="menu-item-right">
        <text class="menu-desc">查看我的申请</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
    <view class="menu-item" bindtap="goToService">
      <view class="menu-item-left">
        <text class="menu-icon icon-service">💬</text>
        <text class="menu-title">联系客服</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="showAbout">
      <view class="menu-item-left">
        <text class="menu-icon icon-about">ℹ️</text>
        <text class="menu-title">关于我们</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="showFeedback">
      <view class="menu-item-left">
        <text class="menu-icon icon-feedback">📝</text>
        <text class="menu-title">意见反馈</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="showSettings">
      <view class="menu-item-left">
        <text class="menu-icon icon-settings">⚙️</text>
        <text class="menu-title">设置</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <!-- 超级管理员入口 -->
    <view class="menu-item admin-entry" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="menu-item-left">
        <text class="menu-icon admin-icon">👑</text>
        <text class="menu-title admin-title">超级管理员</text>
      </view>
      <text class="menu-arrow admin-arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>

  <!-- 设置弹窗 -->
  <view class="settings-mask" wx:if="{{showSettingsPanel}}" bindtap="closeSettings" catchmove>
    <view class="settings-panel {{showSettingsPanel ? 'slide-up' : ''}}" catchtap>
      <!-- 弹窗头部 -->
      <view class="settings-header">
        <text class="settings-title">设置</text>
        <view class="settings-close" bindtap="closeSettings">
          <text class="close-icon">✕</text>
        </view>
      </view>

      <scroll-view class="settings-body" scroll-y>
        <!-- 通知设置 -->
        <view class="settings-group">
          <view class="settings-group-title">通知设置</view>
          <view class="settings-item-tip">开启后自动请求微信消息订阅，关闭后不再显示对应通知</view>
          <view class="settings-item">
            <view class="settings-item-left">
              <text class="settings-item-icon">📦</text>
              <view class="settings-item-text">
                <text class="settings-item-title">订单通知</text>
                <text class="settings-item-desc">接收订单状态变更推送</text>
              </view>
            </view>
            <switch class="settings-switch" checked="{{settings.orderNotify}}" bindchange="toggleOrderNotify" color="#4f6b84"/>
          </view>
          <view class="settings-item">
            <view class="settings-item-left">
              <text class="settings-item-icon">🔧</text>
              <view class="settings-item-text">
                <text class="settings-item-title">维修进度通知</text>
                <text class="settings-item-desc">接收维修进度更新推送</text>
              </view>
            </view>
            <switch class="settings-switch" checked="{{settings.progressNotify}}" bindchange="toggleProgressNotify" color="#4f6b84"/>
          </view>
          <view class="settings-item">
            <view class="settings-item-left">
              <text class="settings-item-icon">💰</text>
              <view class="settings-item-text">
                <text class="settings-item-title">报价通知</text>
                <text class="settings-item-desc">接收维修报价通知推送</text>
              </view>
            </view>
            <switch class="settings-switch" checked="{{settings.quoteNotify}}" bindchange="toggleQuoteNotify" color="#4f6b84"/>
          </view>
        </view>

        <!-- 通用设置 -->
        <view class="settings-group">
          <view class="settings-group-title">通用</view>
          <view class="settings-item" bindtap="clearCache">
            <view class="settings-item-left">
              <text class="settings-item-icon">🗑️</text>
              <view class="settings-item-text">
                <text class="settings-item-title">清除缓存</text>
                <text class="settings-item-desc">当前缓存 {{cacheSize}}</text>
              </view>
            </view>
            <text class="settings-arrow">></text>
          </view>
        </view>

        <!-- 关于与隐私 -->
        <view class="settings-group">
          <view class="settings-group-title">关于与隐私</view>
          <view class="settings-item" bindtap="goToAgreement" data-type="user">
            <view class="settings-item-left">
              <text class="settings-item-icon">📄</text>
              <view class="settings-item-text">
                <text class="settings-item-title">用户协议</text>
                <text class="settings-item-desc">服务条款与双方权利义务</text>
              </view>
            </view>
            <text class="settings-arrow">></text>
          </view>
          <view class="settings-item" bindtap="goToAgreement" data-type="privacy">
            <view class="settings-item-left">
              <text class="settings-item-icon">🔒</text>
              <view class="settings-item-text">
                <text class="settings-item-title">隐私政策</text>
                <text class="settings-item-desc">信息收集、使用与保护规则</text>
              </view>
            </view>
            <text class="settings-arrow">></text>
          </view>
          <view class="settings-item" bindtap="goToAgreement" data-type="cancel">
            <view class="settings-item-left">
              <text class="settings-item-icon">📕</text>
              <view class="settings-item-text">
                <text class="settings-item-title">账号注销协议</text>
                <text class="settings-item-desc">注销条件、后果与数据处理</text>
              </view>
            </view>
            <text class="settings-arrow">></text>
          </view>
          <view class="settings-item">
            <view class="settings-item-left">
              <text class="settings-item-icon">📱</text>
              <view class="settings-item-text">
                <text class="settings-item-title">当前版本</text>
              </view>
            </view>
            <text class="settings-value">v1.0.0</text>
          </view>
        </view>

        <!-- 账号安全 -->
        <view class="settings-group">
          <view class="settings-group-title">账号安全</view>
          <view class="settings-item" bindtap="showDeleteAccountConfirm">
            <view class="settings-item-left">
              <text class="settings-item-icon">⚠️</text>
              <view class="settings-item-text">
                <text class="settings-item-title danger-text">注销账号</text>
