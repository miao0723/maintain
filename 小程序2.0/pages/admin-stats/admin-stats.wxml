<!--pages/admin-stats/admin-stats.wxml-->
<view class="page-container">
  <view class="page-head">
    <view class="head-title">数据统计</view>
    <view class="refresh" bindtap="loadStats">刷新</view>
  </view>

  <!-- 收入卡片 -->
  <view class="card">
    <view class="card-title">收入概览</view>
    <view class="grid-2">
      <view class="stat-cell">
        <text class="stat-value">¥{{revenue.total_revenue || 0}}</text>
        <text class="stat-label">累计收入</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value">¥{{revenue.monthly_revenue || 0}}</text>
        <text class="stat-label">近30天</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value">¥{{revenue.weekly_revenue || 0}}</text>
        <text class="stat-label">近7天</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value">¥{{revenue.daily_revenue || 0}}</text>
        <text class="stat-label">今日</text>
      </view>
    </view>
  </view>

  <!-- 订单统计 -->
  <view class="card">
    <view class="card-title">订单统计</view>
    <view class="grid-3">
      <view class="stat-cell"><text class="stat-value">{{orders.total_orders || 0}}</text><text class="stat-label">总订单</text></view>
      <view class="stat-cell"><text class="stat-value warn">{{orders.pending_orders || 0}}</text><text class="stat-label">待处理</text></view>
      <view class="stat-cell"><text class="stat-value">{{orders.processing_orders || 0}}</text><text class="stat-label">维修中</text></view>
      <view class="stat-cell"><text class="stat-value ok">{{orders.completed_orders || 0}}</text><text class="stat-label">已完成</text></view>
      <view class="stat-cell"><text class="stat-value">{{orders.review_orders || 0}}</text><text class="stat-label">待评价</text></view>
      <view class="stat-cell"><text class="stat-value">{{orders.cancelled_orders || 0}}</text><text class="stat-label">已取消</text></view>
    </view>
  </view>

  <!-- 用户统计 -->
  <view class="card">
    <view class="card-title">用户统计</view>
    <view class="grid-3">
      <view class="stat-cell"><text class="stat-value">{{users.total_users || 0}}</text><text class="stat-label">总用户</text></view>
      <view class="stat-cell"><text class="stat-value">{{users.admin_users || 0}}</text><text class="stat-label">管理员</text></view>
      <view class="stat-cell"><text class="stat-value">{{users.super_admin_users || 0}}</text><text class="stat-label">超管</text></view>
      <view class="stat-cell"><text class="stat-value">{{users.new_users_week || 0}}</text><text class="stat-label">本周新增</text></view>
      <view class="stat-cell"><text class="stat-value">{{users.active_users_day || 0}}</text><text class="stat-label">今日活跃</text></view>
      <view class="stat-cell"><text class="stat-value">{{users.normal_users || 0}}</text><text class="stat-label">普通用户</text></view>
    </view>
  </view>

  <!-- 备件库存 -->
  <view class="card">
    <view class="card-title">备件库存</view>
    <view class="grid-3">
      <view class="stat-cell"><text class="stat-value">{{parts.total_parts || 0}}</text><text class="stat-label">种类</text></view>
      <view class="stat-cell"><text class="stat-value warn">{{parts.low_stock_parts || 0}}</text><text class="stat-label">低位预警</text></view>
      <view class="stat-cell"><text class="stat-value">¥{{parts.total_value || 0}}</text><text class="stat-label">库存价值</text></view>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="card">
    <view class="card-title">最近订单</view>
    <view class="order-item" wx:for="{{recentOrders}}" wx:key="id">
      <view class="order-main">
        <text class="order-no">#{{item.order_id || item.id}}</text>
        <text class="order-dev">{{item.device_type}} {{item.device_model}}</text>
      </view>
      <view class="order-right">
        <text class="order-status">{{item.statusLabel}}</text>
        <text class="order-price">¥{{item.price}}</text>
      </view>
    </view>
    <view class="empty-text" wx:if="{{recentOrders.length===0}}">暂无订单</view>
  </view>
</view>
<confirm-modal id="confirmModal" />
