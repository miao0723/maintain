<!--pages/address-edit/address-edit.wxml-->
<view class="page-container">
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input
        class="form-input"
        type="text"
        placeholder="请输入联系人姓名"
        value="{{formData.contactName}}"
        bindinput="onInput"
        data-field="contactName"
        maxlength="10"/>
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入手机号"
        value="{{formData.contactPhone}}"
        bindinput="onInput"
        data-field="contactPhone"
        maxlength="11"/>
    </view>

    <view class="form-item" bindtap="chooseRegion">
      <text class="form-label">所在地区</text>
      <picker
        mode="region"
        value="{{regionValue}}"
        bindchange="onRegionChange">
        <view class="region-selector">
          <text class="region-text {{regionText ? '' : 'placeholder'}}">
            {{regionText || '请选择省/市/区'}}
          </text>
          <text class="region-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 地图选择位置 -->
    <view class="form-item map-picker-btn" bindtap="openMapPicker">
      <text class="form-label">地图选点</text>
      <view class="map-picker-content">
        <text class="map-icon">📍</text>
        <text class="map-text">{{formattedAddress || '点击在地图上选择位置'}}</text>
        <text class="map-arrow">></text>
      </view>
    </view>

    <view class="form-item" wx:if="{{locationAccuracy}}">
      <text class="form-label">定位状态</text>
      <view class="region-selector">
        <text class="region-text">{{locationAccuracy}}</text>
        <text class="region-arrow" bindtap="openLocationSettings">授权</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">详细地址</text>
      <textarea
        class="form-textarea"
        placeholder="请输入详细地址信息，如街道、楼栋号、门牌号等"
        value="{{formData.detail}}"
        bindinput="onInput"
        data-field="detail"
        maxlength="100"/>
      <text class="char-count">{{formData.detail.length}}/100</text>
    </view>

    <view class="form-item">
      <text class="form-label">邮政编码</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入邮政编码（选填）"
        value="{{formData.postalCode}}"
        bindinput="onInput"
        data-field="postalCode"
        maxlength="6"/>
    </view>
  </view>

  <!-- 地址标签 -->
  <view class="form-section">
    <view class="section-title">地址标签</view>
    <view class="tags-container">
      <view
        class="tag-option {{selectedTags.includes('家') ? 'active' : ''}}"
        bindtap="toggleTag"
        data-tag="家">
        <text class="tag-text">家</text>
      </view>
      <view
        class="tag-option {{selectedTags.includes('公司') ? 'active' : ''}}"
        bindtap="toggleTag"
        data-tag="公司">
        <text class="tag-text">公司</text>
      </view>
      <view
        class="tag-option {{selectedTags.includes('学校') ? 'active' : ''}}"
        bindtap="toggleTag"
        data-tag="学校">
        <text class="tag-text">学校</text>
      </view>
    </view>
  </view>

  <!-- 设为默认 -->
  <view class="form-section">
    <view class="default-option" bindtap="toggleDefault">
      <view class="default-left">
        <text class="default-icon {{formData.isDefault ? 'checked' : ''}}">✓</text>
        <text class="default-text">设为默认地址</text>
      </view>
      <view class="default-switch {{formData.isDefault ? 'active' : ''}}">
        <view class="switch-dot"></view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-action">
    <button class="save-btn" bindtap="saveAddress" disabled="{{saving}}" loading="{{saving}}">保存地址</button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>
</view>
