/* pages/order-detail/order-detail.wxss */

.container {
  min-height: 100vh;
  background: #f4f6f9;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* ====== 加载 / 错误状态 ====== */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}
.error-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.error-text { font-size: 28rpx; color: #999; margin-bottom: 30rpx; }
.retry-btn {
  background: #436f95;
  color: #fff;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #436f95;
  border-radius: 50%;
  animation: spin .8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #999; }

/* ====== 头部 ====== */
.header {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  padding: 36rpx 30rpx 30rpx;
  color: #fff;
}
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.order-no-row {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.order-no-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-right: 12rpx;
}
.order-no-value {
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 12rpx;
}
.copy-icon {
  font-size: 20rpx;
  opacity: 0.6;
  border: 1rpx solid rgba(255,255,255,0.4);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}
.status-badge {
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  white-space: nowrap;
}
.header-bottom {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.header-tag {
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.priority-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}
.priority-tag.high { background: rgba(244,67,54,0.8); }
.priority-tag.low { background: rgba(76,175,80,0.8); }
.priority-tag.medium { background: rgba(255,152,0,0.8); }
.header-time {
  margin-left: auto;
  font-size: 22rpx;
  opacity: 0.75;
}

/* ====== 通用卡片 ====== */
.card {
  background: #fff;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-title {
  position: relative;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 22rpx;
  padding-left: 22rpx;
  border-left: 8rpx solid #4f6b84;
  line-height: 1.4;
}

/* ====== 设备信息 ====== */
.device-card {
  display: flex;
  align-items: center;
}
.device-icon {
  width: 96rpx; height: 96rpx;
  background: #f4f6f9;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.device-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}
.device-model {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 4rpx;
}
.device-brand {
  font-size: 24rpx;
  color: #999;
}
.device-condition-tag {
  background: #e8f5e9;
  color: #4caf50;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* ====== 问题描述 ====== */
.desc-box {
  background: #f8f9fa;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
}

/* ====== 图片网格 ====== */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.progress-media-thumb {
  width: 200rpx;
  height: 200rpx;
}

.img-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  background: #eef2f7;
  display: block;
}

.media-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #eef2f7 0%, #dde5ef 100%);
  color: #7b8794;
}

.media-fallback-icon {
  font-size: 44rpx;
}

.media-fallback-text {
  font-size: 22rpx;
}

/* ====== 进度照片 ====== */
.progress-photos-card {
  border-left: 4rpx solid #436f95;
}

.progress-photos-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.progress-photo-item {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.progress-photo-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.progress-photo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-photo-time {
  font-size: 24rpx;
  color: #999;
}

.progress-photo-uploader {
  font-size: 24rpx;
  color: #436f95;
  font-weight: 500;
}

.progress-photo-desc {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* ====== 进度视频 ====== */
.progress-videos-card {
  border-left: 4rpx solid #436f95;
}

.progress-videos-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.progress-video-item {
  display: flex;
  position: relative;
  background: #f4f6f9;
  border-radius: 16rpx;
  overflow: hidden;
}

.video-cover {
  width: 280rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #eef2f7;
  display: block;
}

.video-cover-preview {
  pointer-events: none;
}

.video-cover-placeholder {
  width: 280rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #2d2d2d 0%, #1a1a2e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-video-item .placeholder-icon {
  font-size: 64rpx;
  opacity: 0.7;
}

.video-play-icon {
  position: absolute;
  top: 50%;
  left: 140rpx;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  font-size: 32rpx;
  color: #fff;
  margin-left: 6rpx;
}

.video-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.video-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.video-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.video-duration {
  font-size: 22rpx;
  color: #999;
}

.video-uploader {
  font-size: 22rpx;
  color: #436f95;
}

.video-time {
  font-size: 22rpx;
  color: #999;
}

/* ====== 费用与服务 ====== */
.price-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.price-item {
  flex: 1;
  text-align: center;
}
.price-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.price-num {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.price-num.estimate { color: #f59e0b; }
.price-num.actual { color: #10b981; }
.price-divider {
  width: 1rpx;
  height: 60rpx;
  background: #e0e0e0;
}
.service-row {
  display: flex;
  align-items: center;
  background: #f4f6f9;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
}
.service-icon { font-size: 40rpx; margin-right: 16rpx; }
.service-text { font-size: 28rpx; color: #333; font-weight: 500; }

/* ====== 进度条 ====== */
.progress-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.progress-bar-bg {
  flex: 1;
  height: 14rpx;
  background: #e8e8e8;
  border-radius: 7rpx;
  overflow: hidden;
}
.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #436f95, #436f95);
  border-radius: 7rpx;
  transition: width .3s;
}
.progress-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #436f95;
  margin-left: 16rpx;
  min-width: 80rpx;
  text-align: right;
}
.steps {
  display: flex;
  align-items: center;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.35;
}
.step-item.done { opacity: 1; }
.step-dot {
  width: 44rpx; height: 44rpx;
  background: #e0e0e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.step-item.done .step-dot { background: #436f95; }
.step-label { font-size: 20rpx; color: #666; }
.step-line {
  flex: 1;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 8rpx;
  margin-bottom: 28rpx;
}
.step-line.done { background: #436f95; }

/* ====== 客户信息 ====== */
.customer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.customer-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.call-btn {
  background: #e8f5e9;
  color: #4caf50;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* ====== 单位信息 ====== */
.unit-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.unit-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.unit-row .unit-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.unit-tag {
  font-size: 20rpx;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  color: #ffffff;
  padding: 5rpx 12rpx;
  border-radius: 20rpx;
}
.unit-contact,
.unit-phone,
.unit-address {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}
.unit-contact-label,
.unit-phone-label,
.unit-address-label {
  flex: 0 0 150rpx;
  font-size: 26rpx;
  color: #8a96a3;
  line-height: 1.5;
}
.unit-contact-value,
.unit-phone-value,
.unit-address-value {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: 28rpx;
  color: #2b3440;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-word;
}

/* ====== 时间线 ====== */
.timeline { padding: 4rpx 0; }
.tl-item {
  display: flex;
  margin-bottom: 28rpx;
  position: relative;
}
.tl-item:last-child { margin-bottom: 0; }
.tl-item::after {
  content: '';
  position: absolute;
  left: 18rpx;
  top: 44rpx;
  bottom: -28rpx;
  width: 2rpx;
  background: #e8e8e8;
}
.tl-item:last-child::after { display: none; }
.tl-dot {
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.tl-dot.create { background: #e3f2fd; }
.tl-dot.assign { background: #fff3e0; }
.tl-dot.progress { background: #ede7f6; }
.tl-dot.done { background: #e8f5e9; }
.tl-empty {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 0;
}
.tl-body { padding-top: 4rpx; }
.tl-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.tl-event {
  font-size: 26rpx;
  color: #333;
}

/* ====== 评价 ====== */
.review-box { background: #f8f9fa; padding: 20rpx; border-radius: 12rpx; }
.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.review-stars { font-size: 30rpx; margin-right: 12rpx; }
.review-score { font-size: 26rpx; color: #f59e0b; font-weight: bold; }
.review-time { margin-left: auto; font-size: 22rpx; color: #999; }
.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

/* ====== 底部操作栏 ====== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  display: flex;
  gap: 16rpx;
}
.footer-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.footer-btn.default {
  background: #f4f6f9;
  color: #666;
}

/* 报价卡片 */
.quote-card {
  margin-bottom: 32rpx;
}

.quote-card.quote-pending {
  border-left: 4rpx solid #f59e0b;
}

.quote-card.quote-accepted {
  border-left: 4rpx solid #10b981;
}

.quote-card.quote-rejected {
  border-left: 4rpx solid #ef4444;
}

/* 待确认报价 */
.quote-pending {
  background: linear-gradient(135deg, #fffbeb0 0%, #fef3c7 100%);
  padding: 24rpx;
  border-radius: 16rpx;
}

.quote-price-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f5f8;
}

.quote-label {
  flex: 0 0 160rpx;
  font-size: 26rpx;
  color: #8a96a3;
  line-height: 1.6;
}

.quote-value {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: 30rpx;
  font-weight: 600;
  color: #d97706;
  line-height: 1.6;
  word-break: break-word;
}

.quote-desc {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.quote-files {
  margin-top: 16rpx;
}

.quote-files-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  display: block;
}

.quote-files-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quote-file-item {
  width: 140rpx;
}

.quote-file-img {
  width: 100%;
  height: 140rpx;
  border-radius: 8rpx;
}

.quote-file-doc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  background: #dbeafe;
  border-radius: 8rpx;
  font-size: 56rpx;
}

.doc-icon {
  font-size: 56rpx;
}

.doc-name {
  font-size: 22rpx;
  color: #1e293b;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.quote-time {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

.quote-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quote-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.quote-btn.accept {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #fff;
}

.quote-btn.reject {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #fff;
}

/* 已接受/已拒绝状态 */
.quote-accepted,
.quote-rejected {
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.quote-accepted {
  background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
}

.quote-rejected {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
}

.quote-status-text {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 16rpx;
}

.quote-reason {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 8rpx;
}

.quote-reason-label {
  font-size: 26rpx;
  color: #dc2626;
  margin-bottom: 8rpx;
  display: block;
}

.quote-reason-text {
  font-size: 28rpx;
  color: #dc2626;
  line-height: 1.5;
}

/* 拒绝报价弹窗 */
.reject-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.reject-modal-content {
  width: 100%;
  max-height: 60vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.reject-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.reject-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.reject-modal-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #9ca3af;
}

.reject-modal-body {
  padding: 32rpx;
}

.reject-modal-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 16rpx;
  display: block;
}

.reject-modal-label .required {
  color: #ef4444;
}

.reject-modal-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.reject-modal-count {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: right;
  display: block;
  margin-top: 8rpx;
    }

.reject-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 32rpx;
  border-top: 1rpx solid #e5e7eb;
}

.reject-modal-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.reject-modal-btn.cancel {
  background: #f4f6f9;
  color: #666;
}

.reject-modal-btn.confirm {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #fff;
}

/* 配送信息卡片 */
.delivery-card {
  border-left: 4rpx solid #3b82f6;
}

.delivery-status-row,
.delivery-person-row,
.delivery-phone-row,
.delivery-fee-row,
.delivery-address-row,
.delivery-time-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}

.delivery-status-row:last-child,
.delivery-person-row:last-child,
.delivery-phone-row:last-child,
.delivery-fee-row:last-child,
.delivery-address-row:last-child,
.delivery-time-row:last-child {
  border-bottom: none;
}

.delivery-status-label,
.delivery-person-label,
.delivery-phone-label,
.delivery-fee-label,
.delivery-address-label,
.delivery-time-label {
  flex: 0 0 150rpx;
  font-size: 26rpx;
  color: #8a96a3;
  line-height: 1.5;
}

.delivery-status-value,
.delivery-person-value,
.delivery-phone-value,
.delivery-fee-value,
.delivery-address-value,
.delivery-time-value {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: 28rpx;
  color: #2b3440;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-word;
}

.delivery-status-value {
  color: #4f6b84;
  font-weight: 600;
}

.delivery-status-value.delivery-pending {
  color: #f59e0b;
}

.delivery-status-value.delivery-assigned {
  color: #3b82f6;
}

.delivery-status-value.delivery-picked_up {
  color: #436f95;
}

.delivery-status-value.delivery-delivered {
  color: #10b981;
}

.delivery-status-value.delivery-cancelled {
  color: #ef4444;
}

/* ====== 代客订单：管理员已填写产品提示 ====== */
.admin-created-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #e0f2fe;
  border-radius: 12rpx;
  border: 1rpx solid #bae6fd;
}
.admin-created-tip-icon { font-size: 28rpx; line-height: 1.5; }
.admin-created-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #0369a1;
  line-height: 1.6;
}

/* ====== 代客订单：选择已存地址 ====== */
.addr-quick-pick {
  padding: 24rpx 32rpx 8rpx;
  border-bottom: 1rpx solid #eef1f5;
}
.addr-quick-pick-label {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
}
.addr-quick-pick-list {
  max-height: 260rpx;
  margin-top: 16rpx;
}
.addr-quick-pick-item {
  position: relative;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
}
.addr-quick-pick-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}
.addr-quick-pick-detail {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
  line-height: 1.5;
}
.addr-quick-pick-default {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  color: #0891b2;
  background: #cffafe;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}
.addr-quick-pick-divider {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 12rpx 0 4rpx;
}
