<view class="page-container">
  <!-- 头部 -->
  <view class="header">
    <text class="page-title">进度申请管理</text>
    <text class="page-desc">管理用户的维修进度申请</text>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stat-card" bindtap="switchFilter" data-status="">
      <text class="stat-value">{{total}}</text>
      <text class="stat-label">全部</text>
    </view>
    <view class="stat-card pending" bindtap="switchFilter" data-status="pending">
      <text class="stat-value pending-value">{{stats.pending || '...'}}</text>
      <text class="stat-label">待审核</text>
    </view>
    <view class="stat-card approved" bindtap="switchFilter" data-status="approved">
      <text class="stat-value approved-value">{{stats.approved || '...'}}</text>
      <text class="stat-label">已通过</text>
    </view>
    <view class="stat-card rejected" bindtap="switchFilter" data-status="rejected">
      <text class="stat-value rejected-value">{{stats.rejected || '...'}}</text>
      <text class="stat-label">已拒绝</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view class="filter-tab {{statusFilter === '' ? 'active' : ''}}" bindtap="switchFilter" data-status="">全部</view>
    <view class="filter-tab {{statusFilter === 'pending' ? 'active' : ''}}" bindtap="switchFilter" data-status="pending">待审核</view>
    <view class="filter-tab {{statusFilter === 'approved' ? 'active' : ''}}" bindtap="switchFilter" data-status="approved">已通过</view>
    <view class="filter-tab {{statusFilter === 'rejected' ? 'active' : ''}}" bindtap="switchFilter" data-status="rejected">已拒绝</view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading && applyList.length === 0}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{applyList.length === 0 && !loading}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无进度申请</text>
  </view>

  <!-- 列表 -->
  <view wx:else class="apply-list">
    <view class="apply-card" wx:for="{{applyList}}" wx:key="id">
      <!-- 头部 -->
      <view class="card-header">
        <view class="header-left">
          <text class="apply-no">{{item.apply_no}}</text>
          <text class="apply-user">申请人: {{item.userName}}</text>
        </view>
        <view class="status-badge" style="background: {{item.statusBg}}; color: {{item.statusColor}}">
          {{item.statusIcon}} {{item.statusLabel}}
        </view>
      </view>

      <!-- 信息 -->
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">设备</text>
          <text class="info-value">{{item.device_name || item.order_device_model || '未填写'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">进度类型</text>
          <text class="info-value">{{item.progressTypeText}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">联系方式</text>
          <text class="info-value">{{item.phone}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">申请时间</text>
          <text class="info-value time">{{item.createdAt}}</text>
        </view>
      </view>

      <!-- 申请原因 -->
      <view class="reason-box">
        <text class="reason-label">申请原因:</text>
        <text class="reason-text">{{item.apply_reason}}</text>
      </view>

      <!-- 关联订单 -->
      <view class="order-link" bindtap="viewOrder" data-orderid="{{item.order_id}}">
        <text class="link-icon">📦</text>
        <text class="link-text">查看关联订单 #{{item.order_id}}</text>
        <text class="link-arrow">›</text>
      </view>

      <!-- 操作按钮 (仅待审核) -->
      <view wx:if="{{item.approval_status === 'pending'}}" class="action-bar">
        <view class="action-btn approve-btn" bindtap="openApproveModal" data-id="{{item.id}}">✅ 通过</view>
        <view class="action-btn reject-btn" bindtap="openRejectModal" data-id="{{item.id}}">❌ 拒绝</view>
        <view class="action-btn detail-btn" bindtap="viewDetail" data-id="{{item.id}}">查看</view>
      </view>

      <!-- 已处理的显示审批备注 -->
      <view wx:if="{{item.approval_status !== 'pending' && item.approval_remark}}" class="approval-note" style="border-left-color: {{item.statusColor}}">
        <text class="note-label">{{item.approval_status === 'approved' ? '审批备注:' : '拒绝原因:'}}</text>
        <text class="note-text">{{item.approval_remark}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loading && applyList.length > 0}}" class="loading-more">加载中...</view>
    <view wx:if="{{!hasMore && applyList.length > 0}}" class="no-more">没有更多了</view>
  </view>

  <!-- 审批通过弹窗 -->
  <view wx:if="{{showApproveModal}}" class="modal-overlay" bindtap="closeApproveModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">审批通过</text>
        <view class="modal-close" bindtap="closeApproveModal">×</view>
      </view>
      <view class="modal-body">
        <view class="modal-info">
          <text class="modal-info-label">申请编号: {{currentApply.apply_no}}</text>
          <text class="modal-info-label">申请人: {{currentApply.userName}}</text>
        </view>
        <view class="form-group">
          <text class="form-label">审批备注 (选填)</text>
          <textarea class="form-textarea" placeholder="输入审批意见..." value="{{approveRemark}}" bindinput="onApproveRemarkInput"/>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closeApproveModal">取消</view>
        <view class="modal-btn primary approve" bindtap="submitApprove">确认通过</view>
      </view>
    </view>
  </view>

  <!-- 拒绝弹窗 -->
  <view wx:if="{{showRejectModal}}" class="modal-overlay" bindtap="closeRejectModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">拒绝申请</text>
        <view class="modal-close" bindtap="closeRejectModal">×</view>
      </view>
      <view class="modal-body">
        <view class="modal-info">
          <text class="modal-info-label">申请编号: {{currentApply.apply_no}}</text>
          <text class="modal-info-label">申请人: {{currentApply.userName}}</text>
        </view>
        <view class="form-group">
          <text class="form-label">拒绝原因 <text class="required">*</text></text>
          <textarea class="form-textarea" placeholder="请填写拒绝原因..." value="{{rejectRemark}}" bindinput="onRejectRemarkInput"/>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closeRejectModal">取消</view>
        <view class="modal-btn danger" bindtap="submitReject">确认拒绝</view>
      </view>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
