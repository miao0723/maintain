<!--pages/device-edit/device-edit.wxml-->
<view class="page-container">
  <view class="form-section">
    <!-- 步骤提示 -->
    <view class="step-indicator">
      <text class="step-text">选择你的设备信息，维修时可快速复用</text>
    </view>

    <!-- 设备类型 -->
    <view class="form-group">
      <text class="form-label">
        <text class="label-required">*</text>设备类型
      </text>
      <view class="type-picker-wrap">
        <view
          class="type-item {{selectedTypeId === item.id && !isCustomType ? 'active' : ''}}"
          wx:for="{{deviceTypes}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="selectType"
        >
          <text class="type-icon">{{item.icon}}</text>
          <text class="type-name">{{item.name}}</text>
        </view>
        <!-- 自定义类型 -->
        <view
          class="type-item type-custom {{isCustomType ? 'active' : ''}}"
          data-id="custom"
          bindtap="selectType"
        >
          <text class="type-icon type-icon-custom">✏️</text>
          <text class="type-name">自定义</text>
        </view>
      </view>
    </view>

    <!-- 自定义类型名称输入 -->
    <view class="form-group" wx:if="{{isCustomType}}">
      <text class="form-label">
        <text class="label-required">*</text>设备类型名称
      </text>
      <input
        class="form-input"
        value="{{customTypeName}}"
        placeholder="如：投影仪、示波器、对讲机等"
        maxlength="50"
        bindinput="onCustomTypeInput"
        placeholder-style="color: #c0c0c0;"
      />
    </view>

    <!-- 自定义品牌名称输入 -->
    <view class="form-group" wx:if="{{isCustomType}}">
      <text class="form-label">品牌</text>
      <input
        class="form-input"
        value="{{customBrandName}}"
        placeholder="如：明基、泰克、摩托罗拉（可选）"
        maxlength="50"
        bindinput="onCustomBrandInput"
        placeholder-style="color: #c0c0c0;"
      />
    </view>

    <!-- 品牌 -->
    <view class="form-group" wx:if="{{selectedTypeId}}">
      <text class="form-label">品牌</text>
      <picker
        mode="selector"
        range="{{brandNames}}"
        value="{{selectedBrandIndex}}"
        bindchange="selectBrand"
      >
        <view class="picker-view">
          <text class="picker-text {{selectedBrandName ? '' : 'placeholder'}}">{{selectedBrandName || '请选择品牌（可选）'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 型号 -->
    <view class="form-group" wx:if="{{selectedTypeId && modelList.length > 0}}">
      <text class="form-label">型号</text>
      <picker
        mode="selector"
        range="{{modelNames}}"
        value="{{selectedModelIndex}}"
        bindchange="selectModel"
      >
        <view class="picker-view">
          <text class="picker-text {{deviceModel ? '' : 'placeholder'}}">
            {{deviceModel || '请选择型号（或手动输入）'}}
          </text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 手动输入型号 -->
    <view class="form-group" wx:if="{{selectedTypeId || isCustomType}}">
      <text class="form-label">
        <text class="label-required">*</text>设备型号
      </text>
      <input
        class="form-input"
        value="{{deviceModel}}"
        placeholder="如：iPhone 15 Pro / 自填型号名称"
        maxlength="100"
        bindinput="onModelInput"
        placeholder-style="color: #c0c0c0;"
      />
      <text class="form-hint" wx:if="{{modelList.length > 0}}">可选择上方常用型号，也可直接输入</text>
    </view>

    <!-- 设备昵称 -->
    <view class="form-group" wx:if="{{selectedTypeId || isCustomType}}">
      <text class="form-label">设备昵称</text>
      <input
        class="form-input"
        value="{{deviceNickname}}"
        placeholder="如：工作手机 / 备用机 （可选）"
        maxlength="50"
        bindinput="onNicknameInput"
        placeholder-style="color: #c0c0c0;"
      />
      <text class="form-hint">给设备起个名字，方便识别</text>
    </view>

    <!-- 序列号 -->
    <view class="form-group" wx:if="{{selectedTypeId || isCustomType}}">
      <text class="form-label">序列号/IMEI</text>
      <input
        class="form-input"
        value="{{serialNumber}}"
        placeholder="设备的SN码或IMEI号（可选）"
        maxlength="100"
        bindinput="onSerialInput"
        placeholder-style="color: #c0c0c0;"
      />
    </view>

    <!-- 设备现状 -->
    <view class="form-group" wx:if="{{selectedTypeId || isCustomType}}">
      <text class="form-label">设备现状</text>
      <textarea
        class="form-textarea"
        value="{{deviceCondition}}"
        placeholder="简单描述设备当前状况（可选）"
        maxlength="200"
        bindinput="onConditionInput"
        placeholder-style="color: #c0c0c0;"
        auto-height
      />
      <text class="form-hint">{{deviceCondition.length || 0}}/200</text>
    </view>

    <!-- 购买日期 -->
    <view class="form-group" wx:if="{{selectedTypeId || isCustomType}}">
      <text class="form-label">购买日期</text>
      <picker
        mode="date"
        value="{{purchaseDate}}"
        start="2010-01-01"
        end="{{todayDate}}"
        bindchange="selectDate"
      >
        <view class="picker-view">
          <text class="picker-text {{purchaseDate ? '' : 'placeholder'}}">{{purchaseDate || '请选择购买日期（可选）'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 设备用途 -->
    <view class="form-group" wx:if="{{selectedTypeId || isCustomType}}">
      <text class="form-label">设备用途</text>
      <view class="purpose-switch">
        <view
          class="purpose-item {{devicePurpose === item.value ? 'active' : ''}}"
          wx:for="{{purposeOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="selectPurpose"
        >
          <text class="purpose-item-text">{{item.label}}</text>
        </view>
      </view>
      <text class="form-hint">同一台设备只存一条记录，勾选"均可"会同时出现在维修与回收清单，编辑后两处自动同步</text>
    </view>

    <!-- 设为默认 -->
    <view class="form-group" wx:if="{{selectedTypeId || isCustomType}}">
      <view class="switch-row">
        <view class="switch-info">
          <text class="form-label switch-label">设为默认设备</text>
          <text class="form-hint switch-hint">新建设备时将自动选中</text>
        </view>
        <switch checked="{{isDefault}}" bindchange="toggleDefault" color="#5a6e8a" />
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button class="submit-btn" bindtap="submitForm" disabled="{{!canSubmit}}">
      {{mode === 'edit' ? '保存修改' : '绑定设备'}}
    </button>
  </view>
</view>
