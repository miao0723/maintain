/* pages/device-edit/device-edit.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 140rpx;
}

/* 步骤指示 */
.step-indicator {
  margin: 24rpx 30rpx;
  padding: 20rpx 24rpx;
  background: #e8f0fe;
  border-radius: 12rpx;
}
.step-text {
  font-size: 26rpx;
  color: #4a6fa5;
  line-height: 1.6;
}

/* 表单区域 */
.form-section {
  padding: 0 30rpx;
}
.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}

/* 表单标签 */
.form-label {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}
.label-required {
  color: #ff4d4f;
  margin-right: 4rpx;
}
.form-hint {
  font-size: 22rpx;
  color: #c0c0c0;
  margin-top: 10rpx;
  display: block;
}

/* 设备类型选择器 */
.type-picker-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.type-item.active {
  background: #e8edf5;
  border-color: #4f6b84;
  box-shadow: 0 2rpx 12rpx rgba(90,110,138,0.15);
}
/* 自定义类型卡片区分样式 */
.type-custom {
  border-style: dashed;
  border-color: #d0d5dd;
  background: #fafbfc;
}
.type-custom.active {
  border-style: solid;
  border-color: #4f6b84;
  background: #e8edf5;
}
.type-icon-custom {
  filter: grayscale(0.3);
}
.type-item:active {
  transform: scale(0.96);
}
.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.type-name {
  font-size: 24rpx;
  color: #595959;
}
.type-item.active .type-name {
  color: #4f6b84;
  font-weight: 600;
}

/* 选择器样式 */
.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
}
.picker-text {
  font-size: 28rpx;
  color: #1a1a1a;
  flex: 1;
}
.picker-text.placeholder {
  color: #c0c0c0;
}
.picker-arrow {
  font-size: 36rpx;
  color: #c0c0c0;
  font-weight: 300;
}

/* 输入框 */
.form-input {
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
}

/* 文本域 */
.form-textarea {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  line-height: 1.6;
}

/* 设备用途选择器 */
.purpose-switch {
  display: flex;
  gap: 16rpx;
}
.purpose-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.purpose-item.active {
  background: #e8edf5;
  border-color: #4f6b84;
  box-shadow: 0 2rpx 12rpx rgba(90,110,138,0.15);
}
.purpose-item:active {
  transform: scale(0.97);
}
.purpose-item-text {
  font-size: 27rpx;
  color: #595959;
  font-weight: 500;
}
.purpose-item.active .purpose-item-text {
  color: #4f6b84;
  font-weight: 700;
}

/* 开关行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-info {
  flex: 1;
}
.switch-label {
  margin-bottom: 4rpx;
}
.switch-hint {
  margin-top: 0;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, #fff 85%, transparent);
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #4f6b84, #6b82a0);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(90,110,138,0.3);
}
.submit-btn::after {
  border: none;
}
.submit-btn[disabled] {
  background: #d9d9d9;
  color: #a0a0a0;
  box-shadow: none;
}
.submit-btn:not([disabled]):active {
  opacity: 0.9;
  transform: scale(0.98);
}
