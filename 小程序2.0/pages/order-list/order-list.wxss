/* pages/order-list/order-list.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

/* 搜索区域 */
.search-section {
  background: white;
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  background: #f5f5f5;
  transition: all 0.3s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-weight: bold;
}

/* 状态筛选 */
.status-filter {
  margin-bottom: 20rpx;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.picker text:first-child {
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

/* 订单列表 */
.order-list {
  height: calc(100vh - 400rpx);
  padding: 20rpx 30rpx;
}

/* 订单卡片 */
.order-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.order-card:active {
  transform: scale(0.98);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-badges {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.type-badge.repair {
  background: #e3f2fd;
  color: #2196f3;
}

.type-badge.recycle {
  background: #fff3e0;
  color: #ff9800;
}

.priority-badge.high {
  background: #ffebee;
  color: #f44336;
}

.priority-badge.medium {
  background: #fff8e1;
  color: #ff9800;
}

.priority-badge.low {
  background: #e8f5e9;
  color: #4caf50;
}

/* 设备信息 */
.device-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.device-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.device-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.device-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.device-model,
.device-brand {
  font-size: 24rpx;
  color: #999;
}

.device-condition {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: white;
  font-weight: 500;
}

.device-condition.good {
  background: #4caf50;
}

.device-condition.normal {
  background: #2196f3;
}

.device-condition.fair {
  background: #ff9800;
}

.device-condition.poor {
  background: #f44336;
}

/* 客户信息 */
.customer-info {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.customer-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.customer-item .icon {
  font-size: 28rpx;
}

.customer-item .name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.customer-item .phone {
  font-size: 26rpx;
  color: #666;
}

/* 问题描述 */
.problem-info {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.problem-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.problem-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 价格信息 */
.price-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.price-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.price-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.price-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.price-value.estimate {
  color: #ff9800;
}

.price-value.actual {
  color: #4caf50;
}

.progress-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.progress-label {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

.progress-bar-small {
  flex: 1;
  height: 16rpx;
  background: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2196f3 0%, #64b5f6 100%);
  transition: width 0.3s ease;
}

.progress-value {
  font-size: 24rpx;
  color: #2196f3;
  font-weight: bold;
  min-width: 60rpx;
  text-align: right;
}

/* 地址信息 */
.address-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.address-icon {
  font-size: 28rpx;
}

.address-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 服务信息 */
.service-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.service-label {
  font-size: 26rpx;
  color: #999;
}

.service-type {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.service-type.shop {
  background: #e3f2fd;
  color: #2196f3;
}

.service-type.home {
  background: #e8f5e9;
  color: #4caf50;
}

/* 分配信息 */
.assign-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #e3f2fd;
  border-radius: 12rpx;
}

.assign-label {
  font-size: 26rpx;
  color: #666;
}

.assign-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.assign-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #999;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn.detail {
  background: #e3f2fd;
  color: #2196f3;
}

.action-btn.assign {
  background: #fff8e1;
  color: #ff9800;
}

.action-btn.process {
  background: #e8f5e9;
  color: #4caf50;
}

.action-btn.review {
  background: #f3e5f5;
  color: #9c27b0;
}

/* 加载状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
}

.loading-state,
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text,
.no-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 底部统计 */
.footer-stats {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
}
