<!--pages/order-list/order-list.wxml-->
<view class="container">
  <!-- 搜索和筛选 -->
  <view class="search-section">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索订单号、客户姓名、手机号"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
    </view>
    <view class="filter-tabs">
      <view
        class="filter-tab {{currentFilter === 'all' ? 'active' : ''}}"
        bindtap="switchFilter"
        data-filter="all"
      >
        全部
      </view>
      <view
        class="filter-tab {{currentFilter === 'repair' ? 'active' : ''}}"
        bindtap="switchFilter"
        data-filter="repair"
      >
        维修
      </view>
      <view
        class="filter-tab {{currentFilter === 'recycle' ? 'active' : ''}}"
        bindtap="switchFilter"
        data-filter="recycle"
      >
        回收
      </view>
    </view>
    <view class="status-filter">
      <picker
        mode="selector"
        range="{{statusOptions}}"
        range-key="label"
        value="{{statusIndex}}"
        bindchange="onStatusChange"
      >
        <view class="picker">
          <text>{{statusOptions[statusIndex].label}}</text>
          <text class="arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view
    class="order-list"
    scroll-y
    bindscrolltolower="loadMore"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view wx:if="{{orders.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无订单</text>
    </view>

    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-info">
          <text class="order-no">{{item.order_no}}</text>
          <text class="order-time">{{formatTime(item.created_at)}}</text>
        </view>
        <view class="order-badges">
          <view class="badge type-badge {{item.order_type}}">
            {{item.order_type === 'repair' ? '维修' : '回收'}}
          </view>
          <view class="badge status-badge" style="background: {{getStatusColor(item.status)}}; color: white;">
            {{getStatusLabel(item.status)}}
          </view>
          <view wx:if="{{item.priority}}" class="badge priority-badge {{item.priority}}">
            {{item.priority === 'high' ? '紧急' : (item.priority === 'medium' ? '普通' : '低')}}
          </view>
        </view>
      </view>

      <!-- 设备信息 -->
      <view class="device-info">
        <view class="device-icon">{{getDeviceIcon(item.device_type)}}</view>
        <view class="device-details">
          <text class="device-name">{{item.device_name || '未知设备'}}</text>
          <text wx:if="{{item.device_model}}" class="device-model">{{item.device_model}}</text>
          <text wx:if="{{item.brand_name}}" class="device-brand">{{item.brand_name}}</text>
        </view>
        <view wx:if="{{item.device_condition}}" class="device-condition {{item.device_condition}}">
          {{getConditionLabel(item.device_condition)}}
        </view>
      </view>

      <!-- 客户信息 -->
      <view class="customer-info">
        <view class="customer-item">
          <text class="icon">👤</text>
          <text class="name">{{item.user_name}}</text>
        </view>
        <view class="customer-item">
          <text class="icon">📱</text>
          <text class="phone">{{item.user_phone}}</text>
        </view>
      </view>

      <!-- 问题描述 -->
      <view wx:if="{{item.problem_description || item.custom_description}}" class="problem-info">
        <text class="problem-label">问题描述:</text>
        <text class="problem-text">{{item.problem_description || item.custom_description}}</text>
      </view>

      <!-- 价格信息 -->
      <view class="price-info">
        <view class="price-item">
          <text class="price-label">预估</text>
          <text class="price-value estimate">¥{{item.estimated_price || '0.00'}}</text>
        </view>
        <view class="price-item">
          <text class="price-label">实际</text>
          <text class="price-value actual">¥{{item.actual_price || '待定'}}</text>
        </view>
        <view wx:if="{{item.progress !== undefined}}" class="progress-item">
          <text class="progress-label">进度</text>
          <view class="progress-bar-small">
            <view class="progress-fill" style="width: {{item.progress}}%"></view>
          </view>
          <text class="progress-value">{{item.progress}}%</text>
        </view>
      </view>

      <!-- 地址信息 -->
      <view wx:if="{{item.address_info}}" class="address-info">
        <text class="address-icon">📍</text>
        <text class="address-text">{{item.address_info}}</text>
      </view>

      <!-- 服务方式 -->
      <view wx:if="{{item.service_type}}" class="service-info">
        <text class="service-label">服务方式:</text>
        <view class="service-type {{item.service_type}}">
          <text>{{item.service_type === 'shop' ? '🏪 到店' : '🏠 上门'}}</text>
        </view>
      </view>

      <!-- 分配信息 -->
      <view wx:if="{{item.assigned_to}}" class="assign-info">
        <text class="assign-label">👨‍🔧 维修人员:</text>
        <text class="assign-name">{{item.assigned_name}}</text>
        <text class="assign-time">{{formatTime(item.assigned_at)}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions">
        <view class="action-btn detail">查看详情</view>
        <view wx:if="{{item.status === 'pending'}}" class="action-btn assign" bindtap="assignOrder" data-id="{{item.id}}" catchtap="stopPropagation">
          分配
        </view>
        <view wx:if="{{item.status === 'quoted'}}" class="action-btn" style="background: #8b5cf6; color: #fff;" catchtap="stopPropagation">
          待确认
        </view>
        <view wx:if="{{item.status === 'confirmed'}}" class="action-btn process" bindtap="processOrder" data-id="{{item.id}}" catchtap="stopPropagation">
          处理
        </view>
        <view wx:if="{{item.status === 'processing'}}" class="action-btn process" bindtap="processOrder" data-id="{{item.id}}" catchtap="stopPropagation">
          处理
        </view>
        <view wx:if="{{item.status === 'completed'}}" class="action-btn review" bindtap="viewReview" data-id="{{item.id}}" catchtap="stopPropagation">
          评价
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:if="{{!hasMore && orders.length > 0}}" class="no-more">
      <text class="no-more-text">没有更多了</text>
    </view>
  </scroll-view>

  <!-- 底部统计 -->
  <view class="footer-stats">
    <view class="stat-item">
      <text class="stat-label">总数</text>
      <text class="stat-value">{{total}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">待处理</text>
      <text class="stat-value">{{statusCounts.pending}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">待确认</text>
      <text class="stat-value">{{statusCounts.quoted}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">处理中</text>
      <text class="stat-value">{{statusCounts.processing}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">已完成</text>
      <text class="stat-value">{{statusCounts.completed}}</text>
    </view>
  </view>
</view>
