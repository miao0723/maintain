<!--pages/service/service.wxml-->
<view class="page-container">
  <!-- 紧凑视图切换标签 -->
  <view class="view-tabs">
    <view class="tabs-left">
      <view class="view-tab-item {{currentView === 'chat' ? 'active' : ''}}" bindtap="switchView" data-view="chat">
        <text class="tab-text">当前对话</text>
        <view class="tab-indicator" wx:if="{{currentView === 'chat'}}"></view>
      </view>
      <view class="view-tab-item {{currentView === 'history' ? 'active' : ''}}" bindtap="switchView" data-view="history">
        <text class="tab-text">历史记录</text>
        <view class="tab-divider"></view>
        <text class="tab-badge" wx:if="{{conversations.length > 0}}">{{conversations.length}}</text>
        <view class="tab-indicator" wx:if="{{currentView === 'history'}}"></view>
      </view>
    </view>
    <!-- 新建对话按钮（聊天界面可见） -->
    <view class="new-chat-btn {{currentView === 'chat' ? 'visible' : ''}}" bindtap="startNewChat">
      <text class="new-chat-icon">+</text>
    </view>
  </view>

  <!-- ========== 聊天视图 ========== -->
  <block wx:if="{{currentView === 'chat'}}">
  <view class="human-service-banner waiting" wx:if="{{queueInfo}}">
    <text class="human-banner-title">已转人工客服</text>
    <text class="human-banner-desc">当前排队位置 {{queueInfo.queuePosition || queueInfo.queue_position || 0}}，请继续发送消息，客服接入后会实时回复。</text>
  </view>
  <view class="human-service-banner connected" wx:if="{{humanConnected}}">
    <text class="human-banner-title">人工客服已接入</text>
    <text class="human-banner-desc">{{currentAgentInfo && currentAgentInfo.name ? currentAgentInfo.name : '人工客服'}} 正在为您服务，当前消息将不再由 AI 自动回复。</text>
  </view>

  <!-- 当前选中产品提示 -->
  <view class="current-product" wx:if="{{selectedProduct}}">
    <view class="current-product-tag">
      <text class="tag-icon">{{selectedProduct.icon}}</text>
      <text class="tag-text">当前咨询：{{selectedProduct.name}}</text>
      <text class="tag-change" bindtap="openProductPanel">更换</text>
    </view>
  </view>

  <!-- 聊天消息区域 -->
  <scroll-view class="chat-area" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation>
    <view class="message-list">
      <!-- 消息列表 -->
      <view class="message-item {{item.type === 'user' ? 'user' : 'service'}}" wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
        <view class="avatar-wrapper user-avatar" wx:if="{{item.type === 'user'}}">
          <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        </view>
        <view class="avatar-wrapper service-avatar" wx:else>
          <view class="avatar-glow"></view>
          <image class="avatar" src="/images/service-avatar-pro.svg" mode="aspectFill"></image>
          <view class="online-dot"></view>
        </view>
        <view class="message-content">
          <!-- 产品卡片消息 -->
          <view class="product-card" wx:if="{{item.type === 'product'}}">
            <view class="product-icon">{{item.data.icon}}</view>
            <view class="product-info">
              <text class="product-name">{{item.data.name}}</text>
              <view class="product-tags" wx:if="{{item.data.repair_types.length > 0}}">
                <text class="product-tag" wx:for="{{item.data.repair_types}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
              </view>
              <text class="product-price">{{item.data.price}}</text>
            </view>
          </view>
          <!-- 普通文本消息 -->
          <view class="message-bubble {{item.type === 'user' ? 'user-bubble' : 'service-bubble'}}" wx:else>
            <text class="message-text">{{item.content}}</text>
            <!-- 路由跳转链接 -->
            <view class="jump-link" wx:if="{{item.jumpLink}}" catchtap="onJumpLink" data-path="{{item.jumpLink.path}}">
              <text class="jump-link-icon">🔗</text>
              <text class="jump-link-text">{{item.jumpLink.text}}</text>
              <text class="jump-link-arrow">→</text>
            </view>
          </view>
          <text class="message-time">{{item.time}}</text>
        </view>
      </view>

      <view class="message-item service" wx:if="{{serviceTyping}}" id="typing-indicator">
        <view class="avatar-wrapper service-avatar">
          <view class="avatar-glow"></view>
          <image class="avatar" src="/images/service-avatar-pro.svg" mode="aspectFill"></image>
          <view class="online-dot"></view>
        </view>
        <view class="message-content">
          <view class="message-bubble service-bubble typing-bubble">
            <view class="typing-dots">
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 产品选择提示 -->
      <view class="product-tip" wx:if="{{messages.length === 0}}">
        <view class="tip-avatar">
          <image class="tip-avatar-img" src="/images/service-avatar-pro.svg" mode="aspectFill"></image>
          <view class="tip-online-dot"></view>
        </view>
        <view class="tip-content">
          <view class="tip-name">修小宝 · 在线</view>
          <text class="tip-text">直接描述设备和问题现象就可以，我会帮您判断方向、说明流程，并在需要时引导您去下单。</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- ========== 底部操作区（快捷入口 + 输入框，整体在自定义 tabBar 之上） ========== -->
  <view class="bottom-dock">

    <!-- 快捷短语弹层（悬浮在底部操作区上方，隐藏时不拦截点击） -->
    <view class="quick-phrases {{showQuickPhrases ? 'show' : ''}}">
      <scroll-view class="quick-phrases-scroll" scroll-y>
        <view class="phrase-item" wx:for="{{quickPhrases}}" wx:key="index" bindtap="selectQuickPhrase" data-phrase="{{item}}">
          <text class="phrase-text">{{item}}</text>
        </view>
        <view class="phrase-item clear" bindtap="clearChatHistory">
          <text class="phrase-text">🔄 重置对话</text>
        </view>
      </scroll-view>
    </view>

    <!-- 语音状态提示 -->
    <view class="voice-status-bar {{voiceRecognizing || voiceRecording ? 'active' : ''}}" wx:if="{{voiceHint}}">
      <text class="voice-status-text">{{voiceHint}}</text>
    </view>

    <!-- 快捷建议操作 -->
    <scroll-view class="suggested-actions" wx:if="{{suggestedActions.length > 0}}" scroll-x enable-flex>
      <view class="suggested-actions-list">
        <view class="action-tag" wx:for="{{suggestedActions}}" wx:key="index" bindtap="selectSuggestedAction" data-action="{{item}}">
          <text class="action-text">{{item.text}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 快捷入口小按钮（原顶部快捷入口，已移到输入框上方） -->
    <scroll-view class="quick-entry-bar" scroll-x enable-flex>
      <view class="quick-entry-list">
        <view class="quick-entry-chip {{item.strong ? 'strong' : ''}}"
              wx:for="{{quickEntries}}"
              wx:key="label"
              bindtap="selectQuickPhrase"
              data-phrase="{{item.phrase}}">
          <text class="quick-entry-text">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 输入行 -->
    <view class="input-area">

      <!-- 产品选择按钮 -->
      <view class="product-btn" bindtap="openProductPanel">
        <text class="product-btn-icon">📦</text>
      </view>

      <!-- 快捷短语按钮 -->
      <view class="phrase-btn" bindtap="toggleQuickPhrases">
        <text class="phrase-btn-icon">💬</text>
      </view>

      <!-- 语音输入按钮 -->
      <view class="voice-btn {{voiceRecording ? 'recording' : ''}}" bindtap="toggleVoiceInput">
        <text class="voice-btn-icon">{{voiceRecording ? '■' : '🎤'}}</text>
      </view>

      <!-- 输入框 -->
      <view class="input-box">
        <input
          class="input-field"
          type="text"
          placeholder="{{selectedProduct ? '继续咨询' : '输入消息，或点击📦选择产品...'}}"
          value="{{inputText}}"
          bindinput="onInputChange"
          bindconfirm="onInputConfirm"
          confirm-type="send"
          adjust-position="{{true}}"
          cursor-spacing="20"
          confirm-hold="{{false}}"/>
        <text class="char-count">{{inputText.length}}/200</text>
      </view>

      <!-- 发送按钮 -->
      <button class="send-btn" bindtap="onSendSubmit" disabled="{{!canSend}}">
        <text class="send-text">发送</text>
      </button>
    </view>
  </view>
  </block>

  <!-- ========== 历史记录视图 ========== -->
  <block wx:if="{{currentView === 'history'}}">
    <scroll-view class="history-container" scroll-y>
      <!-- 加载中 -->
      <view class="history-loading" wx:if="{{conversationsLoading}}">
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 空状态 -->
      <view class="history-empty" wx:if="{{!conversationsLoading && conversations.length === 0}}">
        <view class="empty-icon">💬</view>
        <text class="empty-title">暂无历史记录</text>
        <text class="empty-desc">开始和修小宝对话吧</text>
        <view class="empty-action" bindtap="startNewChat">
          <text class="empty-action-text">开始新对话</text>
        </view>
      </view>

      <!-- 历史会话列表 -->
      <view class="history-list" wx:if="{{!conversationsLoading && conversations.length > 0}}">
        <view class="history-item" wx:for="{{conversations}}" wx:key="id">
          <view class="history-item-left" bindtap="openConversation" data-id="{{item.id}}">
            <view class="history-avatar">
              <text class="history-avatar-icon">🤖</text>
            </view>
            <view class="history-item-info">
              <view class="history-item-top">
                <text class="history-item-title">{{item.summary || '客服对话'}}</text>
                <text class="history-item-status {{item.status}}">
                  {{item.status === 'active' ? '进行中' : (item.status === 'transferred' ? '已转人工' : '已结束')}}
                </text>
              </view>
              <text class="history-item-count">{{item.message_count || 0}} 条消息</text>
            </view>
          </view>
          <view class="history-item-right">
            <text class="history-item-time">{{item._displayTime || ''}}</text>
            <view class="history-item-actions">
              <text class="history-item-arrow">></text>
              <view class="history-delete-btn" catchtap="deleteConversation" data-id="{{item.id}}">
                <text class="history-delete-icon">✕</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 新建对话按钮 -->
    <view class="history-new-btn" wx:if="{{!conversationsLoading && conversations.length > 0}}" bindtap="startNewChat">
      <text class="history-new-icon">+</text>
      <text class="history-new-text">新建对话</text>
    </view>
  </block>

  <!-- 产品选择面板 -->
  <view class="product-panel {{showProductPanel ? 'show' : ''}}">
    <view class="panel-header">
      <view class="panel-header-left">
        <image class="panel-avatar" src="/images/service-avatar-pro.svg" mode="aspectFill"></image>
        <view class="panel-title-group">
          <text class="panel-title">选择产品</text>
          <text class="panel-subtitle">选择您需要维修的设备</text>
        </view>
      </view>
      <view class="close-btn" bindtap="closeProductPanel">×</view>
    </view>
    <scroll-view class="product-list" scroll-y>
      <!-- 搜索栏 -->
      <view class="product-search">
        <input class="product-search-input" placeholder="搜索产品名称或品牌..." value="{{productSearchKey}}" bindinput="onProductSearch" />
      </view>
      <!-- 搜索无结果提示 -->
      <view class="search-empty" wx:if="{{filteredGroupedProducts && filteredGroupedProducts.length === 0}}">
        <view class="search-empty-icon">🔍</view>
        <text class="search-empty-title">未找到相关产品</text>
        <text class="search-empty-desc">没有关系，我们支持维修各类电子设备！</text>
        <view class="search-empty-action" bindtap="onSearchEmptyConsult">
          <text class="search-empty-action-text">直接咨询客服</text>
        </view>
      </view>
      <!-- 按品牌分组 -->
      <view class="brand-group" wx:for="{{filteredGroupedProducts || groupedProducts}}" wx:key="brand">
        <view class="brand-header">
          <view class="brand-logo">{{item.brandLogo}}</view>
          <text class="brand-title">{{item.brand}}</text>
          <text class="brand-count">{{item.products.length}}款产品</text>
        </view>
        <view class="product-option" wx:for="{{item.products}}" wx:key="id" wx:for-item="product" bindtap="selectProduct" data-product="{{product}}">
          <view class="option-icon">{{product.icon}}</view>
          <view class="option-info">
            <text class="option-name">{{product.name}}</text>
            <view class="option-tags" wx:if="{{product.repair_types.length > 0}}">
              <text class="option-tag" wx:for="{{product.repair_types}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
            <text class="option-category" wx:else>{{product.category}}</text>
          </view>
          <text class="option-arrow">></text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
