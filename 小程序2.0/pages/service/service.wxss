/* pages/service/service.wxss */

/*
 * 布局说明：
 * 页面整体使用「固定视口 + 纵向 flex」布局，底部预留自定义 tabBar 的高度，
 * 中间聊天区用 flex:1 自适应，底部输入区在正常文档流内，
 * 这样不同机型（有无安全区、不同屏幕比例）都不会出现输入框被遮挡、点不到的问题。
 */
.page-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  /* 底部让开自定义 tabBar（118rpx + home indicator 安全区） */
  bottom: 118rpx;
  bottom: calc(118rpx + constant(safe-area-inset-bottom));
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f0f2f5 0%, #e5e8eb 50%, #dce0e5 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ========== 视图切换标签 ========== */
.view-tabs {
  display: flex;
  align-items: center;
  padding: 8rpx 30rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  gap: 8rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 30;
}

/* 注意：类名不用 .tab-item，避免被 app.wxss 里 .tab-item{min-height:88rpx!important} 撑高 */
.view-tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  position: relative;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.view-tab-item.active {
  background: linear-gradient(135deg, rgba(79, 107, 132, 0.12) 0%, rgba(110, 133, 165, 0.08) 100%);
}

.tab-text {
  font-size: 26rpx;
  color: #8a8f9b;
  font-weight: 500;
  transition: all 0.3s ease;
}

.view-tab-item.active .tab-text {
  color: #4f6b84;
  font-weight: 700;
}

.tab-divider {
  width: 2rpx;
  height: 18rpx;
  background: #d0d5dd;
  border-radius: 1rpx;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.tab-indicator {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 2rpx;
  animation: indicatorIn 0.3s ease;
}

@keyframes indicatorIn {
  from { width: 0; opacity: 0; }
  to { width: 32rpx; opacity: 1; }
}

/* 标签左侧分组 */
.tabs-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

/* 新建对话按钮（聊天界面右侧） */
.new-chat-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3rpx 12rpx rgba(79, 107, 132, 0.24);
  flex-shrink: 0;
  opacity: 0;
  transform: scale(0.5);
  pointer-events: none;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.new-chat-btn.visible {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.new-chat-btn:active {
  transform: scale(0.85);
  box-shadow: 0 1rpx 6rpx rgba(79, 107, 132, 0.32);
  background: linear-gradient(135deg, #445e75 0%, #5a7e9c 100%);
}

.new-chat-icon {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

.human-service-banner {
  margin: 12rpx 20rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  position: relative;
  z-index: 20;
  flex-shrink: 0;
}

.human-service-banner.waiting {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
}

.human-service-banner.connected {
  background: linear-gradient(135deg, #ecfeff 0%, #cffafe 100%);
}

.human-banner-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

.human-banner-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5b6472;
}

/* 聊天区域：占据标签栏与底部输入区之间的全部剩余空间 */
.chat-area {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 25rpx 30rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  animation: messageSlideIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes messageSlideIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-item.user {
  flex-direction: row-reverse;
}

/* 用户头像容器 */
.avatar-wrapper.user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 14rpx rgba(79, 107, 132, 0.22);
  flex-shrink: 0;
  border: 3rpx solid #ffffff;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
}

/* 客服头像容器 - 现代化设计 */
.avatar-wrapper.service-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  overflow: visible;
  position: relative;
  flex-shrink: 0;
  background: transparent;
}

/* 客服头像柔光环 */
.avatar-glow {
  position: absolute;
  top: -5rpx;
  left: -5rpx;
  right: -5rpx;
  bottom: -5rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(110, 133, 165, 0.35) 0%, rgba(110, 133, 165, 0) 70%);
  z-index: 0;
  animation: glowPulse 3.2s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% {
    opacity: 0.55;
    transform: scale(1);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.08);
  }
}

/* 客服头像图片 - 内圆裁切 */
.avatar-wrapper.service-avatar .avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  position: relative;
  z-index: 1;
  border: 3rpx solid #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(79, 107, 132, 0.28);
}

/* 在线状态指示器 */
.online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #48bb78;
  border: 3rpx solid #ffffff;
  z-index: 2;
  box-shadow: 0 0 8rpx rgba(72, 187, 120, 0.6);
  animation: onlineBlink 2s ease-in-out infinite;
}

@keyframes onlineBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.avatar {
  width: 100%;
  height: 100%;
}

.message-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  max-width: 68%;
}

.message-bubble {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  position: relative;
  word-wrap: break-word;
  transition: all 0.3s ease;
}

.user-bubble {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #ffffff;
  align-self: flex-end;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 30rpx rgba(79, 107, 132, 0.26);
  position: relative;
  overflow: hidden;
}

.user-bubble::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  animation: bubbleShine 3s infinite;
}

@keyframes bubbleShine {
  0% { left: -100%; }
  50%, 100% { left: 100%; }
}

.service-bubble {
  background: linear-gradient(160deg, #ffffff 0%, #f4f7fb 100%);
  color: #2d3748;
  align-self: flex-start;
  border-radius: 24rpx;
  border-top-left-radius: 6rpx;
  box-shadow: 0 6rpx 24rpx rgba(79, 107, 132, 0.14), 0 1rpx 3rpx rgba(79, 107, 132, 0.08);
  border: 1rpx solid rgba(79, 107, 132, 0.1);
  position: relative;
}

/* 客服气泡左上角小尖角 */
.service-bubble::after {
  content: '';
  position: absolute;
  top: 18rpx;
  left: -12rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10rpx 14rpx 10rpx 0;
  border-color: transparent #ffffff transparent transparent;
  filter: drop-shadow(-2rpx 0 2rpx rgba(79, 107, 132, 0.06));
}

.message-text {
  font-size: 30rpx;
  line-height: 1.72;
  word-wrap: break-word;
  letter-spacing: 0.4rpx;
}

/* 用户气泡文字保持白色，客服气泡文字为深色 */
.service-bubble .message-text {
  color: #34405a;
}

.message-time {
  font-size: 20rpx;
  color: #b3bccb;
  margin-top: 8rpx;
  align-self: flex-end;
  letter-spacing: 0.5rpx;
}

/* 客服消息时间靠左对齐 */
.message-item.service .message-time {
  align-self: flex-start;
  padding-left: 6rpx;
}

.typing-bubble {
  padding: 22rpx 24rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #8ea0b5;
  animation: typingPulse 1.2s ease-in-out infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typingPulse {
  0%, 80%, 100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

/* 产品卡片 */
.product-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid #e5e8eb;
  transition: all 0.3s ease;
}

.product-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.2);
}

.product-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 16rpx;
  font-size: 44rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.22);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3748;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 6rpx 0;
}

.product-tag {
  font-size: 20rpx;
  color: #4f6b84;
  background: rgba(79, 107, 132, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

.product-price {
  font-size: 26rpx;
  color: #4f6b84;
  font-weight: 600;
}

/* 产品提示 - 欢迎卡片 */
.product-tip {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(79, 107, 132, 0.4);
  animation: tipFadeIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
}

@keyframes tipFadeIn {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.product-tip::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.tip-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  padding: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.24);
}

.tip-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #ffffff;
}

.tip-online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #48bb78;
  border: 2rpx solid #ffffff;
  box-shadow: 0 0 6rpx rgba(72, 187, 120, 0.6);
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tip-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.92);
  font-weight: 400;
  line-height: 1.7;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 当前选中产品 */
.current-product {
  position: relative;
  z-index: 20;
  flex-shrink: 0;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  padding: 16rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(79, 107, 132, 0.3);
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    transform: translateY(-100%);
  }
  to {
    transform: translateY(0);
  }
}

.current-product-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag-icon {
  font-size: 32rpx;
}

.tag-text {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.tag-change {
  padding: 10rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tag-change:active {
  background-color: rgba(255, 255, 255, 0.35);
  transform: scale(0.95);
}

/* 产品选择面板 */
.product-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.product-panel.show {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.25);
}

.panel-header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.panel-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.panel-title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
}

.panel-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  font-size: 40rpx;
  color: #ffffff;
  transition: all 0.3s ease;
}

.close-btn:active {
  background-color: rgba(255, 255, 255, 0.4);
  transform: scale(0.9);
}

.product-list {
  position: absolute;
  top: 128rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 0 0 36rpx 36rpx;
  padding-bottom: 80rpx;
  padding-bottom: calc(80rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.brand-group {
  padding: 20rpx 24rpx;
}

.brand-group:last-child {
  padding-bottom: 60rpx;
}

.brand-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 8rpx 12rpx;
  background: linear-gradient(135deg, #f0f2f5 0%, #e8ecf1 100%);
  border-radius: 12rpx;
}

.brand-logo {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.brand-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4f6b84;
  flex: 1;
}

.brand-count {
  font-size: 22rpx;
  color: #a0aec0;
  background: rgba(79, 107, 132, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

/* 产品搜索栏 */
.product-search {
  padding: 16rpx 24rpx;
  background: #f8f9fa;
  position: sticky;
  top: 0;
  z-index: 10;
}

.product-search-input {
  width: 100%;
  height: 64rpx;
  background: #ffffff;
  border: 2rpx solid #e5e8eb;
  border-radius: 32rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  color: #2d3748;
}

.product-search-input::placeholder {
  color: #a0aec0;
}

/* 搜索无结果提示 */
.search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.search-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.search-empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3748;
  margin-bottom: 12rpx;
}

.search-empty-desc {
  font-size: 26rpx;
  color: #a0aec0;
  margin-bottom: 32rpx;
  text-align: center;
  line-height: 1.6;
}

.search-empty-action {
  padding: 20rpx 56rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(79, 107, 132, 0.24);
  transition: all 0.3s ease;
}

.search-empty-action:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.4);
}

.search-empty-action-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.product-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border: 2rpx solid #e5e8eb;
}

.product-option:active {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-color: #4f6b84;
  transform: scale(0.96);
  box-shadow: 0 6rpx 20rpx rgba(79, 107, 132, 0.3);
}

.option-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 14rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.25);
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3748;
}

.option-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.option-tag {
  font-size: 20rpx;
  color: #4f6b84;
  background: rgba(79, 107, 132, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

.option-category {
  font-size: 24rpx;
  color: #a0aec0;
}

.option-arrow {
  font-size: 28rpx;
  color: #cbd5e0;
  transition: all 0.3s ease;
}

.product-option:active .option-arrow {
  color: #ffffff;
  transform: translateX(4rpx);
}

/* ========== 底部操作区（快捷入口 + 输入行） ========== */
.bottom-dock {
  position: relative;
  flex-shrink: 0;
  z-index: 60;
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
  border-top: 2rpx solid #e5e8eb;
  box-shadow: 0 -6rpx 28rpx rgba(0, 0, 0, 0.08);
  padding-bottom: 10rpx;
}

/* 快捷入口小按钮（横向可滑动） */
.quick-entry-bar {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  padding: 14rpx 20rpx 2rpx;
}

.quick-entry-list {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 20rpx;
  vertical-align: top;
}

.quick-entry-chip {
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef3f8;
  border: 1rpx solid rgba(79, 107, 132, 0.14);
  border-radius: 26rpx;
  transition: all 0.2s ease;
}

.quick-entry-chip:active {
  transform: scale(0.94);
  background: #dfe8f2;
}

.quick-entry-chip.strong {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.24);
}

.quick-entry-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #4f627d;
  line-height: 1;
}

.quick-entry-chip.strong .quick-entry-text {
  color: #ffffff;
}

/* 语音状态提示行 */
.voice-status-bar {
  padding: 8rpx 24rpx 0;
}

.voice-status-text {
  font-size: 22rpx;
  line-height: 1.4;
  color: #7c8898;
}

.voice-status-bar.active .voice-status-text {
  color: #ef4444;
  font-weight: 600;
}

/* 输入行 */
.input-area {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx 4rpx;
  background: transparent;
}


/* 功能按钮 */
.product-btn,
.phrase-btn,
.voice-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.3);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  flex-shrink: 0;
  margin-left: 4rpx;
  margin-right: 4rpx;
}

.product-btn:active,
.phrase-btn:active,
.voice-btn:active {
  transform: scale(0.88);
  box-shadow: 0 2rpx 8rpx rgba(79, 107, 132, 0.4);
}

.product-btn-icon,
.phrase-btn-icon,
.voice-btn-icon {
  font-size: 28rpx;
}

.voice-btn.recording {
  background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.28);
}

/* 输入框 - 占用左右宽度75% */
.input-field {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 96rpx 0 28rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 44rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  border: 2rpx solid #e5e8eb;
  transition: all 0.3s ease;
  color: #2d3748;
}

.input-field:focus {
  background: #ffffff;
  border-color: #4f6b84;
  box-shadow: 0 0 0 4rpx rgba(79, 107, 132, 0.1);
  outline: none;
}

.input-field::placeholder {
  color: #a0aec0;
}

/* 字数统计放到输入框内部右侧，避免溢出容器遮挡其他元素 */
.char-count {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #a0aec0;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.92);
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  pointer-events: none;
}

/* 输入框容器 - 使用flex布局，输入框占2份，按钮占1份 */
.input-box {
  flex: 2;
  position: relative;
  min-width: 0;
  display: flex;
  align-items: center;
}

/* 发送按钮 - flex:1占1份，与输入框2:1比例 */
.send-btn {
  flex: 1;
  min-width: 130rpx !important;
  max-width: 190rpx;
  height: 88rpx;
  min-height: 88rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%) !important;
  border-radius: 44rpx !important;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.3);
  transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  padding: 0 !important;
  flex-shrink: 0;
  line-height: 1;
  margin: 0 0 0 8rpx;
}

.send-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(79, 107, 132, 0.4);
  background: linear-gradient(135deg, #445e75 0%, #5a7e9c 100%) !important;
}

.send-btn[disabled] {
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e0 100%) !important;
  box-shadow: none;
  opacity: 0.5;
  transform: none;
}

.send-btn::after {
  border: none;
}

.send-text {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
  letter-spacing: 2rpx;
}

/* 快捷短语弹层：绝对定位在底部操作区正上方 */
.quick-phrases {
  position: absolute;
  bottom: 100%;
  left: 20rpx;
  right: 20rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  transform: translateY(24rpx);
  opacity: 0;
  /* 关键：隐藏时必须彻底不可交互，否则会盖住输入框/发送按钮导致点不动 */
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.28s ease, transform 0.28s ease, visibility 0.28s;
  z-index: 70;
  border: 2rpx solid #e5e8eb;
}

.quick-phrases.show {
  transform: translateY(0);
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.quick-phrases-scroll {
  max-height: 46vh;
}

.phrase-item {
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 14rpx;
  margin-bottom: 12rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border: 2rpx solid #e5e8eb;
}

.phrase-item:active {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-color: #4f6b84;
  transform: scale(0.98);
  box-shadow: 0 6rpx 20rpx rgba(79, 107, 132, 0.3);
}

.phrase-item:active .phrase-text {
  color: #ffffff;
}

.phrase-text {
  font-size: 28rpx;
  color: #2d3748;
  transition: all 0.3s ease;
  line-height: 1.5;
}

.phrase-item.clear {
  background: linear-gradient(135deg, #fff9c4 0%, #fff176 100%);
  border-color: #ffd54f;
}

.phrase-item.clear:active {
  background: linear-gradient(135deg, #ffd54f 0%, #ffca28 100%);
}

/* 快捷建议操作（横向滑动，位于输入区上方，不再浮空遮挡） */
.suggested-actions {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  padding: 12rpx 20rpx 0;
}

.suggested-actions-list {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 20rpx;
  vertical-align: top;
}

.action-tag {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(79, 107, 132, 0.3);
  animation: tagSlideIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  transition: all 0.3s ease;
}

@keyframes tagSlideIn {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.action-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1.4;
}

.action-tag:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.4);
}

/* 路由跳转链接按钮 */
.jump-link {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 16rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.24);
}

.jump-link:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(79, 107, 132, 0.3);
}

.jump-link-icon {
  font-size: 28rpx;
}

.jump-link-text {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.jump-link-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  transition: transform 0.3s ease;
}

.jump-link:active .jump-link-arrow {
  transform: translateX(6rpx);
}

/* ========== 历史记录视图 ========== */
.history-container {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 25rpx;
}

/* 历史加载中 */
.history-loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #a0aec0;
}

/* 空状态 */
.history-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 500rpx;
  padding: 60rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3748;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #a0aec0;
  margin-bottom: 36rpx;
}

.empty-action {
  padding: 20rpx 56rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(79, 107, 132, 0.24);
  transition: all 0.3s ease;
}

.empty-action:active {
  transform: scale(0.95);
}

.empty-action-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 历史列表 */
.history-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 120rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.history-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(79, 107, 132, 0.2);
  background: linear-gradient(135deg, #f0f2f5 0%, #e8ecf1 100%);
}

.history-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.history-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.2);
}

.history-avatar-icon {
  font-size: 36rpx;
}

.history-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.history-item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.history-item-title {
  display: block;
  width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3748;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 280rpx;
}

.history-item-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.history-item-status.active {
  color: #48bb78;
  background: rgba(72, 187, 120, 0.1);
}

.history-item-status.transferred {
  color: #ed8936;
  background: rgba(237, 137, 54, 0.1);
}

.history-item-status.completed {
  color: #a0aec0;
  background: rgba(160, 174, 192, 0.1);
}

.history-item-count {
  font-size: 22rpx;
  color: #a0aec0;
}

.history-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.history-item-time {
  font-size: 22rpx;
  color: #a0aec0;
  white-space: nowrap;
}

.history-item-arrow {
  font-size: 24rpx;
  color: #cbd5e0;
}

/* 历史记录操作区 */
.history-item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 删除按钮 */
.history-delete-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(229, 62, 62, 0.08);
  border-radius: 50%;
  transition: all 0.2s ease;
}

.history-delete-icon {
  font-size: 24rpx;
  color: #e53e3e;
  font-weight: bold;
  line-height: 1;
}

.history-delete-btn:active {
  background: rgba(229, 62, 62, 0.2);
  transform: scale(0.85);
}

/* 日期分组头 */
.history-group-header {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 4rpx;
  margin-top: 8rpx;
}

.history-group-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #718096;
  letter-spacing: 1rpx;
}

/* 首问预览（标题下方第一句问题） */
.history-item-preview {
  display: block;
  width: 100%;
  font-size: 24rpx;
  color: #718096;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

/* 元信息行：条数 + 时间 */
.history-item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-item-meta .history-item-count,
.history-item-meta .history-item-time {
  font-size: 22rpx;
  color: #a0aec0;
}

/* 查看历史会话提示条 */
.history-view-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 25rpx 0;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #eef3fb 0%, #e3ecf7 100%);
  border: 1rpx solid rgba(79, 107, 132, 0.18);
  border-radius: 18rpx;
}

.history-view-icon {
  font-size: 30rpx;
}

.history-view-text {
  flex: 1;
  font-size: 26rpx;
  color: #4a5a72;
  font-weight: 500;
}

.history-view-back {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(79, 107, 132, 0.24);
}

.history-view-back:active {
  transform: scale(0.95);
}

.history-view-back-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 新建对话按钮 */
.history-new-btn {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 44rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 44rpx;
  box-shadow: 0 8rpx 28rpx rgba(79, 107, 132, 0.28);
  z-index: 80;
  transition: all 0.3s ease;
}

.history-new-btn:active {
  transform: translateX(-50%) scale(0.94);
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.32);
}

.history-new-icon {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.history-new-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

@media (max-width: 375px) {
  .message-bubble {
    padding: 20rpx 24rpx;
    border-radius: 20rpx;
  }

  .message-text {
    font-size: 28rpx;
  }

  .input-field {
    font-size: 30rpx;
    padding: 0 90rpx 0 24rpx;
  }

  .send-btn {
    min-width: 118rpx !important;
    max-width: 150rpx;
  }

  .quick-entry-chip {
    height: 48rpx;
    padding: 0 18rpx;
  }

  .quick-entry-text {
    font-size: 22rpx;
  }

  .product-btn,
  .phrase-btn,
  .voice-btn {
    width: 48rpx;
    height: 48rpx;
    margin-left: 2rpx;
    margin-right: 2rpx;
  }

  .avatar-wrapper.service-avatar,
  .avatar-wrapper.user-avatar {
    width: 76rpx;
    height: 76rpx;
  }

  .avatar-wrapper.service-avatar .avatar {
    width: 76rpx;
    height: 76rpx;
  }
}
