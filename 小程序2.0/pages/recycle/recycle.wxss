/* pages/recycle/recycle.wxss */

.recycle-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(126, 200, 178, 0.22), transparent 26%),
    linear-gradient(180deg, #edf5f1 0%, #f6f8fb 32%, #f4f6fa 100%);
}

/* 顶部标题 — 回收主题采用清新绿色调 */
.recycle-header {
  padding: 30rpx 28rpx 18rpx;
  background:
    radial-gradient(circle at 84% 18%, rgba(255,255,255,0.22), transparent 16%),
    radial-gradient(circle at 96% 40%, rgba(255,255,255,0.14), transparent 18%),
    linear-gradient(145deg, #2f695e 0%, #4f9782 38%, #7ec8b2 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.recycle-header::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
}

.recycle-header::after {
  content: '';
  position: absolute;
  inset: auto -80rpx -90rpx auto;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 32% 68% 72% 28% / 39% 29% 71% 61%;
  transform: rotate(18deg);
}

.header-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.recycle-header-kicker {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.16);
  color: rgba(255,255,255,0.92);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.recycle-header-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.recycle-header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  position: relative;
  z-index: 1;
}

.header-stat-card {
  width: 220rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.14);
  border: 1rpx solid rgba(255,255,255,0.18);
  backdrop-filter: blur(10rpx);
  position: relative;
  z-index: 1;
  box-shadow: 0 12rpx 30rpx rgba(27, 60, 53, 0.16);
}

.header-stat-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.16);
  margin-bottom: 12rpx;
}

.header-stat-title {
  display: block;
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

.header-stat-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(255,255,255,0.76);
}

/* 主体 */
.recycle-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类边栏 */
.category-sidebar {
  width: 180rpx;
  background: rgba(255,255,255,0.86);
  backdrop-filter: blur(12rpx);
  flex-shrink: 0;
  border-right: 1rpx solid rgba(59, 94, 82, 0.06);
}

.category-item {
  position: relative;
  padding: 28rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.category-item.active {
  background: linear-gradient(90deg, rgba(91, 158, 138, 0.14), rgba(91, 158, 138, 0.04));
}

.category-item-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.category-icon {
  width: 56rpx;
  height: 56rpx;
  transition: transform 0.25s ease;
}

.category-icon-emoji {
  font-size: 40rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
}

.category-item.active .category-icon {
  transform: scale(1.1);
}

.category-name {
  font-size: 24rpx;
  color: #909399;
  text-align: center;
  line-height: 1.3;
  font-weight: 500;
}

.category-item.active .category-name {
  color: #5b9e8a;
  font-weight: 700;
}

.category-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 44rpx;
  background: linear-gradient(180deg, #5b9e8a, #72b8a4);
  border-radius: 0 4rpx 4rpx 0;
  box-shadow: 0 0 8rpx rgba(91, 158, 138, 0.3);
}

/* 右侧产品区 */
.product-area {
  flex: 1;
  background: transparent;
}

.product-content {
  padding: 16rpx 18rpx 0;
}

.category-spotlight {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(140deg, rgba(255,255,255,0.92), rgba(245, 250, 247, 0.98));
  border: 1rpx solid rgba(95, 143, 128, 0.08);
  box-shadow: 0 14rpx 32rpx rgba(75, 112, 100, 0.08);
}

.spotlight-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #427d6e, #77bea8);
  padding: 10rpx;
  flex-shrink: 0;
  box-shadow: 0 10rpx 22rpx rgba(76, 136, 119, 0.24);
}

.spotlight-copy {
  flex: 1;
  min-width: 0;
}

.spotlight-title {
  display: block;
  font-size: 28rpx;
  color: #1f2b25;
  font-weight: 700;
}

.spotlight-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #73807a;
  line-height: 1.4;
}

/* 品牌快捷导航 */
.brand-nav {
  white-space: nowrap;
  padding: 8rpx 0 18rpx;
}

.brand-nav-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(94, 126, 116, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
  transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.brand-nav-item.active {
  background: linear-gradient(135deg, #5b9e8a, #6eb8a0);
  box-shadow: 0 6rpx 18rpx rgba(91, 158, 138, 0.3);
  transform: translateY(-2rpx);
}

.brand-nav-logo {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

/* 品牌图标 - 快捷导航小尺寸 */
.brand-icon-sm {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  flex-shrink: 0;
  box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.1);
}

.brand-nav-item.active .brand-icon-sm {
  box-shadow: 0 2rpx 10rpx rgba(255,255,255,0.35);
}

.brand-nav-name {
  font-size: 20rpx;
  color: #7a7e85;
  font-weight: 500;
}

.brand-nav-item.active .brand-nav-name {
  color: #fff;
  font-weight: 600;
}

/* 品牌区域 */
.brand-section {
  margin-bottom: 28rpx;
}

.brand-header {
  display: flex;
  align-items: center;
  padding: 18rpx 6rpx 14rpx;
  margin-bottom: 10rpx;
}

/* 品牌图标 - 列表大尺寸 */
.brand-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 3rpx 10rpx rgba(0,0,0,0.1);
}

.brand-logo {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.brand-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3340;
  flex: 1;
}

.brand-count {
  font-size: 22rpx;
  color: #909399;
  background: #f4f5f7;
  padding: 6rpx 14rpx;
  border-radius: 22rpx;
  font-weight: 500;
}

/* 型号网格 */
.model-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.model-card {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.94);
  border-radius: 28rpx;
  padding: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(34, 47, 43, 0.07);
  transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border: 1rpx solid rgba(94, 126, 116, 0.06);
}

.model-card:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 22rpx rgba(91,158,138,0.15);
}

.model-image-wrap {
  width: 150rpx;
  height: 136rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  position: relative;
  overflow: hidden;
  padding: 10rpx;
  box-sizing: border-box;
  background: #f7f9fc;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.model-product-image {
  width: 100%;
  height: 100%;
}

.model-visual-shape {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.12);
}

.model-visual-shape-a {
  width: 96rpx;
  height: 96rpx;
  right: -22rpx;
  top: -20rpx;
}

.model-visual-shape-b {
  width: 64rpx;
  height: 64rpx;
  left: -16rpx;
  bottom: 28rpx;
}

.model-visual-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.model-visual-icon {
  width: 40rpx;
  height: 40rpx;
}

.model-visual-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(79, 107, 132, 0.1);
  color: #4f6b84;
  font-size: 18rpx;
  font-weight: 600;
  z-index: 2;
}

.model-device-frame {
  position: absolute;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%);
  width: 78rpx;
  height: 92rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255,255,255,0.82);
  background: rgba(12, 20, 17, 0.12);
  box-shadow: inset 0 0 0 6rpx rgba(255,255,255,0.08);
}

.model-device-frame.phone {
  width: 70rpx;
  height: 98rpx;
  border-radius: 20rpx;
}

.model-device-frame.phone::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.8);
}

.model-device-frame.computer {
  width: 88rpx;
  height: 58rpx;
  top: 54%;
  border-radius: 12rpx;
}

.model-device-frame.computer::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -14rpx;
  transform: translateX(-50%);
  width: 56rpx;
  height: 12rpx;
  border-radius: 0 0 18rpx 18rpx;
  background: rgba(255,255,255,0.7);
}

.model-device-frame.camera {
  width: 92rpx;
  height: 54rpx;
  top: 54%;
  border-radius: 18rpx;
}

.model-device-frame.camera::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.86);
}

.model-device-frame.gaming {
  width: 88rpx;
  height: 50rpx;
  top: 55%;
  border-radius: 999rpx;
}

.model-device-frame.gaming::before,
.model-device-frame.gaming::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.86);
  transform: translateY(-50%);
}

.model-device-frame.gaming::before {
  left: 20rpx;
}

.model-device-frame.gaming::after {
  right: 20rpx;
}

.model-device-frame.drone {
  width: 86rpx;
  height: 18rpx;
  top: 50%;
  border-radius: 999rpx;
}

.model-device-frame.drone::before,
.model-device-frame.drone::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 28rpx;
  height: 2rpx;
  background: rgba(255,255,255,0.9);
}

.model-device-frame.drone::before {
  left: -18rpx;
  transform: rotate(26deg);
}

.model-device-frame.drone::after {
  right: -18rpx;
  transform: rotate(-26deg);
}

.model-visual-bottom {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  bottom: 12rpx;
  z-index: 2;
}

.model-family-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-scene {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  text-align: center;
  color: rgba(255,255,255,0.82);
}

.model-info {
  flex: 1;
  min-width: 0;
}

.model-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3340;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.model-specs {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.model-spec-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.model-spec-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f4f7f5;
  color: #6b7c75;
  font-size: 20rpx;
  line-height: 1;
}

.model-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.model-price-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.model-price-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #c87070;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.model-arrow {
  font-size: 28rpx;
  color: #c0c4cc;
  margin-left: 10rpx;
  transition: transform 0.2s;
}

.model-card:active .model-arrow {
  transform: translateX(6rpx);
  color: #5b9e8a;
}

/* 底部留白 */
.product-bottom-space {
  height: 60rpx;
}

/* ============================================
   搜索栏（页面顶部入口）
   ============================================ */
.search-bar {
  padding: 0 24rpx 18rpx;
  background: linear-gradient(145deg, #2f695e 0%, #4f9782 38%, #7ec8b2 100%);
}

.search-bar-inner {
  display: flex;
  align-items: center;
  height: 74rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 40rpx;
  padding: 0 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 62, 53, 0.16);
  transition: all 0.2s;
}

.search-bar-inner:active {
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.45;
}

.search-placeholder {
  font-size: 26rpx;
  color: #a0a5ae;
}

/* ============================================
   搜索面板（全屏覆盖层）
   ============================================ */
.search-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0);
  visibility: hidden;
  transition: background 0.25s ease;
  display: flex;
  flex-direction: column;
}

.search-panel.show {
  visibility: visible;
  background: rgba(0, 0, 0, 0.3);
}

/* 搜索头部 */
.search-panel-header {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 100rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  /* 适配状态栏 */
  padding-top: env(safe-area-inset-top);
  min-height: 100rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f4f5f7;
  border-radius: 38rpx;
  padding: 0 24rpx;
  transition: all 0.2s;
}

.search-input-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2c3340;
}

.search-input-placeholder {
  color: #bcc0c8;
  font-size: 26rpx;
}

.search-clear-btn {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  background: #c0c4cc;
  border-radius: 50%;
  flex-shrink: 0;
  transition: all 0.15s;
}

.search-clear-btn:active {
  background: #a0a5ae;
  transform: scale(0.9);
}

.search-cancel-text {
  font-size: 28rpx;
  color: #5b9e8a;
  margin-left: 24rpx;
  flex-shrink: 0;
  font-weight: 500;
}

/* 搜索内容区 */
.search-panel-body {
  flex: 1;
  overflow: hidden;
  background: #f0f2f6;
}

.search-scroll {
  height: 100%;
}

/* ===== 搜索历史 ===== */
.search-history {
  padding: 32rpx 24rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.history-clear {
  font-size: 24rpx;
  color: #b0b5be;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #f4f5f7;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  padding: 14rpx 30rpx;
  background: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #5a5e66;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.15s;
}

.history-tag:active {
  background: #ecf8f4;
  color: #5b9e8a;
}

/* ===== 空搜索引导 ===== */
.search-empty-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.empty-guide-icon {
  font-size: 88rpx;
  margin-bottom: 28rpx;
  opacity: 0.3;
}

.empty-guide-text {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 52rpx;
  text-align: center;
}

.hot-search-hint {
  width: 100%;
}

.hot-hint-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #7a7e85;
  margin-bottom: 20rpx;
}

.hot-hint-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* ===== 搜索结果列表 ===== */
.search-results {
  padding: 8rpx 24rpx 32rpx;
}

.search-results-count {
  font-size: 24rpx;
  color: #9ca3af;
  padding: 18rpx 0;
  font-weight: 500;
}

.search-result-card {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.94);
  border-radius: 24rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 12rpx 24rpx rgba(33, 46, 41, 0.06);
  transition: all 0.25s;
  border: 1rpx solid rgba(94, 126, 116, 0.06);
}

.search-result-card:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 20rpx rgba(91, 158, 138, 0.12);
}

.search-result-image {
  width: 116rpx;
  height: 104rpx;
  border-radius: 22rpx;
  display: flex;
  flex-shrink: 0;
  margin-right: 20rpx;
  overflow: hidden;
  position: relative;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
  background: #f7f9fc;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.search-result-product-image {
  width: 100%;
  height: 100%;
}

.search-result-shape {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.12);
}

.search-result-shape-a {
  width: 68rpx;
  height: 68rpx;
  top: -14rpx;
  right: -10rpx;
}

.search-result-shape-b {
  width: 46rpx;
  height: 46rpx;
  left: -12rpx;
  bottom: 24rpx;
}

.search-result-icon {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 8rpx;
}

.search-result-scene {
  position: relative;
  z-index: 1;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.search-result-info {
  flex: 1;
  min-width: 0;
}

.search-result-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.search-result-brand {
  font-size: 24rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.search-result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-result-specs {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-result-price-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.search-result-price-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.search-result-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #c87070;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.search-result-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #5b9e8a;
  background: #ecf8f4;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  margin-left: 12rpx;
  font-weight: 500;
}

