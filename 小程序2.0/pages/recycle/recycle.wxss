.search-no-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.no-result-icon {
  font-size: 84rpx;
  margin-bottom: 28rpx;
}

.no-result-text {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  text-align: center;
}

.no-result-hint {
  font-size: 24rpx;
  color: #b0b5be;
}
