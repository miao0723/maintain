<!--pages/orders/orders.wxml-->
<view class="page-container">
  <!-- 顶部Tab切换 -->
  <view class="top-tabs">
    <view class="tab-item {{currentStatus === 'all' ? 'active' : ''}}" bindtap="switchStatus" data-status="all">
      <text class="tab-text">全部</text>
    </view>
    <view class="tab-item {{currentStatus === 'pending' ? 'active' : ''}}" bindtap="switchStatus" data-status="pending">
      <text class="tab-text">待处理</text>
    </view>
    <view class="tab-item {{currentStatus === 'quoted' ? 'active' : ''}}" bindtap="switchStatus" data-status="quoted">
      <text class="tab-text">待确认</text>
    </view>
    <view class="tab-item {{currentStatus === 'processing' ? 'active' : ''}}" bindtap="switchStatus" data-status="processing">
      <text class="tab-text">处理中</text>
    </view>
    <view class="tab-item {{currentStatus === 'completed' ? 'active' : ''}}" bindtap="switchStatus" data-status="completed">
      <text class="tab-text">已完成</text>
    </view>
    <view class="tab-item {{currentStatus === 'review' ? 'active' : ''}}" bindtap="switchStatus" data-status="review">
      <text class="tab-text">待评价</text>
    </view>
    <!-- 内部人员专属：免付款申请独立归类，不与普通待处理混在一起 -->
    <view wx:if="{{isInternal}}" class="tab-item internal-tab {{currentStatus === 'internal_pending' ? 'active' : ''}}" bindtap="switchStatus" data-status="internal_pending">
      <text class="tab-text">🏢 内部申请</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y wx:if="{{filteredOrders.length > 0}}">
    <view class="order-item {{item.progressUnread ? 'has-unread' : ''}}" wx:for="{{filteredOrders}}" wx:key="id" bindtap="viewOrderDetail" data-order="{{item}}">
      <!-- 未读进度红点 -->
      <view class="unread-dot" wx:if="{{item.progressUnread}}"></view>
      <view class="order-header">
        <view class="order-type">
          <text class="type-badge {{item.orderType === 'repair' ? 'repair' : 'recycle'}}">
            {{item.orderType === 'repair' ? '维修' : '回收'}}
          </text>
          <text class="order-id">订单号：{{item.order_id || item.orderId}}</text>
        </view>
        <view class="order-status">
          <text class="status-text {{getStatusClass(item.status)}}">{{getStatusText(item.status)}}</text>
          <text wx:if="{{item.isInternalOrder}}" class="internal-tag">🏢 内部免付款</text>
          <text wx:if="{{item.afterSalesLabel}}" class="as-tag" style="background: {{item.afterSalesBg}}; color: {{item.afterSalesColor}}">{{item.afterSalesIcon}} {{item.afterSalesLabel}}</text>
        </view>
      </view>

      <view class="order-content">
        <view class="device-info">
          <text class="device-icon">{{item.icon || '📱'}}</text>
          <view class="device-details">
            <text class="device-name">{{item.deviceName}}</text>
            <text class="device-desc" wx:if="{{item.problem}}">{{item.problem}}</text>
            <text class="device-desc" wx:elif="{{item.model}}">{{item.model}}</text>
          </view>
        </view>
        <view class="order-price" wx:if="{{item.price}}">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{item.price}}</text>
        </view>
      </view>

      <!-- 可视化进度条 -->
      <view class="progress-section" wx:if="{{item.progressSteps.length > 0}}">
        <view class="progress-header">
          <text class="progress-title">{{item.isRecycle ? '回收进度' : '维修进度'}}</text>
          <text class="progress-percent" style="color: {{item.statusColor}}">{{item.progressPercentText}}</text>
        </view>
        <view class="progress-steps">
          <block wx:for="{{item.progressSteps}}" wx:key="key" wx:for-item="step">
            <view class="pstep-col {{step.state}}">
              <view class="pstep-dot {{step.state}}">
                <text class="pstep-icon">{{step.icon}}</text>
              </view>
              <text class="pstep-label">{{step.label}}</text>
            </view>
            <view wx:if="{{step.index < item.progressSteps.length - 1}}" class="pstep-line {{step.state}}">
              <view class="pstep-line-fill"></view>
            </view>
          </block>
        </view>
        <view class="progress-bar">
          <view class="progress-bar-fill" style="width: {{item.progressPercent}}%; background: linear-gradient(90deg, {{item.statusColor}}, {{item.statusColor}}99)"></view>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-time">{{item.createTime}}</text>
        <view class="order-actions">
          <!-- 待处理：编辑 + 退款 + 取消 一排均分 -->
          <block wx:if="{{item.status === 'pending'}}">
            <button class="action-btn edit" catchtap="openEditModal" data-order="{{item}}">编辑</button>
            <button class="action-btn refund" catchtap="openRefundModal" data-order="{{item}}">申请退款</button>
            <button class="action-btn cancel" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
          </block>
          <!-- 待确认报价：接受 + 拒绝 + 查看报价 -->
          <block wx:if="{{item.status === 'quoted'}}">
            <button class="action-btn accept" catchtap="acceptQuote" data-order="{{item}}">接受报价</button>
            <button class="action-btn reject" catchtap="openRejectQuoteModal" data-order="{{item}}">拒绝报价</button>
            <button class="action-btn detail" catchtap="viewDetail" data-order="{{item}}">查看详情</button>
          </block>
          <!-- 已确认报价：去支付 / 申请进度 / 联系客服 -->
          <block wx:if="{{item.status === 'confirmed'}}">
            <button class="action-btn primary" wx:if="{{item.paymentStatus !== 'paid'}}" catchtap="payOrder" data-order="{{item}}">立即支付</button>
            <button class="action-btn" wx:if="{{item.paymentStatus === 'paid'}}" catchtap="goToProgressApply" data-order="{{item}}">📝 申请进度</button>
            <button class="action-btn" catchtap="contactService" data-id="{{item.id}}">联系客服</button>
          </block>
          <!-- 处理中：查看进度 + 申请进度 + 联系客服 -->
          <block wx:if="{{item.status === 'processing'}}">
            <button class="action-btn {{item.progressUnread ? 'primary unread-btn' : 'primary'}}" catchtap="viewProgress" data-order="{{item}}">{{item.progressUnread ? '🔧 新进度' : '查看进度'}}</button>
            <button class="action-btn" catchtap="goToProgressApply" data-order="{{item}}">📝 申请进度</button>
            <button class="action-btn" catchtap="contactService" data-id="{{item.id}}">联系客服</button>
          </block>
          <!-- 已完成：查看详情 + 维修报告 + 申请售后 -->
          <block wx:if="{{item.status === 'completed'}}">
            <button class="action-btn" catchtap="viewDetail" data-order="{{item}}">查看详情</button>
            <button class="action-btn primary" wx:if="{{item.repairReportFiles && item.repairReportFiles.length > 0}}" catchtap="viewRepairReport" data-order="{{item}}">查看维修报告</button>
            <button class="action-btn after-sales" catchtap="openAfterSales" data-order="{{item}}">🛠 申请售后</button>
          </block>
          <!-- 待评价：去评价 + 申请售后 -->
          <button class="action-btn primary" wx:if="{{item.status === 'review'}}" catchtap="goToReview" data-order="{{item}}">评价订单</button>
          <button class="action-btn after-sales" wx:if="{{item.status === 'review'}}" catchtap="openAfterSales" data-order="{{item}}">🛠 申请售后</button>
          <!-- 已取消 -->
          <button class="action-btn disabled" wx:if="{{item.status === 'cancelled'}}" disabled>已取消</button>
          <!-- 内部免付款申请待确认：查看详情 + 撤回申请 -->
          <block wx:if="{{item.status === 'internal_pending'}}">
            <button class="action-btn detail" catchtap="viewDetail" data-order="{{item}}">查看详情</button>
            <button class="action-btn cancel" catchtap="cancelOrder" data-id="{{item.id}}">撤回申请</button>
          </block>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{isLoading && filteredOrders.length === 0}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && filteredOrders.length === 0}}">
    <view class="empty-icon">📦</view>
    <text class="empty-text">暂无订单</text>
    <text class="empty-desc">您还没有相关订单哦</text>
    <button class="empty-btn" bindtap="goToRepair">去下单</button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>

  <!-- ===================== 申请售后弹窗 ===================== -->
  <view class="modal-overlay" wx:if="{{showAfterSalesModal}}" bindtap="closeAfterSales">
    <view class="modal-container as-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">申请售后</text>
        <view class="modal-close" bindtap="closeAfterSales">
          <text class="close-icon">×</text>
        </view>
      </view>

      <scroll-view class="modal-body" scroll-y>
        <!-- 订单信息 -->
        <view class="as-order-info">
          <view class="as-info-row">
            <text class="as-info-label">订单号</text>
            <text class="as-info-value">{{afterSalesOrder.orderNo || ''}}</text>
          </view>
          <view class="as-info-row">
            <text class="as-info-label">设备</text>
            <text class="as-info-value">{{afterSalesOrder.deviceName || ''}}</text>
          </view>
        </view>

        <!-- 售后类型 -->
        <view class="as-section">
          <text class="as-section-title">售后类型 <text class="as-required">*</text></text>
          <view class="as-type-list">
            <view
              wx:for="{{afterSalesTypes}}"
              wx:key="value"
              class="as-type-item {{afterSalesForm.type === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectAfterSalesType"
            >{{item.label}}</view>
          </view>
        </view>

        <!-- 具体产品 -->
        <view class="as-section">
          <text class="as-section-title">具体产品 <text class="as-required">*</text></text>
          <input
            class="as-input"
            placeholder="请填写需要售后的具体产品"
            value="{{afterSalesForm.product_name}}"
            data-field="product_name"
            bindinput="onAfterSalesInput"
          />
          <input
            class="as-input"
            style="margin-top: 16rpx;"
            placeholder="产品型号（选填）"
            value="{{afterSalesForm.product_model}}"
            data-field="product_model"
            bindinput="onAfterSalesInput"
          />
        </view>

        <!-- 问题描述 -->
        <view class="as-section">
          <text class="as-section-title">问题描述 <text class="as-required">*</text></text>
          <textarea
            class="as-textarea"
            placeholder="请描述具体的售后问题"
            maxlength="500"
            value="{{afterSalesForm.description}}"
            data-field="description"
            bindinput="onAfterSalesInput"
          />
          <text class="as-count">{{afterSalesForm.description.length}}/500</text>
        </view>

        <!-- 联系电话 -->
        <view class="as-section">
          <text class="as-section-title">联系电话</text>
          <input
            class="as-input"
            type="number"
            placeholder="请填写联系电话"
            value="{{afterSalesForm.contact_phone}}"
            data-field="contact_phone"
            bindinput="onAfterSalesInput"
          />
        </view>

        <!-- 图片凭证 -->
        <view class="as-section">
          <text class="as-section-title">图片凭证</text>
          <view class="as-images">
            <view wx:for="{{afterSalesForm.images}}" wx:key="index" class="as-image-item">
              <image class="as-image" src="{{item.url || item}}" mode="aspectFill"></image>
              <view class="as-image-remove" catchtap="removeAfterSalesImage" data-index="{{index}}">×</view>
            </view>
            <view wx:if="{{afterSalesForm.images.length < 9}}" class="as-image-add" bindtap="chooseAfterSalesImage">
              <text class="as-upload-icon">📷</text>
              <text class="as-upload-text">添加图片</text>
            </view>
          </view>
        </view>

        <view class="as-warning">
          <text class="as-warning-icon">⚠️</text>
          <text class="as-warning-text">提交后管理员会尽快为您处理该售后问题</text>
        </view>
      </scroll-view>

      <view class="modal-actions">
        <button class="modal-btn seconary" bindtap="closeAfterSales">取消</button>
        <button class="modal-btn as-submit" loading="{{afterSalesSubmitting}}" bindtap="submitAfterSales">提交申请</button>
      </view>
    </view>
  </view>
</view>

<!-- ===================== 编辑订单弹窗 ===================== -->
<view class="modal-overlay" wx:if="{{showEditModal}}" bindtap="closeEditModal">
  <view class="modal-container edit-modal" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">编辑订单</text>
      <view class="modal-close" bindtap="closeEditModal">
        <text class="close-icon">×</text>
      </view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 收货地址 -->
      <view class="edit-section">
        <view class="edit-section-header">
          <text class="edit-section-title">收货地址</text>
          <view class="address-pick-btn" bindtap="showAddressPicker">
            <text class="address-pick-icon">📍</text>
            <text class="address-pick-text">从地址管理选择</text>
          </view>
        </view>
        <view class="edit-form-group">
          <text class="edit-label">联系人</text>
          <input class="edit-input" value="{{editFormData.contactName}}" bindinput="onEditInput" data-field="contactName" placeholder="请输入联系人姓名"/>
        </view>
        <view class="edit-form-group">
          <text class="edit-label">联系电话</text>
          <input class="edit-input" value="{{editFormData.contactPhone}}" type="number" bindinput="onEditInput" data-field="contactPhone" placeholder="请输入联系电话"/>
        </view>
        <view class="edit-form-group region-group">
          <text class="edit-label">所在地区</text>
          <view class="region-input" bindtap="onEditRegionChange">
            <text class="region-text {{editFormData.province ? '' : 'placeholder'}}">{{editFormData.province ? editFormData.province + ' ' + editFormData.city + ' ' + editFormData.district : '请选择省/市/区'}}</text>
            <text class="region-arrow">▸</text>
          </view>
          <picker mode="region" value="{{editRegionValue}}" bindchange="onEditRegionConfirm" class="region-picker-hidden">
          </picker>
        </view>
        <view class="edit-form-group">
          <text class="edit-label">详细地址</text>
          <textarea class="edit-textarea" value="{{editFormData.detailAddress}}" bindinput="onEditInput" data-field="detailAddress" placeholder="请输入详细地址"/>
        </view>
      </view>

      <!-- 问题描述 -->
      <view class="edit-section">
        <text class="edit-section-title">订单信息</text>
        <view class="edit-form-group">
          <text class="edit-label">问题描述</text>
          <textarea class="edit-textarea" value="{{editFormData.problemDescription}}" bindinput="onEditInput" data-field="problemDescription" placeholder="请描述设备问题"/>
        </view>
        <view class="edit-form-group">
          <text class="edit-label">补充说明</text>
          <textarea class="edit-textarea" value="{{editFormData.customDescription}}" bindinput="onEditInput" data-field="customDescription" placeholder="补充说明（选填）"/>
        </view>
      </view>
    </scroll-view>

    <view class="modal-actions">
      <button class="modal-btn secondary" bindtap="closeEditModal">取消</button>
      <button class="modal-btn save-btn" bindtap="saveEditOrder" disabled="{{savingEdit}}" loading="{{savingEdit}}">保存</button>
    </view>
  </view>
</view>

<!-- ===================== 地址选择弹窗 ===================== -->
<view class="modal-overlay" wx:if="{{showAddressPickerModal}}" bindtap="closeAddressPicker">
  <view class="modal-container address-picker-modal" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择收货地址</text>
      <view class="modal-close" bindtap="closeAddressPicker">
        <text class="close-icon">×</text>
      </view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <view wx:if="{{addressListLoading}}" class="modal-loading">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载地址中...</text>
      </view>

      <view wx:elif="{{addressList.length === 0}}" class="address-empty">
        <text class="address-empty-icon">📭</text>
        <text class="address-empty-text">暂无保存的地址</text>
        <text class="address-empty-hint">请手动填写或前往地址管理添加</text>
      </view>

      <view wx:else class="address-list">
        <view
          wx:for="{{addressList}}"
          wx:key="id"
          class="address-item {{editFormData._selectedAddrId === item.id ? 'active' : ''}}"
          data-addr="{{item}}"
          bindtap="onSelectAddress"
        >
          <view class="address-item-left">
            <view class="address-contact-row">
              <text class="address-contact-name">{{item.contact_name || item.contactName}}</text>
              <text class="address-contact-phone">{{item.contact_phone || item.contactPhone}}</text>
              <view wx:if="{{item.is_default || item.isDefault}}" class="address-default-tag">默认</view>
            </view>
            <text class="address-detail-text">{{item.province || ''}}{{item.city || ''}}{{item.district || ''}}{{item.detail_address || item.detail || ''}}</text>
          </view>
          <view class="address-item-check">
            <view wx:if="{{editFormData._selectedAddrId === item.id}}" class="address-check-icon">✓</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="modal-actions">
      <button class="modal-btn secondary" bindtap="closeAddressPicker">取消</button>
      <button class="modal-btn save-btn" bindtap="confirmAddressSelect" disabled="{{!editFormData._selectedAddrId}}">确认选择</button>
    </view>
  </view>
</view>

<!-- ===================== 退款申请弹窗 ===================== -->
<view class="modal-overlay" wx:if="{{showRefundModal}}" bindtap="closeRefundModal">
  <view class="modal-container refund-modal" catchtap="stopPropagation">
    <!-- 步骤1: 填写退款信息 -->
    <block wx:if="{{refundStep === 1}}">
      <view class="modal-header">
        <text class="modal-title">申请退款</text>
        <view class="modal-close" bindtap="closeRefundModal">
          <text class="close-icon">×</text>
        </view>
      </view>

      <scroll-view class="modal-body" scroll-y>
        <!-- 退款订单信息 -->
        <view class="refund-order-info">
          <view class="refund-info-row">
            <text class="refund-info-label">订单编号</text>
            <text class="refund-info-value">{{refundOrderData.orderNo || ''}}</text>
          </view>
          <view class="refund-info-row">
            <text class="refund-info-label">退款金额</text>
            <text class="refund-info-value refund-amount">¥{{refundOrderData.price || '0.0'}}</text>
          </view>
        </view>

        <!-- 退款原因选择 -->
        <view class="refund-section">
          <text class="refund-section-title">退款原因 <text class="required-star">*</text></text>
          <view class="refund-reason-list">
            <view
              wx:for="{{refundReasons}}"
              wx:key="value"
              class="refund-reason-item {{refundFormData.reason === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectRefundReason"
            >
              <view class="reason-radio">
                <view wx:if="{{refundFormData.reason === item.value}}" class="reason-radio-checked"></view>
              </view>
              <text class="reason-text">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 补充说明 -->
        <view class="refund-section">
          <text class="refund-section-title">补充说明</text>
          <textarea
            class="refund-desc-input"
            placeholder="请描述具体退款原因（选填）"
            maxlength="200"
            value="{{refundFormData.description}}"
            bindinput="onRefundDescInput"
          />
          <text class="refund-desc-count">{{refundFormData.description.length}}/200</text>
        </view>

        <!-- 提示 -->
        <view class="refund-warning">
          <text class="warning-icon">⚠️</text>
          <text class="warning-text">提交退款后订单将自动取消，此操作不可撤销</text>
        </view>
      </scroll-view>

      <view class="modal-actions">
        <button class="modal-btn secondary" bindtap="closeRefundModal">取消</button>
        <button class="modal-btn refund-next-btn" bindtap="goToRefundConfirm" disabled="{{!refundFormData.reason}}">下一步</button>
      </view>
    </block>

    <!-- 步骤2: 确认退款 -->
    <block wx:elif="{{refundStep === 2}}">
      <view class="modal-header refund-confirm-header">
        <text class="modal-title">确认退款</text>
        <view class="modal-close" bindtap="backToRefundStep1">
          <text class="close-icon">×</text>
        </view>
      </view>

      <scroll-view class="modal-body" scroll-y>
        <view class="refund-confirm-card">
          <view class="refund-confirm-icon">💰</view>
          <text class="refund-confirm-amount">¥{{refundOrderData.price || '0.0'}}</text>
          <text class="refund-confirm-label">退款金额</text>
        </view>

        <view class="refund-confirm-info">
          <view class="confirm-info-row">
            <text class="confirm-info-label">订单编号</text>
            <text class="confirm-info-value">{{refundOrderData.orderNo || ''}}</text>
          </view>
          <view class="confirm-info-row">
            <text class="confirm-info-label">退款原因</text>
            <text class="confirm-info-value">{{refundReasonLabel}}</text>
          </view>
          <view class="confirm-info-row" wx:if="{{refundFormData.description}}">
            <text class="confirm-info-label">补充说明</text>
            <text class="confirm-info-value">{{refundFormData.description}}</text>
          </view>
        </view>

        <view class="refund-confirm-warning">
          <view class="confirm-warning-box">
            <text class="confirm-warning-title">请仔细确认</text>
            <text class="confirm-warning-item">· 退款金额将原路返回</text>
            <text class="confirm-warning-item">· 订单状态将变更为"已取消"</text>
            <text class="confirm-warning-item">· 此操作不可撤销，请谨慎操作</text>
          </view>
        </view>
      </scroll-view>

      <view class="modal-actions">
        <button class="modal-btn secondary" bindtap="backToRefundStep1">返回修改</button>
        <button class="modal-btn refund-confirm-btn" bindtap="submitRefund" disabled="{{refundSubmitting}}" loading="{{refundSubmitting}}">确认退款</button>
      </view>
    </block>
  </view>
</view>

<!-- ===================== 拒绝报价弹窗 ===================== -->
<view class="modal-overlay" wx:if="{{showRejectQuoteModal}}" bindtap="closeRejectQuoteModal">
  <view class="modal-container reject-quote-modal" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">拒绝报价</text>
      <view class="modal-close" bindtap="closeRejectQuoteModal">
        <text class="close-icon">×</text>
      </view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 报价信息 -->
      <view class="reject-quote-info">
        <view class="reject-quote-row">
          <text class="reject-quote-label">订单编号</text>
          <text class="reject-quote-value">{{rejectQuoteOrderData.orderNo || ''}}</text>
        </view>
        <view class="reject-quote-row">
          <text class="reject-quote-label">报价金额</text>
          <text class="reject-quote-value reject-quote-price">{{rejectQuoteOrderData.quotePrice || ''}}</text>
        </view>
      </view>

      <!-- 拒绝原因 -->
      <view class="reject-quote-section">
        <text class="reject-quote-section-title">拒绝原因 <text class="required-star">*</text></text>
        <textarea
          class="reject-quote-input"
          placeholder="请说明为什么拒绝这个报价"
          maxlength="200"
          value="{{rejectQuoteFormData.reason}}"
          bindinput="onRejectQuoteReasonInput"
        />
        <text class="reject-quote-count">{{rejectQuoteFormData.reason.length}}/200</text>
      </view>

      <!-- 提示 -->
      <view class="reject-quote-warning">
        <text class="warning-icon">⚠️</text>
        <text class="warning-text">拒绝后需要管理员重新报价，确定继续？</text>
      </view>
    </scroll-view>

    <view class="modal-actions">
      <button class="modal-btn secondary" bindtap="closeRejectQuoteModal">取消</button>
      <button class="modal-btn reject-confirm-btn" bindtap="submitRejectQuote" disabled="{{!rejectQuoteFormData.reason || quoteSubmitting}}" loading="{{quoteSubmitting}}">确认拒绝</button>
    </view>
  </view>
</view>

<!-- ===================== 订单详情弹窗 ===================== -->
<view class="modal-overlay" wx:if="{{showOrderDetailModal}}" bindtap="closeOrderDetailModal">
  <view class="modal-container" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">订单详情</text>
      <view class="modal-close" bindtap="closeOrderDetailModal">
        <text class="close-icon">×</text>
      </view>
    </view>
    
    <scroll-view class="modal-content" scroll-y>
      <!-- 加载状态 -->
      <view wx:if="{{modalLoading}}" class="modal-loading">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      
      <!-- 订单详情内容 -->
      <view wx:elif="{{modalOrderDetail}}" class="order-detail-content">
        <!-- 订单状态卡片 -->
        <view class="detail-status-card">
          <view class="status-header">
            <text class="order-no">{{modalOrderDetail.order_id || modalOrderDetail.orderId}}</text>
            <view class="status-badge status-{{modalOrderDetail.status}}">
              <text>{{modalOrderDetail.statusText}}</text>
            </view>
          </view>
          <view class="status-body">
            <text class="order-type-label">{{modalOrderDetail.orderType}}</text>
            <text class="detail-device-icon">{{modalOrderDetail.deviceIcon}}</text>
            <text class="detail-device-name">{{modalOrderDetail.deviceName}}</text>
          </view>
          <view class="status-footer">
            <text class="detail-price">¥{{modalOrderDetail.price}}</text>
            <text class="detail-create-time">创建时间: {{modalOrderDetail.createTime}}</text>
          </view>
        </view>

        <!-- 维修进度 -->
        <view class="detail-info-section" wx:if="{{modalOrderDetail.progressSteps && modalOrderDetail.progressSteps.length > 0}}">
          <view class="section-title">{{modalOrderDetail.isRecycle ? '回收进度' : '维修进度'}}</view>
          <view class="progress-steps">
            <block wx:for="{{modalOrderDetail.progressSteps}}" wx:key="key" wx:for-item="step">
              <view class="pstep-col {{step.state}}">
                <view class="pstep-dot {{step.state}}">
                  <text class="pstep-icon">{{step.icon}}</text>
                </view>
                <text class="pstep-label">{{step.label}}</text>
              </view>
              <view wx:if="{{step.index < modalOrderDetail.progressSteps.length - 1}}" class="pstep-line {{step.state}}">
                <view class="pstep-line-fill"></view>
              </view>
            </block>
          </view>
          <view class="progress-bar">
            <view class="progress-bar-fill" style="width: {{modalOrderDetail.progressPercent}}%; background: linear-gradient(90deg, {{modalOrderDetail.statusColor}}, {{modalOrderDetail.statusColor}}99)"></view>
          </view>
        </view>

        <!-- 订单信息 -->
        <view class="detail-info-section">
          <view class="section-title">订单信息</view>
          
          <view class="info-item">
            <text class="info-label">设备型号:</text>
            <text class="info-value">{{modalOrderDetail.deviceModel}}</text>
          </view>
          
          <view class="info-item" wx:if="{{modalOrderDetail.deviceCondition}}">
            <text class="info-label">设备状态:</text>
            <text class="info-value">{{modalOrderDetail.deviceCondition}}</text>
          </view>
          
          <view class="info-item" wx:if="{{modalOrderDetail.serviceType}}">
            <text class="info-label">服务方式:</text>
            <text class="info-value">{{modalOrderDetail.serviceType === 'shop' ? '到店维修' : modalOrderDetail.serviceType === 'home' ? '上门服务' : modalOrderDetail.serviceType}}</text>
          </view>
          
          <view class="info-item" wx:if="{{modalOrderDetail.problemDescription}}">
            <text class="info-label">问题描述:</text>
            <text class="info-value">{{modalOrderDetail.problemDescription}}</text>
          </view>
          
          <view class="info-item" wx:if="{{modalOrderDetail.customDescription}}">
            <text class="info-label">自定义描述:</text>
            <text class="info-value">{{modalOrderDetail.customDescription}}</text>
          </view>
        </view>

        <!-- 金额信息 -->
        <view class="detail-info-section" wx:if="{{modalOrderDetail.estimatedPrice || modalOrderDetail.actualPrice}}">
          <view class="section-title">金额信息</view>
          <view class="info-item" wx:if="{{modalOrderDetail.estimatedPrice}}">
            <text class="info-label">预估价格:</text>
            <text class="info-value price-text">¥{{modalOrderDetail.estimatedPrice}}</text>
          </view>
          <view class="info-item" wx:if="{{modalOrderDetail.actualPrice}}">
            <text class="info-label">实际价格:</text>
            <text class="info-value price-text">¥{{modalOrderDetail.actualPrice}}</text>
          </view>
        </view>

        <!-- 时间线 -->
        <view class="detail-info-section" wx:if="{{modalOrderDetail.completedAt || modalOrderDetail.updatedAt}}">
          <view class="section-title">时间线</view>
          
          <view class="timeline">
            <view class="timeline-item">
              <view class="timeline-dot"></view>
              <view class="timeline-content">
                <text class="timeline-title">订单创建</text>
                <text class="timeline-time">{{modalOrderDetail.createTime}}</text>
              </view>
            </view>
            
            <view class="timeline-item" wx:if="{{modalOrderDetail.updatedAt}}">
              <view class="timeline-dot"></view>
              <view class="timeline-content">
                <text class="timeline-title">订单更新</text>
                <text class="timeline-time">{{modalOrderDetail.updatedAt}}</text>
              </view>
            </view>
            
            <view class="timeline-item" wx:if="{{modalOrderDetail.completedAt}}">
              <view class="timeline-dot"></view>
              <view class="timeline-content">
                <text class="timeline-title">订单完成</text>
                <text class="timeline-time">{{modalOrderDetail.completedAt}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 加载失败状态 -->
      <view wx:else class="modal-error">
        <text class="error-icon">⚠️</text>
        <text class="error-text">加载失败</text>
        <text class="error-desc">无法获取订单详情</text>
      </view>
    </scroll-view>
    
    <!-- 弹窗操作按钮 -->
    <view class="modal-actions">
      <button class="modal-btn secondary" bindtap="closeOrderDetailModal">关闭</button>
      <button class="modal-btn primary" bindtap="goToFullDetail" wx:if="{{modalOrderDetail}}">
        查看完整详情
      </button>
    </view>
  </view>
</view>
