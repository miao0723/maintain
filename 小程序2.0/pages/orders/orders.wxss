/* pages/orders/orders.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 顶部Tab切换 */
.top-tabs {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 15rpx 10rpx;
  border-radius: 10rpx;
  position: relative;
}

.tab-item.active {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
}

.tab-text {
  font-size: 26rpx;
  color: #333333;
}

.tab-item.active .tab-text {
  color: #ffffff;
  font-weight: bold;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
  height: calc(100vh - 120rpx);
}

.order-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.order-item.has-unread {
  border-left: 6rpx solid #0ea5e9;
}

/* 未读进度红点 */
.unread-dot {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 18rpx;
  height: 18rpx;
  background: #ff4757;
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(255, 71, 87, 0.5);
  animation: dotPulse 1.5s ease-in-out infinite;
  z-index: 2;
}

@keyframes dotPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.3); }
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.order-type {
  display: flex;
  align-items: center;
}

.type-badge {
  padding: 6rpx 15rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 15rpx;
}

.type-badge.repair {
  background-color: #e3f2ff;
  color: #436f95;
}

.type-badge.recycle {
  background-color: #fff4e6;
  color: #ffa502;
}

.order-id {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  display: flex;
  align-items: center;
}

.status-text {
  font-size: 26rpx;
  font-weight: bold;
}

.status-text.pending {
  color: #ffa502;
}

.status-text.processing {
  color: #436f95;
}

.status-text.completed {
  color: #2ed573;
}

.status-text.review {
  color: #ff6b6b;
}

.status-text.cancelled {
  color: #999999;
}

.status-text.internal_pending {
  color: #d97706;
}

/* 内部人员免付款专属徽标 */
.internal-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  line-height: 1;
}

/* 内部申请专属 tab */
.tab-item.internal-tab .tab-text {
  color: #d97706;
}

.tab-item.internal-tab.active {
  background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);
}

.tab-item.internal-tab.active .tab-text {
  color: #ffffff;
}

/* 订单内容 */
.order-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.device-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.device-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  border-radius: 15rpx;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.device-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.device-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.device-desc {
  font-size: 24rpx;
  color: #999999;
}

.order-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff6b6b;
}

.price-value {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
}

/* ===== 可视化维修进度条 ===== */
.progress-section {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8faff 0%, #f0f4ff 100%);
  border-radius: 16rpx;
  border: 2rpx solid #e8eeff;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
}

.progress-percent {
  font-size: 26rpx;
  font-weight: 700;
}

.progress-steps {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.pstep-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
  z-index: 1;
}

.pstep-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
  transition: all 0.4s ease;
}

.pstep-dot.done {
  background: linear-gradient(135deg, #10b981, #059669);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.4);
}

.pstep-dot.active {
  background: #fff;
  border: 3rpx solid #436f95;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  animation: pstepPulse 1.8s ease-in-out infinite;
}

.pstep-dot.pending {
  background: #e5e7eb;
  box-shadow: none;
}

.pstep-icon {
  font-size: 20rpx;
  line-height: 1;
}

.pstep-dot.pending .pstep-icon {
  opacity: 0.35;
  filter: grayscale(1);
}

.pstep-label {
  font-size: 18rpx;
  color: #999;
  text-align: center;
  line-height: 1.3;
  transition: color 0.3s ease;
}

.pstep-col.done .pstep-label {
  color: #059669;
  font-weight: 500;
}

.pstep-col.active .pstep-label {
  color: #436f95;
  font-weight: 600;
}

.pstep-line {
  flex: 1;
  display: flex;
  align-items: center;
  height: 48rpx;
  margin-bottom: 6rpx;
  position: relative;
  z-index: 0;
}

.pstep-line-fill {
  flex: 1;
  height: 4rpx;
  border-radius: 4rpx;
  background: #e5e7eb;
  position: relative;
  overflow: hidden;
}

.pstep-line.done .pstep-line-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, #10b981, #059669);
  border-radius: 4rpx;
}

.pstep-line.active .pstep-line-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  bottom: 0;
  background: linear-gradient(90deg, #10b981, #436f95);
  border-radius: 4rpx;
  animation: pstepLineGrow 1.5s ease-in-out infinite;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
  overflow: hidden;
  margin-top: 4rpx;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

@keyframes pstepPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4); }
  50% { transform: scale(1.08); box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.6); }
}

@keyframes pstepLineGrow {
  0%, 100% { width: 40%; opacity: 0.7; }
  50% { width: 60%; opacity: 1; }
}

/* ===== 订单底部 + 操作按钮（一排排列） ===== */
.order-footer {
  display: flex;
  flex-direction: column;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 22rpx;
  color: #bbbbbb;
  margin-bottom: 14rpx;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

/* 操作按钮统一紧凑尺寸 */
.action-btn {
  flex: 1;
  padding: 0 4rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  color: #666666;
  border: none;
  min-height: 56rpx;
  margin-left: 0;
  box-sizing: border-box;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  color: #ffffff;
}

.action-btn.edit {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  color: #ffffff;
}

.action-btn.refund {
  background: #fff7ed;
  color: #ea580c;
  border: 2rpx solid #fed7aa;
}

.action-btn.cancel {
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #e5e7eb;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 50rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 50rpx;
}

.empty-btn {
  width: 300rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  border-radius: 40rpx;
  color: #ffffff;
  font-size: 28rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

/* 底部间距 */
.bottom-space {
  height: 20rpx;
}

/* 加载中状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-state .loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #436f95;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-state .loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 禁用按钮 */
.action-btn.disabled {
  background-color: #f0f0f0;
  color: #ccc;
}

/* 接受报价按钮 */
.action-btn.accept {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
  color: #fff !important;
  border: none;
  font-weight: 500;
}

.action-btn.accept::after {
  border: none;
}

/* 拒绝报价按钮 */
.action-btn.reject {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
  color: #fff !important;
  border: none;
  font-weight: 500;
}

.action-btn.reject::after {
  border: none;
}

/* 查看详情按钮（报价卡片中的次要按钮） */
.action-btn.detail {
  background-color: #f4f6f9 !important;
  color: #666 !important;
  border: none;
}

.action-btn.detail::after {
  border: none;
}

/* 未读进度按钮高亮 */
.action-btn.unread-btn {
  background: linear-gradient(135deg, #0ea5e9 0%, #06b6d4 100%) !important;
  color: #fff !important;
  animation: unreadPulse 2s ease-in-out infinite;
}

@keyframes unreadPulse {
  0%, 100% { box-shadow: 0 2rpx 8rpx rgba(14, 165, 233, 0.3); }
  50% { box-shadow: 0 4rpx 16rpx rgba(14, 165, 233, 0.6); }
}

/* ===================== 拒绝报价弹窗样式 ===================== */
.reject-quote-modal {
  max-height: 80vh;
}

.reject-quote-info {
  padding: 24rpx;
  background: linear-gradient(135deg, #e8f1f8 0%, #ddd6fe 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #c4b5fd;
}

.reject-quote-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.reject-quote-label {
  font-size: 24rpx;
  color: #5b21b6;
}

.reject-quote-value {
  font-size: 24rpx;
  color: #4c1d95;
  font-weight: 500;
}

.reject-quote-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #d97706;
}

.reject-quote-section {
  margin-bottom: 24rpx;
}

.reject-quote-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 14rpx;
  display: block;
}

.reject-quote-input {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.reject-quote-count {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 6rpx;
}

.reject-quote-warning {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 18rpx 20rpx;
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.reject-confirm-btn {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
  color: #fff !important;
  font-weight: 600 !important;
}

/* ===================== 通用弹窗样式 ===================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.modal-container {
  width: 100%;
  max-width: 700rpx;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f5f5f5;
  color: #999;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.close-icon {
  margin-top: -5rpx;
}

.modal-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx 36rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 36rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fff;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn::after {
  border: none;
}

.modal-btn.secondary {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #07c160 0%, #05a854 100%);
  color: white;
}

.modal-btn[disabled] {
  opacity: 0.5;
}

/* ===================== 编辑弹窗样式 ===================== */
.edit-modal {
  max-height: 85vh;
}

.edit-section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fafbfc;
  border-radius: 16rpx;
  border: 1rpx solid #f0f0f0;
}

.edit-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.edit-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 从地址管理选择按钮 */
.address-pick-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  border-radius: 20rpx;
}

.address-pick-icon {
  font-size: 22rpx;
}

.address-pick-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.edit-form-group {
  margin-bottom: 18rpx;
}

.edit-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
  display: block;
}

.edit-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.edit-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 地区选择器 */
.region-group {
  position: relative;
}

.region-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.region-text {
  flex: 1;
  color: #333;
}

.region-text.placeholder {
  color: #bbb;
}

.region-arrow {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.region-picker-hidden {
  position: absolute;
  left: -9999rpx;
  top: -9999rpx;
  width: 0;
  height: 0;
}

.save-btn {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%) !important;
  color: #fff !important;
}

/* ===================== 地址选择弹窗样式 ===================== */
.address-picker-modal {
  max-height: 75vh;
}

.address-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.address-empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.address-empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.address-empty-hint {
  font-size: 24rpx;
  color: #999;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.address-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  transition: all 0.25s;
}

.address-item.active {
  border-color: #436f95;
  background: #f8f7ff;
}

.address-item-left {
  flex: 1;
  min-width: 0;
}

.address-contact-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.address-contact-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.address-contact-phone {
  font-size: 26rpx;
  color: #666;
}

.address-default-tag {
  padding: 2rpx 12rpx;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  border-radius: 10rpx;
  font-size: 20rpx;
  color: #fff;
}

.address-detail-text {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.address-item-check {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.address-check-icon {
  font-size: 28rpx;
  color: #436f95;
  font-weight: 700;
}

/* ===================== 退款弹窗样式 ===================== */
.refund-modal {
  max-height: 85vh;
}

.refund-order-info {
  padding: 24rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #fde68a;
}

.refund-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.refund-info-label {
  font-size: 24rpx;
  color: #92400e;
}

.refund-info-value {
  font-size: 24rpx;
  color: #78350f;
  font-weight: 500;
}

.refund-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #dc2626;
}

.refund-section {
  margin-bottom: 24rpx;
}

.refund-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 14rpx;
  display: block;
}

.required-star {
  color: #dc2626;
}

.refund-reason-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.refund-reason-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  transition: all 0.25s;
}

.refund-reason-item.active {
  border-color: #436f95;
  background: #f8f7ff;
}

.reason-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.refund-reason-item.active .reason-radio {
  border-color: #436f95;
}

.reason-radio-checked {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
}

.reason-text {
  font-size: 26rpx;
  color: #333;
}

.refund-desc-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.refund-desc-count {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 6rpx;
}

.refund-warning {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 18rpx 20rpx;
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.warning-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.warning-text {
  font-size: 22rpx;
  color: #991b1b;
  line-height: 1.6;
}

.refund-next-btn {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%) !important;
  color: #fff !important;
}

/* 退款确认步骤样式 */
.refund-confirm-header {
  border-bottom-color: #fecaca;
}

.refund-confirm-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  background: linear-gradient(135deg, #fef2f2 0%, #fff5f5 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #fecaca;
}

.refund-confirm-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.refund-confirm-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #dc2626;
  margin-bottom: 8rpx;
}

.refund-confirm-label {
  font-size: 24rpx;
  color: #999;
}

.refund-confirm-info {
  background: #fafbfc;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #f0f0f0;
}

.confirm-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10rpx 0;
}

.confirm-info-row + .confirm-info-row {
  border-top: 1rpx solid #f0f0f0;
}

.confirm-info-label {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.confirm-info-value {
  font-size: 24rpx;
  color: #333;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.refund-confirm-warning {
  margin-bottom: 16rpx;
}

.confirm-warning-box {
  padding: 20rpx 24rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 12rpx;
}

.confirm-warning-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 12rpx;
  display: block;
}

.confirm-warning-item {
  font-size: 24rpx;
  color: #a16207;
  line-height: 1.8;
  display: block;
}

.refund-confirm-btn {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
  color: #fff !important;
  font-weight: 600 !important;
}

/* ===================== 订单详情弹窗样式 ===================== */
.modal-content {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 0 36rpx;
}

.modal-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.modal-loading .loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.modal-loading .loading-text {
  font-size: 28rpx;
  color: #999;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.modal-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.error-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.error-desc {
  font-size: 26rpx;
  color: #999;
}

/* 订单详情内容 */
.order-detail-content {
  padding: 30rpx 0;
}

.detail-status-card {
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  color: white;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.2);
}

.detail-status-card .status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.detail-status-card .order-no {
  font-size: 32rpx;
  font-weight: 600;
}

.detail-status-card .status-badge {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.detail-status-card .status-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.detail-status-card .order-type-label {
  font-size: 28rpx;
  font-weight: 500;
}

.detail-status-card .detail-device-icon {
  font-size: 36rpx;
}

.detail-status-card .detail-device-name {
  font-size: 26rpx;
  opacity: 0.9;
  flex: 1;
}

.detail-status-card .status-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-status-card .detail-price {
  font-size: 32rpx;
  font-weight: 600;
}

.detail-status-card .detail-create-time {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 详情信息区域 */
.detail-info-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f0f0f0;
}

.detail-info-section .section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  margin-bottom: 25rpx;
  align-items: flex-start;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.info-value.price-text {
  color: #ff6b6b;
  font-weight: 600;
}

/* 时间线 */
.timeline {
  position: relative;
}

.timeline-item {
  display: flex;
  margin-bottom: 40rpx;
  position: relative;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  background-color: #436f95;
  border-radius: 50%;
  margin-right: 30rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 20rpx;
  bottom: -40rpx;
  width: 1rpx;
  background-color: #e0e0e0;
  z-index: 0;
}

.timeline-content {
  flex: 1;
  padding-top: -5rpx;
}

.timeline-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 26rpx;
  color: #999;
}

/* 阻止事件冒泡 */
.stopPropagation {
  /* empty */
}

/* ===================== 申请售后 ===================== */
/* 订单卡片上的售后状态标签 */
.as-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
}

/* 申请售后按钮（橙色，与已完成/待评价订单搭配） */
.action-btn.after-sales {
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
  color: #fff;
  border: none;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, 0.3);
}

.action-btn.after-sales::after {
  border: none;
}

/* 售后弹窗 */
.as-modal {
  max-height: 88vh;
}

.as-order-info {
  padding: 24rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #fed7aa;
}

.as-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.as-info-label {
  font-size: 24rpx;
  color: #9a3412;
}

.as-info-value {
  font-size: 24rpx;
  color: #7c2d12;
  font-weight: 500;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.as-section {
  margin-bottom: 24rpx;
}

.as-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 14rpx;
  display: block;
}

.as-required {
  color: #ef4444;
}

.as-type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.as-type-item {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
  padding: 20rpx 12rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s;
}

.as-type-item.active {
  border-color: #f97316;
  background: #fff7ed;
  color: #ea580c;
  font-weight: 600;
}

.as-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.as-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.as-count {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 8rpx;
}

.as-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.as-image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.as-image {
  width: 100%;
  height: 100%;
}

.as-image-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}

.as-image-add {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
}

.as-upload-icon {
  font-size: 48rpx;
}

.as-upload-text {
  font-size: 22rpx;
  color: #64748b;
}

.as-warning {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.as-warning-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.as-warning-text {
  font-size: 24rpx;
  color: #991b1b;
  line-height: 1.6;
}

/* 提交售后按钮 */
.modal-btn.as-submit {
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
  color: #fff;
}

.modal-btn.as-submit::after {
  border: none;
}
