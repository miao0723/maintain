<!--pages/profile-edit/profile-edit.wxml-->
<view class="page-container">
  <!-- 头像编辑 -->
  <view class="avatar-section">
    <view class="avatar-wrapper">
      <button class="avatar-container" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none" style="padding:0;border:none;background:transparent;line-height:normal;">
        <view class="avatar-ring {{userInfo.avatarUrl ? 'has-img' : ''}}">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
          <view wx:else class="avatar-placeholder">
            <text class="avatar-camera-icon">📷</text>
            <text class="avatar-camera-text">点击上传头像</text>
          </view>
        </view>
        <view class="avatar-badge">✏️</view>
      </button>
      <view class="avatar-tip">
        <text class="tip-text">读取微信头像或从相册上传</text>
      </view>
    </view>
  </view>

  <!-- 账号信息（角色中英文映射 + 手机号掩码） -->
  <view class="form-section">
    <view class="section-header">
      <text class="section-title">账号信息</text>
    </view>
    <view class="account-card">
      <view class="account-row">
        <text class="account-label">当前角色</text>
        <view class="role-tag role-{{roleTheme}}">
          <text class="role-icon">{{roleIcon}}</text>
          <text class="role-text">{{roleText || '客户 / Customer'}}</text>
        </view>
      </view>
      <text class="role-desc" wx:if="{{roleDesc}}">{{roleDesc}}</text>
      <view class="account-row" wx:if="{{uidText}}">
        <text class="account-label">账号 ID</text>
        <text class="account-value">{{uidText}}</text>
      </view>
      <view class="account-row" wx:if="{{createdAtText}}">
        <text class="account-label">注册时间</text>
        <text class="account-value">{{createdAtText}}</text>
      </view>
    </view>
  </view>

  <!-- 信息表单 -->
  <view class="form-section">
    <view class="section-header">
      <text class="section-title">基本信息</text>
    </view>
    <view class="form-item">
      <view class="form-label">
        <text class="label-dot"></text>
        <text class="label-text">昵称</text>
      </view>
      <input
        class="form-input"
        type="nickname"
        placeholder="点击一键填入微信昵称"
        placeholder-class="form-input-ph"
        value="{{userInfo.nickName}}"
        bindnickname="onFillNickName"
        bindinput="onNicknameInput"
        maxlength="20"/>
      <text class="char-count {{userInfo.nickName.length >= 18 ? 'near' : ''}}">{{userInfo.nickName.length}}/20</text>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-dot"></text>
        <text class="label-text">真实姓名</text>
      </view>
      <input
        class="form-input"
        type="text"
        placeholder="请输入真实姓名"
        value="{{realName}}"
        bindinput="onRealNameInput"
        maxlength="10"/>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-dot"></text>
        <text class="label-text">联系电话</text>
      </view>
      <view class="phone-row">
        <view class="phone-left">
          <text class="phone-icon">📱</text>
          <text class="phone-value {{phoneNumber ? '' : 'phone-empty'}}">{{phoneDisplay || '尚未绑定手机号'}}</text>
          <text class="phone-toggle" wx:if="{{phoneNumber}}" catchtap="togglePhoneVisible">{{phoneVisible ? '隐藏' : '显示'}}</text>
        </view>
        <button
          class="phone-btn"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber">{{phoneNumber ? '更换' : '微信授权'}}</button>
      </view>
      <view class="privacy-tip" wx:if="{{phoneNumber}}">
        <text class="privacy-tip-text">{{phoneVisible ? '已展示完整号码，核对后建议点击「隐藏」' : '手机号已做中间四位掩码处理，保护您的隐私'}}</text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-dot"></text>
        <text class="label-text">电子邮箱</text>
      </view>
      <input
        class="form-input"
        type="text"
        placeholder="请输入电子邮箱"
        value="{{email}}"
        bindinput="onEmailInput"/>
    </view>
  </view>

  <!-- 默认地址 -->
  <view class="form-section">
    <view class="section-header">
      <text class="section-title">默认地址</text>
    </view>
    <view class="address-display" bindtap="goToAddress" wx:if="{{defaultAddress}}">
      <view class="address-info">
        <text class="address-name">{{defaultAddress.contactName}} {{defaultAddress.contactPhone}}</text>
        <text class="address-detail">{{defaultAddress.province}} {{defaultAddress.city}} {{defaultAddress.district}} {{defaultAddress.detail}}</text>
      </view>
      <text class="address-arrow">›</text>
    </view>
    <view class="no-address" bindtap="goToAddress" wx:else>
      <text class="no-address-text">暂无默认地址，点击添加</text>
      <text class="no-address-arrow">›</text>
    </view>
  </view>

  <!-- 默认单位 -->
  <view class="form-section">
    <view class="section-header">
      <text class="section-title">默认单位</text>
    </view>
    <view class="unit-display" bindtap="goToUnits" wx:if="{{defaultUnit}}">
      <view class="unit-info">
        <text class="unit-name">{{defaultUnit.name}}</text>
        <text class="unit-detail">{{defaultUnit.address}}</text>
      </view>
      <text class="unit-arrow">›</text>
    </view>
    <view class="no-unit" bindtap="goToUnits" wx:else>
      <text class="no-unit-text">暂无默认单位，点击添加</text>
      <text class="no-unit-arrow">›</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="bottom-action">
    <button class="save-btn" bindtap="saveProfile" loading="{{isSaving}}" disabled="{{isSaving}}">{{isSaving ? '保存中...' : '保存修改'}}</button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>
</view>
<confirm-modal id="confirmModal" />
