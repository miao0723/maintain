/* pages/profile-edit/profile-edit.wxss */

.page-container {
  min-height: 100vh;
  background-color: #eef1f6;
  padding-bottom: 40rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* ============ 头像区域（透明背景，仅保留圆形头像框） ============ */
.avatar-section {
  position: relative;
  background: transparent;
  padding: 60rpx 0 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.avatar-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

/* 头像按钮：必须 !important 顶掉 app.wxss 全局 button 的钢蓝 !important */
.avatar-container {
  position: relative;
  width: 200rpx !important;
  height: 200rpx !important;
  min-width: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  border-radius: 50% !important;
  overflow: visible !important;
  line-height: normal;
  transition: transform 0.25s ease;
}
.avatar-container::after {
  border: none !important;
  border-radius: 50% !important;
}
.avatar-container:active {
  transform: scale(0.95);
}

/* 圆形头像框：白色细环 + 柔和阴影，选中后转橙色环 */
.avatar-ring {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffffff 0%, #eaf0f6 100%);
  border: 4rpx solid #ffffff;
  box-shadow:
    0 0 0 2rpx #e2e8ef,
    0 14rpx 34rpx rgba(33, 52, 73, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
  transition: box-shadow 0.3s ease;
}
.avatar-ring.has-img {
  box-shadow:
    0 0 0 2rpx #e2e8ef,
    0 14rpx 34rpx rgba(33, 52, 73, 0.2);
}
.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.avatar-camera-icon {
  font-size: 56rpx;
}
.avatar-camera-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #7c8b9a;
}

/* 编辑角标（右下角橙色小圆） */
.avatar-badge {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a3d 0%, #f5701e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 112, 30, 0.4);
  border: 4rpx solid #ffffff;
  z-index: 2;
}

.avatar-tip {
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}
.tip-text {
  font-size: 24rpx;
  color: #6a7b8c;
  letter-spacing: 1rpx;
}

/* ============ 表单卡片 ============ */
.form-section {
  background-color: #ffffff;
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(33, 52, 73, 0.06);
}
.section-header {
  padding: 28rpx 0 12rpx;
}
.section-title {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 700;
}
.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f1f3f6;
  position: relative;
}
.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 150rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.label-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #ff8a3d 0%, #f5701e 100%);
  margin-right: 14rpx;
}
.label-text {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
}

.form-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2c3e50;
  padding: 4rpx 20rpx;
}
.form-input-ph {
  color: #b3bcc6;
}

.char-count {
  position: absolute;
  right: 0;
  bottom: 28rpx;
  font-size: 22rpx;
  color: #b3bcc6;
}
.char-count.near {
  color: #f5701e;
}

/* ============ 账号信息（角色映射 + 隐私脱敏） ============ */
.account-card {
  padding: 8rpx 0 24rpx;
}
.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.account-label {
  font-size: 27rpx;
  color: #7b8794;
}
.account-value {
  font-size: 27rpx;
  color: #2c3e50;
  font-weight: 500;
}
.role-desc {
  display: block;
  font-size: 22rpx;
  color: #96a1ad;
  line-height: 1.6;
  padding: 0 0 6rpx;
}

/* 角色徽标：中文 / 英文 双标识 */
.role-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #eef3f8;
  border: 1rpx solid rgba(200, 214, 228, 0.9);
}
.role-icon {
  font-size: 22rpx;
  margin-right: 8rpx;
}
.role-text {
  font-size: 24rpx;
  color: #4f6b84;
  font-weight: 600;
}
.role-tag.role-internal {
  background: #eef7f1;
  border-color: rgba(190, 226, 205, 0.9);
}
.role-tag.role-internal .role-text {
  color: #3f7a5a;
}
.role-tag.role-repair {
  background: #fdf3e7;
  border-color: rgba(240, 219, 184, 0.9);
}
.role-tag.role-repair .role-text {
  color: #a3702a;
}
.role-tag.role-admin,
.role-tag.role-super-admin {
  background: #f3eefb;
  border-color: rgba(219, 205, 240, 0.9);
}
.role-tag.role-admin .role-text,
.role-tag.role-super-admin .role-text {
  color: #6b4fa3;
}

/* ============ 手机号行 ============ */
.phone-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}
.phone-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.phone-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.phone-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  white-space: nowrap;
  overflow: visible !important;
  text-overflow: clip !important;
}
.phone-value.phone-empty {
  color: #b3bcc6;
  font-weight: 400;
}

/* 更换按钮：!important 顶掉全局 button 的钢蓝 !important */
.phone-btn {
  margin: 0 0 0 12rpx !important;
  padding: 0 20rpx !important;
  width: auto !important;
  min-width: 0 !important;
  height: 52rpx !important;
  min-height: 0 !important;
  line-height: 52rpx !important;
  font-size: 22rpx !important;
  font-weight: 600 !important;
  color: #ffffff !important;
  background: linear-gradient(135deg, #ff8a3d 0%, #f5701e 100%) !important;
  border-radius: 26rpx !important;
  border: none !important;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(245, 112, 30, 0.22);
}
.phone-btn::after {
  border: none !important;
}
.phone-btn:active {
  transform: scale(0.96);
}

/* 掩码 / 明文切换 + 隐私提示 */
.phone-toggle {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #4f6b84;
  background: #f1f5f8;
  border-radius: 18rpx;
}
.privacy-tip {
  padding: 0 0 24rpx;
}
.privacy-tip-text {
  font-size: 21rpx;
  color: #96a1ad;
  line-height: 1.6;
}

/* ============ 地址 / 单位 ============ */
.address-display,
.unit-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
}
.address-info,
.unit-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.address-name,
.unit-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.address-detail,
.unit-detail {
  font-size: 24rpx;
  color: #99a3ad;
  line-height: 36rpx;
}
.address-arrow,
.unit-arrow {
  font-size: 40rpx;
  color: #c4cdd6;
  margin-left: 16rpx;
}

.no-address,
.no-unit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
}
.no-address-text,
.no-unit-text {
  font-size: 26rpx;
  color: #99a3ad;
}
.no-address-arrow,
.no-unit-arrow {
  font-size: 40rpx;
  color: #c4cdd6;
}

/* ============ 保存按钮 ============ */
.bottom-action {
  padding: 44rpx 32rpx 12rpx;
}
.save-btn {
  width: 100% !important;
  height: 94rpx !important;
  min-height: 94rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff8a3d 0%, #f5701e 100%) !important;
  border-radius: 47rpx !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 700 !important;
  letter-spacing: 2rpx;
  border: none !important;
  box-shadow: 0 14rpx 30rpx rgba(245, 112, 30, 0.3);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.save-btn::after {
  border: none !important;
}
.save-btn:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 8rpx 18rpx rgba(245, 112, 30, 0.34);
}

.bottom-space {
  height: 20rpx;
}
