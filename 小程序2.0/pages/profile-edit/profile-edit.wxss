/* pages/profile-edit/profile-edit.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

/* 头像区域 */
.avatar-section {
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  padding: 76rpx 0 56rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.avatar-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
  animation: rotate 22s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.avatar-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.avatar-container {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  overflow: visible;
  transition: transform 0.3s ease;
}

.avatar-container:active {
  transform: scale(0.96);
}

.avatar-circle {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffffff 0%, #eef3f8 100%);
  border: 2rpx dashed rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.avatar-circle.has-img {
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.28);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #ffffff;
  transition: all 0.3s ease;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-camera-icon {
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.9);
}

.avatar-camera-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.avatar-tip {
  margin-top: 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 表单区块 */
.form-section {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 6rpx 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 150rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.form-input-ph {
  color: #b3bcc6;
}

.char-count {
  position: absolute;
  right: 0;
  bottom: 30rpx;
  font-size: 22rpx;
  color: #b3bcc6;
  transition: color 0.2s ease;
}

.char-count.near {
  color: #d97757;
}

/* 手机号授权行 */
.phone-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.phone-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-value.phone-empty {
  color: #b3bcc6;
}

.phone-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a3d 0%, #f5701e 100%);
  border-radius: 30rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(245, 112, 30, 0.24);
}

.phone-btn::after {
  border: none;
}

.phone-btn:active {
  transform: scale(0.97);
}

/* 区块头部 */
.section-header {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  color: #666666;
  font-weight: bold;
}

/* 地址显示 */
.address-display,
.unit-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
}

.address-info,
.unit-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.address-name,
.unit-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.address-detail,
.unit-detail {
  font-size: 24rpx;
  color: #999999;
  line-height: 36rpx;
}

.address-arrow,
.unit-arrow {
  font-size: 28rpx;
  color: #cccccc;
}

/* 无地址/单位 */
.no-address,
.no-unit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
}

.no-address-text,
.no-unit-text {
  font-size: 26rpx;
  color: #999999;
}

.no-address-arrow,
.no-unit-arrow {
  font-size: 28rpx;
  color: #cccccc;
}

/* 底部操作 */
.bottom-action {
  padding: 30rpx;
}

.save-btn {
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  border-radius: 45rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.save-btn::after {
  border: none;
}

/* 底部间距 */
.bottom-space {
  height: 20rpx;
}
