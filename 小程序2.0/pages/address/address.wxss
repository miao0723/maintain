/* pages/address/address.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

/* 地址列表 */
.address-list {
  padding: 20rpx;
  height: calc(100vh - 140rpx);
}

.address-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.address-content {
  margin-bottom: 20rpx;
}

.address-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.contact-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.contact-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
}

.contact-phone {
  font-size: 26rpx;
  color: #666666;
}

.default-badge {
  padding: 6rpx 15rpx;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.address-detail {
  margin-bottom: 15rpx;
}

.address-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 40rpx;
}

.address-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  padding: 6rpx 15rpx;
  background-color: #f0f4ff;
  color: #436f95;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.address-actions {
  display: flex;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #333333;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn.delete {
  background-color: #fff0f0;
  color: #ff4757;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 50rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 底部操作 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e0e0e0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.add-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
  border-radius: 40rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.add-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

/* 底部间距 */
.bottom-space {
  height: 20rpx;
}
