<!--pages/address/address.wxml-->
<view class="page-container">
  <!-- 地址列表 -->
  <scroll-view class="address-list" scroll-y wx:if="{{addressList.length > 0}}">
    <view class="address-item" wx:for="{{addressList}}" wx:key="id">
      <view class="address-content" bindtap="editAddress" data-address="{{item}}">
        <view class="address-header">
          <view class="contact-info">
            <text class="contact-name">{{item.contactName}}</text>
            <text class="contact-phone">{{item.contactPhone}}</text>
          </view>
          <view class="default-badge" wx:if="{{item.isDefault}}">默认</view>
        </view>
        <view class="address-detail">
          <text class="address-text">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</text>
        </view>
        <view class="address-tags" wx:if="{{item.tags && item.tags.length > 0}}">
          <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
      </view>
      <view class="address-actions">
        <button class="action-btn" bindtap="setDefault" data-id="{{item.id}}" wx:if="{{!item.isDefault}}">
          设为默认
        </button>
        <button class="action-btn delete" bindtap="deleteAddress" data-id="{{item.id}}">
          删除
        </button>
      </view>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{addressList.length === 0}}">
    <view class="empty-icon">📍</view>
    <text class="empty-text">暂无收货地址</text>
    <text class="empty-desc">添加您的收货地址，方便服务</text>
  </view>

  <!-- 底部添加按钮 -->
  <view class="bottom-action">
    <button class="add-btn" bindtap="addAddress">
      <text class="btn-icon">+</text>
      <text>添加新地址</text>
    </button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>
</view>
<confirm-modal id="confirmModal" />
