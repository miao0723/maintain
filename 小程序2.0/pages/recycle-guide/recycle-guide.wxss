/* pages/recycle-guide/recycle-guide.wxss - 一题一页模式 */

.guide-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6fa;
  overflow: hidden;
}

/* ============================================
   产品头部
   ============================================ */
.question-header {
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  flex-shrink: 0;
  z-index: 10;
}

.qh-product {
  display: flex;
  align-items: center;
}

.qh-brand-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.12);
}

.qh-info {
  flex: 1;
  min-width: 0;
}

.qh-model {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.qh-specs {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.qh-base-price {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.qh-price-label {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
}

.qh-price-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #e74c3c;
  font-family: 'Menlo', monospace;
}

/* ============================================
   进度条
   ============================================ */
.progress-section {
  background: #fff;
  padding: 20rpx 32rpx 16rpx;
  flex-shrink: 0;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #e8ecf1;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.35s ease;
}

.progress-step.active .step-dot {
  background: linear-gradient(135deg, #5a6e8a, #7b93b0);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(90,110,138,0.35);
  transform: scale(1.15);
}

.progress-step.done .step-dot {
  background: linear-gradient(135deg, #27ae60, #2ecc71);
  color: #fff;
  font-size: 24rpx;
}

.step-label {
  font-size: 18rpx;
  color: #ccc;
  margin-top: 6rpx;
  transition: color 0.3s;
}

.progress-step.active .step-label,
.progress-step.done .step-label {
  color: #5a6e8a;
  font-weight: 500;
}

.progress-bar {
  height: 6rpx;
  background: #e8ecf1;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5a6e8a, #7b93b0);
  border-radius: 3rpx;
  transition: width 0.4s ease;
}

/* ============================================
   问题区域
   ============================================ */
.question-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.question-stage.visible {
  opacity: 1;
  transform: translateY(0);
}

.question-stage.enter {
  opacity: 0;
  transform: translateY(30rpx);
}

.question-stage.exit {
  opacity: 0;
  transform: translateY(-20rpx);
}

.question-scroll {
  flex: 1;
  padding: 20rpx 28rpx;
}

/* 问题卡片 */
.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
}

/* 装饰元素 */
.qc-deco {
  position: absolute;
  top: -40rpx;
  right: -30rpx;
  opacity: 0.06;
}

.qc-deco-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #5a6e8a;
}

.qc-deco-line {
  position: absolute;
  top: 60rpx;
  right: 30rpx;
  width: 120rpx;
  height: 4rpx;
  background: #5a6e8a;
  border-radius: 2rpx;
}

/* 问题标题区 */
.qc-header {
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.qc-step-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: linear-gradient(135deg, #5a6e8a15, #6b829918);
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #5a6e8a;
  margin-bottom: 16rpx;
}

.qc-question-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.qc-hint {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 选项列表 */
.qc-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  position: relative;
  z-index: 1;
}

.qc-option {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  background: #f8f9fc;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.qc-option::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #5a6e8a, #7b93b0);
  border-radius: 0 3rpx 3rpx 0;
  opacity: 0;
  transition: opacity 0.2s;
}

.qc-option:active {
  background: #eef1f8;
  border-color: #5a6e8a;
  transform: scale(0.98);
}

.qc-option:active::before {
  opacity: 1;
}

.qc-option.has-desc {
  padding: 24rpx 20rpx;
}

.qco-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f0f2f5, #e8ecf1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 18rpx;
}

.qco-icon {
  font-size: 30rpx;
}

.qc-option:active .qco-icon-wrap {
  background: linear-gradient(135deg, #5a6e8a18, #7b93b018);
}

.qco-content {
  flex: 1;
  min-width: 0;
}

.qco-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 2rpx;
}

.qco-desc {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  line-height: 1.4;
}

.qco-rate {
  display: inline-block;
  margin-top: 6rpx;
  padding: 2rpx 10rpx;
  background: #fff3cd;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #856404;
}

.qco-arrow {
  font-size: 28rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 8rpx;
  transition: all 0.2s;
}

.qc-option:active .qco-arrow {
  color: #5a6e8a;
  transform: translateX(4rpx);
}

/* 实时估价 */
.qc-live-price {
  margin-top: 28rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #5a6e8a08, #7b93b008);
  border-radius: 16rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.live-price-label {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.live-price-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #5a6e8a;
  font-family: 'Menlo', 'SF Mono', monospace;
}

/* 输入类问题 */
.qc-input-area {
  position: relative;
  z-index: 1;
}

.qc-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  background: #f8f9fc;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.6;
  box-sizing: border-box;
}

.qc-textarea-placeholder {
  color: #bbb;
}

.qc-input-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.qc-skip-btn {
  padding: 16rpx 32rpx;
  background: #f0f2f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

.qc-confirm-btn {
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #5a6e8a, #6b8299);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(90,110,138,0.3);
}

/* ============================================
   估价中
   ============================================ */
.evaluating-stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.evaluating-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.eval-spinner {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
}

.spinner-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 4rpx solid #e8ecf1;
  border-top-color: #5a6e8a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.spinner-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.eval-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.eval-sub {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
}

.eval-dots {
  display: flex;
  gap: 10rpx;
}

.eval-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  animation: evalBounce 1.4s infinite ease-in-out both;
}

.eval-dot:nth-child(1) { animation-delay: -0.32s; }
.eval-dot:nth-child(2) { animation-delay: -0.16s; }
.eval-dot:nth-child(3) { animation-delay: 0s; }

@keyframes evalBounce {
  0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

/* ============================================
   估价结果页面
   ============================================ */
.result-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.result-stage {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx;
}

/* 价格 hero 卡片 */
.result-hero {
  background: linear-gradient(135deg, #4a5e7a, #5a6e8a, #6b8299);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(90,110,138,0.3);
  margin-bottom: 20rpx;
}

.result-badge {
  display: inline-flex;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 20rpx;
  backdrop-filter: blur(10rpx);
}

.result-badge.ai {
  background: rgba(39,174,96,0.3);
}

.result-price-block {
  margin: 8rpx 0;
}

.result-price-currency {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.75);
  margin-right: 4rpx;
}

.result-price-number {
  font-size: 80rpx;
  font-weight: 800;
  color: #fff;
  font-family: 'Menlo', 'SF Mono', monospace;
  letter-spacing: 2rpx;
}

.result-price-range {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

/* 评估摘要 */
.result-summary {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.rs-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.rs-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rs-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.rs-item:last-child {
  border-bottom: none;
}

.rs-q {
  font-size: 26rpx;
  color: #6b7280;
}

.rs-a {
  font-size: 26rpx;
  font-weight: 600;
  color: #5a6e8a;
  text-align: right;
  max-width: 55%;
}

/* 产品确认 */
.result-product {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.rp-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rp-info {
  flex: 1;
  min-width: 0;
}

.rp-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.rp-specs {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* 地址选择 */
.result-address {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 2rpx dashed #d0d5dd;
}

.ra-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.ra-content {
  flex: 1;
  min-width: 0;
}

.ra-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.ra-detail {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  line-height: 1.4;
}

.ra-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: #9ca3af;
}

.ra-arrow {
  font-size: 32rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.result-bottom-space {
  height: 24rpx;
}

/* ============================================
   底部操作栏
   ============================================ */
.guide-footer {
  background: #fff;
  padding: 24rpx 28rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  flex-shrink: 0;
}

.submit-row {
  display: flex;
  gap: 20rpx;
}

.contact-btn.ghost {
  flex: 0 0 170rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #f0f2f5 !important;
  color: #5a6e8a !important;
  font-size: 28rpx !important;
  font-weight: 500 !important;
  border-radius: 14rpx !important;
  box-shadow: none !important;
}

.submit-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  border-radius: 14rpx !important;
}

.submit-btn[disabled] {
  opacity: 0.5;
}

/* ============================================
   地址选择弹窗
   ============================================ */
.address-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  animation: fadeIn 0.2s ease;
}

.address-picker {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 60vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.address-picker.show {
  transform: translateY(0);
}

.address-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.picker-close {
  font-size: 32rpx;
  color: #ccc;
  padding: 8rpx;
}

.address-picker-list {
  max-height: 40vh;
}

.address-picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.address-picker-item.active {
  background: #f0f4ff;
}

.picker-item-info {
  flex: 1;
}

.picker-item-name {
  display: block;
  font-size: 28rpx;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.picker-item-addr {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
}

.picker-check {
  font-size: 32rpx;
  color: #5a6e8a;
  font-weight: 700;
}

.address-empty {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

.address-picker-footer {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.add-addr-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx !important;
  border-radius: 12rpx !important;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
