<!--pages/recycle-guide/recycle-guide.wxml-->
<view class="guide-page">

  <!-- ==================== 问题阶段 ==================== -->
  <block wx:if="{{!evaluationComplete && !isEvaluating}}">
    
    <!-- 顶部产品信息栏 -->
    <view class="question-header">
      <view class="qh-product">
        <view class="qh-brand-badge" style="background:{{product.brandLogoColor}};">{{product.brandLogoText}}</view>
        <view class="qh-info">
          <text class="qh-model">{{product.modelName}}</text>
          <text class="qh-specs">{{product.modelSpecs}}</text>
        </view>
        <view class="qh-base-price">
          <text class="qh-price-label">基准价</text>
          <text class="qh-price-value">¥{{product.modelPrice}}</text>
        </view>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-section">
      <view class="progress-steps">
        <view 
          class="progress-step {{index < currentQuestionIndex ? 'done' : ''}} {{index === currentQuestionIndex ? 'active' : ''}}"
          wx:for="{{questions}}"
          wx:key="id">
          <view class="step-dot">
            <text wx:if="{{index < currentQuestionIndex}}">✓</text>
            <text wx:else>{{item.stepNumber}}</text>
          </view>
          <text class="step-label">{{item.stepNumber}}/{{totalQuestions}}</text>
        </view>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{(currentQuestionIndex / totalQuestions) * 100}}%"></view>
      </view>
    </view>

    <!-- 问题卡片区域 -->
    <view class="question-stage {{questionState}}">
      
      <!-- 选择类问题 -->
      <block wx:if="{{questions[currentQuestionIndex].type === 'select'}}">
        <scroll-view class="question-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="question-card">
            <!-- 装饰元素 -->
            <view class="qc-deco">
              <view class="qc-deco-circle"></view>
              <view class="qc-deco-line"></view>
            </view>
            
            <!-- 问题标题 -->
            <view class="qc-header">
              <text class="qc-step-badge">第{{questions[currentQuestionIndex].stepNumber}}题</text>
              <text class="qc-question-title">{{questions[currentQuestionIndex].question}}</text>
              <text class="qc-hint">请选择一个最符合您设备情况的选项</text>
            </view>

            <!-- 选项列表 -->
            <view class="qc-options">
              <view
                class="qc-option {{item.desc ? 'has-desc' : ''}}"
                wx:for="{{questions[currentQuestionIndex].options}}"
                wx:key="value"
                bindtap="onOptionSelect"
                data-value="{{item.value}}"
                data-label="{{item.label}}"
                data-rate="{{item.rate}}"
                data-desc="{{item.desc}}">
                
                <view class="qco-icon-wrap">
                  <text wx:if="{{index === 0}}" class="qco-icon">⭐</text>
                  <text wx:elif="{{index === 1}}" class="qco-icon">👍</text>
                  <text wx:elif="{{index === 2}}" class="qco-icon">👌</text>
                  <text wx:elif="{{index === 3}}" class="qco-icon">⚠️</text>
                  <text wx:else class="qco-icon">❗</text>
                </view>
                
                <view class="qco-content">
                  <text class="qco-label">{{item.label}}</text>
                  <text wx:if="{{item.desc}}" class="qco-desc">{{item.desc}}</text>
                  <text wx:if="{{item.rate < 1}}" class="qco-rate">折价系数 {{item.rate * 100}}%</text>
                </view>
                
                <view class="qco-arrow">→</view>
              </view>
            </view>

            <!-- 实时估价预览 -->
            <view class="qc-live-price">
              <text class="live-price-label">当前实时估价</text>
              <text class="live-price-value">¥{{estimatedPrice}}</text>
            </view>
          </view>
        </scroll-view>
      </block>

      <!-- 输入类问题 -->
      <block wx:else>
        <view class="question-card">
          <view class="qc-header">
            <text class="qc-step-badge">第{{questions[currentQuestionIndex].stepNumber}}题</text>
            <text class="qc-question-title">{{questions[currentQuestionIndex].question}}</text>
            <text wx:if="{{!questions[currentQuestionIndex].required}}" class="qc-hint">可选填，不需要可跳过</text>
          </view>

          <view class="qc-input-area">
            <textarea
              class="qc-textarea"
              placeholder="{{questions[currentQuestionIndex].placeholder}}"
              placeholder-class="qc-textarea-placeholder"
              value="{{extraNotes}}"
              bindinput="onExtraInputInput"
              maxlength="200"
              auto-height />
            <view class="qc-input-actions">
              <view wx:if="{{!questions[currentQuestionIndex].required}}" class="qc-skip-btn" bindtap="onSkipExtra">
                <text>跳过 →</text>
              </view>
              <view class="qc-confirm-btn" bindtap="onExtraInputConfirm">
                <text>确认提交</text>
              </view>
            </view>
          </view>
        </view>
      </block>

    </view>
  </block>

  <!-- ==================== 估价中 ==================== -->
  <view class="evaluating-stage" wx:if="{{isEvaluating}}">
    <view class="evaluating-card">
      <view class="eval-spinner">
        <view class="spinner-ring"></view>
        <text class="spinner-icon">💰</text>
      </view>
      <text class="eval-title">正在为您综合估价</text>
      <text class="eval-sub">AI正在分析您的设备信息…</text>
      <view class="eval-dots">
        <view class="eval-dot"></view>
        <view class="eval-dot"></view>
        <view class="eval-dot"></view>
      </view>
    </view>
  </view>

  <!-- ==================== 估价完成 ==================== -->
  <view wx:if="{{evaluationComplete}}" class="result-wrapper">
    
    <!-- 结果页面 -->
    <scroll-view class="result-stage" scroll-y enhanced show-scrollbar="{{false}}">
      
      <!-- 结果卡片 -->
      <view class="result-hero">
        <view class="result-badge {{fromLLM ? 'ai' : ''}}">
          <text wx:if="{{fromLLM}}">🤖 AI智能估价</text>
          <text wx:else>📊 系统估价</text>
        </view>
        
        <view class="result-price-block">
          <text class="result-price-currency">¥</text>
          <text class="result-price-number">{{estimatedPrice}}</text>
          <text class="result-price-range">估价区间 ¥{{priceRange.min}} ~ ¥{{priceRange.max}}</text>
        </view>
      </view>

      <!-- 评估摘要 -->
      <view class="result-summary">
        <view class="rs-title">评估摘要</view>
        <view class="rs-list">
          <view class="rs-item" wx:for="{{questions}}" wx:key="id" wx:if="{{item.id !== 'extra'}}">
            <text class="rs-q">{{item.question}}</text>
            <text class="rs-a">{{answers[item.id] ? answers[item.id].label : '未选择'}}</text>
          </view>
        </view>
      </view>

      <!-- 产品确认 -->
      <view class="result-product">
        <view class="rp-badge" style="background:{{product.brandLogoColor}};">{{product.brandLogoText}}</view>
        <view class="rp-info">
          <text class="rp-name">{{product.brandName}} {{product.modelName}}</text>
          <text class="rp-specs">{{product.modelSpecs}}</text>
        </view>
      </view>

      <!-- 内部人员：设备来源选择 -->
      <view class="device-source-card" wx:if="{{isInternal}}">
        <view class="ds-title">设备来源 <text class="required-mark">*</text></view>
        <view class="ds-options">
          <view class="ds-option {{deviceSource === item.key ? 'active' : ''}}"
                wx:for="{{deviceSourceOptions}}" wx:key="key"
                catchtap="selectDeviceSource" data-key="{{item.key}}">
            <view class="ds-check {{deviceSource === item.key ? 'checked' : ''}}">✓</view>
            <text class="ds-label">{{item.label}}</text>
          </view>
        </view>
        <text class="ds-hint">内部免付款申请，提交后由管理员确认，全程无需支付</text>
      </view>

      <!-- 地址选择 -->
      <view class="result-address" bindtap="openAddressPicker">
        <text class="ra-icon">📍</text>
        <view class="ra-content" wx:if="{{selectedAddress}}">
          <text class="ra-name">{{selectedAddress.name}} {{selectedAddress.phone}}</text>
          <text class="ra-detail">{{selectedAddress.province}}{{selectedAddress.city}}{{selectedAddress.district}} {{selectedAddress.detail}}</text>
        </view>
        <text class="ra-placeholder" wx:else>请选择回收地址</text>
        <text class="ra-arrow">›</text>
      </view>

      <!-- 底部留白 -->
      <view class="result-bottom-space"></view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="guide-footer">
      <view class="submit-row">
        <button class="contact-btn ghost" bindtap="onContactSupport">联系客服</button>
        <button class="submit-btn {{isInternal ? 'internal' : ''}}" bindtap="onSubmitOrder" loading="{{submitting}}" disabled="{{!selectedAddress || (isInternal && !deviceSource)}}">
          {{isInternal ? '提交内部回收申请' : '提交回收订单'}}
        </button>
      </view>
    </view>

  </view>

  <!-- ==================== 地址选择弹窗 ==================== -->
  <view class="address-mask" wx:if="{{showAddressPicker}}" bindtap="closeAddressPicker"></view>
  <view class="address-picker {{showAddressPicker ? 'show' : ''}}">
    <view class="address-picker-header">
      <text class="picker-title">选择回收地址</text>
      <text class="picker-close" bindtap="closeAddressPicker">✕</text>
    </view>
    <scroll-view class="address-picker-list" scroll-y>
      <view
        class="address-picker-item {{selectedAddress && selectedAddress.id === item.id ? 'active' : ''}}"
        wx:for="{{addressList}}"
        wx:key="id"
        bindtap="onSelectAddress"
        data-index="{{index}}">
        <view class="picker-item-info">
          <text class="picker-item-name">{{item.name}} {{item.phone}}</text>
          <text class="picker-item-addr">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text>
        </view>
        <text wx:if="{{selectedAddress && selectedAddress.id === item.id}}" class="picker-check">✓</text>
      </view>
      <view wx:if="{{addressList.length === 0}}" class="address-empty">
        <text>暂无地址，请先添加</text>
      </view>
    </scroll-view>
    <view class="address-picker-footer">
      <button class="add-addr-btn" bindtap="goToAddAddress">+ 新增地址</button>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
