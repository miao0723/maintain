/* pages/unit-edit/unit-edit.wxss —— 简洁美观的单位表单 */

.page-container {
  padding: 24rpx;
  background-color: #f5f8fc;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(25, 44, 66, 0.06);
}

/* 每个字段：标签在上，输入框在下，自带盒体，文字有左侧内边距 */
.form-item {
  display: flex;
  flex-direction: column;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #1f2d3d;
  background: #f5f8fb;
  border: 2rpx solid #e6ebf1;
  border-radius: 16rpx;
  /* 左侧 24rpx 内边距，输入框文字不再贴左边 */
  padding: 22rpx 24rpx;
  transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}

.form-input:focus,
.form-textarea:focus {
  border-color: #4f8bc9;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(79, 139, 201, 0.10);
}

.form-textarea {
  min-height: 140rpx;
  line-height: 1.6;
}

/* 设为默认：标签与开关左右分布 */
.switch-item {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.switch-item .form-label {
  margin-bottom: 0;
}

.bottom-action {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
}

.save-btn {
  background: linear-gradient(135deg, #4f8bc9 0%, #3a6ea5 100%) !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 50rpx !important;
  padding: 24rpx 0 !important;
  font-size: 32rpx !important;
  font-weight: 700 !important;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(58, 110, 165, 0.30) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.save-btn::after { border: none !important; }

.save-btn:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 8rpx 18rpx rgba(58, 110, 165, 0.32) !important;
}

.bottom-space {
  height: 160rpx;
}

/* 暗色模式 */
@media (prefers-color-scheme: dark) {
  .page-container { background-color: #11161c; }
  .form-section { background: #1c242e; box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.4); }
  .form-item { border-bottom-color: #2a333d; }
  .form-label { color: #eef3f8; }
  .form-input,
  .form-textarea {
    background: #2a333d;
    border-color: #3a4654;
    color: #eef3f8;
  }
  .form-input:focus,
  .form-textarea:focus {
    border-color: #5a9bd8;
    background: #2a333d;
    box-shadow: 0 0 0 6rpx rgba(90, 155, 216, 0.16);
  }
}
