<!-- pages/welcome/welcome.wxml -->
<view class="welcome-container">
  <view class="header">
    <view class="logo-box">
      <text class="logo-icon">🔧</text>
    </view>
    <text class="app-title">电子维修服务</text>
    <text class="welcome-text">欢迎使用，请先阅读并同意以下协议</text>
  </view>

  <view class="agreement-wrapper">
    <view class="agreement-box">
      <view class="agreement-header">
        <view class="header-icon">📄</view>
        <text class="header-title">免责协议</text>
      </view>

      <scroll-view class="agreement-content" scroll-y>
        <view class="content-section">
          <view class="section">
            <text class="section-title">一、服务说明</text>
            <text class="section-content">本平台提供电子设备维修信息咨询服务，用户在使用本服务前需仔细阅读并同意本协议。</text>
          </view>

          <view class="section">
            <text class="section-title">二、免责声明</text>
            <text class="section-content">本平台提供的维修建议仅供参考，不构成任何形式的保证或承诺。因设备故障、维修操作等造成的任何损失，本平台不承担责任。用户应选择正规维修渠道进行设备维修。</text>
          </view>

          <view class="section">
            <text class="section-title">三、用户责任</text>
            <text class="section-content">用户应确保提供的信息真实有效，妥善保管个人账号和密码，禁止利用本平台进行任何违法活动。</text>
          </view>

          <view class="section">
            <text class="section-title">四、隐私保护</text>
            <text class="section-content">我们将严格保护您的个人隐私信息。未经您同意，不会向第三方泄露您的信息。您的微信头像和昵称仅用于身份识别。</text>
          </view>

          <view class="section">
            <text class="section-title">五、协议修改</text>
            <text class="section-content">本平台有权随时修改本协议，修改后的协议一经发布即生效。</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="btn-group">
    <button class="btn-disagree" bindtap="onDisagree">不同意</button>
    <button class="btn-agree" bindtap="onAgree">我已阅读并同意</button>
  </view>

  <view class="footer-tip">
    <text class="tip-text">登录即表示您同意我们的服务条款和隐私政策</text>
  </view>
</view>
<confirm-modal id="confirmModal" />
