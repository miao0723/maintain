/* pages/welcome/welcome.wxss */

/* 容器 */
.welcome-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 头部区域 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  margin-bottom: 35rpx;
  animation: fadeInDown 0.6s ease-out;
}

.logo-box {
  width: 110rpx;
  height: 110rpx;
  background: white;
  border-radius: 55rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.15);
  animation: scaleIn 0.4s ease-out 0.2s both;
}

.logo-icon {
  font-size: 60rpx;
}

.app-title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.15);
  animation: fadeIn 0.5s ease-out 0.3s both;
}

.welcome-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 300;
  text-align: center;
  animation: fadeIn 0.5s ease-out 0.4s both;
}

/* 协议包装器 */
.agreement-wrapper {
  flex: 1;
  margin-bottom: 25rpx;
  animation: fadeInUp 0.5s ease-out 0.3s both;
}

/* 协议框 */
.agreement-box {
  height: 100%;
  background: white;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 协议头部 */
.agreement-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0fdfa;
}

.header-icon {
  font-size: 32rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5a6e8a;
}

/* 协议内容 */
.agreement-content {
  flex: 1;
  padding: 30rpx;
}

.content-section {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #5a6e8a;
  display: block;
}

.section-content {
  font-size: 25rpx;
  color: #666;
  line-height: 1.8;
  display: block;
  white-space: pre-line;
  text-align: justify;
}

/* 按钮组 */
.btn-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  animation: fadeInUp 0.5s ease-out 0.4s both;
}

.btn-disagree,
.btn-agree {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 30rpx;
  border: none;
  transition: all 0.3s ease;
}

.btn-disagree {
  background: rgba(255, 255, 255, 0.7);
  color: #666;
}

.btn-disagree::after {
  border: none;
}

.btn-agree {
  background: white;
  color: #5a6e8a;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(255, 255, 255, 0.3);
}

.btn-agree::after {
  border: none;
}

/* 底部提示 */
.footer-tip {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 20rpx;
  animation: fadeIn 0.5s ease-out 0.5s both;
}

.tip-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 动画定义 */
@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
