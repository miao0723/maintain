/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(123, 154, 190, 0.18), transparent 28%),
    linear-gradient(180deg, #eff4f8 0%, #e7eef5 34%, #f8fbfd 100%);
  padding: 0 20rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-card {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 64rpx 48rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(32, 51, 73, 0.14);
}

.login-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 12rpx 28rpx rgba(40, 62, 86, 0.24);
}

.login-title {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #213449;
}

.login-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6a7888;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  margin-top: 44rpx;
  border: none;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(40, 62, 86, 0.24);
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: translateY(2rpx);
}

.btn-text {
  position: relative;
  z-index: 1;
}

.login-policy {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  color: #8a99a8;
  line-height: 1.6;
}

.login-link {
  color: #46698a;
  font-weight: 700;
  margin: 0 4rpx;
}

/* 资料补全弹层 */
.fill-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 32, 46, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.fill-card {
  width: 600rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.fill-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #213449;
  text-align: center;
}

.fill-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #6a7888;
  text-align: center;
}

.fill-avatar-row {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fill-avatar-btn {
  width: 150rpx;
  height: 150rpx;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #eef3f8;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #c2d0de;
}

.fill-avatar-btn::after {
  border: none;
}

.fill-avatar-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
}

.fill-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.fill-avatar-icon {
  font-size: 48rpx;
  color: #8aa0b6;
  line-height: 1;
}

.fill-avatar-tip {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8aa0b6;
}

.fill-avatar-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #7a8a9a;
}

.fill-nick-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  background: #f3f6fa;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.fill-nick-label {
  font-size: 26rpx;
  color: #41576f;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.fill-nick-input {
  flex: 1;
  font-size: 28rpx;
  color: #213449;
}

.fill-actions {
  margin-top: 34rpx;
  display: flex;
  gap: 20rpx;
}

.fill-skip,
.fill-save {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.fill-skip {
  background: #eef3f8;
  color: #5a6e8a;
}

.fill-save {
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  color: #ffffff;
}

.fill-skip::after,
.fill-save::after {
  border: none;
}

.fill-save:active {
  transform: translateY(2rpx);
}

/* 资料层：一步获取头像+昵称 */
.fill-preview {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fill-preview-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #e3ebf3;
  background: #eef3f8;
}

.fill-preview-default {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #eef3f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: #b6c4d3;
}

.fill-preview-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #213449;
}

.fill-nick-hidden {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0;
  left: -9999rpx;
}

.fill-oneshot {
  width: 100%;
  height: 88rpx;
  margin-top: 30rpx;
  border-radius: 22rpx;
  border: none;
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(40, 62, 86, 0.24);
}

.fill-oneshot::after {
  border: none;
}

.fill-oneshot:active {
  transform: translateY(2rpx);
}

.fill-skip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9aa8b6;
}
