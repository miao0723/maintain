/* pages/login/login.wxss —— 授权微信头像与昵称页（简洁美观版） */

/* ===== 整体背景 ===== */
.login-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% -8%, rgba(255, 138, 61, 0.12), transparent 44%),
    linear-gradient(180deg, #eef3f8 0%, #e8eef5 48%, #f6f9fc 100%);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx calc(56rpx + env(safe-area-inset-bottom));
}

/* ===== 主卡片：整体调大 ===== */
.login-card {
  width: 100%;
  max-width: 720rpx;
  background: #ffffff;
  border-radius: 48rpx;
  padding: 72rpx 60rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 32rpx 80rpx rgba(25, 44, 66, 0.16);
}

/* ===== 品牌头部 ===== */
.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  margin-bottom: 56rpx;
}

.brand-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ff8a3d 0%, #f5701e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  box-shadow: 0 10rpx 24rpx rgba(245, 112, 30, 0.30);
  flex-shrink: 0;
}

.brand-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2d3d;
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8a99a8;
}

/* ===== 头像：纯圆形，彻底去掉按钮矩形背景 =====
   复合选择器 button.fill-avatar 优先级(0,1,1) > app.wxss 的 button(0,0,1) */
button.fill-avatar {
  position: relative;
  width: 240rpx !important;
  height: 240rpx !important;
  min-width: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0;
  border: none !important;
  border-radius: 50% !important;
  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;
  box-shadow: none !important;
  color: transparent !important;
  line-height: normal !important;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: transform 0.15s ease;
}

/* 默认占位头像也画成圆，避免空图露矩形 */
button.fill-avatar .fill-avatar-img,
.fill-avatar-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(40, 62, 86, 0.18);
  display: block;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

/* 已选头像高亮描边（维修橙） */
.fill-avatar--set .fill-avatar-img {
  border-color: #ff8a3d;
  box-shadow: 0 16rpx 36rpx rgba(245, 112, 30, 0.26);
}

.fill-avatar-cap {
  margin-top: 22rpx;
  font-size: 25rpx;
  color: #8a99a8;
}

button.fill-avatar:active { transform: scale(0.97); }
button.fill-avatar:active .fill-avatar-img { transform: scale(0.97); }
button.fill-avatar:active {
  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;
}

/* 关键：杀掉微信原生 button 的 ::after 边框（也是矩形来源之一） */
button.fill-avatar::after { border: none !important; }

/* ===== 昵称 ===== */
.fill-nick {
  margin-top: 48rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.fill-nick-label {
  margin-bottom: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.fill-nick-box {
  position: relative;
  width: 100%;
}

.fill-nick-input {
  width: 100%;
  height: 100rpx;
  background: #f5f8fb;
  border: 2rpx solid #e2eaf2;
  border-radius: 26rpx;
  padding: 0 64rpx 0 28rpx;
  box-sizing: border-box;
  font-size: 31rpx;
  color: #1f2d3d;
  transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}

.fill-nick-input:focus {
  border-color: #f5701e;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(245, 112, 30, 0.10);
}

.fill-nick-ph { color: #9aa8b6; }

.fill-nick-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ff8a3d;
  color: #fff;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 底部按钮行：登录 + 跳过 等宽一致 ===== */
.login-actions {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  width: 100%;
  margin-top: 56rpx;
}

/* 登录按钮：复合选择器压过全局 button 默认样式 */
button.login-btn {
  position: relative;
  z-index: 1;
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
  height: 100rpx !important;
  min-height: 0 !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 50rpx !important;
  background: linear-gradient(135deg, #ff8a3d 0%, #f5701e 100%) !important;
  background-image: linear-gradient(135deg, #ff8a3d 0%, #f5701e 100%) !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 700 !important;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(245, 112, 30, 0.30) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

button.login-btn::after { border: none !important; }

button.login-btn:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 8rpx 18rpx rgba(245, 112, 30, 0.34) !important;
  background: linear-gradient(135deg, #f57a2d 0%, #e8661a 100%) !important;
  background-image: linear-gradient(135deg, #f57a2d 0%, #e8661a 100%) !important;
}

/* 跳过按钮：与登录等宽、同高、同圆角 */
.login-skip {
  position: relative;
  z-index: 1;
  flex: 1;
  width: auto;
  height: 100rpx;
  margin-top: 0;
  border-radius: 50rpx;
  background: transparent;
  color: #6a7b8c;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dbe3ec;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.login-skip:active {
  background: rgba(245, 112, 30, 0.06);
  border-color: #f3c4a0;
  color: #f5701e;
}

/* ===== 暗色模式（保持简洁一致） ===== */
@media (prefers-color-scheme: dark) {
  .login-container { background: linear-gradient(180deg, #11161c 0%, #161d25 100%); }
  .login-card { background: #1c242e; box-shadow: 0 32rpx 84rpx rgba(0, 0, 0, 0.45); }
  .brand-title { color: #eef3f8; }
  .brand-sub { color: #9aa8b6; }
  .fill-avatar-cap { color: #9aa8b6; }
  .fill-nick-label { color: #eef3f8; }
  .fill-nick-input { background: #2a333d; border-color: #3a4654; color: #eef3f8; }
  .fill-nick-ph { color: #7c8b9a; }
  .login-skip { color: #9aa8b6; border-color: #3a4654; }
  .login-skip:active { background: rgba(255, 138, 61, 0.12); border-color: #5a4326; color: #ff8a3d; }
}
