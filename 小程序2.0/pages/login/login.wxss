/* pages/login/login.wxss —— 简洁美观的微信资料授权页 */

.login-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% -10%, rgba(255, 138, 61, 0.10), transparent 42%),
    linear-gradient(180deg, #eef3f8 0%, #e6edf4 46%, #f5f8fc 100%);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx calc(48rpx + env(safe-area-inset-bottom));
}

.login-card {
  width: 100%;
  max-width: 700rpx;
  background: #ffffff;
  border-radius: 44rpx;
  padding: 64rpx 56rpx 56rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 28rpx 72rpx rgba(25, 44, 66, 0.14);
}

/* ===== 品牌头部 ===== */
.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  margin-bottom: 48rpx;
}

.brand-logo {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #ff8a3d 0%, #f5701e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(245, 112, 30, 0.30);
  flex-shrink: 0;
}

.brand-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.brand-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2d3d;
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a99a8;
}

/* ===== 头像选择：纯圆形，无矩形按钮背景 ===== */
.fill-avatar {
  position: relative;
  width: 220rpx !important;
  height: 220rpx !important;
  min-width: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0;
  border: none !important;
  border-radius: 50% !important;
  background: transparent !important;
  background-color: transparent !important;
  box-shadow: none !important;
  color: transparent !important;
  line-height: normal !important;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.fill-avatar::after { border: none !important; }

.fill-avatar-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(40, 62, 86, 0.16);
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

/* 已选头像时的高亮描边（维修橙） */
.fill-avatar--set .fill-avatar-img {
  border-color: #ff8a3d;
  box-shadow: 0 14rpx 34rpx rgba(245, 112, 30, 0.24);
}

.fill-avatar-cap {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8a99a8;
}

.fill-avatar:active { transform: scale(0.96); }
.fill-avatar:active .fill-avatar-img { transform: scale(0.96); }
.fill-avatar:active {
  background: transparent !important;
  background-color: transparent !important;
}

/* ===== 昵称 ===== */
.fill-nick {
  margin-top: 42rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.fill-nick-label {
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.fill-nick-box {
  position: relative;
  width: 100%;
}

.fill-nick-input {
  width: 100%;
  height: 96rpx;
  background: #f5f8fb;
  border: 2rpx solid #e2eaf2;
  border-radius: 24rpx;
  padding: 0 64rpx 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #1f2d3d;
  transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}

.fill-nick-input:focus {
  border-color: #f5701e;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(245, 112, 30, 0.10);
}

.fill-nick-ph { color: #9aa8b6; }

.fill-nick-icon {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ff8a3d;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 底部按钮行：登录 + 跳过 等宽 ===== */
.login-actions {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  width: 100%;
  margin-top: 52rpx;
}

/* ===== 登录按钮 ===== */
.login-btn {
  position: relative;
  z-index: 1;
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
  height: 96rpx !important;
  min-height: 0 !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 48rpx !important;
  background: linear-gradient(135deg, #ff8a3d 0%, #f5701e 100%) !important;
  color: #ffffff !important;
  font-size: 31rpx !important;
  font-weight: 700 !important;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(245, 112, 30, 0.28) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.login-btn::after { border: none !important; }

.login-btn:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 8rpx 18rpx rgba(245, 112, 30, 0.32) !important;
  background: linear-gradient(135deg, #f57a2d 0%, #e8661a 100%) !important;
}

/* ===== 跳过按钮 ===== */
.login-skip {
  position: relative;
  z-index: 1;
  flex: 1;
  width: auto;
  height: 96rpx;
  margin-top: 0;
  border-radius: 48rpx;
  background: transparent;
  color: #6a7b8c;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dbe3ec;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.login-skip:active {
  background: rgba(245, 112, 30, 0.06);
  border-color: #f3c4a0;
  color: #f5701e;
}

/* ===== 暗色模式 ===== */
@media (prefers-color-scheme: dark) {
  .login-container { background: linear-gradient(180deg, #11161c 0%, #161d25 100%); }
  .login-card { background: #1c242e; box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.4); }
  .brand-title { color: #eef3f8; }
  .brand-sub { color: #9aa8b6; }
  .fill-avatar-cap { color: #9aa8b6; }
  .fill-nick-label { color: #eef3f8; }
  .fill-nick-input { background: #2a333d; border-color: #3a4654; color: #eef3f8; }
  .fill-nick-ph { color: #7c8b9a; }
  .fill-avatar--set .fill-avatar-img { border-color: #ff8a3d; }
  .login-skip { color: #9aa8b6; border-color: #3a4654; }
  .login-skip:active { background: rgba(255, 138, 61, 0.12); border-color: #5a4326; color: #ff8a3d; }
}
