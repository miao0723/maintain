/* pages/login/login.wxss —— 维修行业风格：钢蓝底色 + 工具橙点缀，简洁美观 */

.login-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% -12%, rgba(255, 138, 61, 0.10), transparent 40%),
    linear-gradient(180deg, #eef3f8 0%, #e6edf4 46%, #f5f8fc 100%);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx calc(40rpx + env(safe-area-inset-bottom));
}

.login-card {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 56rpx 48rpx 44rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 64rpx rgba(25, 44, 66, 0.14);
}

/* ===== 品牌头部：维修行业风格 ===== */
.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  margin-bottom: 44rpx;
}

.brand-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #ff8a3d 0%, #f5701e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  box-shadow: 0 10rpx 24rpx rgba(245, 112, 30, 0.30);
  flex-shrink: 0;
}

.brand-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2d3d;
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a99a8;
}

/* ===== 头像选择：干净圆形，无旋转虚线环 / 发光背景 ===== */
.fill-avatar {
  position: relative;
  margin-top: 4rpx;
  width: 168rpx;
  height: 168rpx;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.fill-avatar::after { border: none; }

.fill-avatar-img {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(40, 62, 86, 0.16);
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

/* 已选头像时的高亮描边（维修橙） */
.fill-avatar--set .fill-avatar-img {
  border-color: #ff8a3d;
  box-shadow: 0 12rpx 30rpx rgba(245, 112, 30, 0.24);
}

.fill-avatar-cap {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8a99a8;
}

.fill-avatar:active .fill-avatar-img { transform: scale(0.96); }

/* ===== 昵称 ===== */
.fill-nick {
  margin-top: 38rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.fill-nick-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.fill-nick-box {
  position: relative;
  width: 100%;
}

.fill-nick-input {
  width: 100%;
  height: 92rpx;
  background: #f5f8fb;
  border: 2rpx solid #e2eaf2;
  border-radius: 18rpx;
  padding: 0 64rpx 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #1f2d3d;
  transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}

.fill-nick-input:focus {
  border-color: #f5701e;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(245, 112, 30, 0.10);
}

.fill-nick-ph { color: #9aa8b6; }

.fill-nick-icon {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ff8a3d;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 底部按钮行：登录 + 跳过 同行左右摆放 ===== */
.login-actions {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  width: 100%;
  margin-top: 44rpx;
}

/* ===== 登录按钮（维修橙，占据主要宽度） ===== */
.login-btn {
  position: relative;
  z-index: 1;
  flex: 1;
  width: auto;
  height: 92rpx;
  border: none;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #ff8a3d 0%, #f5701e 100%);
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(245, 112, 30, 0.28);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.login-btn::after { border: none; }

.login-btn:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 8rpx 18rpx rgba(245, 112, 30, 0.32);
}

/* ===== 跳过按钮（幽灵，固定宽度在右侧） ===== */
.login-skip {
  position: relative;
  z-index: 1;
  flex: 0 0 200rpx;
  width: auto;
  height: 92rpx;
  margin-top: 0;
  border-radius: 46rpx;
  background: transparent;
  color: #6a7b8c;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dbe3ec;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.login-skip:active {
  background: rgba(245, 112, 30, 0.06);
  border-color: #f3c4a0;
  color: #f5701e;
}

@media (prefers-color-scheme: dark) {
  .login-container { background: linear-gradient(180deg, #11161c 0%, #161d25 100%); }
  .login-card { background: #1c242e; box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.4); }
  .brand-title { color: #eef3f8; }
  .brand-sub { color: #9aa8b6; }
  .fill-avatar-cap { color: #9aa8b6; }
  .fill-nick-label { color: #eef3f8; }
  .fill-nick-input { background: #2a333d; border-color: #3a4654; color: #eef3f8; }
  .fill-nick-ph { color: #7c8b9a; }
  .fill-avatar--set .fill-avatar-img { border-color: #ff8a3d; }
  .login-skip { color: #9aa8b6; border-color: #3a4654; }
  .login-skip:active { background: rgba(255, 138, 61, 0.12); border-color: #5a4326; color: #ff8a3d; }
}
