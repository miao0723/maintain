/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(123, 154, 190, 0.18), transparent 28%),
    linear-gradient(180deg, #eff4f8 0%, #e7eef5 34%, #f8fbfd 100%);
  padding: 0 20rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-card {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 64rpx 48rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(32, 51, 73, 0.14);
}

.login-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 12rpx 28rpx rgba(40, 62, 86, 0.24);
}

.login-title {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #213449;
}

.login-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6a7888;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  margin-top: 44rpx;
  border: none;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(40, 62, 86, 0.24);
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: translateY(2rpx);
}

.btn-text {
  position: relative;
  z-index: 1;
}

.login-policy {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  color: #8a99a8;
  line-height: 1.6;
}

.login-link {
  color: #46698a;
  font-weight: 700;
  margin: 0 4rpx;
}

/* 资料补全弹层 */
.fill-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 32, 46, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.fill-card {
  width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 44rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 70rpx rgba(13, 25, 40, 0.28);
  animation: fillPop 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes fillPop {
  from { opacity: 0; transform: translateY(40rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.fill-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fill-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2f3d;
  letter-spacing: 1rpx;
}

.fill-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #7a8a9a;
  text-align: center;
}

/* 圆形头像框 */
.avatar-pick {
  margin-top: 40rpx;
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  border: none;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

.avatar-pick::after {
  border: none;
}

.avatar-circle {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #eef3f8 0%, #e2ebf3 100%);
  border: 2rpx dashed #c2d0de;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.3s ease;
}

.avatar-circle.has-img {
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(40, 62, 86, 0.18);
}

.avatar-pick:active .avatar-circle {
  transform: scale(0.96);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-camera-icon {
  font-size: 56rpx;
  color: #8aa0b6;
}

.avatar-camera-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8aa0b6;
}

.avatar-hint {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #9aa8b6;
  text-align: center;
}

/* 现代风格昵称输入框 */
.nick-field {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
}

.nick-label {
  margin-bottom: 14rpx;
  display: flex;
  align-items: baseline;
}

.nick-label-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2f3d;
}

.nick-label-sub {
  margin-left: 14rpx;
  font-size: 21rpx;
  color: #9aa8b6;
}

.nick-input-box {
  display: flex;
  align-items: center;
  background: #f5f8fb;
  border: 2rpx solid #e2eaf2;
  border-radius: 18rpx;
  padding: 0 24rpx;
  height: 92rpx;
  box-sizing: border-box;
  transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
}

.nick-input-box:focus-within {
  border-color: #4f6b84;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(79, 107, 132, 0.08);
}

.nick-input {
  flex: 1;
  font-size: 30rpx;
  color: #1f2f3d;
  height: 100%;
}

.nick-input-ph {
  color: #b3c0cd;
  font-size: 28rpx;
}

.nick-count {
  font-size: 22rpx;
  color: #b3c0cd;
  margin-left: 16rpx;
  flex-shrink: 0;
  transition: color 0.2s ease;
}

.nick-count.near {
  color: #d97757;
}

/* 隐藏的昵称 input（接收微信一键填入） */
.fill-nick-hidden {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0;
  left: -9999rpx;
}

/* 保存按钮 */
.fill-save-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 36rpx;
  border: none;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #213449 0%, #446786 100%);
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(40, 62, 86, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fill-save-btn::after {
  border: none;
}

.fill-save-btn:active {
  transform: translateY(2rpx);
}

.fill-skip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9aa8b6;
}

.fill-skip:active {
  color: #6a7888;
}
