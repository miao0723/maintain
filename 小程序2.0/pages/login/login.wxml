<!-- pages/login/login.wxml -->
<view class="login-container">
  <view class="login-card">
    <view class="login-logo">🔧</view>
    <view class="login-title">电子维修服务</view>
    <view class="login-desc">登录后可使用故障自检、报价确认、进度反馈与设备回收</view>

    <button
      class="login-btn"
      bindtap="handleLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      <text class="btn-text">{{loading ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <view class="login-policy">
      <text>登录即表示同意</text>
      <text class="login-link" bindtap="viewAgreement" catchtap="viewAgreement">《免责协议》</text>
      <text>和</text>
      <text class="login-link" bindtap="viewPrivacyPolicy" catchtap="viewPrivacyPolicy">《隐私政策》</text>
    </view>
  </view>

  <!-- 资料补全弹层：读取微信头像与昵称 -->
  <view class="fill-mask" wx:if="{{showProfileFill}}">
    <view class="fill-card">
      <view class="fill-glow"></view>
      <view class="fill-emoji">🙂</view>
      <text class="fill-title">完善微信资料</text>
      <text class="fill-sub">点击下方头像获取微信头像，昵称可一键填入</text>

      <button class="fill-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" loading="{{isFilling}}" disabled="{{isFilling}}">
        <image class="fill-avatar-img" src="{{fillAvatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
        <view class="fill-avatar-hint">点击选择微信头像</view>
      </button>

      <view class="fill-nick">
        <text class="fill-nick-label">昵称</text>
        <input class="fill-nick-input" type="nickname" placeholder="点此填入微信昵称" placeholder-class="fill-nick-ph" value="{{fillNickName}}" bindnickname="onFillNickName" bindinput="onFillNickNameInput" maxlength="20"/>
      </view>

      <button class="fill-save" bindtap="saveProfileFill" loading="{{isFilling}}" disabled="{{isFilling}}">{{isFilling ? '保存中...' : '保存并进入'}}</button>
      <view class="fill-skip" bindtap="skipProfileFill">跳过，先用默认资料进入 ›</view>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
