<!-- pages/login/login.wxml -->
<view class="login-container">
  <view class="login-card">

    <!-- 维修行业风格品牌头部 -->
    <view class="brand">
      <view class="brand-logo">🔧</view>
      <view class="brand-info">
        <text class="brand-title">电子维修服务</text>
        <text class="brand-sub">完善资料，开启专业维修</text>
      </view>
    </view>

    <!-- 头像：open-type=chooseAvatar 直接拉起微信头像授权，选完即解析展示 -->
    <button
      class="fill-avatar {{fillAvatarUrl ? 'fill-avatar--set' : ''}}"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
      disabled="{{loading}}"
    >
      <image
        class="fill-avatar-img"
        src="{{fillAvatarUrl || defaultAvatarUrl}}"
        mode="aspectFill"
      ></image>
    </button>
    <text class="fill-avatar-cap">{{fillAvatarUrl ? '点击更换头像' : '点击头像选择微信头像'}}</text>

    <!-- 昵称：type=nickname 可一键填入微信昵称，bindnickname 解析后即时回显 -->
    <view class="fill-nick">
      <text class="fill-nick-label">微信昵称</text>
      <view class="fill-nick-box">
        <input
          class="fill-nick-input"
          type="nickname"
          placeholder="点此填入微信昵称"
          placeholder-class="fill-nick-ph"
          value="{{fillNickName}}"
          bindnickname="onFillNickName"
          bindinput="onFillNickNameInput"
          maxlength="20"
        />
        <view class="fill-nick-icon" wx:if="{{fillNickName}}">✓</view>
      </view>
    </view>

    <!-- 底部：登录 + 跳过 同一行左右摆放 -->
    <view class="login-actions">
      <button
        class="login-btn"
        bindtap="handleLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >{{loading ? '登录中...' : '登录'}}</button>

      <view class="login-skip" bindtap="skipProfileFill">跳过</view>
    </view>

  </view>
</view>
<confirm-modal id="confirmModal" />
