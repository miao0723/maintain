<!-- pages/login/login.wxml -->
<view class="login-container">
  <view class="login-card">
    <view class="login-logo">🔧</view>
    <view class="login-title">电子维修服务</view>
    <view class="login-desc">登录后可使用故障自检、报价确认、进度反馈与设备回收</view>

    <button
      class="login-btn"
      bindtap="handleLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      <text class="btn-text">{{loading ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <view class="login-policy">
      <text>登录即表示同意</text>
      <text class="login-link" bindtap="viewAgreement" catchtap="viewAgreement">《免责协议》</text>
      <text>和</text>
      <text class="login-link" bindtap="viewPrivacyPolicy" catchtap="viewPrivacyPolicy">《隐私政策》</text>
    </view>
  </view>

  <!-- 资料补全弹层：读取微信头像与昵称 -->
  <view class="fill-mask" wx:if="{{showProfileFill}}">
    <view class="fill-card">
      <view class="fill-head">
        <text class="fill-title">完善微信资料</text>
        <text class="fill-sub">一键获取您的微信头像与昵称，让服务更贴心</text>
      </view>

      <!-- 圆形头像框：点击选择微信头像或从相册上传 -->
      <button
        class="avatar-pick"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatarAndSave"
        loading="{{isFilling}}"
        disabled="{{isFilling}}"
      >
        <view class="avatar-circle {{fillAvatarUrl ? 'has-img' : ''}}">
          <image wx:if="{{fillAvatarUrl}}" class="avatar-img" src="{{fillAvatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-placeholder">
            <text class="avatar-camera-icon">📷</text>
            <text class="avatar-camera-text">点击上传头像</text>
          </view>
        </view>
      </button>
      <text class="avatar-hint">{{fillAvatarUrl ? '已选择，可点击更换' : '读取微信头像或从相册上传'}}</text>

      <!-- 昵称 input：隐藏，仅用于接收微信一键填入的昵称 -->
      <input
        class="fill-nick-hidden"
        type="nickname"
        value="{{fillNickName}}"
        bindnickname="onFillNickName"
        bindinput="onFillNickNameInput"
        maxlength="20"/>

      <!-- 现代风格昵称输入框 -->
      <view class="nick-field">
        <view class="nick-label">
          <text class="nick-label-text">昵称</text>
          <text class="nick-label-sub">将展示在订单与聊天中</text>
        </view>
        <view class="nick-input-box">
          <input
            class="nick-input"
            type="nickname"
            placeholder="点击一键填入微信昵称"
            placeholder-class="nick-input-ph"
            value="{{fillNickName}}"
            bindinput="onFillNickNameInput"
            maxlength="20"/>
          <text class="nick-count {{fillNickName.length >= 18 ? 'near' : ''}}">{{fillNickName.length}}/20</text>
        </view>
      </view>

      <button
        class="fill-save-btn"
        bindtap="saveProfileFill"
        loading="{{isFilling}}"
        disabled="{{isFilling}}"
      >{{isFilling ? '保存中...' : '保存并进入'}}</button>

      <view class="fill-skip" bindtap="skipProfileFill">暂不设置，直接进入</view>
    </view>
  </view>
</view>
