/* pages/agreement/agreement.wxss - light theme */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.doc-header {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 34, 58, 0.06);
}

.doc-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.doc-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5b6b7c;
}

.doc-updated {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b4;
}

.doc-intro {
  margin-top: 20rpx;
  background: #eef4fb;
  border-left: 6rpx solid #4f6b84;
  border-radius: 12rpx;
  padding: 24rpx 26rpx;
}

.intro-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #3d5165;
}

.doc-body {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 32rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 34, 58, 0.06);
}

.doc-section {
  padding-top: 30rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 14rpx;
}

.section-p {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #4a5b6d;
  margin-bottom: 14rpx;
}

.doc-footer {
  margin-top: 24rpx;
  background: #fff5f4;
  border: 1rpx solid #fcd9d4;
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
}

.footer-warn {
  font-size: 25rpx;
  line-height: 1.7;
  color: #c8452f;
}

.bottom-action {
  margin-top: 32rpx;
}

.agree-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #4f6b84;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 46rpx;
}

.agree-btn::after {
  border: none;
}

.bottom-space {
  height: 60rpx;
}
