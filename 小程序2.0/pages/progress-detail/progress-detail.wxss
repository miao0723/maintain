page {
  background: #f5f7fa;
  min-height: 100vh;
}

.container {
  padding: 24rpx 32rpx;
  padding-bottom: 40rpx;
}

/* 反馈头部 */
.feedback-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.feedback-meta {
  margin-bottom: 16rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.meta-time {
  font-size: 26rpx;
  color: #436f95;
  font-weight: 500;
}

.feedback-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.photo-tag {
  background: rgba(102, 126, 234, 0.1);
  color: #436f95;
}

.video-tag {
  background: rgba(240, 147, 251, 0.1);
  color: #d946ef;
}

/* 通用卡片 */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

/* 描述 */
.description-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  word-break: break-all;
}

/* 照片网格 */
.photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  width: calc((100% - 24rpx) / 3);
  border-radius: 12rpx;
  overflow: hidden;
  background: #eef2f7;
  height: 220rpx;
  border: 1rpx solid #dbe3ee;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #eef2f7;
}

.photo-tip {
  text-align: center;
  margin-top: 16rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #999;
}

/* 视频 */
.video-card {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #000;
}

.video-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.video-cover-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #2d2d2d 0%, #1a1a2e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.placeholder-icon {
  font-size: 80rpx;
  opacity: 0.7;
}

.video-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.play-icon {
  font-size: 48rpx;
  color: #fff;
  margin-left: 6rpx;
}

.video-title-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  z-index: 2;
}

.video-title-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

/* 无内容 */
.empty-hint {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
