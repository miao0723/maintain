/* pages/device-detail/device-detail.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 40rpx;
}

.device-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #4f6b84, #7c8db0);
  color: #fff;
}
.device-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
}
.device-head-info { flex: 1; display: flex; flex-direction: column; }
.device-name { font-size: 34rpx; font-weight: 600; }
.device-sub { font-size: 26rpx; opacity: 0.9; margin-top: 4rpx; }
.device-type { font-size: 22rpx; opacity: 0.8; margin-top: 6rpx; }
.edit-entry { font-size: 40rpx; padding: 10rpx; }

.warranty-card {
  margin: 24rpx 28rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
}
.warranty-card.in { background: #e8f8ee; border: 1rpx solid #b7e8c8; }
.warranty-card.out { background: #f2f3f5; border: 1rpx solid #e2e5ea; }
.warranty-card.none { background: #fff7e6; border: 1rpx solid #ffe1a8; }
.warranty-title { font-size: 30rpx; font-weight: 600; color: #1f2d3d; }
.warranty-desc { font-size: 24rpx; color: #6b7785; margin-top: 8rpx; }

.quick-actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 28rpx 0;
}
.quick-btn {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.quick-btn.disabled { opacity: 0.45; }
.quick-icon { font-size: 40rpx; margin-bottom: 8rpx; }

.section { margin: 28rpx 28rpx 0; }
.section-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }

.advice-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #4f6b84;
}
.advice-maintain { border-left-color: #2f9e6f; }
.advice-warning { border-left-color: #e6a23c; }
.advice-upgrade { border-left-color: #4f6b84; }
.advice-warranty { border-left-color: #2f6fed; }
.advice-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.advice-badge {
  font-size: 20rpx;
  color: #fff;
  background: #4f6b84;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-right: 14rpx;
}
.advice-maintain .advice-badge { background: #2f9e6f; }
.advice-warning .advice-badge { background: #e6a23c; }
.advice-upgrade .advice-badge { background: #4f6b84; }
.advice-warranty .advice-badge { background: #2f6fed; }
.advice-title { font-size: 27rpx; font-weight: 600; color: #1f2d3d; }
.advice-content { font-size: 24rpx; color: #6b7785; line-height: 1.6; }

.history-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.history-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #4f6b84; margin-top: 10rpx; margin-right: 20rpx; flex-shrink: 0;
}
.history-body { flex: 1; display: flex; flex-direction: column; }
.history-row { display: flex; justify-content: space-between; align-items: center; }
.history-order { font-size: 26rpx; font-weight: 600; color: #1f2d3d; }
.history-status { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 8rpx; background: #eef1f6; color: #6b7785; }
.history-problem { font-size: 24rpx; color: #6b7785; margin-top: 8rpx; }
.history-meta { display: flex; gap: 20rpx; align-items: center; margin-top: 10rpx; font-size: 22rpx; color: #9aa4b0; }
.history-records { color: #2f6fed; }
.history-warranty { color: #e6a23c; }

.empty-hint { font-size: 24rpx; color: #9aa4b0; text-align: center; padding: 30rpx 0; }

.loading-state { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.loading-spinner {
  width: 60rpx; height: 60rpx; border: 6rpx solid #e2e5ea;
  border-top-color: #4f6b84; border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-text { font-size: 24rpx; color: #9aa4b0; margin-top: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
