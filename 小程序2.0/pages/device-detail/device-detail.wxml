<!--pages/device-detail/device-detail.wxml-->
<view class="page-container" wx:if="{{!loading && device}}">
  <!-- 设备头部 -->
  <view class="device-header">
    <view class="device-icon">{{deviceIcons[device.device_type_id] || '🔧'}}</view>
    <view class="device-head-info">
      <text class="device-name">{{device.device_nickname || device.device_model}}</text>
      <text class="device-sub">{{device.brand_name ? device.brand_name + ' ' : ''}}{{device.device_model}}</text>
      <text class="device-type">{{device.device_type_name || '未知类型'}}<text wx:if="{{device.serial_number}}"> · {{device.serial_number}}</text></text>
    </view>
    <view class="edit-entry" bindtap="goEdit">✏️</view>
  </view>

  <!-- 质保徽标 -->
  <view class="warranty-card {{warranty.status === 'in' ? 'in' : (warranty.status === 'out' ? 'out' : 'none')}}">
    <block wx:if="{{warranty.status === 'in'}}">
      <text class="warranty-title">🛡️ 质保中</text>
      <text class="warranty-desc">剩余 {{warranty.remaining_days}} 天 · 到期 {{warranty.warranty_end_date}}</text>
    </block>
    <block wx:elif="{{warranty.status === 'out'}}">
      <text class="warranty-title">⏳ 已过保</text>
      <text class="warranty-desc">已于 {{warranty.warranty_end_date}} 到期</text>
    </block>
    <block wx:else>
      <text class="warranty-title">📋 暂无质保</text>
      <text class="warranty-desc">完成维修后将自动生成质保记录</text>
    </block>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="quick-btn" bindtap="startRepair">
      <text class="quick-icon">🔧</text>
      <text>发起维修</text>
    </view>
    <view class="quick-btn {{canWarranty ? '' : 'disabled'}}" bindtap="applyWarranty">
      <text class="quick-icon">🛡️</text>
      <text>申请质保维修</text>
    </view>
  </view>

  <!-- 保养 / 换新建议 -->
  <view class="section" wx:if="{{advice.length > 0}}">
    <view class="section-title">💡 保养与换新建议</view>
    <view class="advice-card advice-{{item.type}}" wx:for="{{advice}}" wx:key="title">
      <view class="advice-head">
        <text class="advice-badge">{{item.type === 'maintain' ? '保养' : (item.type === 'warning' ? '提醒' : (item.type === 'upgrade' ? '换新' : '质保'))}}</text>
        <text class="advice-title">{{item.title}}</text>
      </view>
      <text class="advice-content">{{item.content}}</text>
    </view>
  </view>

  <!-- 维修履历 -->
  <view class="section">
    <view class="section-title">📜 维修履历（{{history.length}}）</view>
    <view wx:if="{{history.length === 0}}" class="empty-hint">该设备暂无维修记录</view>
    <view class="history-item" wx:for="{{history}}" wx:key="id" bindtap="goRepairRecords" data-orderid="{{item.id}}">
      <view class="history-dot"></view>
      <view class="history-body">
        <view class="history-row">
          <text class="history-order">订单 {{item.order_no}}</text>
          <text class="history-status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <text class="history-problem">{{item.problem_description || item.custom_description || '维修工单'}}</text>
        <view class="history-meta">
          <text>{{item.created_at}}</text>
          <text wx:if="{{item.recordsCount > 0}}" class="history-records">维修记录 {{item.recordsCount}} 条 ›</text>
          <text wx:if="{{item.is_warranty}}" class="history-warranty">质保单</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="loading-state" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>
<confirm-modal id="confirmModal" />
