<view class="admin-service-page">
  <view class="hero-card">
    <text class="hero-title">人工客服会话</text>
    <text class="hero-desc">查看待接入和服务中的人工会话，点击进入独立会话页处理。</text>
  </view>

  <view class="list-card">
    <view class="list-header">
      <text class="list-title">活跃会话</text>
      <text class="list-refresh" bindtap="loadConversations">刷新</text>
    </view>

    <view class="empty-state" wx:if="{{!loading && conversations.length === 0}}">
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无活跃人工客服会话</text>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>

    <view class="conversation-list" wx:if="{{conversations.length > 0}}">
      <view class="conversation-item" wx:for="{{conversations}}" wx:key="conversation_id" bindtap="openConversation" data-id="{{item.conversation_id}}">
        <view class="conversation-top">
          <text class="conversation-summary">{{item.summary || item.conversation_id}}</text>
          <text class="conversation-status {{item.status}}">{{item.status === 'waiting' ? '待接入' : item.status === 'connected' ? '服务中' : item.status === 'completed' ? '已完成' : '已取消'}}</text>
        </view>
        <text class="conversation-meta">会话ID：{{item.conversation_id}}</text>
        <text class="conversation-meta">用户ID：{{item.user_id}}</text>
        <text class="conversation-last">{{item.last_message || '暂无消息'}}</text>
        <text class="conversation-enter">点击进入会话 ></text>
      </view>
    </view>

    <!-- 查看历史已完成会话 -->
    <view class="toggle-all-bar" wx:if="{{allConversations.length > conversations.length}}" bindtap="toggleShowAll">
      <text class="toggle-all-text">{{showAll ? '收起历史会话' : '查看历史已完成会话 (' + (allConversations.length - conversations.length) + ')'}}</text>
      <text class="toggle-all-arrow">{{showAll ? '▲' : '▼'}}</text>
    </view>

    <view class="conversation-list history-list" wx:if="{{showAll && allConversations.length > 0}}">
      <view class="list-header sub-header">
        <text class="list-title">历史会话</text>
      </view>
      <view class="conversation-item" wx:for="{{allConversations}}" wx:key="conversation_id" wx:if="{{item.status !== 'waiting' && item.status !== 'connected'}}" bindtap="openConversation" data-id="{{item.conversation_id}}">
        <view class="conversation-top">
          <text class="conversation-summary">{{item.summary || item.conversation_id}}</text>
          <text class="conversation-status {{item.status}}">{{item.status === 'completed' ? '已完成' : item.status === 'cancelled' ? '已取消' : item.status}}</text>
        </view>
        <text class="conversation-meta">会话ID：{{item.conversation_id}}</text>
        <text class="conversation-meta" wx:if="{{item.assigned_admin_name}}">处理客服：{{item.assigned_admin_name}}</text>
        <text class="conversation-last">{{item.last_message || '暂无消息'}}</text>
        <text class="conversation-enter">点击查看会话 ></text>
      </view>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
