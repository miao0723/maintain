<!--pages/admin/admin.wxml-->
<view class="admin-container">
  <!-- 管理员头部 -->
  <view class="admin-header">
    <view class="header-content">
      <text class="header-title">👑 超级管理员控制台</text>
      <text class="header-subtitle">电子维修管理系统</text>
    </view>
    <view class="admin-avatar">
      <image class="avatar-img" src="{{userInfo.avatar_url || userInfo.avatarUrl || '/images/avatar-repair.png'}}" mode="aspectFill" binderror="onAvatarError"></image>
    </view>
  </view>

  <!-- 数据统计卡片 -->
  <view class="stats-section">
    <view class="stats-grid">
      <view class="stat-card" bindtap="viewAllOrders">
        <view class="stat-icon stat-orders">📋</view>
        <view class="stat-info">
          <text class="stat-value">{{stats.totalOrders}}</text>
          <text class="stat-label">总订单</text>
        </view>
        <view class="stat-badge stat-badge-pending">{{stats.pendingOrders}}</view>
      </view>
      <view class="stat-card" bindtap="viewProcessingOrders">
        <view class="stat-icon stat-processing">🔧</view>
        <view class="stat-info">
          <text class="stat-value">{{stats.processingOrders}}</text>
          <text class="stat-label">维修中</text>
        </view>
      </view>
      <view class="stat-card" bindtap="viewCompletedOrders">
        <view class="stat-icon stat-completed">✅</view>
        <view class="stat-info">
          <text class="stat-value">{{stats.completedOrders}}</text>
          <text class="stat-label">已完成</text>
        </view>
      </view>
      <view class="stat-card" bindtap="viewAllUsers">
        <view class="stat-icon stat-users">👥</view>
        <view class="stat-info">
          <text class="stat-value">{{stats.totalUsers}}</text>
          <text class="stat-label">用户数</text>
        </view>
      </view>
      <view class="stat-card">
        <view class="stat-icon stat-revenue">💰</view>
        <view class="stat-info">
          <text class="stat-value">¥{{stats.totalRevenue}}</text>
          <text class="stat-label">总收入</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 待处理提醒横幅 -->
  <view wx:if="{{pendingCount.total > 0}}" class="pending-banner" bindtap="goToProgressApplyManagement">
    <view class="pending-banner-icon">🔔</view>
    <view class="pending-banner-body">
      <text class="pending-banner-title">您有 {{pendingCount.total}} 条待处理事项</text>
      <view class="pending-banner-desc">
        <text wx:if="{{pendingCount.pendingProgress > 0}}">进度申请 {{pendingCount.pendingProgress}} 条</text>
        <text wx:if="{{pendingCount.pendingOrders > 0}}"> · 待接单 {{pendingCount.pendingOrders}} 条</text>
        <text wx:if="{{pendingCount.pendingQuote > 0}}"> · 待报价 {{pendingCount.pendingQuote}} 条</text>
      </view>
    </view>
    <text class="pending-banner-arrow">›</text>
  </view>

  <!-- 客服管理入口 -->
  <view class="service-entry-banner" bindtap="goToServiceManagement">
    <view class="service-entry-icon">💬</view>
    <view class="service-entry-body">
      <text class="service-entry-title">客服管理</text>
      <text class="service-entry-desc">接入人工客服会话并实时回复用户消息</text>
    </view>
    <view class="service-entry-tag">人工客服</view>
    <text class="service-entry-arrow">›</text>
  </view>

  <!-- 功能模块 -->
  <view class="modules-section">
    <view class="section-title">
      <text class="title-text">管理功能</text>
    </view>

    <view class="modules-grid">
      <!-- 进度申请管理 (重要，放在第一位) -->
      <view class="module-card highlight" bindtap="goToProgressApplyManagement">
        <view class="module-icon">📝</view>
        <text class="module-name">进度申请</text>
        <text class="module-desc">审核用户的进度申请</text>
        <view wx:if="{{pendingCount.pendingProgress > 0}}" class="module-badge danger">{{pendingCount.pendingProgress > 99 ? '99+' : pendingCount.pendingProgress}}</view>
      </view>

      <!-- 我的订单 -->
      <view class="module-card highlight" bindtap="goToMyOrders">
        <view class="module-icon">📋</view>
        <text class="module-name">我的订单</text>
        <text class="module-desc">查看和处理我的订单</text>
        <view class="module-badge">{{stats.processingOrders}}</view>
      </view>

      <!-- 订单分配 -->
      <view class="module-card" bindtap="goToOrderAssign">
        <view class="module-icon">👷</view>
        <text class="module-name">订单分配</text>
        <text class="module-desc">分配订单给管理员</text>
        <view wx:if="{{pendingCount.pendingOrders > 0}}" class="module-badge danger">{{pendingCount.pendingOrders}}</view>
      </view>

      <!-- 订单管理 -->
      <view class="module-card" bindtap="goToOrderManagement">
        <view class="module-icon">📊</view>
        <text class="module-name">订单管理</text>
        <text class="module-desc">查看和处理所有订单</text>
        <text class="module-badge">{{stats.totalOrders}}</text>
      </view>

      <!-- 用户管理 -->
      <view class="module-card" bindtap="goToUserManagement">
        <view class="module-icon">👥</view>
        <text class="module-name">用户管理</text>
        <text class="module-desc">管理用户信息和权限</text>
      </view>

      <!-- 设备管理 -->
      <view class="module-card" bindtap="goToDeviceManagement">
        <view class="module-icon">📱</view>
        <text class="module-name">设备管理</text>
        <text class="module-desc">管理设备型号和维修项目</text>
      </view>

      <!-- 价格管理 -->
      <view class="module-card" bindtap="goToPriceManagement">
        <view class="module-icon">💰</view>
        <text class="module-name">价格管理</text>
        <text class="module-desc">管理维修价格表</text>
      </view>

      <!-- 单位管理 -->
      <view class="module-card" bindtap="goToUnitManagement">
        <view class="module-icon">🏢</view>
        <text class="module-name">单位管理</text>
        <text class="module-desc">管理维修单位信息</text>
      </view>

      <!-- 全部订单 -->
      <view class="module-card" bindtap="goToAllOrdersList">
        <view class="module-icon">📋</view>
        <text class="module-name">全部订单</text>
        <text class="module-desc">完整数据可视化展示</text>
        <view class="module-badge new">新</view>
      </view>

      <!-- 数据统计 -->
      <view class="module-card" bindtap="goToDataStatistics">
        <view class="module-icon">📊</view>
        <text class="module-name">数据统计</text>
        <text class="module-desc">查看详细数据报表</text>
      </view>

      <!-- 系统设置 -->
      <view class="module-card" bindtap="goToSystemSettings">
        <view class="module-icon">⚙️</view>
        <text class="module-name">系统设置</text>
        <text class="module-desc">管理系统配置</text>
      </view>

    </view>
  </view>

  <!-- 维修人员列表 (仅超级管理员) -->
  <view class="technicians-section" wx:if="{{userInfo.role === 'super_admin' && technicians.length > 0}}">
    <view class="section-title">
      <text class="title-text">维修人员</text>
      <text class="title-count">{{technicians.length}}人</text>
    </view>

    <view class="technicians-list">
      <view class="technician-item" wx:for="{{technicians}}" wx:key="id">
        <view class="tech-avatar">
          <image class="tech-avatar-img" src="{{item.avatar_url || '/images/avatar-repair.png'}}" mode="aspectFill"></image>
        </view>
        <view class="tech-info">
          <text class="tech-name">{{item.real_name || item.nickname}}</text>
          <text class="tech-phone">{{item.phone}}</text>
          <view class="tech-stats">
            <text class="tech-stat">订单: {{item.total_orders}}</text>
            <text class="tech-stat processing">维修中: {{item.processing_orders}}</text>
            <text class="tech-stat completed">已完成: {{item.completed_orders}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="recent-orders-section" wx:if="{{recentOrders.length > 0}}">
    <view class="section-title">
      <text class="title-text">最近订单</text>
      <text class="title-more" bindtap="goToAllOrdersList">查看全部 ></text>
    </view>

    <view class="recent-orders-list">
      <view class="recent-order-item" wx:for="{{recentOrders}}" wx:key="id">
        <view class="ro-header">
          <text class="ro-device">{{item.device_model}}</text>
          <text class="ro-status ro-status-{{item.status}}">{{item.status === 'pending' ? '待处理' : item.status === 'processing' ? '维修中' : item.status === 'completed' ? '已完成' : '已取消'}}</text>
        </view>
        <view class="ro-body">
          <text class="ro-customer">{{item.customer_name}}</text>
          <text class="ro-price">¥{{item.actual_price || item.estimated_price || 0}}</text>
        </view>
        <view class="ro-footer">
          <text class="ro-time">{{item.created_at}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions-section">
    <view class="section-title">
      <text class="title-text">快捷操作</text>
    </view>

    <view class="actions-list">
      <view class="action-item" bindtap="exportData">
        <view class="action-icon">📥</view>
        <text class="action-text">导出数据</text>
      </view>
      <view class="action-item" bindtap="clearCache">
        <view class="action-icon">🗑️</view>
        <text class="action-text">清除缓存</text>
      </view>
      <view class="action-item" bindtap="sendNotification">
        <view class="action-icon">📢</view>
        <text class="action-text">发送通知</text>
      </view>
      <view class="action-item" bindtap="checkSystem">
        <view class="action-icon">🔍</view>
        <text class="action-text">系统检查</text>
      </view>
    </view>
  </view>

  <!-- 返回用户端 -->
  <view class="back-section">
    <button class="back-btn" bindtap="goToUserApp">
      <text class="back-icon">🏠</text>
      <text class="back-text">返回用户端</text>
    </button>
  </view>
</view>
<confirm-modal id="confirmModal" />
