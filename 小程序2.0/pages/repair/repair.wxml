      <text class="internal-banner-icon">🏢</text>
      <view class="internal-banner-text">
        <text class="internal-banner-title">内部免付款回收申请</text>
        <text class="internal-banner-desc">您填写信息提交后即为内部申请，无需支付，由管理员确认后安排回收</text>
      </view>
    </view>

    <view class="recycle-overview" wx:if="{{recycleType || isCustomRecycleType}}">
      <view class="overview-header">
        <view>
          <text class="overview-title">回收信息</text>
          <text class="overview-subtitle">优先补全类型、品牌、型号、成色</text>
        </view>
        <view class="overview-state {{canSubmitRecycle ? 'ready' : 'editing'}}">{{canSubmitRecycle ? '可提交' : '待完善'}}</view>
      </view>
      <view class="overview-tags">
        <view class="overview-tag">{{isCustomRecycleType ? customRecycleType : (recycleType ? recycleType.name : '未选类型')}}</view>
        <view class="overview-tag" wx:if="{{selectedRecycleBrand || customRecycleBrand}}">{{isCustomRecycleBrand ? customRecycleBrand : selectedRecycleBrand.name}}</view>
        <view class="overview-tag" wx:if="{{deviceModel}}">{{deviceModel}}</view>
        <view class="overview-tag accent" wx:if="{{deviceCondition}}">{{deviceCondition}}</view>
      </view>
    </view>

    <!-- 回收类型 -->
    <view class="section">
      <view class="section-header drawer-header" bindtap="toggleRecycleTypeDrawer">
        <view class="drawer-title-group">
          <view class="section-title">回收类型</view>
          <view class="section-subtitle" wx:if="{{!(recycleType || isCustomRecycleType)}}">找不到您的类型？可以选择自定义</view>
          <view class="drawer-summary" wx:if="{{recycleType || isCustomRecycleType}}">
            已选：{{isCustomRecycleType ? customRecycleType : recycleType.name}}
          </view>
        </view>
        <view class="drawer-toggle">
          <text class="drawer-toggle-text">{{showRecycleTypeDrawer ? '收起' : '展开'}}</text>
          <text class="drawer-toggle-icon">{{showRecycleTypeDrawer ? '▴' : '▾'}}</text>
        </view>
      </view>
      <view class="drawer-content" wx:if="{{showRecycleTypeDrawer}}">
      <view class="recycle-types recycle-grid">
        <view
          class="recycle-item {{recycleType && recycleType.id === item.id ? 'active' : ''}}"
          wx:for="{{recycleTypes}}"
          wx:key="id"
          bindtap="selectRecycleType"
          data-id="{{item.id}}">
          <view class="recycle-icon">{{item.icon}}</view>
          <view class="recycle-info">
            <text class="recycle-name">{{item.name}}</text>
            <text class="recycle-price">{{item.price}}</text>
            <text class="recycle-summary">{{item.summary}}</text>
          </view>
          <view class="recycle-check {{recycleType && recycleType.id === item.id ? 'checked' : ''}}">✓</view>
        </view>
        <!-- 自定义回收类型选项 -->
        <view
          class="recycle-item {{isCustomRecycleType ? 'active custom' : 'custom'}}"
          bindtap="selectCustomRecycleType">
          <view class="recycle-icon">✏️</view>
          <view class="recycle-info">
            <text class="recycle-name">自定义类型</text>
            <text class="recycle-price">等待报价</text>
            <text class="recycle-summary">无人机、音响、专业设备等</text>
          </view>
          <view class="recycle-check {{isCustomRecycleType ? 'checked' : ''}}">✓</view>
        </view>
      </view>
      </view>
    </view>

    <!-- 自定义回收类型输入 -->
    <view class="section custom-input-section" wx:if="{{isCustomRecycleType}}">
      <view class="custom-header">
        <view class="custom-badge">
          <text class="custom-badge-icon">✏️</text>
          <text class="custom-badge-text">自定义回收类型</text>
        </view>
        <text class="input-required {{customRecycleType ? 'filled' : ''}}">{{customRecycleType ? '✓ 已填写' : '必填'}}</text>
      </view>
      <view class="input-wrapper {{customRecycleType ? 'has-value' : ''}}">
        <text class="input-prefix">设备类型：</text>
        <input
          class="custom-input-field"
          placeholder="例如：无人机、投影仪、音响等"
          value="{{customRecycleType}}"
          bindinput="onCustomRecycleTypeInput"
          maxlength="20"/>
      </view>
      <view class="input-tip">
        <text class="tip-icon">💡</text>
        <text class="tip-text">准确描述设备类型有助于我们提供精准的回收报价</text>
      </view>
    </view>

    <!-- 设备品牌 -->
    <view class="section" wx:if="{{recycleType || isCustomRecycleType}}">
      <view class="section-header drawer-header" bindtap="toggleRecycleBrandDrawer">
        <view class="drawer-title-group">
          <view class="section-title">设备品牌</view>
          <view class="drawer-summary" wx:if="{{selectedRecycleBrand || customRecycleBrand}}">
            已选：{{isCustomRecycleBrand ? customRecycleBrand : selectedRecycleBrand.name}}
          </view>
        </view>
        <view class="drawer-toggle">
          <text class="drawer-toggle-text">{{showRecycleBrandDrawer ? '收起' : '展开'}}</text>
          <text class="drawer-toggle-icon">{{showRecycleBrandDrawer ? '▴' : '▾'}}</text>
        </view>
      </view>
      <view class="drawer-content" wx:if="{{showRecycleBrandDrawer}}">
      <!-- 预设品牌列表（选择了回收类型时显示） -->
      <view class="brand-grid" wx:if="{{recycleBrands.length > 0}}">
        <view
          class="brand-item {{selectedRecycleBrand && selectedRecycleBrand.id === item.id ? 'active' : ''}}"
          wx:for="{{recycleBrands}}"
          wx:key="id"
          bindtap="selectRecycleBrand"
          data-id="{{item.id}}">
          <text class="brand-name">{{item.name}}</text>
        </view>
        <!-- 自定义品牌选项 -->
        <view
          class="brand-item {{isCustomRecycleBrand ? 'active custom' : 'custom'}}"
          bindtap="selectCustomRecycleBrand">
          <text class="brand-name">其他品牌</text>
        </view>
      </view>
      <!-- 自定义回收类型时，只显示自定义品牌入口 -->
      <view class="brand-grid" wx:if="{{recycleBrands.length === 0}}">
        <view
          class="brand-item {{isCustomRecycleBrand ? 'active custom' : 'custom'}}"
          bindtap="selectCustomRecycleBrand">
          <text class="brand-name">自定义品牌</text>
        </view>
      </view>
      </view>
    </view>

    <!-- 自定义品牌输入 -->
    <view class="section custom-input-section" wx:if="{{isCustomRecycleBrand}}">
      <view class="custom-header">
        <view class="custom-badge">
          <text class="custom-badge-icon">✏️</text>
          <text class="custom-badge-text">自定义品牌</text>
        </view>
        <text class="input-required {{customRecycleBrand ? 'filled' : ''}}">{{customRecycleBrand ? '✓ 已填写' : '必填'}}</text>
      </view>
      <view class="input-wrapper {{customRecycleBrand ? 'has-value' : ''}}">
        <text class="input-prefix">品牌名称：</text>
        <input
          class="custom-input-field"
          placeholder="例如：大疆、索尼、极米等"
          value="{{customRecycleBrand}}"
          bindinput="onCustomRecycleBrandInput"
          maxlength="20"/>
      </view>
      <view class="input-tip">
        <text class="tip-icon">💡</text>
        <text class="tip-text">品牌信息可以帮助我们更准确地评估设备价值</text>
      </view>
    </view>

    <!-- 设备型号 -->
    <view class="section" wx:if="{{(recycleType || isCustomRecycleType) && (selectedRecycleBrand || isCustomRecycleBrand)}}">
      <view class="section-header drawer-header" bindtap="toggleRecycleModelDrawer">
        <view class="drawer-title-group">
          <view class="section-title">设备型号</view>
          <view class="section-subtitle" wx:if="{{!deviceModel}}">已知型号直接选，价格会更准确</view>
          <view class="drawer-summary" wx:if="{{deviceModel}}">
            已选：{{deviceModel}}{{selectedRecycleModel ? '' : '（手动输入）'}}
          </view>
        </view>
        <view class="drawer-toggle">
          <text class="drawer-toggle-text">{{showRecycleModelDrawer ? '收起' : '展开'}}</text>
          <text class="drawer-toggle-icon">{{showRecycleModelDrawer ? '▴' : '▾'}}</text>
        </view>
      </view>
      <view class="drawer-content" wx:if="{{showRecycleModelDrawer}}">
        <view class="model-list-inline" wx:if="{{recycleModels.length > 0 && !isCustomRecycleBrand}}">
          <view
            class="model-item {{selectedRecycleModel && selectedRecycleModel.id === item.id ? 'active' : ''}}"
            wx:for="{{recycleModels}}"
            wx:key="id"
            bindtap="selectRecycleModel"
            data-id="{{item.id}}">
            <view class="model-info">
              <text class="model-name">{{item.name}}</text>
              <text class="model-rate">报价系数 {{item.priceRate}}x</text>
            </view>
          </view>
        </view>
        <view class="custom-model-btn" bindtap="selectCustomRecycleModel">
          <text class="custom-btn-icon">✏️</text>
          <text class="custom-btn-text">手动输入型号</text>
        </view>
        <input
          class="model-input recycle-model-input"
          placeholder="请输入具体型号，如：iPhone 13 Pro"
          value="{{deviceModel}}"
          bindinput="onRecycleModelInput"/>
        <text class="model-input-tip" wx:if="{{!selectedRecycleModel && deviceModel}}">
          当前为手动输入型号，将转为人工报价
        </text>
      </view>
    </view>

    <!-- 设备状态 -->
    <view class="section" wx:if="{{(recycleType || isCustomRecycleType) && (selectedRecycleBrand || isCustomRecycleBrand)}}">
      <view class="section-header drawer-header" bindtap="toggleRecycleConditionDrawer">
        <view class="drawer-title-group">
          <view class="section-title">设备状态（成色）</view>
          <view class="drawer-summary" wx:if="{{deviceCondition}}">已选：{{deviceCondition}}</view>
        </view>
        <view class="drawer-toggle">
          <text class="drawer-toggle-text">{{showRecycleConditionDrawer ? '收起' : '展开'}}</text>
          <text class="drawer-toggle-icon">{{showRecycleConditionDrawer ? '▴' : '▾'}}</text>
        </view>
      </view>
      <view class="drawer-content" wx:if="{{showRecycleConditionDrawer}}">
      <view class="condition-options">
        <view
          class="condition-item {{deviceCondition === item.name ? 'active' : ''}}"
          wx:for="{{conditions}}"
          wx:key="id"
          bindtap="selectRecycleCondition"
          data-id="{{item.id}}">
          <view class="condition-header">
            <text class="condition-name">{{item.name}}</text>
            <text class="condition-rate">{{item.rate * 10}}折</text>
          </view>
          <text class="condition-desc">回收价按{{item.rate * 100}}%计算</text>
        </view>
      </view>
      </view>
    </view>

    <!-- 回收描述 -->
    <view class="section" wx:if="{{(recycleType || isCustomRecycleType) && (selectedRecycleBrand || isCustomRecycleBrand)}}">
      <view class="section-title">设备描述</view>
      <view class="custom-input">
        <textarea
          class="textarea"
          placeholder="请详细描述设备的情况，如：是否有划痕、是否修过、配件是否齐全等..."
          value="{{recycleDescription}}"
          bindinput="onRecycleDescriptionInput"
          maxlength="200"/>
        <text class="char-count">{{recycleDescription.length}}/200</text>
      </view>
    </view>

    <!-- 上传设备照片 -->
    <view class="section" wx:if="{{(recycleType || isCustomRecycleType) && (selectedRecycleBrand || isCustomRecycleBrand)}}">
      <view class="section-title">上传设备照片</view>
      <view class="upload-area">
        <view class="upload-btn" bindtap="chooseRecycleImage" wx:if="{{recycleImageList.length < 3}}">
          <text class="upload-icon">+</text>
          <text class="upload-text">添加照片</text>
        </view>
        <view class="image-preview" wx:for="{{recycleImageList}}" wx:key="index" bindtap="previewRecycleImage" data-index="{{index}}">
          <image class="preview-img" src="{{item}}" mode="aspectFill"></image>
          <view class="remove-btn" catchtap="deleteRecycleImage" data-index="{{index}}">×</view>
        </view>
      </view>
      <text class="upload-tip">最多上传3张照片，有助于我们准确评估设备价值</text>
    </view>

    <!-- 创建回收订单按钮 -->
    <view class="section">
      <button class="create-recycle-btn {{canSubmitRecycle ? 'active' : 'disabled'}}" bindtap="showRecycleConfirm" disabled="{{!canSubmitRecycle || recycleSubmitting}}" loading="{{recycleSubmitting}}">
        <text class="btn-icon">📦</text>
        <text class="btn-text">{{isInternal ? '提交内部回收申请' : (canSubmitRecycle ? '创建回收订单' : '请完善回收信息')}}</text>
        <text class="btn-hint" wx:if="{{isInternal && canSubmitRecycle}}">内部免付款申请</text>
        <text class="btn-hint" wx:if="{{!isInternal && canSubmitRecycle && !isRecycleWaitingPrice}}">预估价：¥{{recyclablePrice}}</text>
        <text class="btn-hint waiting" wx:if="{{!isInternal && canSubmitRecycle && isRecycleWaitingPrice}}">等待管理员报价</text>
      </button>
      <text class="create-hint" wx:if="{{!canSubmitRecycle}}">请依次选择：回收类型、品牌、型号、成色</text>
    </view>

    <!-- 估价结果（内部人员不展示金额） -->
    <view class="section price-section" wx:if="{{!isInternal && recyclablePrice > 0 && !isRecycleWaitingPrice}}">
      <view class="price-title">预估回收价</view>
      <view class="price-display">
        <text class="price-symbol">¥</text>
        <text class="price-amount">{{recyclablePrice}}</text>
      </view>
      <view class="price-range" wx:if="{{recyclePriceRange.max > 0}}">
        <text class="price-range-text">参考区间 ¥{{recyclePriceRange.min}} ~ ¥{{recyclePriceRange.max}}</text>
      </view>
      <text class="price-note">最终价格以检测后实际报价为准</text>
    </view>

    <!-- 等待报价提示（内部人员不展示） -->
    <view class="section price-section waiting-section" wx:if="{{!isInternal && isRecycleWaitingPrice}}">
      <view class="price-title">等待报价</view>
      <view class="price-display waiting-display">
        <text class="price-icon">⏰</text>
        <text class="price-amount">等待管理员报价</text>
      </view>
      <text class="price-note">自定义类型或品牌需要管理员评估后报价</text>
    </view>

    <!-- 内部人员免付款提示 -->
    <view class="section internal-note-section" wx:if="{{isInternal}}">
      <view class="internal-note-icon">🏢</view>
      <view class="internal-note-text">内部免付款申请 · 提交后由管理员确认并安排回收，全程无需支付</view>
    </view>

    <!-- 内部人员：设备来源选择 -->
    <view class="section device-source-section" wx:if="{{isInternal}}">
      <view class="section-title">设备来源 <text class="required-mark">*</text></view>
      <view class="device-source-options">
        <view class="device-source-option {{deviceSource === item.key ? 'active' : ''}}"
              wx:for="{{deviceSourceOptions}}" wx:key="key"
              bindtap="selectDeviceSource" data-key="{{item.key}}">
          <view class="device-source-check {{deviceSource === item.key ? 'checked' : ''}}">✓</view>
          <text class="device-source-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 提交回收 -->
    <view class="bottom-action recycle-action {{isInternal ? 'internal' : ''}}" wx:if="{{canSubmitRecycle}}">
      <view class="price-info">
        <text class="price-label" wx:if="{{isInternal}}">状态：</text>
        <text class="price-label" wx:elif="{{isRecycleWaitingPrice}}">状态：</text>
        <text class="price-label" wx:else>预估价：</text>
        <text class="price-value" wx:if="{{isInternal}}">内部免付款申请</text>
        <text class="price-value waiting" wx:elif="{{isRecycleWaitingPrice}}">等待报价</text>
        <text class="price-value" wx:else>¥{{recyclablePrice}}</text>
      </view>
      <button class="submit-btn recycle-btn {{isInternal ? 'internal' : (isRecycleWaitingPrice ? 'waiting' : '')}}" bindtap="submitRecycleOrder" disabled="{{recycleSubmitting}}" loading="{{recycleSubmitting}}">
        <text class="btn-icon" wx:if="{{isInternal}}">🏢</text>
        <text class="btn-icon" wx:elif="{{isRecycleWaitingPrice}}">📤</text>
        <text>{{isInternal ? '提交内部回收申请' : (isRecycleWaitingPrice ? '提交申请' : '提交回收申请')}}</text>
      </button>
    </view>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>

  <!-- 单位选择器弹窗 -->
  <view class="unit-selector-mask" wx:if="{{showUnitSelector}}" catchtap="hideUnitSelector">
    <view class="unit-selector-content" catchtap="">
