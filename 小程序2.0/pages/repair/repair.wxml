        <text class="unit-selector-title">选择单位</text>
        <view class="unit-selector-close" bindtap="hideUnitSelector">×</view>
      </view>

      <scroll-view class="unit-selector-body" scroll-y>
        <view wx:if="{{unitList.length === 0}}" class="empty-unit">
          <text class="empty-icon">🏢</text>
          <text class="empty-text">暂无单位</text>
        </view>

        <view class="unit-item-list">
          <view
            class="unit-list-item {{selectedUnit && selectedUnit.id === item.id ? 'selected' : ''}}"
            wx:for="{{unitList}}"
            wx:key="id"
            bindtap="selectUnit"
            data-id="{{item.id}}">
            <view class="unit-list-left">
              <view class="unit-list-icon">🏢</view>
              <view class="unit-list-details">
                <view class="unit-list-name-row">
                  <text class="unit-list-name">{{item.name}}</text>
                  <view class="unit-list-badge" wx:if="{{item.isDefault}}">默认</view>
                </view>
                <view class="unit-list-contact">
                  <text class="contact-person">{{item.contactName}}</text>
                  <text class="contact-phone">{{item.contactPhone}}</text>
                </view>
                <text class="unit-list-address">{{item.address}}</text>
              </view>
            </view>
            <view class="unit-list-check" wx:if="{{selectedUnit && selectedUnit.id === item.id}}">✓</view>
          </view>
        </view>
      </scroll-view>

      <view class="unit-selector-footer">
        <button class="add-unit-btn" bindtap="addNewUnit">
          <text class="add-btn-icon">+</text>
          <text>添加新单位</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 地址选择器弹窗 -->
  <view class="address-selector-mask" wx:if="{{showAddressSelector}}" catchtap="hideAddressSelector">
    <view class="address-selector-content" catchtap="">
      <view class="address-selector-header">
        <text class="address-selector-title">选择上门地址</text>
        <view class="address-selector-close" bindtap="hideAddressSelector">×</view>
      </view>

      <scroll-view class="address-selector-body" scroll-y>
        <view wx:if="{{addressList.length === 0}}" class="empty-address">
          <text class="empty-icon">📍</text>
          <text class="empty-text">暂无地址</text>
        </view>

        <view class="address-item-list">
          <view
            class="address-item {{selectedAddress && selectedAddress.id === item.id ? 'selected' : ''}}"
            wx:for="{{addressList}}"
            wx:key="id"
            bindtap="selectAddress"
            data-id="{{item.id}}">
            <view class="address-item-content">
              <view class="address-item-header">
                <text class="contact-name">{{item.contactName}}</text>
                <text class="contact-phone">{{item.contactPhone}}</text>
              </view>
              <text class="address-detail">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</text>
            </view>
            <view wx:if="{{selectedAddress && selectedAddress.id === item.id}}" class="address-check">✓</view>
          </view>
        </view>
      </scroll-view>

      <view class="address-selector-footer">
        <button class="add-address-btn" bindtap="addNewAddress">
          <text class="add-btn-icon">+</text>
          <text>添加新地址</text>
        </button>
      </view>
    </view>
  </view>
</view>
