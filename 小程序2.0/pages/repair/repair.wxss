  background: linear-gradient(135deg, #ffa502 0%, #ff6348 100%);
}

/* 内部人员免付款回收按钮：与内部维修横幅配色一致 */
.recycle-btn.internal,
.recycle-action.internal {
  background: linear-gradient(135deg, #1d4ed8 0%, #4b6cb7 100%);
}

/* 回收操作区域 */
.recycle-action {
  background: linear-gradient(135deg, #ffa502 0%, #ff6348 100%);
  border-top: none;
}

.recycle-action .price-value {
  color: #ffffff;
}

.recycle-action .price-label {
  color: rgba(255, 255, 255, 0.9);
}

/* 创建回收订单按钮 */
.create-recycle-btn {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0f0f0 0%, #dde5ee 100%);
  color: #999;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 15rpx;
  border: none;
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
}

.create-recycle-btn.active {
  background: linear-gradient(135deg, #ffa502 0%, #ff6348 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(255, 165, 2, 0.4);
}


.create-recycle-btn:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(255, 165, 2, 0.3);
}

.create-recycle-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.btn-text {
  flex: 1;
  text-align: center;
  letter-spacing: 2rpx;
}

.btn-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 5rpx 15rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 20rpx;
  margin-left: 20rpx;
  }


.create-recycle-btn.disabled {
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  color: #ccc;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  cursor: not-allowed;
}

.create-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 15rpx;
  padding: 10rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
  border-left: 4rpx solid #4f6b84;
}

/* 底部间距 */
.bottom-space {
  height: 20rpx;
}

/* 已选设备信息 */
.device-info {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(79, 107, 132, 0.25);
}

.device-info .info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.device-info .info-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.device-info .info-icon {
  font-size: 36rpx;
}

.device-info .info-label {
  font-size: 30rpx;
  font-weight: bold;
}

.device-info .custom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.device-info .custom-tags .custom-tag {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.95);
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
}

.device-info .info-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx 20rpx;
}

.device-detail-item {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  padding: 10rpx 0;
}

.detail-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.detail-icon {
  font-size: 24rpx;
  opacity: 0.8;
}

.detail-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.detail-value-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
  justify-content: flex-start;
  margin-top: 8rpx;
}

.detail-value {
  font-size: 26rpx;
  font-weight: 600;
  text-align: left;
  word-break: break-all;
  line-height: 1.4;
}

.detail-badge {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.95);
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  white-space: nowrap;
}



/* 单位选择相关样式 - 卡片式设计 */
.selected-unit-card {
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #4f6b8408 0%, #6a9abb08 100%);
  border-radius: 24rpx;
  border: 2rpx solid #4f6b8430;
  overflow: hidden;
  transition: all 0.3s ease;
}

.selected-unit-card:active {
  transform: scale(0.98);
}

.unit-card-main {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  gap: 20rpx;
}

.unit-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 20rpx;
  font-size: 40rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 15rpx rgba(79, 107, 132, 0.3);
}

.unit-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.unit-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.unit-name-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 350rpx;
}

.unit-default-badge {
  font-size: 18rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #ffffff;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(79, 107, 132, 0.3);
}

.unit-contact-row {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.unit-contact-person {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.unit-contact-phone {
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.unit-address-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.unit-address-icon {
  font-size: 22rpx;
  line-height: 1;
  margin-top: 2rpx;
}

.unit-address-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.unit-card-actions {
  display: flex;
  border-top: 1rpx solid #4f6b8420;
  background: rgba(255,255,255, 0.5);
}

.unit-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #4f6b84;
  font-weight: 500;
  transition: all 0.3s ease;
  position: relative;
}

.unit-action-btn:not(:last-child) {
  border-right: 1rpx solid #4f6b8420;
}

.unit-action-btn:active {
  background: rgba(79, 107, 132, 0.1);
}

.unit-action-btn.cancel {
  color: #ff6b6b;
}

.unit-action-btn.cancel:active {
  background: rgba(255, 107, 107, 0.1);
}

.action-icon {
  font-size: 28rpx;
}

.action-text {
  font-size: 26rpx;
}

.select-unit-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: linear-gradient(135deg, #4f6b8415 0%, #6a9abb15 100%);
  border-radius: 16rpx;
  border: 2rpx dashed #4f6b8440;
  gap: 10rpx;
}

.select-unit-hint .hint-text {
  font-size: 28rpx;
  color: #4f6b84;
}

.unit-tip {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
  padding: 15rpx 20rpx;
  background: #f0f5ff;
  border-radius: 12rpx;
  border-left: 4rpx solid #4f6b84;
  gap: 8rpx;
}

.unit-tip .tip-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 单位选择器弹窗 */
.unit-selector-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.unit-selector-content {
  width: 100%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.unit-selector-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.unit-selector-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.unit-selector-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.unit-selector-body {
  max-height: 50vh;
}

.empty-unit {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
}

.empty-unit .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-unit .empty-text {
  font-size: 28rpx;
  color: #999;
}


.unit-item-list {
  padding: 20rpx 30rpx;
}

/* 单位列表项 - 优化样式 */
.unit-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 20rpx;
  margin-bottom: 15rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.unit-list-item:active {
  transform: scale(0.98);
}

.unit-list-item.selected {
  background: linear-gradient(135deg, #4f6b8410 0%, #6a9abb10 100%);
  border-color: #4f6b84;
}

.unit-list-left {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  flex: 1;
}

.unit-list-icon {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 16rpx;
  font-size: 36rpx;
  flex-shrink: 0;
}

.unit-list-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.unit-list-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.unit-list-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
}

.unit-list-badge {
  font-size: 16rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.unit-list-contact {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.unit-list-contact .contact-person {
  font-size: 24rpx;
  color: #666;
}

.unit-list-contact .contact-phone {
  font-size: 24rpx;
  color: #999;
}

.unit-list-address {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.unit-list-check {
  width: 45rpx;
  height: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #ffffff;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: bold;
  margin-left: 15rpx;
  flex-shrink: 0;
}

.unit-selector-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.add-unit-btn {
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 45rpx;
  border: none;
  gap: 8rpx;
}

.add-unit-btn::after {
  border: none;
}

/* 内部人员设备来源选择 */
.device-source-section {
  background-color: rgba(255, 255, 255, 0.95);
  margin: 16rpx 24rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(79, 107, 132, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.device-source-section .section-title {
  margin-bottom: 18rpx;
}

.required-mark {
  color: #e54d42;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.device-source-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.device-source-option {
  flex: 1;
  min-width: 180rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  border: 2rpx solid #e5e8eb;
  transition: all 0.25s ease;
}

.device-source-option.active {
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.1) 0%, rgba(75, 108, 183, 0.1) 100%);
  border-color: #1d4ed8;
}

.device-source-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #c0c4cc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.device-source-check.checked {
  background: #1d4ed8;
  border-color: #1d4ed8;
}

.device-source-label {
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 500;
}
