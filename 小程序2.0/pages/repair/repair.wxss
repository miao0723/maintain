/* pages/repair/repair.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f2f5 0%, #e5e8eb 100%);
  padding-bottom: 210rpx;
}

.tab-content {
  padding-top: 10rpx;
}

/* 内部人员免付款申请提示横幅 */
.internal-banner {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #eef6ff 0%, #e3f0ff 100%);
  border: 1rpx solid #bcd9ff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(79, 107, 132, 0.08);
}

.internal-banner-icon {
  font-size: 44rpx;
  flex-shrink: 0;
}

.internal-banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.internal-banner-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d4ed8;
}

.internal-banner-desc {
  font-size: 21rpx;
  line-height: 1.5;
  color: #4b6cb7;
}

.repair-wizard {
  padding: 10rpx 0 40rpx;
}

.repair-hero {
  margin: 20rpx 24rpx 0;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.2), transparent 28%),
    linear-gradient(135deg, #4f627d 0%, #6f86a5 52%, #879cb0 100%);
  box-shadow: 0 18rpx 42rpx rgba(79, 98, 125, 0.24);
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: #ffffff;
}

.repair-hero-copy {
  flex: 1;
}

.repair-hero-eyebrow {
  display: block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.72);
}

.repair-hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.repair-hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.84);
}

.repair-hero-badge {
  align-self: flex-start;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
  font-weight: 700;
}

.repair-progress-card {
  margin: 18rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 34rpx rgba(79, 98, 125, 0.12);
  backdrop-filter: blur(18rpx);
}

.repair-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.repair-progress-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #14202e;
}

.repair-progress-percent {
  font-size: 22rpx;
  color: #6a9abb;
  font-weight: 600;
}

.repair-progress-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #65758b;
}

.repair-progress-track {
  margin-top: 16rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #e3e9f0;
  overflow: hidden;
}

.repair-progress-bar {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #4f627d 0%, #7991b0 100%);
}

.repair-step-strip {
  margin-top: 20rpx;
  white-space: nowrap;
}

.repair-step-list {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 6rpx;
}

.repair-step-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  color: #62738a;
}

.repair-step-chip.active {
  background: linear-gradient(135deg, #4f627d 0%, #6f86a5 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(79, 98, 125, 0.22);
}

.repair-step-chip.done {
  background: #dde7f2;
}

.repair-step-chip-index {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
  font-weight: 700;
}

.repair-step-chip.active .repair-step-chip-index {
  background: rgba(255, 255, 255, 0.2);
}

.repair-step-chip-text {
  font-size: 22rpx;
  font-weight: 600;
}

.wizard-summary {
  margin-top: 18rpx;
}

.wizard-stage {
  margin-top: 14rpx;
}

.wizard-stage-header {
  margin: 0 24rpx 12rpx;
  padding: 0 6rpx;
}

.wizard-stage-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #16202d;
}

.wizard-stage-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #738196;
}

.wizard-tip-card {
  background: linear-gradient(135deg, #f6f9fc 0%, #edf2f7 100%);
}

.wizard-tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
}

.wizard-tip-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.manual-step-tip {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(79, 98, 125, 0.06);
}

.manual-step-tip-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #5f6f84;
}

.review-card-section {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
}

.review-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.review-row:first-child {
  padding-top: 0;
}

.review-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.review-label {
  display: block;
  font-size: 22rpx;
  color: #7b8798;
}

.review-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #1f2937;
  word-break: break-word;
}

.wizard-price-section {
  margin-bottom: 0;
}

/* 内部人员免付款提示区块（维修/回收共用） */
.internal-note-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.08) 0%, rgba(75, 108, 183, 0.08) 100%);
  border: 1rpx solid rgba(29, 78, 216, 0.2);
}

.internal-note-icon {
  font-size: 40rpx;
  line-height: 1;
}

.internal-note-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.6;
  color: #1d4ed8;
  font-weight: 500;
}

.submit-callout {
  background: linear-gradient(135deg, #fffdf8 0%, #f8fbff 100%);
  border: 1rpx solid rgba(111, 134, 165, 0.12);
}

.submit-callout-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.submit-callout-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.confirm-submit-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4f627d 0%, #6f86a5 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(79, 98, 125, 0.24);
}

.confirm-submit-btn::after {
  border: none;
}

.confirm-submit-btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.repair-step-footer {
  margin: 18rpx 24rpx 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(43, 56, 73, 0.16);
  backdrop-filter: blur(16rpx);
}

.repair-step-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 700;
}

.repair-step-btn.only,
.repair-step-btn.single {
  flex: none;
  width: 100%;
}

.repair-step-btn::after {
  border: none;
}

.repair-step-btn.ghost {
  background: #eef2f6;
  color: #5b6d84;
}

.repair-step-btn.primary {
  background: linear-gradient(135deg, #4f627d 0%, #6f86a5 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(79, 98, 125, 0.28);
}

.repair-step-btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.repair-overview,
.recycle-overview {
  margin: 20rpx 24rpx 8rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(79, 107, 132, 0.96) 0%, rgba(110, 133, 165, 0.96) 100%);
  box-shadow: 0 10rpx 28rpx rgba(79, 107, 132, 0.18);
  color: #ffffff;
}

.overview-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.overview-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.overview-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.overview-state {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.18);
}

.overview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.overview-tag {
  max-width: 100%;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
  line-height: 1.3;
}

.overview-tag.accent {
  background: rgba(255, 255, 255, 0.22);
}

/* 顶部Tab切换 */
.top-tabs {
  display: flex;
  background: linear-gradient(135deg, rgba(79, 107, 132, 0.05) 0%, rgba(110, 133, 165, 0.05) 100%);
  padding: 18rpx 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(79, 107, 132, 0.12);
  position: relative;
  z-index: 100;
  border-bottom: 2rpx solid rgba(79, 107, 132, 0.1);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 18rpx;
  position: relative;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.tab-item.active {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  box-shadow: 0 8rpx 30rpx rgba(79, 107, 132, 0.5);
  transform: translateY(-4rpx) scale(1.02);
}

.tab-text {
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 600;
  transition: all 0.4s ease;
  letter-spacing: 2rpx;
}

.tab-item.active .tab-text {
  color: #ffffff;
  font-weight: 700;
}

/* 已选地址显示 */
.selected-address {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #4f6b8415 0%, #6a9abb15 100%);
  border-radius: 16rpx;
  padding: 25rpx;
  border: 2rpx solid #4f6b8430;
}

.address-content {
  flex: 1;
  margin-right: 20rpx;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.contact-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  margin-right: 20rpx;
}

.contact-phone {
  font-size: 26rpx;
  color: #5b6b7b;
}

.address-detail {
  font-size: 26rpx;
  color: #5b6b7b;
  line-height: 1.6;
}

.address-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.change-btn {
  font-size: 26rpx;
  color: #4f6b84;
  font-weight: 500;
}

.arrow-icon {
  font-size: 28rpx;
  color: #4f6b84;
}

/* 选择地址提示 */
.select-address-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
  border-radius: 16rpx;
  border: 2rpx dashed #4f6b8450;
}

.hint-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #4f6b84;
  flex: 1;
  text-align: center;
}

.hint-arrow {
  font-size: 30rpx;
  color: #4f6b84;
}

/* 地址选择器弹窗 */
.address-selector-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.address-selector-content {
  width: 100%;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.address-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.address-selector-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1f2937;
}

.address-selector-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  color: #8a96a3;
  line-height: 1;
}

.address-selector-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 0;
}

.empty-address {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8a96a3;
}

.address-item-list {
  padding: 0 20rpx;
}

.address-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  margin-bottom: 15rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.address-item.selected {
  background: linear-gradient(135deg, #4f6b8415 0%, #6a9abb15 100%);
  border-color: #4f6b84;
}

.address-item-content {
  flex: 1;
}

.address-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.address-check {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #4f6b84;
  color: #ffffff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
}

.address-selector-footer {
  padding: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.add-address-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.add-btn-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

/* 通用区块 */
.section {
  background-color: rgba(255, 255, 255, 0.95);
  margin: 16rpx 24rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(79, 107, 132, 0.1);
  backdrop-filter: blur(20rpx);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.section:active {
  box-shadow: 0 8rpx 20rpx rgba(79, 107, 132, 0.1);
}

.section-header {
  margin-bottom: 18rpx;
}

.drawer-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 0;
}

.drawer-title-group {
  flex: 1;
  min-width: 0;
}

.drawer-summary {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #4f6b84;
  line-height: 1.4;
  word-break: break-all;
}

.drawer-toggle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f6fb;
}

.drawer-toggle-text {
  font-size: 22rpx;
  color: #4f6b84;
  font-weight: 600;
}

.drawer-toggle-icon {
  font-size: 20rpx;
  color: #4f6b84;
}

.drawer-content {
  margin-top: 18rpx;
}

.inner-drawer-section {
  margin: 0;
  padding: 20rpx;
  border-radius: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #666680;
  line-height: 1.4;
  font-weight: 400;
}

.required-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #f0f2f5 0%, #e5e8eb 100%);
  color: #4f6b84;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-left: 18rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(79, 107, 132, 0.2);
}

/* 自定义输入区块 */
.custom-input-section {
  background: linear-gradient(135deg, #f0f4ff 0%, #e8edf5 100%);
  border: 2rpx solid #4f6b8440;
  box-shadow: 0 8rpx 25rpx rgba(79, 107, 132, 0.1);
  position: relative;
  overflow: hidden;
}

.custom-input-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 0 3rpx 3rpx 0;
}


/* 自定义头部 */
.custom-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.custom-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.3);
}

.custom-badge-icon {
  font-size: 24rpx;
}

.custom-badge-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
}

.input-required {
  font-size: 22rpx;
  color: #4f6b84;
  padding: 6rpx 14rpx;
  background: rgba(79, 107, 132, 0.1);
  border-radius: 20rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.input-required.filled {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(79, 107, 132, 0.3);
}

/* 输入包装器 */
.input-wrapper {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 14rpx;
  padding: 0 16rpx;
  border: 2rpx solid #dde5ee;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.input-wrapper.has-value {
  border-color: #4f6b84;
  box-shadow: 0 4rpx 15rpx rgba(79, 107, 132, 0.15);
}


.input-prefix {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  white-space: nowrap;
  margin-right: 10rpx;
}

.custom-input-field {
  flex: 1;
  height: 72rpx;
  padding: 0;
  background-color: transparent;
  border-radius: 0;
  font-size: 26rpx;
  box-sizing: border-box;
  border: none;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.custom-input-field:focus {
