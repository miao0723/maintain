/* pages/admin-prices/admin-prices.wxss */
.page-container { min-height: 100vh; background: #f5f7fa; padding: 0 24rpx 40rpx; box-sizing: border-box; }

.page-head { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 8rpx 20rpx; }
.head-title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.add-btn { background: #4f6b84; color: #fff; font-size: 26rpx; padding: 12rpx 28rpx; border-radius: 30rpx; }

.price-list { margin-top: 8rpx; }
.price-item { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 6rpx 18rpx rgba(79,107,132,0.05); }
.price-top { display: flex; align-items: center; justify-content: space-between; }
.price-type { font-size: 30rpx; font-weight: 600; color: #1f2937; }
.price-value { font-size: 32rpx; font-weight: 700; color: #4f6b84; }
.price-sub { font-size: 24rpx; color: #8a96a3; margin-top: 8rpx; }
.price-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.price-time { font-size: 22rpx; color: #aab3bd; }
.price-actions { display: flex; gap: 12rpx; }
.mini-btn { font-size: 24rpx; color: #4f6b84; background: #eef2f7; padding: 10rpx 20rpx; border-radius: 10rpx; }
.mini-btn.danger { color: #d14343; background: #fdecec; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.empty-icon { font-size: 96rpx; }
.empty-text { margin-top: 20rpx; color: #8a96a3; font-size: 28rpx; }

.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 100;
}
.modal { width: 620rpx; background: #fff; border-radius: 24rpx; padding: 36rpx; box-sizing: border-box; }
.modal-title { font-size: 32rpx; font-weight: 700; color: #1f2937; margin-bottom: 20rpx; text-align: center; }
.form-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.form-label { width: 130rpx; font-size: 26rpx; color: #5b6b7b; }
.form-input {
  flex: 1; height: 68rpx; background: #f5f7fa; border-radius: 12rpx;
  padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box;
}
.modal-actions { display: flex; gap: 20rpx; margin-top: 12rpx; }
.modal-btn { flex: 1; text-align: center; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; font-size: 30rpx; }
.modal-btn.cancel { background: #eef2f7; color: #5b6b7b; }
.modal-btn.confirm { background: #4f6b84; color: #fff; }
