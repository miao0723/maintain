/* 进度详情 */
.progress-section-detail {
  padding: 24rpx;
  background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
  border-radius: 16rpx;
}

.progress-bar-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.progress-bar-detail {
  flex: 1;
  height: 24rpx;
  background: #c7d2fe;
  border-radius: 24rpx;
  overflow: hidden;
}

.progress-fill-detail {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  transition: width 0.3s ease;
  position: relative;
}

.progress-fill-detail::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.3),
    transparent
  );
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

