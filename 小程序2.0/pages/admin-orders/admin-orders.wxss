/* pages/admin-orders/admin-orders.wxss */
page {
  background: #f5f7fa;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部信息 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-count {
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.create-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.quick-create-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

.quick-create-bar:active {
  opacity: 0.9;
}

.quick-create-icon {
  font-size: 40rpx;
  color: #fff;
}

.quick-create-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.quick-create-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 2rpx solid #e5e7eb;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f5f7fa;
  border-radius: 48rpx;
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.search-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 48rpx;
}

/* 金额统计卡片 */
.amount-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 2rpx solid #e5e7eb;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.stat-card.highlight {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.stat-amount {
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'Helvetica Neue', monospace;
}

.stat-amount.estimated {
  color: #d97706;
}

.stat-amount.actual {
  color: #059669;
}

.stat-amount.completed {
  color: #dc2626;
}

.stat-amount.pending {
  color: #6366f1;
}

.stat-sub {
  font-size: 20rpx;
  color: #bbb;
}

/* 订单金额区域（独立突出展示） */
.order-amount-section {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border-radius: 12rpx;
  border: 2rpx solid #fde68a;
}

.amount-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.amount-label {
  font-size: 22rpx;
  color: #92400e;
}

.amount-value {
  font-size: 30rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'Helvetica Neue', monospace;
}

.amount-value.estimated {
  color: #d97706;
}

.amount-value.actual {
  color: #dc2626;
}

.amount-value.pending-text {
  color: #999;
  font-size: 26rpx;
  font-weight: 400;
}

.amount-divider {
  width: 2rpx;
  height: 48rpx;
  background: #fbbf24;
}

/* 状态标签 */
.tabs-container {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 2rpx solid #e5e7eb;
  overflow-x: auto;
}

.tab-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f5f7fa;
  border-radius: 48rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.tab-label {
  font-size: 26rpx;
  font-weight: 500;
}

.tab-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
  min-width: 32rpx;
  text-align: center;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 24rpx 32rpx;
  gap: 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
}

.order-card:active {
  transform: scale(0.98);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 48rpx;
}

.status-icon {
  font-size: 24rpx;
}

.status-text {
  font-size: 24rpx;
  font-weight: 500;
}

/* 设备信息 */
.order-device {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.device-icon {
  font-size: 48rpx;
}

.device-details {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.device-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.device-model {
  font-size: 24rpx;
  color: #666;
}

.priority-badge {
  padding: 6rpx 12rpx;
  background: #fee2e2;
  color: #dc2626;
  font-size: 22rpx;
  border-radius: 8rpx;
}

/* 问题描述 */
.order-problem {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding: 12rpx;
  background: #fef3c7;
  border-radius: 8rpx;
}

.problem-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #92400e;
  white-space: nowrap;
}

.problem-text {
  flex: 1;
  font-size: 26rpx;
  color: #78350f;
  line-height: 1.6;
}

/* 客户信息 */
.order-customer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx;
  background: #f0f9ff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.customer-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.customer-icon {
  font-size: 32rpx;
}

.customer-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.customer-phone {
  font-size: 24rpx;
  color: #666;
  margin-left: 8rpx;
}

.order-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #dc2626;
}

/* 进度条 */
.progress-section {
  margin-bottom: 16rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #666;
}

.progress-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #667eea;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.accept {
  background: #f0f9ff;
  color: #0369a1;
  border: 2rpx solid #bae6fd;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 转发按钮（button open-type="share" 需覆盖默认样式与 action-btn 对齐） */
.share-btn {
  padding: 0;
  margin: 0;
  line-height: 72rpx;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
  color: #fff;
}
.share-btn::after {
  border: none;
}

.action-btn.success {
  background: #d1fae5;
  color: #059669;
  border: 2rpx solid #a7f3d0;
}

.action-btn.info {
  background: #fef3c7;
  color: #92400e;
  border: 2rpx solid #fde68a;
}

.action-btn.danger {
  background: #fee2e2;
  color: #dc2626;
  border: 2rpx solid #fecaca;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.loading-more,
.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}

.loading-text,
.no-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 订单详情弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  width: 640rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #e5e7eb;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.detail-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 状态显示 */
.status-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.status-icon-large {
  font-size: 48rpx;
}

.status-text-large {
  font-size: 32rpx;
  font-weight: 600;
}

/* 详情行 */
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.detail-value.price {
  color: #dc2626;
  font-weight: 600;
}

/* 设备卡片 */
.device-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.device-icon-large {
  font-size: 64rpx;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name-large {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.device-model-large {
  font-size: 26rpx;
  color: #666;
}

/* 问题卡片 */
.problem-card {
  padding: 24rpx;
  background: #fef3c7;
  border-radius: 12rpx;
}

.problem-text-large {
  font-size: 26rpx;
  color: #78350f;
  line-height: 1.8;
}

/* 客户卡片 */
.customer-card {
  padding: 24rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
}

.customer-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #bae6fd;
}

.customer-row:last-child {
  border-bottom: none;
}

.customer-label {
  font-size: 26rpx;
  color: #0369a1;
}

.customer-value {
  font-size: 26rpx;
  color: #333;
}

/* 进度显示 */
.progress-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bar-large {
  flex: 1;
  height: 16rpx;
  background: #e5e7eb;
  border-radius: 16rpx;
  overflow: hidden;
}

.progress-fill-large {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  transition: width 0.3s ease;
}

.progress-text-large {
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
}

/* 底部操作 */
.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #e5e7eb;
}

.modal-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.modal-btn.cancel {
  background: #f5f7fa;
  color: #666;
  border: 2rpx solid #e5e7eb;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.modal-btn:active {
  transform: scale(0.95);
}

/* 订单类型标签 */
.order-type-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.type-icon {
  font-size: 20rpx;
}

.type-text {
  font-size: 20rpx;
  font-weight: 500;
}

/* 设备信息增强 */
.device-details {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.device-type {
  font-size: 24rpx;
  color: #666;
}

.device-brand,
.device-condition {
  font-size: 22rpx;
  color: #999;
}

.priority-badge.medium {
  background: #fef3c7;
  color: #d97706;
}

.priority-badge.low {
  background: #d1fae5;
  color: #059669;
}

/* 服务方式 */
.service-type {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #e0e7ff;
  color: #4338ca;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* 服务地址 */
.order-address {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding: 12rpx;
  background: #f0fdf4;
  border-radius: 8rpx;
}

.address-icon {
  font-size: 24rpx;
  margin-top: 2rpx;
}

.address-text {
  flex: 1;
  font-size: 24rpx;
  color: #166534;
  line-height: 1.6;
}

/* 价格信息增强 */
.order-prices {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.order-price.estimated {
  font-size: 24rpx;
  color: #f59e0b;
}

.order-price.actual {
  font-size: 28rpx;
  font-weight: 600;
  color: #dc2626;
}

/* 订单号可复制 */
.order-no {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 详情页增强 */
.detail-value.order-no {
  font-family: 'Monaco', 'Courier New', monospace;
}

/* 状态徽章 */
.status-badge {
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

/* 设备详情卡片 */
.device-card-detail {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
}

.device-icon-detail {
  font-size: 64rpx;
}

.device-info-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.device-model {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.device-type-detail {
  font-size: 26rpx;
  color: #666;
}

.device-brand-detail,
.device-condition-detail {
  font-size: 24rpx;
  color: #999;
}

/* 问题详情 */
.problem-card-detail {
  padding: 24rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 16rpx;
}

.problem-text-detail {
  font-size: 28rpx;
  color: #78350f;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.custom-desc-detail {
  display: block;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
  padding-top: 12rpx;
  border-top: 2rpx dashed #fbbf24;
}

.service-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #dbeafe;
  color: #1e40af;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 图片展示 */
.image-scroll {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.image-item {
  flex-shrink: 0;
}

.order-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 地址卡片 */
.address-card,
.unit-card {
  padding: 24rpx;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border-radius: 16rpx;
}

.address-row,
.unit-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #bae6fd;
}

.address-row.full,
.unit-row.full {
  flex-direction: column;
  gap: 8rpx;
}

.address-row:last-child,
.unit-row:last-child {
  border-bottom: none;
}

.address-label,
.unit-label {
  font-size: 26rpx;
