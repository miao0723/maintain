        <input class="form-input" data-field="brand" value="{{createFormData.brand}}" bindinput="onCreateFieldInput" placeholder="如 Apple"/>
      </view>

      <!-- 服务方式 -->
      <view class="form-group">
        <text class="form-label">服务方式</text>
        <view class="priority-selector">
          <view class="priority-option {{createFormData.service_type === 'shop' ? 'active' : ''}}" data-value="shop" bindtap="selectCreateServiceType">
            <text class="priority-label">🏪 到店</text>
          </view>
          <view class="priority-option {{createFormData.service_type === 'home' ? 'active' : ''}}" data-value="home" bindtap="selectCreateServiceType">
            <text class="priority-label">🏠 上门</text>
          </view>
        </view>
      </view>

      <!-- 问题描述 -->
      <view class="form-group">
        <text class="form-label">故障/服务描述 <text class="required">*</text></text>
        <textarea class="form-textarea" data-field="problem_description" value="{{createFormData.problem_description}}" bindinput="onCreateFieldInput" placeholder="请描述故障或服务内容"/>
      </view>

      <!-- 备注 -->
      <view class="form-group">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" data-field="remark" value="{{createFormData.remark}}" bindinput="onCreateFieldInput" placeholder="可填写内部备注"/>
      </view>
    </scroll-view>

    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeCreateModal">❌ 取消</view>
      <view class="modal-btn primary" bindtap="submitCreateOrder">{{creatingOrder ? '创建中...' : '✅ 生成订单'}}</view>
    </view>
  </view>
</view>
