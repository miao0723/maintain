<!--pages/admin-orders/admin-orders.wxml-->
<view class="container">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="header-left">
      <text class="page-title">我的订单</text>
      <text class="page-subtitle">管理分配给您的维修订单</text>
    </view>
    <view class="header-right">
      <text class="order-count">共 {{total}} 单</text>
      <view class="create-btn" bindtap="openCreateModal">+ 代客下单</view>
    </view>
  </view>

  <!-- 代客下单快捷入口（醒目横条） -->
  <view class="quick-create-bar" bindtap="openCreateModal">
    <text class="quick-create-icon">➕</text>
    <text class="quick-create-text">代客下单：帮客户创建订单并转发</text>
    <text class="quick-create-arrow">›</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索订单号、客户姓名、手机号"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
    </view>
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 金额统计卡片 -->
  <view class="amount-stats">
    <view class="stat-card">
      <text class="stat-label">预估总额</text>
      <text class="stat-amount estimated">¥{{amountStats.totalEstimated}}</text>
      <text class="stat-sub">全部订单预估</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">实际总额</text>
      <text class="stat-amount actual">¥{{amountStats.totalActual}}</text>
      <text class="stat-sub">全部订单实际</text>
    </view>
    <view class="stat-card highlight">
      <text class="stat-label">已完成收入</text>
      <text class="stat-amount completed">¥{{amountStats.completedActual}}</text>
      <text class="stat-sub">已结算金额</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">待处理预估</text>
      <text class="stat-amount pending">¥{{amountStats.pendingEstimated}}</text>
      <text class="stat-sub">待接单金额</text>
    </view>
  </view>

  <!-- 状态标签 -->
  <view class="tabs-container">
    <view
      class="tab-item {{currentTab === 'all' ? 'active' : ''}}"
      data-tab="all"
      bindtap="switchTab"
    >
      <text class="tab-label">全部</text>
      <text class="tab-badge">{{total}}</text>
    </view>
    <view
      class="tab-item {{currentTab === 'pending' ? 'active' : ''}}"
      data-tab="pending"
      bindtap="switchTab"
    >
      <text class="tab-label">待报价</text>
      <text class="tab-badge">{{statusCounts.pending}}</text>
      <view class="tab-unread" wx:if="{{adminUnread.pending > 0}}">{{adminUnread.pending}}</view>
    </view>
    <view
      class="tab-item {{currentTab === 'quoted' ? 'active' : ''}}"
      data-tab="quoted"
      bindtap="switchTab"
    >
      <text class="tab-label">待确认</text>
      <text class="tab-badge">{{statusCounts.quoted}}</text>
      <view class="tab-unread" wx:if="{{adminUnread.quoted > 0}}">{{adminUnread.quoted}}</view>
    </view>
    <view
      class="tab-item {{currentTab === 'confirmed' ? 'active' : ''}}"
      data-tab="confirmed"
      bindtap="switchTab"
    >
      <text class="tab-label">待处理</text>
      <text class="tab-badge">{{statusCounts.confirmed}}</text>
      <view class="tab-unread" wx:if="{{adminUnread.confirmed > 0}}">{{adminUnread.confirmed}}</view>
    </view>
    <view
      class="tab-item {{currentTab === 'processing' ? 'active' : ''}}"
      data-tab="processing"
      bindtap="switchTab"
    >
      <text class="tab-label">维修中</text>
      <text class="tab-badge">{{statusCounts.processing}}</text>
      <view class="tab-unread" wx:if="{{adminUnread.processing > 0}}">{{adminUnread.processing}}</view>
    </view>
    <view
      class="tab-item {{currentTab === 'completed' ? 'active' : ''}}"
      data-tab="completed"
      bindtap="switchTab"
    >
      <text class="tab-label">已完成</text>
      <text class="tab-badge">{{statusCounts.completed}}</text>
      <view class="tab-unread" wx:if="{{adminUnread.completed > 0}}">{{adminUnread.completed}}</view>
    </view>
    <view
      class="tab-item {{currentTab === 'internal_pending' ? 'active' : ''}}"
      data-tab="internal_pending"
      bindtap="switchTab"
    >
      <text class="tab-label">内部待确认</text>
      <text class="tab-badge">{{statusCounts.internal_pending}}</text>
      <view class="tab-unread" wx:if="{{adminUnread.internal_pending > 0}}">{{adminUnread.internal_pending}}</view>
    </view>
    <view
      class="tab-item {{currentTab === 'admin_created' ? 'active' : ''}}"
      data-tab="admin_created"
      bindtap="switchTab"
    >
      <text class="tab-label">代客待支付</text>
      <text class="tab-badge">{{statusCounts.admin_created}}</text>
      <view class="tab-unread" wx:if="{{adminUnread.admin_created > 0}}">{{adminUnread.admin_created}}</view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view
    class="order-list"
    scroll-y
    bindscrolltolower="onReachBottom"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <view wx:if="{{orders.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无订单</text>
    </view>

    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      bindtap="viewOrderDetail"
      data-id="{{item.id}}"
      style="position: relative"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-info">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-time">{{formatTime(item.createdAt)}}</text>
        </view>
        <view class="order-status" style="background: {{getStatusConfig(item.status).bg}}; color: {{getStatusConfig(item.status).color}}">
          <text class="status-icon">{{getStatusConfig(item.status).icon}}</text>
          <text class="status-text">{{getStatusConfig(item.status).label}}</text>
        </view>
      </view>

      <!-- 订单类型 -->
      <view class="order-type-badge">
        <text class="type-icon">{{item.orderType === 'recycle' ? '♻️' : '🔧'}}</text>
        <text class="type-text">{{item.orderType === 'recycle' ? '回收' : '维修'}}</text>
      </view>

      <!-- 设备信息 -->
      <view class="order-device">
        <view class="device-icon">{{item.deviceTypeIcon || '📱'}}</view>
        <view class="device-details">
          <text class="device-name">{{item.deviceModel || '未知型号'}}</text>
          <text class="device-type">{{item.deviceTypeName || '未知设备'}}</text>
          <text wx:if="{{item.brandName}}" class="device-brand">品牌: {{item.brandName}}</text>
          <text wx:if="{{item.deviceCondition}}" class="device-condition">成色: {{item.deviceCondition}}</text>
        </view>
        <view wx:if="{{item.priority === 'high'}}" class="priority-badge">🔴 紧急</view>
        <view wx:if="{{item.priority === 'medium'}}" class="priority-badge medium">🟡 普通</view>
        <view wx:if="{{item.priority === 'low'}}" class="priority-badge low">🟢 低优</view>
      </view>

      <!-- 问题描述 -->
      <view class="order-problem">
        <text class="problem-label">问题：</text>
        <text class="problem-text">{{item.problemDescription || item.customDescription || '暂无问题描述'}}</text>
        <text wx:if="{{item.serviceType}}" class="service-type">
          {{item.serviceType === 'home' ? '🏠 上门服务' : '🏪 到店维修'}}
        </text>
      </view>

      <!-- 报价被拒绝提示 -->
      <view wx:if="{{item.quote_status === 'rejected'}}" class="quote-rejected-tip">
        <text class="rejected-tip-icon">❌</text>
        <view class="rejected-tip-content">
          <text class="rejected-tip-title">报价已被用户拒绝</text>
          <text wx:if="{{item.quote_rejected_reason}}" class="rejected-tip-reason">原因：{{item.quote_rejected_reason}}</text>
        </view>
      </view>

      <!-- 进度反馈提示 -->
      <view wx:if="{{item.needsProgressFeedback}}" class="progress-feedback-tip">
        <text class="feedback-tip-icon">📢</text>
        <view class="feedback-tip-content">
          <text class="feedback-tip-title">该订单进度申请已审核通过</text>
          <text class="feedback-tip-hint">请点击下方「进度反馈」按钮发送维修进度</text>
        </view>
      </view>

      <!-- 服务地址（仅上门服务显示） -->
      <view wx:if="{{item.serviceType === 'home' && item.address}}" class="order-address">
        <text class="address-icon">📍</text>
        <text class="address-text">{{item.address.province}}{{item.address.city}}{{item.address.district}}{{item.address.detail_address}}</text>
      </view>

      <!-- 订单金额（突出展示） -->
      <view class="order-amount-section">
        <view class="amount-item">
          <text class="amount-label">预估金额</text>
          <text wx:if="{{item.estimatedPriceDisplay}}" class="amount-value estimated">¥{{item.estimatedPriceDisplay}}</text>
          <text wx:else class="amount-value pending-text">待评估</text>
        </view>
        <view class="amount-divider"></view>
        <view class="amount-item">
          <text class="amount-label">实际金额</text>
          <text wx:if="{{item.actualPriceDisplay}}" class="amount-value actual">¥{{item.actualPriceDisplay}}</text>
          <text wx:else class="amount-value pending-text">待定价</text>
        </view>
      </view>

      <!-- 客户信息 -->
      <view class="order-customer">
        <view class="customer-info">
          <text class="customer-icon">👤</text>
          <view class="customer-details">
            <text class="customer-name">{{item.userName || '未知用户'}}</text>
            <text class="customer-phone">{{item.userPhone || '暂无'}}</text>
            <text wx:if="{{item.userEmail}}" class="customer-email">{{item.userEmail}}</text>
          </view>
        </view>
      </view>

      <!-- 进度条（仅维修中订单显示） -->
      <view wx:if="{{item.status === 'processing' && item.progress}}" class="progress-section">
        <view class="progress-info">
          <text class="progress-label">维修进度</text>
          <text class="progress-value">{{item.progress}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.progress}}%"></view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions">
        <block wx:if="{{item.status === 'pending'}}">
          <view class="action-btn btn-edit" catchtap="openEditModal" data-id="{{item.id}}">✏️ 编辑</view>
          <view class="action-btn btn-refund" catchtap="openRefundModal" data-id="{{item.id}}">💰 退款</view>
          <view class="action-btn primary" catchtap="openQuoteModal" data-id="{{item.id}}">💰 报价</view>
        </block>

        <block wx:if="{{item.status === 'quoted'}}">
          <view class="action-btn info" catchtap="navigateToOrderDetail" data-id="{{item.id}}">查看详情</view>
          <view class="action-btn" style="background: #436f95; color: #fff;">等待用户确认</view>
        </block>

        <block wx:if="{{item.quote_status === 'rejected'}}">
          <view class="action-btn danger" catchtap="navigateToOrderDetail" data-id="{{item.id}}">报价被拒绝</view>
          <view class="action-btn primary" catchtap="openQuoteModal" data-id="{{item.id}}">重新报价</view>
        </block>

        <block wx:if="{{item.status === 'confirmed'}}">
          <view class="action-btn primary" catchtap="startProcessing" data-id="{{item.id}}">开始处理</view>
          <view class="action-btn info" catchtap="navigateToOrderDetail" data-id="{{item.id}}">查看详情</view>
        </block>

        <block wx:if="{{item.status === 'processing'}}">
          <view class="action-btn info" bindtap="navigateToRepairRecords" data-id="{{item.id}}">维修记录</view>
          <view class="action-btn" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: #fff;" catchtap="navigateToProgressFeedback" data-id="{{item.id}}">📹 进度反馈</view>
          <view class="action-btn info" bindtap="updateOrderProgress" data-id="{{item.id}}">更新进度</view>
          <view class="action-btn success" bindtap="completeOrder" data-id="{{item.id}}">完成</view>
          <view class="action-btn danger" bindtap="cancelOrder" data-id="{{item.id}}">取消</view>
        </block>

        <block wx:if="{{item.status === 'completed'}}">
          <view class="action-btn info" catchtap="navigateToOrderDetail" data-id="{{item.id}}">查看详情</view>
          <view class="action-btn primary" catchtap="openRepairReportModal" data-id="{{item.id}}">返回维修报告</view>
          <view class="action-btn success" bindtap="navigateToDeliveryAssign" data-id="{{item.id}}">分配配送</view>
        </block>

        <block wx:if="{{item.status === 'admin_created'}}">
          <view class="action-btn info" catchtap="navigateToOrderDetail" data-id="{{item.id}}">查看详情</view>
          <button class="action-btn primary share-btn" open-type="share" data-orderno="{{item.orderNo}}" data-orderid="{{item.id}}" data-phone="{{item.customer_phone}}">📤 转发给用户</button>
          <view class="action-btn" style="background:#f4f6f9;color:#475569;" catchtap="copyForward" data-orderno="{{item.orderNo}}" data-id="{{item.id}}">复制订单号</view>
        </block>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loading}}" class="loading-more">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:if="{{!hasMore && orders.length > 0}}" class="no-more">
      <text class="no-more-text">没有更多了</text>
    </view>
  </scroll-view>
</view>

<!-- 订单详情弹窗 -->
<view wx:if="{{showOrderDetail && currentOrder}}" class="modal-overlay" bindtap="closeOrderDetail">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">订单详情</text>
      <view class="modal-close" bindtap="closeOrderDetail">×</view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 订单状态 -->
      <view class="detail-section">
        <text class="section-title">订单状态</text>
        <view class="status-display" style="background: {{getStatusConfig(currentOrder.status).bg}}">
          <text class="status-icon-large">{{getStatusConfig(currentOrder.status).icon}}</text>
          <text class="status-text-large">{{getStatusConfig(currentOrder.status).label}}</text>
        </view>
      </view>

      <!-- 订单基本信息 -->
      <view class="detail-section">
        <text class="section-title">订单信息</text>
        <view class="detail-row">
          <text class="detail-label">订单编号</text>
          <text class="detail-value order-no">{{currentOrder.orderNo}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">订单类型</text>
          <text class="detail-value">{{currentOrder.orderType === 'recycle' ? '♻️ 回收' : '🔧 维修'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">订单状态</text>
          <view class="detail-value status-badge" style="background: {{getStatusConfig(currentOrder.status).bg}}; color: {{getStatusConfig(currentOrder.status).color}}">
            {{getStatusConfig(currentOrder.status).icon}} {{getStatusConfig(currentOrder.status).label}}
          </view>
        </view>
        <view class="detail-row">
          <text class="detail-label">优先级</text>
          <text class="detail-value">{{currentOrder.priority === 'high' ? '🔴 紧急' : currentOrder.priority === 'medium' ? '🟡 普通' : '🟢 低优'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">创建时间</text>
          <text class="detail-value">{{currentOrder.createdAt}}</text>
        </view>
        <view wx:if="{{currentOrder.updatedAt}}" class="detail-row">
          <text class="detail-label">更新时间</text>
          <text class="detail-value">{{currentOrder.updatedAt}}</text>
        </view>
        <view wx:if="{{currentOrder.completedAt}}" class="detail-row">
          <text class="detail-label">完成时间</text>
          <text class="detail-value">{{currentOrder.completedAt}}</text>
        </view>
        <view wx:if="{{currentOrder.assignedAt}}" class="detail-row">
          <text class="detail-label">接单时间</text>
          <text class="detail-value">{{currentOrder.assignedAt}}</text>
        </view>
      </view>

      <!-- 设备信息 -->
      <view class="detail-section">
        <text class="section-title">设备信息</text>
        <view class="device-card-detail">
          <view class="device-icon-detail">{{currentOrder.deviceTypeIcon || '📱'}}</view>
          <view class="device-info-detail">
            <text class="device-model">{{currentOrder.deviceModel || '未知型号'}}</text>
            <text class="device-type-detail">{{currentOrder.deviceTypeName || '未知设备'}}</text>
            <text wx:if="{{currentOrder.brandName}}" class="device-brand-detail">品牌: {{currentOrder.brandName}}</text>
            <text wx:if="{{currentOrder.deviceCondition}}" class="device-condition-detail">成色: {{currentOrder.deviceCondition}}</text>
          </view>
        </view>
      </view>

      <!-- 问题描述 -->
      <view class="detail-section">
        <text class="section-title">问题描述</text>
        <view class="problem-card-detail">
          <text class="problem-text-detail">{{currentOrder.problemDescription}}</text>
          <text wx:if="{{currentOrder.customDescription}}" class="custom-desc-detail">{{currentOrder.customDescription}}</text>
          <view wx:if="{{currentOrder.serviceType}}" class="service-badge">
            {{currentOrder.serviceType === 'home' ? '🏠 上门服务' : '🏪 到店维修'}}
          </view>
        </view>
      </view>

      <!-- 图片展示 -->
      <view wx:if="{{currentOrder.images && currentOrder.images.length > 0}}" class="detail-section">
        <text class="section-title">📷 产品照片（{{currentOrder.images.length}}）</text>
        <view class="detail-images-grid">
          <view wx:for="{{currentOrder.images}}" wx:key="index" class="detail-image-wrapper">
            <image class="detail-image" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" data-urls="{{currentOrder.images}}"></image>
          </view>
        </view>
        <view class="detail-image-tip" bindtap="previewImage" data-url="{{currentOrder.images[0]}}" data-urls="{{currentOrder.images}}">
          <text class="tip-icon">🔍</text>
          <text class="tip-text">点击查看大图</text>
        </view>
      </view>

      <!-- 服务地址（仅上门服务显示） -->
      <view wx:if="{{currentOrder.serviceType === 'home' && currentOrder.address}}" class="detail-section">
        <text class="section-title">服务地址</text>
        <view class="address-card">
          <view class="address-row">
            <text class="address-label">联系人</text>
            <text class="address-value">{{currentOrder.address.contact_name || '暂无'}}</text>
          </view>
          <view class="address-row">
            <text class="address-label">联系电话</text>
            <text class="address-value">{{currentOrder.address.contact_phone || '暂无'}}</text>
          </view>
          <view class="address-row full">
            <text class="address-label">地址</text>
            <text class="address-value">{{currentOrder.address.province || ''}}{{currentOrder.address.city || ''}}{{currentOrder.address.district || ''}}{{currentOrder.address.detail_address || ''}}</text>
          </view>
          <view wx:if="{{currentOrder.address.tags && currentOrder.address.tags.length > 0}}" class="address-tags">
            <text wx:for="{{currentOrder.address.tags}}" wx:key="index" class="address-tag">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 维修单位（仅到店服务显示） -->
      <view wx:if="{{currentOrder.serviceType === 'shop' && currentOrder.unit}}" class="detail-section">
        <text class="section-title">维修单位</text>
        <view class="unit-card">
          <view class="unit-row">
            <text class="unit-label">单位名称</text>
            <text class="unit-value">{{currentOrder.unit.name || '暂无'}}</text>
          </view>
          <view class="unit-row">
            <text class="unit-label">联系人</text>
            <text class="unit-value">{{currentOrder.unit.contact_name || '暂无'}}</text>
          </view>
          <view class="unit-row">
            <text class="unit-label">联系电话</text>
            <text class="unit-value">{{currentOrder.unit.contact_phone || '暂无'}}</text>
          </view>
          <view class="unit-row full">
            <text class="unit-label">地址</text>
            <text class="unit-value">{{currentOrder.unit.address || '暂无'}}</text>
          </view>
        </view>
      </view>

      <!-- 价格信息 -->
      <view class="detail-section">
        <text class="section-title">价格信息</text>
        <view class="price-card">
          <view class="price-row">
            <text class="price-label">预估价格</text>
            <text wx:if="{{currentOrder.estimatedPriceDisplay}}" class="price-value estimated">¥{{currentOrder.estimatedPriceDisplay}}</text>
            <text wx:else class="price-value">未定价</text>
          </view>
          <view class="price-row">
            <text class="price-label">实际价格</text>
            <text wx:if="{{currentOrder.actualPriceDisplay}}" class="price-value actual">¥{{currentOrder.actualPriceDisplay}}</text>
            <text wx:else class="price-value">待定</text>
          </view>
          <view class="price-row price-total">
            <text class="price-label">订单金额</text>
            <text wx:if="{{currentOrder.actualPriceDisplay}}" class="price-value total">¥{{currentOrder.actualPriceDisplay}}</text>
            <text wx:elif="{{currentOrder.estimatedPriceDisplay}}" class="price-value total">¥{{currentOrder.estimatedPriceDisplay}}</text>
            <text wx:else class="price-value total">待定</text>
          </view>
        </view>
      </view>

      <!-- 客户信息 -->
      <view class="detail-section">
        <text class="section-title">客户信息</text>
        <view class="customer-card-detail">
          <view class="customer-row-detail">
            <text class="customer-label-detail">姓名</text>
            <text class="customer-value-detail">{{currentOrder.userName}}</text>
          </view>
          <view class="customer-row-detail">
            <text class="customer-label-detail">手机号</text>
            <text class="customer-value-detail">{{currentOrder.userPhone}}</text>
          </view>
          <view wx:if="{{currentOrder.userEmail}}" class="customer-row-detail">
            <text class="customer-label-detail">邮箱</text>
            <text class="customer-value-detail">{{currentOrder.userEmail}}</text>
          </view>
          <view wx:if="{{currentOrder.userRealName}}" class="customer-row-detail">
            <text class="customer-label-detail">真实姓名</text>
            <text class="customer-value-detail">{{currentOrder.userRealName}}</text>
          </view>
        </view>
      </view>

      <!-- 分配信息 -->
      <view wx:if="{{currentOrder.assignedToName}}" class="detail-section">
        <text class="section-title">分配信息</text>
        <view class="assign-card">
          <view class="assign-row">
            <text class="assign-label">维修师傅</text>
            <text class="assign-value">{{currentOrder.assignedToName}}</text>
          </view>
          <view wx:if="{{currentOrder.assignedAt}}" class="assign-row">
            <text class="assign-label">分配时间</text>
            <text class="assign-value">{{currentOrder.assignedAt}}</text>
          </view>
        </view>
      </view>

      <!-- 报价状态提示（待确认/已拒绝） -->
      <view wx:if="{{currentOrder.quote_status === 'rejected'}}" class="detail-section">
        <text class="section-title">报价反馈</text>
        <view class="quote-rejected-card">
          <view class="rejected-header">
            <text class="rejected-icon">❌</text>
            <text class="rejected-title">用户已拒绝报价</text>
          </view>
          <view wx:if="{{currentOrder.quote_rejected_reason}}" class="rejected-reason">
            <text class="rejected-reason-label">拒绝原因</text>
            <text class="rejected-reason-text">{{currentOrder.quote_rejected_reason}}</text>
          </view>
        </view>
      </view>

      <!-- 维修进度 -->
      <view class="detail-section">
        <text class="section-title">维修进度</text>
        <view class="progress-section-detail">
          <view class="progress-bar-wrapper">
            <view class="progress-bar-detail">
              <view class="progress-fill-detail" style="width: {{currentOrder.progress || 0}}%"></view>
            </view>
            <text class="progress-percent">{{currentOrder.progress || 0}}%</text>
          </view>
          <view class="progress-steps">
            <view class="step {{currentOrder.progress >= 10 ? 'active' : ''}}">
              <view class="step-dot"></view>
              <text class="step-text">报价</text>
            </view>
            <view class="step {{currentOrder.progress >= 20 ? 'active' : ''}}">
              <view class="step-dot"></view>
              <text class="step-text">确认</text>
            </view>
            <view class="step {{currentOrder.progress >= 50 ? 'active' : ''}}">
              <view class="step-dot"></view>
              <text class="step-text">维修</text>
            </view>
            <view class="step {{currentOrder.progress >= 100 ? 'active' : ''}}">
              <view class="step-dot"></view>
              <text class="step-text">完成</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作 -->
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeOrderDetail">关闭</view>
      <view wx:if="{{currentOrder.status === 'completed'}}" class="modal-btn primary" catchtap="openRepairReportModal" data-id="{{currentOrder.id}}">返回维修报告</view>
      <view wx:if="{{currentOrder.status === 'pending'}}" class="modal-btn primary" catchtap="openQuoteModal" data-id="{{currentOrder.id}}">💰 报价</view>
      <view wx:if="{{currentOrder.status === 'pending'}}" class="modal-btn" catchtap="openEditModal" data-id="{{currentOrder.id}}" style="background: #f5f7fa; color: #333; border: 1rpx solid #e5e7eb;">编辑</view>
      <view wx:if="{{currentOrder.status === 'quoted'}}" class="modal-btn" style="background: #436f95; color: #fff;">等待用户确认</view>
      <view wx:if="{{currentOrder.status === 'confirmed'}}" class="modal-btn primary" catchtap="startProcessing" data-id="{{currentOrder.id}}">开始处理</view>
      <view wx:if="{{currentOrder.status === 'processing' && (!currentOrder.quote_status || currentOrder.quote_status === 'rejected')}}" class="modal-btn quote" catchtap="openQuoteModal">返回报价</view>
      <view wx:if="{{currentOrder.status === 'internal_pending'}}" class="modal-btn primary" catchtap="confirmInternalOrder" data-id="{{currentOrder.id}}">✅ 确认内部订单（免付款）</view>
    </view>
  </view>
</view>

<!-- 返回维修报告弹窗 -->
