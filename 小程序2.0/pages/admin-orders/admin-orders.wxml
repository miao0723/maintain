<!-- 退款申请弹窗 -->
<view wx:if="{{showRefundModal}}" class="modal-overlay" bindtap="closeRefundModal">
  <view class="modal-content refund-modal" catchtap="">
    <view class="modal-header">
      <text class="modal-title">申请退款</text>
      <view class="modal-close" bindtap="closeRefundModal">×</view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 退款订单信息 -->
      <view class="refund-order-info">
        <view class="refund-info-row">
          <text class="refund-info-label">订单编号</text>
          <text class="refund-info-value">{{refundOrderData.orderNo || ''}}</text>
        </view>
        <view class="refund-info-row">
          <text class="refund-info-label">退款金额</text>
          <text class="refund-info-value refund-amount">¥{{refundOrderData.estimatedPrice || '0.0'}}</text>
        </view>
      </view>

      <!-- 退款原因选择 -->
      <view class="refund-section">
        <text class="refund-section-title">退款原因 <text class="required">*</text></text>
        <view class="refund-reason-list">
          <view
            wx:for="{{refundReasons}}"
            wx:key="value"
            class="refund-reason-item {{refundFormData.reason === item.value ? 'active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectRefundReason"
          >
            <view class="reason-radio">
              <view wx:if="{{refundFormData.reason === item.value}}" class="reason-radio-checked"></view>
            </view>
            <text class="reason-text">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 补充说明 -->
      <view class="refund-section">
        <text class="refund-section-title">补充说明</text>
        <textarea
          class="refund-desc-input"
          placeholder="请描述具体退款原因（选填）"
          maxlength="200"
          value="{{refundFormData.description}}"
          bindinput="onRefundDescInput"
        />
        <text class="refund-desc-count">{{refundFormData.description.length}}/200</text>
      </view>

      <!-- 提示 -->
      <view class="refund-warning">
        <text class="warning-icon">⚠️</text>
        <text class="warning-text">提交退款后订单将自动取消，此操作不可撤销</text>
      </view>
    </scroll-view>

    <!-- 底部按钮 -->
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeRefundModal">取消</view>
      <view class="modal-btn refund-submit" bindtap="submitRefund">确认退款</view>
    </view>
  </view>
</view>

