/* pages/my-devices/my-devices.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef1f6 0%, #f5f6f8 36%, #f5f6f8 100%);
  padding-bottom: 140rpx;
}

/* ========== 页面头部 ========== */
.page-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 32rpx 26rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 60%, #7f9aba 100%);
  border-radius: 0 0 28rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(79, 107, 132, 0.18);
  position: relative;
  overflow: hidden;
}
.page-header::after {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -36rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.16) 0%, transparent 70%);
  pointer-events: none;
}
.header-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.header-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}
.header-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.4;
}
.header-count {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 14rpx;
}
.count-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}
.count-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 2rpx;
}

/* 顶部提示栏 */
.tip-bar {
  margin: 20rpx 28rpx;
  background: linear-gradient(135deg, #eaf1fd, #dce8ff);
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
}
.tip-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.tip-text {
  font-size: 24rpx;
  color: #4a6fa5;
  line-height: 1.5;
}

/* 清单切换：维修设备 / 回收设备 */
.tab-switch {
  display: flex;
  margin: 20rpx 28rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.07);
}
.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #595959;
  transition: all 0.2s;
}
.tab-item.active {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.25);
}
.tab-icon {
  font-size: 28rpx;
}

/* 设备用途标签（仅维修 / 仅回收） */
.purpose-tag {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 3rpx 12rpx;
  display: inline-block;
  margin-top: 4rpx;
  margin-right: 10rpx;
}
.purpose-tag.repair {
  color: #4a6fa5;
  background: #eaf1fd;
}
.purpose-tag.recycle {
  color: #3a7a3a;
  background: #e8f8e8;
}

/* 列表头部 */
.list-header {
  padding: 24rpx 32rpx 6rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.list-title {
  font-size: 27rpx;
  color: #2d3748;
  font-weight: 700;
  position: relative;
  padding-left: 18rpx;
}
.list-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #4f6b84, #6a9abb);
}
.list-hint {
  font-size: 21rpx;
  color: #e67e22;
}

/* 设备卡片 */
.device-list {
  padding: 0 28rpx;
}
.device-card {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(79, 107, 132, 0.07);
  transition: all 0.2s;
  position: relative;
}
.device-card:active {
  transform: scale(0.992);
}
.device-card.is-default {
  border: 2rpx solid #4f6b84;
  box-shadow: 0 6rpx 20rpx rgba(79, 107, 132, 0.14);
}

/* 默认设备徽章 */
.default-ribbon {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  padding: 8rpx 24rpx;
  display: flex;
  align-items: center;
}
.ribbon-text {
  font-size: 21rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}

.card-main {
  display: flex;
  align-items: center;
  padding: 22rpx 22rpx 18rpx;
}

/* 设备图标 */
.device-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #eef2f8, #e1e8f2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
  box-shadow: inset 0 2rpx 5rpx rgba(255, 255, 255, 0.6), 0 3rpx 8rpx rgba(79, 107, 132, 0.1);
}
.device-icon-wrap.icon-default {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
  box-shadow: 0 4rpx 12rpx rgba(79, 107, 132, 0.28);
}
.device-icon {
  font-size: 38rpx;
}

/* 设备信息 */
.device-info {
  flex: 1;
  min-width: 0;
}
.device-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}
.device-name {
  font-size: 29rpx;
  color: #1f2937;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.device-model {
  font-size: 24rpx;
  color: #595959;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.device-meta {
  margin-bottom: 4rpx;
}
.device-sub {
  font-size: 22rpx;
  color: #8c8c8c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.device-condition {
  font-size: 20rpx;
  color: #a87b2e;
  background: linear-gradient(135deg, #fef6e0, #fdeccb);
  border-radius: 6rpx;
  padding: 3rpx 12rpx;
  display: inline-block;
  margin-top: 4rpx;
  margin-right: 10rpx;
}
.warranty-tag {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 3rpx 12rpx;
  display: inline-block;
  margin-top: 4rpx;
}
.warranty-tag.in {
  color: #2f9e6f;
  background: #e8f8ee;
}
.warranty-tag.out {
  color: #9aa4b0;
  background: #f2f3f5;
}

/* 默认按钮 */
.card-actions {
  flex-shrink: 0;
  margin-left: 10rpx;
}
.action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  transition: all 0.2s;
}
.action-btn:active {
  background: #e8edf5;
  transform: scale(0.96);
}
.action-icon {
  font-size: 24rpx;
}
.action-text {
  font-size: 20rpx;
  color: #4f6b84;
  font-weight: 500;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #eef0f3 12%, #eef0f3 88%, transparent);
  margin: 0 22rpx;
}

/* 快速发起入口 */
.card-quick-actions {
  display: flex;
  padding: 18rpx 22rpx;
  gap: 16rpx;
}
.quick-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  transition: all 0.2s;
}
.quick-btn:active {
  transform: scale(0.97);
}
.quick-icon {
  font-size: 28rpx;
}
.repair-btn {
  background: linear-gradient(135deg, #eaf1fd, #d6e4ff);
  color: #4a6fa5;
  border: 1rpx solid #c5d5f0;
  box-shadow: 0 3rpx 10rpx rgba(74, 111, 165, 0.08);
}
.repair-btn:active {
  background: linear-gradient(135deg, #d6e4ff, #c5d5f0);
}
.recycle-btn {
  background: linear-gradient(135deg, #e8f8e8, #d0f0d0);
  color: #3a7a3a;
  border: 1rpx solid #b8d8b8;
  box-shadow: 0 3rpx 10rpx rgba(58, 122, 58, 0.08);
}
.recycle-btn:active {
  background: linear-gradient(135deg, #d0f0d0, #b8d8b8);
}

/* 卡片底部操作 */
.card-footer {
  display: flex;
  border-top: 1rpx solid #f2f3f5;
}
.footer-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 18rpx 0;
  font-size: 25rpx;
  color: #595959;
  transition: background 0.2s;
}
.footer-btn:active {
  background: #f5f6f8;
}
.footer-icon {
  font-size: 26rpx;
}
.edit-btn {
  border-right: 1rpx solid #f2f3f5;
  color: #4f6b84;
}
.delete-btn {
  color: #ff4d4f;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}
.empty-illustration {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.empty-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(110, 133, 165, 0.18) 0%, transparent 70%);
}
.empty-icon {
  font-size: 80rpx;
  position: relative;
  z-index: 1;
}
.empty-title {
  font-size: 29rpx;
  color: #1f2937;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: #8c8c8c;
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.6;
}
.empty-action {
  margin-top: 32rpx;
  padding: 18rpx 56rpx;
  background: linear-gradient(135deg, #4f6b84, #6a9abb);
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(79, 107, 132, 0.28);
  transition: all 0.2s;
}
.empty-action:active {
  transform: scale(0.96);
}
.empty-action-text {
  font-size: 27rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
  gap: 20rpx;
}
.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 5rpx solid #e2e8f0;
  border-top-color: #4f6b84;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #8c8c8c;
}

/* 底部添加按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, #fff 88%, rgba(255,255,255,0));
}
.add-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 60%, #7f9aba 100%);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  box-shadow: 0 8rpx 22rpx rgba(79, 107, 132, 0.28);
}
.add-btn::after {
  border: none;
}
.add-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}
.add-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}
