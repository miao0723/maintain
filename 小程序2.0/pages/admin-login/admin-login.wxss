/* pages/admin-login/admin-login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  background: white;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.1);
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.login-form {
  width: 100%;
  max-width: 600rpx;
  background: white;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  padding: 30rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  border: none;
  outline: none;
}

.permission-tips {
  background: #fff8e1;
  border-left: 6rpx solid #ffc107;
  padding: 25rpx;
  border-radius: 10rpx;
}

.tip-item {
  display: block;
  font-size: 24rpx;
  color: #8d6e63;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.login-btn {
  width: 100%;
  padding: 35rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 36rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
}

.login-btn.loading {
  opacity: 0.6;
}

.login-btn::after {
  border: none;
}

.login-footer {
  margin-top: 60rpx;
  text-align: center;
}

.footer-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}
