.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef3f8 0%, #e4ebf3 100%);
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top);
  overflow: hidden;
}

.message-list {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 20rpx 0;
}

.list-bottom-pad {
  height: 20rpx;
}

.status-banner {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #dcfce7;
  margin-bottom: 18rpx;
}

.status-banner.ended {
  background: #fee2e2;
}

.status-text {
  font-size: 24rpx;
  color: #1f2937;
}

.message-row {
  display: flex;
  margin-bottom: 18rpx;
}

.message-row.left {
  justify-content: flex-start;
}

.message-row.right {
  justify-content: flex-end;
}

.message-bubble {
  max-width: 70%;
  border-radius: 22rpx;
  padding: 16rpx 18rpx;
  box-shadow: 0 8rpx 18rpx rgba(79, 107, 132, 0.08);
}

.user-bubble {
  background: #ffffff;
}

.admin-bubble {
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
}

.system-bubble {
  background: #eef2f7;
}

.message-role {
  display: block;
  font-size: 20rpx;
  color: #64748b;
}

.admin-bubble .message-role,
.admin-bubble .message-text {
  color: #ffffff;
}

.message-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #1f2937;
  word-break: break-word;
}

/* 底部输入栏：正常文档流，绝不浮于消息列表之上，避免机型遮挡 */
.composer-bar {
  flex-shrink: 0;
  width: 100%;
  padding: 12rpx 20rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e6edf4;
  box-sizing: border-box;
}

.composer-bar.hidden {
  display: none;
}

/* 快捷问题：输入框上方的横向胶囊按钮 */
.quick-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.quick-list {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 2rpx 0;
}

.quick-chip {
  flex-shrink: 0;
  max-width: 360rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eef3f8;
  border: 1rpx solid #dde6ef;
  color: #3d5670;
  font-size: 24rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.quick-chip:active {
  background: #4f6b84;
  color: #ffffff;
  border-color: #4f6b84;
  transform: scale(0.96);
}

.composer {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.composer-btn,
.complete-btn,
.voice-trigger {
  border: none;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #4f6b84 0%, #6a9abb 100%);
}

.composer-btn {
  width: 148rpx;
  height: 84rpx;
  line-height: 84rpx;
  color: #ffffff;
  font-size: 26rpx;
}

.voice-trigger {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(79, 107, 132, 0.12);
}

.voice-trigger.recording {
  background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
}

.voice-trigger-icon {
  font-size: 30rpx;
  color: #ffffff;
}

.complete-btn {
  margin-top: 10rpx;
  height: 80rpx;
  line-height: 80rpx;
  color: #ffffff;
  font-size: 26rpx;
}

.composer-btn::after,
.complete-btn::after {
  border: none;
}

.voice-hint {
  display: block;
  margin: 10rpx 4rpx 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
}

.voice-hint.active {
  color: #ef4444;
  font-weight: 600;
}

/* 客服侧售后信息面板 */
.aftersales-panel {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(79, 107, 132, 0.08);
}
.as-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.as-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}
.as-toggle {
  font-size: 22rpx;
  color: #4f6b84;
}
.as-section-title {
  font-size: 23rpx;
  color: #64748b;
  margin: 16rpx 0 8rpx;
  font-weight: 600;
}
.as-device {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.as-device-name {
  font-size: 25rpx;
  color: #1f2937;
}
.as-warranty {
  font-size: 21rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.as-warranty.in { color: #2f9e6f; background: #e8f8ee; }
.as-warranty.out { color: #9aa4b0; background: #f2f3f5; }
.as-warranty.none { color: #b45309; background: #fef3c7; }
.as-order {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 23rpx;
  color: #475569;
}
.as-order-no { font-weight: 600; }
.as-order-warranty { color: #e6a23c; }
