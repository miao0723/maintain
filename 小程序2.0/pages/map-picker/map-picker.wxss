/* pages/map-picker/map-picker.wxss */
.map-container {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.map {
  width: 100%;
  height: 100%;
}

/* 搜索框 */
.search-container {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  width: 90%;
  max-width: 600rpx;
}

.search-box {
  background: white;
  border-radius: 50rpx;
  padding: 20rpx 20rpx 20rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  padding-right: 10rpx;
}

.search-clear {
  padding: 0 10rpx;
  margin-right: 10rpx;
  color: #999;
  font-size: 32rpx;
  cursor: pointer;
}

.search-clear:active {
  opacity: 0.6;
}

.search-btn {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: white;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.search-btn:active {
  opacity: 0.8;
}

.search-results {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: white;
  border-radius: 20rpx;
  max-height: 500rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  margin-top: 10rpx;
  overflow: hidden;
}

.search-result-item {
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-result-item:active {
  background-color: #f5f5f5;
}

.result-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.result-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.result-distance {
  font-size: 22rpx;
  color: #999;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.result-address {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

/* 加载状态 */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background: white;
  padding: 30rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 3rpx solid #f3f3f3;
  border-top: 3rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 错误提示 */
.error-overlay {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 77, 79, 0.9);
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  z-index: 1000;
  max-width: 80%;
}

.error-text {
  font-size: 26rpx;
  text-align: center;
}

.error-action {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  text-align: center;
  text-decoration: underline;
}

/* 定位按钮 */
.locate-btn {
  position: absolute;
  right: 30rpx;
  bottom: 380rpx;
  width: 80rpx;
  height: 80rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
}

.locate-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.locate-icon {
  font-size: 40rpx;
  color: #1890ff;
}

/* 底部地址信息卡片 */
.address-card {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx;
  box-shadow: 0 -5rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.address-header {
  margin-bottom: 20rpx;
}

.address-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.address-content {
  margin-bottom: 30rpx;
}

.address-detail {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
}

.address-placeholder {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
  display: block;
}

.address-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  border: none;
}

.action-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.action-btn.cancel:active {
  background: #e8e8e8;
}

.action-btn.confirm {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: white;
}

.action-btn.confirm:active {
  opacity: 0.8;
}

.action-btn::after {
  border: none;
}
