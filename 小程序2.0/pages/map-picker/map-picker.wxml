<!--pages/map-picker/map-picker.wxml-->
<view class="map-container">
  <!-- 地图组件 -->
  <map
    id="map"
    class="map"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    polyline="{{polyline}}"
    show-location="{{true}}"
    bindtap="onMapTap"
    bindregionchange="onMapRegionChange"
    enable-3D="{{false}}"
    enable-overlooking="{{false}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    enable-rotate="{{false}}"
    show-compass="{{true}}"
    show-scale="{{true}}"
    enable-poi="{{true}}"
    rotate="{{0}}"
    skew="{{0}}"
    min-level="3"
    max-level="18"
  />

  <!-- 加载状态 -->
  <view class="loading-overlay" wx:if="{{isLoading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在定位...</text>
    </view>
  </view>

  <!-- 错误提示 -->
  <view class="error-overlay" wx:if="{{hasError}}">
    <text class="error-text">{{errorMessage}}</text>
    <text class="error-action" bindtap="openLocationSettings">开启定位权限</text>
  </view>

  <!-- 搜索框 -->
  <view class="search-container">
    <view class="search-box">
      <input
        class="search-input"
        placeholder="搜索地址、小区、商圈..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearchResults">
        <text>✕</text>
      </view>
      <view class="search-btn" bindtap="onSearchConfirm">
        <text>搜索</text>
      </view>
    </view>

    <!-- 搜索结果列表 -->
    <scroll-view class="search-results" scroll-y wx:if="{{searchResults.length > 0}}">
      <view
        class="search-result-item"
        wx:for="{{searchResults}}"
        wx:key="id"
        bindtap="onSelectSearchResult"
        data-index="{{index}}"
      >
        <view class="result-name-row">
          <text class="result-name">{{item.name}}</text>
          <text class="result-distance" wx:if="{{item.distance}}">{{item.distance}}m</text>
        </view>
        <text class="result-address">{{item.province}} {{item.city}} {{item.district}} {{item.address}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 右侧定位按钮 -->
  <view class="locate-btn" bindtap="relocateToCurrent">
    <text class="locate-icon">⊙</text>
  </view>

  <!-- 底部地址信息卡片 -->
  <view class="address-card">
    <view class="address-header">
      <text class="address-title">已选位置</text>
    </view>

    <view class="address-content">
      <text class="address-detail" wx:if="{{selectedAddress.formattedAddress}}">
        {{selectedAddress.formattedAddress}}
      </text>
      <text class="address-placeholder" wx:else>
        请在地图上选择位置或使用搜索功能
      </text>
    </view>

    <view class="address-actions">
      <button class="action-btn cancel" bindtap="cancelSelection">取消</button>
      <button class="action-btn confirm" bindtap="confirmSelection">确认选择</button>
    </view>
  </view>
</view>
