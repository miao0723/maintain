<!--pages/units/units.wxml-->
<view class="page-container">
  <!-- 单位列表 -->
  <scroll-view class="unit-list" scroll-y wx:if="{{unitList.length > 0}}">
    <view class="unit-item" wx:for="{{unitList}}" wx:key="id">
      <view class="unit-content" bindtap="editUnit" data-unit="{{item}}">
        <view class="unit-header">
          <view class="unit-info">
            <text class="unit-name">{{item.name}}</text>
            <text class="unit-contact">{{item.contactName}} {{item.contactPhone}}</text>
          </view>
          <view class="default-badge" wx:if="{{item.isDefault}}">默认</view>
        </view>
        <view class="unit-address">
          <text class="address-text">{{item.address}}</text>
        </view>
        <!-- 订单统计 -->
        <view class="unit-stats" wx:if="{{item.orderCount > 0}}">
          <view class="stat-item">
            <text class="stat-label">订单数：</text>
            <text class="stat-value">{{item.orderCount}}</text>
          </view>
          <view class="stat-item" wx:if="{{item.totalAmount > 0}}">
            <text class="stat-label">消费金额：</text>
            <text class="stat-value amount">¥{{item.totalAmount}}</text>
          </view>
        </view>
      </view>
      <view class="unit-actions">
        <button class="action-btn" bindtap="viewUnitOrders" data-id="{{item.id}}" data-name="{{item.name}}" wx:if="{{item.orderCount > 0}}">
          查看订单
        </button>
        <button class="action-btn" bindtap="setDefault" data-id="{{item.id}}" wx:if="{{!item.isDefault}}">
          设为默认
        </button>
        <button class="action-btn delete" bindtap="deleteUnit" data-id="{{item.id}}">
          删除
        </button>
      </view>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{unitList.length === 0}}">
    <view class="empty-icon">🏢</view>
    <text class="empty-text">暂无单位信息</text>
    <text class="empty-desc">添加您的工作单位，方便服务</text>
  </view>

  <!-- 底部添加按钮 -->
  <view class="bottom-action">
    <button class="add-btn" bindtap="addUnit">
      <text class="btn-icon">+</text>
      <text>添加新单位</text>
    </button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>
</view>
<confirm-modal id="confirmModal" />
