/* pages/units/units.wxss */
.page-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.unit-list {
  margin-bottom: 120rpx;
}

.unit-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.unit-content {
  flex: 1;
}

.unit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.unit-info {
  display: flex;
  flex-direction: column;
}

.unit-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.unit-contact {
  font-size: 26rpx;
  color: #666;
}

.default-badge {
  background: #436f95;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.unit-address {
  margin-top: 10rpx;
}

.address-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.unit-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.unit-stats .stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.unit-stats .stat-label {
  font-size: 24rpx;
  color: #999;
}

.unit-stats .stat-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.unit-stats .stat-value.amount {
  color: #ff6b6b;
  font-weight: 600;
}

.unit-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  gap: 20rpx;
}

.action-btn {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
  border: none;
}

.action-btn.delete {
  background: #ff4757;
  color: white;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 10rpx;
  display: block;
}

.empty-desc {
  font-size: 26rpx;
  display: block;
}

.bottom-action {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
}

.add-btn {
  background: #436f95;
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
}

.btn-icon {
  font-size: 36rpx;
}

.bottom-space {
  height: 160rpx;
}