<!-- pages/index/index.wxml -->
<view class="page-container">
  <view class="hero-section">
    <view class="hero-orb hero-orb-left"></view>
    <view class="hero-orb hero-orb-right"></view>

    <view class="hero-topbar">
      <view class="hero-brand">
        <view class="hero-logo">🔧</view>
        <view class="hero-brand-copy">
          <text class="hero-brand-title">电子维修服务</text>
          <text class="hero-brand-subtitle">维修、回收、报价、进度同步</text>
        </view>
      </view>
      <view class="hero-profile" bindtap="goToMine">
        <image class="hero-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
      </view>
    </view>

    <view class="hero-main">
      <view class="hero-copy">
        <text class="hero-greeting">{{greetingText}}</text>
        <text class="hero-title">你的电子设备问题，这里可以直接开始处理</text>
        <text class="hero-desc">先做故障初判，再接入客服、报价和下单，流程更清楚，页面也更聚焦。</text>
      </view>

      <view class="hero-summary-card">
        <view class="hero-summary-head">
          <text class="hero-summary-label">当前账号</text>
          <text class="hero-summary-role">{{roleText}}</text>
        </view>
        <view class="hero-summary-user">
          <image class="summary-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
          <view class="summary-meta">
            <text class="summary-name">{{userInfo.nickName}}</text>
            <text class="summary-tip" wx:if="{{summaryTipText}}">{{summaryTipText}}</text>
          </view>
        </view>
      </view>
    </view>

  </view>

  <view class="content-shell">
    <view class="action-grid">
      <view class="action-card action-card-diagnose" bindtap="goToDiagnose">
        <view class="action-card-main">
          <view class="action-card-copy">
            <view class="action-badge">故障检测</view>
            <text class="action-title">AI 故障自检</text>
            <text class="action-desc">30 秒内给出初步判断，适合手机、电脑、相机等设备。</text>
          </view>
          <view class="action-icon">🤖</view>
        </view>
        <view class="action-foot">
          <text class="action-metric">快速开始</text>
          <text class="action-arrow">→</text>
        </view>
      </view>

      <view class="action-card action-card-recycle" bindtap="goToRecycle">
        <view class="action-card-main">
          <view class="action-card-copy">
            <view class="action-badge recycle-badge">回收估价</view>
            <text class="action-title">闲置设备回收</text>
            <text class="action-desc">支持手机在线估价和闲置电子设备回收处理。</text>
          </view>
          <view class="action-icon">♻️</view>
        </view>
        <view class="action-foot">
          <text class="action-metric">免费估价</text>
          <text class="action-arrow">→</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">SCOPE</text>
          <text class="section-title">可处理设备范围</text>
        </view>
      </view>
      <view class="business-scope">
        <view class="scope-item" wx:for="{{businessScope}}" wx:key="id">
          <view class="scope-icon">{{item.icon}}</view>
          <text class="scope-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">FLOW</text>
          <text class="section-title">报修路径</text>
        </view>
      </view>
      <view class="flow-list">
        <view class="flow-item" wx:for="{{serviceFlow}}" wx:key="id">
          <view class="flow-step">{{item.step}}</view>
          <view class="flow-content">
            <text class="flow-title">{{item.title}}</text>
            <text class="flow-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">CASES</text>
          <text class="section-title">近期典型维修案例</text>
        </view>
      </view>
      <scroll-view class="cases-scroll" scroll-x>
        <view class="case-item" wx:for="{{successCases}}" wx:key="id">
          <text class="case-icon">{{item.icon}}</text>
          <text class="case-title">{{item.title}}</text>
          <text class="case-desc">{{item.desc}}</text>
          <text class="case-tag">{{item.tag}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="section-card company-card-shell">
      <view class="section-head">
        <view>
          <text class="section-eyebrow">ABOUT</text>
          <text class="section-title">公司与服务</text>
        </view>
      </view>
      <view class="company-card">
        <text class="company-name">{{companyProfile.name}}</text>
        <text class="company-intro">{{companyProfile.intro}}</text>
        <text class="company-desc">{{companyProfile.description}}</text>
      </view>
      <view class="company-highlight-list">
        <view class="company-highlight-item" wx:for="{{companyHighlights}}" wx:key="id">
          <text class="company-highlight-title">{{item.title}}</text>
          <text class="company-highlight-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="section-card contact-section">
      <view class="section-head section-head-light">
        <view>
          <text class="section-eyebrow light">CONTACT</text>
          <text class="section-title light">联系我们</text>
        </view>
      </view>
      <view class="contact-info">
        <view class="contact-item contact-item-wide">
          <text class="contact-label">公司</text>
          <text class="contact-text">{{contactInfo.company}}</text>
        </view>
        <view class="contact-item">
          <text class="contact-label">电话</text>
          <text class="contact-text">{{contactInfo.phone}}</text>
        </view>
        <view class="contact-item contact-item-wide">
          <text class="contact-label">地址</text>
          <text class="contact-text">{{contactInfo.address}}</text>
        </view>
        <view class="contact-item">
          <text class="contact-label">邮箱</text>
          <text class="contact-text">{{contactInfo.email}}</text>
        </view>
      </view>
      <button class="contact-btn" open-type="contact" session-from="home">
        直接咨询客服
      </button>
    </view>
  </view>

  <!-- 授权登录弹窗 -->
  <view class="auth-mask" wx:if="{{needAuth}}">
    <view class="auth-card">
      <view class="auth-logo">🔧</view>
      <view class="auth-title">电子维修服务</view>
      <view class="auth-desc">登录后可使用故障自检、报价确认、进度反馈等服务</view>

      <button
        class="auth-btn"
        bindtap="handleAuthLogin"
        loading="{{authLoading}}"
        disabled="{{authLoading}}"
      >{{authLoading ? '登录中...' : '微信一键登录'}}</button>

      <view class="auth-policy">
        <text>登录即表示同意</text>
        <text class="auth-link" bindtap="viewAgreement" catchtap="viewAgreement">《免责协议》</text>
        <text>和</text>
        <text class="auth-link" bindtap="viewPrivacyPolicy" catchtap="viewPrivacyPolicy">《隐私政策》</text>
      </view>

      <view class="auth-close" bindtap="closeAuth">暂不登录</view>
    </view>
  </view>

  <!-- 资料补全弹层：读取微信头像与昵称 -->
  <view class="fill-mask" wx:if="{{showProfileFill}}">
    <view class="fill-card">
      <view class="fill-glow"></view>
      <view class="fill-emoji">🙂</view>
      <text class="fill-title">完善微信资料</text>
      <text class="fill-sub">点击下方头像获取微信头像，昵称可一键填入</text>

      <button class="fill-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" loading="{{isFilling}}" disabled="{{isFilling}}">
        <image class="fill-avatar-img" src="{{fillAvatarUrl || avatarUrl}}" mode="aspectFill"></image>
      </button>

      <view class="fill-nick">
        <text class="fill-nick-label">昵称</text>
        <input class="fill-nick-input" type="nickname" placeholder="点此填入微信昵称" placeholder-class="fill-nick-ph" value="{{fillNickName}}" bindnickname="onFillNickName" bindinput="onFillNickNameInput" maxlength="20"/>
      </view>

      <button class="fill-save" bindtap="saveProfileFill" loading="{{isFilling}}" disabled="{{isFilling}}">{{isFilling ? '保存中...' : '保存并进入'}}</button>
      <view class="fill-skip" bindtap="skipProfileFill">暂不设置，直接进入</view>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
