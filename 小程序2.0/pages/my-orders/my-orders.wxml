<!--pages/my-orders/my-orders.wxml-->
<view class="container">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="header-left">
      <text class="page-title">我的订单</text>
      <text class="page-subtitle">分配给我的维修订单</text>
    </view>
    <view class="header-right">
      <text class="order-count">共 {{total}} 单</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card {{currentTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending">
      <text class="stat-icon">⏳</text>
      <text class="stat-value">{{statusCounts.pending}}</text>
      <text class="stat-label">待报价</text>
    </view>
    <view class="stat-card {{currentTab === 'quoted' ? 'active' : ''}}" bindtap="switchTab" data-tab="quoted">
      <text class="stat-icon">💰</text>
      <text class="stat-value">{{statusCounts.quoted}}</text>
      <text class="stat-label">待确认</text>
    </view>
    <view class="stat-card {{currentTab === 'confirmed' ? 'active' : ''}}" bindtap="switchTab" data-tab="confirmed">
      <text class="stat-icon">✅</text>
      <text class="stat-value">{{statusCounts.confirmed}}</text>
      <text class="stat-label">待处理</text>
    </view>
    <view class="stat-card {{currentTab === 'processing' ? 'active' : ''}}" bindtap="switchTab" data-tab="processing">
      <text class="stat-icon">🔧</text>
      <text class="stat-value">{{statusCounts.processing}}</text>
      <text class="stat-label">维修中</text>
    </view>
    <view class="stat-card {{currentTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">
      <text class="stat-icon">✅</text>
      <text class="stat-value">{{statusCounts.completed}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-card {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
      <text class="stat-icon">📋</text>
      <text class="stat-value">{{total}}</text>
      <text class="stat-label">全部</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索订单号、客户姓名、手机号"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
    </view>
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 加载中状态 -->
  <view wx:if="{{loading && orders.length === 0}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-hint">加载订单中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{orders.length === 0 && !loading}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
    <text class="empty-hint">当前筛选条件下没有订单</text>
  </view>

  <!-- 订单列表 -->
  <view wx:else class="order-list">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      bindtap="viewOrderDetail"
      data-id="{{item.id}}"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-info">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-time">{{item.timeAgo}}</text>
        </view>
        <view class="order-status" style="background: {{item.statusBg}}; color: {{item.statusColor}}">
          <text class="status-icon-text">{{item.statusIcon}}</text>
          <text class="status-text">{{item.statusLabel}}</text>
        </view>
      </view>

      <!-- 设备信息 -->
      <view class="order-device">
        <view class="device-icon">{{item.deviceTypeIcon || '📱'}}</view>
        <view class="device-details">
          <text class="device-name">{{item.deviceName}}</text>
          <text class="device-model">{{item.device_model || ''}} {{item.brandName ? '· ' + item.brandName : ''}}</text>
        </view>
        <view wx:if="{{item.priority === 'high'}}" class="priority-badge">紧急</view>
      </view>

      <!-- 问题描述 -->
      <view class="order-problem">
        <text class="problem-label">描述：</text>
        <text class="problem-text">{{item.problem}}</text>
      </view>

      <!-- 报价被拒绝提示 -->
      <view wx:if="{{item.quote_status === 'rejected'}}" class="quote-rejected-tip">
        <text class="rejected-tip-icon">❌</text>
        <view class="rejected-tip-content">
          <text class="rejected-tip-title">报价已被用户拒绝</text>
          <text wx:if="{{item.quote_rejected_reason}}" class="rejected-tip-reason">原因：{{item.quote_rejected_reason}}</text>
        </view>
      </view>

      <!-- 进度反馈提示 -->
      <view wx:if="{{item.needsProgressFeedback}}" class="progress-feedback-tip">
        <text class="feedback-tip-icon">📢</text>
        <view class="feedback-tip-content">
          <text class="feedback-tip-title">该订单进度申请已审核通过</text>
          <text class="feedback-tip-hint">请点击下方「进度反馈」按钮发送{{item.isRecycle ? '回收' : '维修'}}进度</text>
        </view>
      </view>

      <!-- 客户信息 -->
      <view class="order-customer">
        <view class="customer-info">
          <text class="customer-icon-text">👤</text>
          <text class="customer-name">{{item.userName}}</text>
          <text class="customer-phone">{{item.userPhone}}</text>
        </view>
        <text wx:if="{{item.priceDisplay}}" class="order-price">{{item.priceDisplay}}</text>
      </view>

      <!-- 维修进度步骤（所有订单都显示） -->
      <view class="progress-timeline" wx:if="{{item.progressSteps.length > 0}}">
        <view class="timeline-header">
          <text class="timeline-title">{{item.isRecycle ? '回收进度' : '维修进度'}}</text>
          <text class="timeline-percent" style="color: {{item.statusColor}}">{{item.progressPercentText}}</text>
        </view>
        <view class="timeline-steps">
          <block wx:for="{{item.progressSteps}}" wx:key="key" wx:for-item="step">
            <!-- 步骤节点 -->
            <view class="step-col {{step.state}}">
              <view class="step-dot {{step.state}}">
                <text class="step-icon">{{step.icon}}</text>
              </view>
              <text class="step-label">{{step.label}}</text>
            </view>
            <!-- 连接线（最后一个步骤不显示） -->
            <view wx:if="{{step.index < item.progressSteps.length - 1}}" class="step-line {{step.state}}">
              <view class="step-line-fill"></view>
            </view>
          </block>
        </view>
        <!-- 进度条 -->
        <view class="timeline-bar">
          <view class="timeline-bar-fill" style="width: {{item.progress}}%; background: linear-gradient(90deg, {{item.statusColor}}, {{item.statusColor}}99)"></view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions">
        <block wx:if="{{item.status === 'pending'}}">
          <view class="action-btn edit" catchtap="openEditModal" data-id="{{item.id}}">✏️ 编辑</view>
          <view class="action-btn refund" catchtap="openRefundModal" data-id="{{item.id}}">💰 退款</view>
          <view class="action-btn primary" catchtap="openQuoteModal" data-id="{{item.id}}">💰 报价</view>
        </block>

        <block wx:elif="{{item.status === 'quoted'}}">
          <view class="action-btn info" catchtap="viewOrderDetail" data-id="{{item.id}}">查看详情</view>
          <view class="action-btn" style="background: #436f95; color: #fff;">等待用户确认</view>
        </block>

        <block wx:elif="{{item.quote_status === 'rejected'}}">
          <view class="action-btn danger" catchtap="viewOrderDetail" data-id="{{item.id}}">报价被拒绝</view>
          <view class="action-btn primary" catchtap="openQuoteModal" data-id="{{item.id}}">重新报价</view>
          <view class="action-btn refund" catchtap="openRefundModal" data-id="{{item.id}}">退款</view>
        </block>

        <block wx:elif="{{item.status === 'confirmed'}}">
          <view class="action-btn primary" catchtap="startProcessing" data-id="{{item.id}}">开始处理</view>
          <view class="action-btn info" catchtap="viewOrderDetail" data-id="{{item.id}}">查看详情</view>
        </block>

        <block wx:elif="{{item.status === 'processing'}}">
          <view class="action-btn info" catchtap="updateOrderProgress" data-id="{{item.id}}">更新进度</view>
          <view class="action-btn" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: #fff;" catchtap="uploadProgress" data-id="{{item.id}}">📹 进度反馈</view>
          <view class="action-btn success" catchtap="completeOrder" data-id="{{item.id}}">完成</view>
          <view class="action-btn danger" catchtap="cancelOrder" data-id="{{item.id}}">取消</view>
        </block>

        <block wx:elif="{{item.status === 'completed'}}">
          <view class="action-btn info" catchtap="viewOrderDetail" data-id="{{item.id}}">查看详情</view>
          <view class="action-btn after-sales" catchtap="openAfterSalesModal" data-id="{{item.id}}">🛠 申请售后</view>
        </block>

        <block wx:elif="{{item.status === 'cancelled'}}">
          <view class="action-btn info disabled">已取消</view>
        </block>

        <block wx:elif="{{item.status === 'review'}}">
          <view class="action-btn info">待评价</view>
          <view class="action-btn after-sales" catchtap="openAfterSalesModal" data-id="{{item.id}}">🛠 申请售后</view>
        </block>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loading && orders.length > 0}}" class="loading-more">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:if="{{!hasMore && orders.length > 0}}" class="no-more">
      <text class="no-more-text">没有更多了</text>
    </view>
  </view>

  <!-- 查看所有订单按钮 -->
  <view class="all-orders-btn" bindtap="goToAllOrders">
    <text class="btn-text">查看所有订单</text>
    <text class="btn-arrow">→</text>
  </view>
</view>

<!-- 退款申请弹窗 -->
<view wx:if="{{showRefundModal}}" class="modal-overlay" bindtap="closeRefundModal">
  <view class="modal-content refund-modal" catchtap="">
    <view class="modal-header">
      <text class="modal-title">申请退款</text>
      <view class="modal-close" bindtap="closeRefundModal">×</view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 退款订单信息 -->
      <view class="refund-order-info">
        <view class="refund-info-row">
          <text class="refund-info-label">订单编号</text>
          <text class="refund-info-value">{{refundOrderData.orderNo || ''}}</text>
        </view>
        <view class="refund-info-row">
          <text class="refund-info-label">退款金额</text>
          <text class="refund-info-value refund-amount">¥{{refundOrderData.estimatedPrice || '0.0'}}</text>
        </view>
      </view>

      <!-- 退款原因选择 -->
      <view class="refund-section">
        <text class="refund-section-title">退款原因 <text class="required">*</text></text>
        <view class="refund-reason-list">
          <view
            wx:for="{{refundReasons}}"
            wx:key="value"
            class="refund-reason-item {{refundFormData.reason === item.value ? 'active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectRefundReason"
          >
            <view class="reason-radio">
              <view wx:if="{{refundFormData.reason === item.value}}" class="reason-radio-checked"></view>
            </view>
            <text class="reason-text">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 补充说明 -->
      <view class="refund-section">
        <text class="refund-section-title">补充说明</text>
        <textarea
          class="refund-desc-input"
          placeholder="请描述具体退款原因（选填）"
          maxlength="200"
          value="{{refundFormData.description}}"
          bindinput="onRefundDescInput"
        />
        <text class="refund-desc-count">{{refundFormData.description.length}}/200</text>
      </view>

      <!-- 提示 -->
      <view class="refund-warning">
        <text class="warning-icon">⚠️</text>
        <text class="warning-text">提交退款后订单将自动取消，此操作不可撤销</text>
      </view>
    </scroll-view>

    <!-- 底部按钮 -->
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeRefundModal">取消</view>
      <view class="modal-btn refund-submit" bindtap="submitRefund">确认退款</view>
    </view>
  </view>
</view>

<!-- 订单编辑弹窗 -->
<view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="closeEditModal">
  <view class="modal-content edit-modal" catchtap="">
    <view class="modal-header">
      <text class="modal-title">编辑订单</text>
      <view class="modal-close" bindtap="closeEditModal">×</view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 客户信息 -->
      <view class="edit-section">
        <text class="edit-section-title">客户信息</text>
        <view class="form-group">
          <text class="form-label">真实姓名</text>
          <input class="form-input" data-field="customer_name" value="{{editFormData.customer_name}}" bindinput="onEditInput" placeholder="请输入真实姓名"/>
        </view>
        <view class="form-group">
          <text class="form-label">联系电话</text>
          <input class="form-input" data-field="customer_phone" type="number" value="{{editFormData.customer_phone}}" bindinput="onEditInput" placeholder="请输入联系电话"/>
        </view>
      </view>

      <!-- 地址信息(上门服务) -->
      <view wx:if="{{editOrderData.serviceType === 'home'}}" class="edit-section">
        <text class="edit-section-title">收货地址</text>
        <view class="form-group">
          <text class="form-label">联系人</text>
          <input class="form-input" data-field="contact_name" value="{{editFormData.contact_name}}" bindinput="onEditInput" placeholder="请输入联系人"/>
        </view>
        <view class="form-group">
          <text class="form-label">联系电话</text>
          <input class="form-input" data-field="contact_phone" type="number" value="{{editFormData.contact_phone}}" bindinput="onEditInput" placeholder="请输入联系电话"/>
        </view>
        <view class="form-group">
          <text class="form-label">省份</text>
          <input class="form-input" data-field="province" value="{{editFormData.province}}" bindinput="onEditInput" placeholder="请输入省份"/>
        </view>
        <view class="form-group">
          <text class="form-label">城市</text>
          <input class="form-input" data-field="city" value="{{editFormData.city}}" bindinput="onEditInput" placeholder="请输入城市"/>
        </view>
        <view class="form-group">
          <text class="form-label">区县</text>
          <input class="form-input" data-field="district" value="{{editFormData.district}}" bindinput="onEditInput" placeholder="请输入区县"/>
        </view>
        <view class="form-group">
          <text class="form-label">详细地址</text>
          <textarea class="form-textarea" data-field="detail_address" value="{{editFormData.detail_address}}" bindinput="onEditInput" placeholder="请输入详细地址"/>
        </view>
      </view>

      <!-- 订单信息 -->
      <view class="edit-section">
        <text class="edit-section-title">订单信息</text>
        <view class="form-group">
          <text class="form-label">问题描述</text>
          <textarea class="form-textarea" data-field="problem_description" value="{{editFormData.problem_description}}" bindinput="onEditInput" placeholder="请输入问题描述"/>
        </view>
        <view class="form-group">
          <text class="form-label">自定义描述</text>
          <textarea class="form-textarea" data-field="custom_description" value="{{editFormData.custom_description}}" bindinput="onEditInput" placeholder="请输入自定义描述"/>
        </view>
        <view class="form-group">
          <text class="form-label">预估价格</text>
          <input class="form-input" data-field="estimated_price" type="digit" value="{{editFormData.estimated_price}}" bindinput="onEditInput" placeholder="请输入预估价格"/>
        </view>
        <view class="form-group">
          <text class="form-label">实际价格</text>
          <input class="form-input" data-field="actual_price" type="digit" value="{{editFormData.actual_price}}" bindinput="onEditInput" placeholder="请输入实际价格"/>
        </view>
        <view class="form-group">
          <text class="form-label">优先级</text>
          <view class="priority-selector">
            <view class="priority-option {{editFormData.priority === 1 ? 'active' : ''}}" data-value="1" bindtap="selectPriority">
              <text class="priority-icon low">🟢</text>
              <text class="priority-label">低</text>
            </view>
            <view class="priority-option {{editFormData.priority === 2 ? 'active' : ''}}" data-value="2" bindtap="selectPriority">
              <text class="priority-icon medium">🟡</text>
              <text class="priority-label">中</text>
            </view>
            <view class="priority-option {{editFormData.priority === 3 ? 'active' : ''}}" data-value="3" bindtap="selectPriority">
              <text class="priority-icon high">🔴</text>
              <text class="priority-label">高</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部按钮 -->
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeEditModal">❌ 取消</view>
      <view class="modal-btn primary" bindtap="saveEditOrder">✅ 保存</view>
    </view>
  </view>
</view>

<!-- 订单详情弹窗 -->
<view wx:if="{{showOrderDetail && currentOrder}}" class="modal-overlay" bindtap="closeOrderDetail">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">订单详情</text>
      <view class="modal-close" bindtap="closeOrderDetail">×</view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 订单状态 -->
      <view class="detail-section">
        <text class="section-title">订单状态</text>
        <view class="status-display" style="background: {{currentOrder.statusBg}}">
          <text class="status-icon-large">{{currentOrder.statusIcon}}</text>
          <text class="status-text-large">{{currentOrder.statusLabel}}</text>
        </view>
      </view>

      <!-- 基本信息 -->
      <view class="detail-section">
        <text class="section-title">基本信息</text>
        <view class="detail-row">
          <text class="detail-label">订单编号</text>
          <text class="detail-value">{{currentOrder.orderNo}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">服务类型</text>
          <text class="detail-value">{{currentOrder.serviceTypeText}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">创建时间</text>
          <text class="detail-value">{{currentOrder.createdAt}}</text>
        </view>
        <view wx:if="{{currentOrder.assignedAt}}" class="detail-row">
          <text class="detail-label">接单时间</text>
          <text class="detail-value">{{currentOrder.assignedAt}}</text>
        </view>
        <view wx:if="{{currentOrder.completedAt}}" class="detail-row">
          <text class="detail-label">完成时间</text>
          <text class="detail-value">{{currentOrder.completedAt}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">预估费用</text>
          <text class="detail-value price" wx:if="{{currentOrder.estimatedPrice}}">¥{{currentOrder.estimatedPrice}}</text>
          <text class="detail-value" wx:else>暂无</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">实际费用</text>
          <text class="detail-value price" wx:if="{{currentOrder.actualPrice}}">¥{{currentOrder.actualPrice}}</text>
          <text class="detail-value" wx:else>暂无</text>
        </view>
      </view>

      <!-- 设备信息 -->
      <view class="detail-section">
        <text class="section-title">设备信息</text>
        <view class="device-card">
          <view class="device-icon-large">{{currentOrder.deviceTypeIcon || '📱'}}</view>
          <view class="device-info">
            <text class="device-name-large">{{currentOrder.deviceName}}</text>
            <text class="device-model-large">{{currentOrder.device_model || ''}} {{currentOrder.brandName ? '· ' + currentOrder.brandName : ''}}</text>
          </view>
        </view>
      </view>

      <!-- 描述 -->
      <view class="detail-section">
        <text class="section-title">描述</text>
        <view class="problem-card">
          <text class="problem-text-large">{{currentOrder.problem}}</text>
        </view>
      </view>

      <!-- 客户信息 -->
      <view class="detail-section">
        <text class="section-title">客户信息</text>
        <view class="customer-card">
          <view class="customer-row">
            <text class="customer-label">姓名</text>
            <text class="customer-value">{{currentOrder.userName}}</text>
          </view>
          <view class="customer-row">
            <text class="customer-label">手机号</text>
            <text class="customer-value">{{currentOrder.userPhone}}</text>
          </view>
        </view>
      </view>

      <!-- 进度 -->
      <view wx:if="{{currentOrder.status === 'processing'}}" class="detail-section">
        <text class="section-title">{{currentOrder.isRecycle ? '回收进度' : '维修进度'}}</text>
        <view class="progress-display">
          <view class="progress-bar-large">
            <view class="progress-fill-large" style="width: {{currentOrder.progress}}%"></view>
          </view>
          <text class="progress-text-large">{{currentOrder.progress}}%</text>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作 -->
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeOrderDetail">关闭</view>
      <view wx:if="{{currentOrder.status === 'pending'}}" class="modal-btn primary" bindtap="openQuoteModal" data-id="{{currentOrder.id}}">💰 报价</view>
      <view wx:if="{{currentOrder.status === 'confirmed'}}" class="modal-btn primary" bindtap="startProcessing" data-id="{{currentOrder.id}}">开始处理</view>
      <view wx:if="{{currentOrder.status === 'processing'}}" class="modal-btn primary" bindtap="updateProgressFromModal">更新进度</view>
    </view>
  </view>
</view>

<!-- 报价弹窗 -->
<view wx:if="{{showQuoteModal}}" class="modal-overlay" bindtap="closeQuoteModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">提交报价</text>
      <view class="modal-close" bindtap="closeQuoteModal">×</view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 报价金额 -->
      <view class="form-section">
        <text class="form-label">报价金额 <text class="required">*</text></text>
        <view class="price-input-row">
          <text class="price-symbol">¥</text>
          <input
            class="price-input"
            type="digit"
            placeholder="请输入报价金额"
            value="{{quoteFormData.price}}"
            bindinput="onQuotePriceInput"
          />
        </view>
      </view>

      <!-- 报价说明 -->
      <view class="form-section">
        <text class="form-label">报价说明</text>
        <textarea
          class="form-textarea"
          placeholder="请描述报价详情、维修方案等"
          maxlength="500"
          value="{{quoteFormData.description}}"
          bindinput="onQuoteDescInput"
        />
        <text class="char-count">{{quoteFormData.description.length}}/500</text>
      </view>

      <!-- 报告文件 -->
      <view class="form-section">
        <text class="form-label">报告文件</text>
        <view class="file-upload-area" bindtap="chooseQuoteFiles">
          <text class="upload-icon">📎</text>
          <text class="upload-text">点击上传检测报告</text>
        </view>
        <view wx:if="{{quoteFormData.files.length > 0}}" class="file-list">
          <view wx:for="{{quoteFormData.files}}" wx:key="index" class="file-item">
            <text class="file-icon">📄</text>
            <text class="file-name">{{item.originalName || item.filename || '文件'}}</text>
            <view class="file-remove" catchtap="removeQuoteFile" data-index="{{index}}">×</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeQuoteModal">取消</view>
      <view class="modal-btn primary" bindtap="submitQuote">提交报价</view>
    </view>
  </view>
</view>

<!-- 售后申请弹窗 -->
<view wx:if="{{showAfterSalesModal}}" class="modal-overlay" bindtap="closeAfterSalesModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">申请售后</text>
      <view class="modal-close" bindtap="closeAfterSalesModal">×</view>
    </view>

    <scroll-view class="modal-body" scroll-y>
      <!-- 订单信息 -->
      <view class="refund-order-info">
        <view class="refund-info-row">
          <text class="refund-info-label">订单编号</text>
          <text class="refund-info-value">{{afterSalesOrderData.orderNo || ''}}</text>
        </view>
        <view class="refund-info-row">
          <text class="refund-info-label">设备</text>
          <text class="refund-info-value">{{afterSalesOrderData.deviceName || ''}}</text>
        </view>
      </view>

      <!-- 售后类型 -->
      <view class="refund-section">
        <text class="refund-section-title">售后类型 <text class="required">*</text></text>
        <view class="after-sales-type-list">
          <view
            wx:for="{{afterSalesTypes}}"
            wx:key="value"
            class="after-sales-type-item {{afterSalesFormData.type === item.value ? 'active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectAfterSalesType"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 具体产品 -->
      <view class="refund-section">
        <text class="refund-section-title">具体产品 <text class="required">*</text></text>
        <input
          class="refund-desc-input"
          style="height: 80rpx;"
          placeholder="请填写需要售后的具体产品"
          value="{{afterSalesFormData.product_name}}"
          data-field="product_name"
          bindinput="onAfterSalesInput"
        />
        <input
          class="refund-desc-input"
          style="height: 80rpx; margin-top: 16rpx;"
          placeholder="产品型号（选填）"
          value="{{afterSalesFormData.product_model}}"
          data-field="product_model"
          bindinput="onAfterSalesInput"
        />
      </view>

      <!-- 问题描述 -->
      <view class="refund-section">
        <text class="refund-section-title">问题描述 <text class="required">*</text></text>
        <textarea
          class="refund-desc-input"
          placeholder="请描述具体的售后问题"
          maxlength="500"
          value="{{afterSalesFormData.description}}"
          data-field="description"
          bindinput="onAfterSalesInput"
        />
        <text class="refund-desc-count">{{afterSalesFormData.description.length}}/500</text>
      </view>

      <!-- 联系电话 -->
      <view class="refund-section">
        <text class="refund-section-title">联系电话</text>
        <input
          class="refund-desc-input"
          style="height: 80rpx;"
          type="number"
          placeholder="请填写联系电话"
          value="{{afterSalesFormData.contact_phone}}"
          data-field="contact_phone"
          bindinput="onAfterSalesInput"
        />
      </view>

      <!-- 图片凭证 -->
      <view class="refund-section">
        <text class="refund-section-title">图片凭证</text>
        <view class="after-sales-images">
          <view wx:for="{{afterSalesFormData.images}}" wx:key="index" class="after-sales-image-item">
            <image class="after-sales-image" src="{{item.url || item}}" mode="aspectFill"></image>
            <view class="after-sales-image-remove" catchtap="removeAfterSalesFile" data-index="{{index}}">×</view>
          </view>
          <view wx:if="{{afterSalesFormData.images.length < 9}}" class="after-sales-image-add" bindtap="chooseAfterSalesFiles">
            <text class="upload-icon">📷</text>
            <text class="upload-text">添加图片</text>
          </view>
        </view>
      </view>

      <view class="refund-warning">
        <text class="warning-icon">⚠️</text>
        <text class="warning-text">提交后管理员会尽快为您处理该售后问题</text>
      </view>
    </scroll-view>

    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeAfterSalesModal">取消</view>
      <view class="modal-btn after-sales-submit" bindtap="submitAfterSales">提交申请</view>
    </view>
  </view>
</view>
<confirm-modal id="confirmModal" />
