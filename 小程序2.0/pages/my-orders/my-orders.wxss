/* pages/my-orders/my-orders.wxss */
page {
  background: #f5f7fa;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

/* 顶部信息 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-count {
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

/* 统计卡片行 */
.stats-row {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  background: #f8f9fa;
  transition: all 0.3s ease;
}

.stat-card:active {
  transform: scale(0.95);
}

.stat-card.pending {
  background: #fef3c7;
}

.stat-card.quoted {
  background: #ede9fe;
}

.stat-card.confirmed {
  background: #cffafe;
}

.stat-card.processing {
  background: #dbeafe;
}

.stat-card.completed {
  background: #d1fae5;
}

.stat-card.all {
  background: #e0e7ff;
}

.stat-icon {
  font-size: 36rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 2rpx solid #e5e7eb;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f5f7fa;
  border-radius: 48rpx;
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.search-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 48rpx;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 24rpx 32rpx;
  gap: 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
}

.order-card:active {
  transform: scale(0.98);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 48rpx;
}

.status-icon,
.status-icon-text {
  font-size: 24rpx;
}

.status-text {
  font-size: 24rpx;
  font-weight: 500;
}

/* 设备信息 */
.order-device {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.device-icon {
  font-size: 48rpx;
}

.device-details {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.device-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.device-model {
  font-size: 24rpx;
  color: #666;
}

.priority-badge {
  padding: 6rpx 12rpx;
  background: #fee2e2;
  color: #dc2626;
  font-size: 22rpx;
  border-radius: 8rpx;
}

/* 问题描述 */
.order-problem {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding: 12rpx;
  background: #fef3c7;
  border-radius: 8rpx;
}

.problem-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #92400e;
  white-space: nowrap;
}

.problem-text {
  flex: 1;
  font-size: 26rpx;
  color: #78350f;
  line-height: 1.6;
}

/* 客户信息 */
.order-customer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx;
  background: #f0f9ff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.customer-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.customer-icon,
.customer-icon-text {
  font-size: 32rpx;
}

.customer-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.customer-phone {
  font-size: 24rpx;
  color: #666;
  margin-left: 8rpx;
}

.order-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #dc2626;
}

/* ===== 维修进度步骤时间线 ===== */
.progress-timeline {
  margin: 16rpx 0;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8faff 0%, #f0f4ff 100%);
  border-radius: 16rpx;
  border: 2rpx solid #e8eeff;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.timeline-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.timeline-percent {
  font-size: 28rpx;
  font-weight: 700;
}

/* 步骤行 */
.timeline-steps {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

/* 每个步骤列 */
.step-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
  z-index: 1;
}

/* 步骤圆点 */
.step-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  transition: all 0.4s ease;
}

.step-dot.done {
  background: linear-gradient(135deg, #10b981, #059669);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.4);
}

.step-dot.active {
  background: #fff;
  border: 4rpx solid #667eea;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  animation: stepPulse 1.8s ease-in-out infinite;
}

.step-dot.pending {
  background: #e5e7eb;
  box-shadow: none;
}

.step-icon {
  font-size: 24rpx;
  line-height: 1;
}

.step-dot.done .step-icon {
  /* 已完成图标默认白色 */
}

.step-dot.active .step-icon {
  /* 活跃图标使用主题色 */
}

.step-dot.pending .step-icon {
  opacity: 0.35;
  filter: grayscale(1);
}

/* 步骤文字 */
.step-label {
  font-size: 20rpx;
  color: #999;
  text-align: center;
  line-height: 1.3;
  transition: color 0.3s ease;
}

.step-col.done .step-label {
  color: #059669;
  font-weight: 500;
}

.step-col.active .step-label {
  color: #667eea;
  font-weight: 600;
}

/* 连接线 */
.step-line {
  flex: 1;
  display: flex;
  align-items: center;
  height: 56rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 0;
}

.step-line-fill {
  flex: 1;
  height: 6rpx;
  border-radius: 6rpx;
  background: #e5e7eb;
  position: relative;
  overflow: hidden;
}

.step-line.done .step-line-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, #10b981, #059669);
  border-radius: 6rpx;
}

.step-line.active .step-line-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  bottom: 0;
  background: linear-gradient(90deg, #10b981, #667eea);
  border-radius: 6rpx;
  animation: lineGrow 1.5s ease-in-out infinite;
}

/* 底部进度条 */
.timeline-bar {
  width: 100%;
  height: 10rpx;
  background: #e5e7eb;
  border-radius: 10rpx;
  overflow: hidden;
  margin-top: 4rpx;
}

.timeline-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.6s ease;
}

/* 步骤脉冲动画 */
@keyframes stepPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4); }
  50% { transform: scale(1.08); box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.6); }
}

/* 连接线生长动画 */
@keyframes lineGrow {
  0%, 100% { width: 40%; opacity: 0.7; }
  50% { width: 60%; opacity: 1; }
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.action-btn.success {
  background: #d1fae5;
  color: #059669;
  border: 2rpx solid #a7f3d0;
}

.action-btn.info {
  background: #fef3c7;
  color: #92400e;
  border: 2rpx solid #fde68a;
}

.action-btn.edit {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #fff;
  border: 2rpx solid #d946ef;
  box-shadow: 0 4rpx 12rpx rgba(240, 147, 251, 0.3);
}

.action-btn.danger {
  background: #fee2e2;
  color: #dc2626;
  border: 2rpx solid #fecaca;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* 编辑弹窗样式 */
.edit-modal {
  max-height: 80vh;
  max-width: 600rpx;
}

.edit-section {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.edit-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

/* 表单样式 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #667eea;
  outline: none;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: #667eea;
  outline: none;
}

/* 优先级选择器 */
.priority-selector {
  display: flex;
  gap: 16rpx;
}

.priority-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.3s;
}

.priority-option.active {
  border-color: #667eea;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.priority-option.active .priority-label {
  color: #fff;
}

.priority-icon {
  font-size: 48rpx;
}

.priority-label {
  font-size: 24rpx;
  color: #666;
}

/* 加载中状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e7eb;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-hint {
  font-size: 26rpx;
  color: #999;
}

/* 统计卡片激活态 */
.stat-card.active {
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  transform: scale(1.05);
}

/* 禁用按钮 */
.action-btn.disabled {
  background: #f3f4f6;
  color: #9ca3af;
  border: 2rpx solid #e5e7eb;
}

/* 加载更多 */
.loading-more,
.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}

.loading-text,
.no-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 地址信息区块 */
.order-address {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f0fdf4;
  border-radius: 12rpx;
  border: 2rpx solid #bbf7d0;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.address-icon-text {
  font-size: 28rpx;
}

.address-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #166534;
}

.address-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-left: 36rpx;
}

.address-contact {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.address-detail {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 退款按钮 */
.action-btn.refund {
  background: #fff7ed;
  color: #ea580c;
  border: 2rpx solid #fed7aa;
}

/* 退款弹窗样式 */
.refund-modal {
  max-height: 85vh;
}

.refund-order-info {
  padding: 24rpx;
  background: #fef3c7;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.refund-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.refund-info-label {
  font-size: 26rpx;
  color: #92400e;
}

.refund-info-value {
  font-size: 26rpx;
  color: #78350f;
  font-weight: 500;
}

.refund-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #dc2626;
}

.refund-section {
  margin-bottom: 32rpx;
}

.refund-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.required {
  color: #dc2626;
}

/* 退款原因列表 */
.refund-reason-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.refund-reason-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.refund-reason-item.active {
  border-color: #667eea;
  background: #f5f3ff;
}

.reason-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.refund-reason-item.active .reason-radio {
  border-color: #667eea;
}

.reason-radio-checked {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.reason-text {
  font-size: 28rpx;
  color: #333;
}

/* 退款描述输入 */
.refund-desc-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.refund-desc-count {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 8rpx;
}

/* 退款警告提示 */
.refund-warning {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.warning-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.warning-text {
  font-size: 24rpx;
  color: #991b1b;
  line-height: 1.6;
}

/* 退款提交按钮 */
.modal-btn.refund-submit {
  background: linear-gradient(135deg, #f87171 0%, #dc2626 100%);
  color: #fff;
}

/* 查看所有订单按钮 */
.all-orders-btn {
  position: fixed;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  z-index: 100;
  transition: transform 0.3s ease;
}

.all-orders-btn:active {
  transform: translateX(-50%) scale(0.95);
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

.btn-arrow {
  font-size: 28rpx;
  font-weight: 600;
}

/* 订单详情弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  width: 640rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #e5e7eb;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.detail-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 状态显示 */
.status-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.status-icon-large {
  font-size: 48rpx;
}

.status-text-large {
  font-size: 32rpx;
  font-weight: 600;
}

/* 详情行 */
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.detail-value.price {
  color: #dc2626;
  font-weight: 600;
}

/* 设备卡片 */
.device-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.device-icon-large {
  font-size: 64rpx;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name-large {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.device-model-large {
  font-size: 26rpx;
  color: #666;
}

/* 问题卡片 */
.problem-card {
  padding: 24rpx;
  background: #fef3c7;
  border-radius: 12rpx;
}

.problem-text-large {
  font-size: 26rpx;
  color: #78350f;
  line-height: 1.8;
}

/* 客户卡片 */
.customer-card {
  padding: 24rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
}

.customer-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #bae6fd;
}

.customer-row:last-child {
  border-bottom: none;
}

.customer-label {
  font-size: 26rpx;
  color: #0369a1;
}

.customer-value {
  font-size: 26rpx;
  color: #333;
}

/* 进度显示 */
.progress-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bar-large {
  flex: 1;
  height: 16rpx;
  background: #e5e7eb;
  border-radius: 16rpx;
  overflow: hidden;
}

.progress-fill-large {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  transition: width 0.3s ease;
}

.progress-text-large {
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
}

/* 底部操作 */
.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #e5e7eb;
}

.modal-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.modal-btn.cancel {
  background: #f5f7fa;
  color: #666;
  border: 2rpx solid #e5e7eb;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.modal-btn:active {
  transform: scale(0.95);
}

/* 申请售后按钮 */
.action-btn.after-sales {
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
  color: #fff;
  border: 2rpx solid #f59e0b;
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, 0.3);
}

/* 售后类型选择 */
.after-sales-type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.after-sales-type-item {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
  padding: 20rpx 12rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s;
}

.after-sales-type-item.active {
  border-color: #f97316;
  background: #fff7ed;
  color: #ea580c;
  font-weight: 600;
}

/* 售后图片凭证 */
.after-sales-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.after-sales-image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.after-sales-image {
  width: 100%;
  height: 100%;
}

.after-sales-image-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}

.after-sales-image-add {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
}

.after-sales-image-add .upload-icon {
  font-size: 48rpx;
}

.after-sales-image-add .upload-text {
  font-size: 22rpx;
  color: #64748b;
}

/* 提交售后按钮 */
.modal-btn.after-sales-submit {
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
  color: #fff;
}

/* 报价弹窗 */
.form-section {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 16rpx;
  display: block;
}

.form-label .required {
  color: #ef4444;
}

.price-input-row {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
}

.price-symbol {
  font-size: 32rpx;
  font-weight: 600;
  color: #667eea;
  margin-right: 12rpx;
}

.price-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.file-upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #64748b;
}

.file-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.file-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f0f9ff;
  border-radius: 8rpx;
  gap: 12rpx;
}

.file-icon {
  font-size: 32rpx;
}

.file-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-remove {
  font-size: 32rpx;
  color: #ef4444;
  padding: 8rpx;
}

/* 报价被拒绝提示 */
.quote-rejected-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
  border: 2rpx solid #fca5a5;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.rejected-tip-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.rejected-tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rejected-tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #dc2626;
}

.rejected-tip-reason {
  font-size: 24rpx;
  color: #991b1b;
  line-height: 1.5;
}

/* 进度反馈提示 */
.progress-feedback-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  border: 2rpx solid #93c5fd;
  border-radius: 12rpx;
  margin-top: 12rpx;
  animation: feedbackPulse 2s ease-in-out infinite;
}

.feedback-tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.feedback-tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.feedback-tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e40af;
}

.feedback-tip-hint {
  font-size: 24rpx;
  color: #3b82f6;
  line-height: 1.5;
}

@keyframes feedbackPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.85; box-shadow: 0 0 16rpx rgba(59, 130, 246, 0.3); }
}
