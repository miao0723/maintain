<view class="container">
  <!-- 订单信息 -->
  <view class="order-info" wx:if="{{orderDetail}}">
    <view class="info-header">订单信息</view>
    <view class="info-row">
      <text class="label">订单号：</text>
      <text class="value">{{orderDetail.orderNo || orderDetail.order_id}}</text>
    </view>
    <view class="info-row">
      <text class="label">设备：</text>
      <text class="value">{{orderDetail.deviceTypeName || '未知设备'}} {{orderDetail.deviceModel || ''}}</text>
    </view>
    <view class="info-row">
      <text class="label">故障：</text>
      <text class="value">{{orderDetail.problemDesc || '暂无'}}</text>
    </view>
  </view>

  <!-- 配送员选择 -->
  <view class="section">
    <view class="section-title">选择配送员 *</view>
    <view class="persons-list">
      <view
        class="person-item {{selectedPersonId === item.id ? 'active' : ''}}"
        wx:for="{{deliveryPersons}}"
        wx:for-item="item"
        wx:key="id"
        bindtap="selectDeliveryPerson"
        data-id="{{item.id}}"
      >
        <view class="person-header">
          <text class="person-name">{{item.name}}</text>
          <text class="person-rating">⭐ {{item.rating || '5.0'}}</text>
        </view>
        <view class="person-details">
          <text class="person-phone">📞 {{item.phone}}</text>
          <text class="person-orders">当前订单：{{item.current_orders || 0}}</text>
        </view>
        <view class="person-vehicle" wx:if="{{item.vehicle_type || item.vehicle_plate}}">
          <text wx:if="{{item.vehicle_type}}">{{item.vehicle_type}}</text>
          <text wx:if="{{item.vehicle_plate}}">{{item.vehicle_plate}}</text>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{deliveryPersons.length === 0}}">
      <text class="empty-text">暂无可用的配送员</text>
    </view>
  </view>

  <!-- 配送地址 -->
  <view class="section">
    <view class="section-title">配送地址 *</view>
    <view class="address-list">
      <view
        class="address-item {{selectedAddressId === item.id ? 'active' : ''}}"
        wx:for="{{addressList}}"
        wx:for-item="item"
        wx:key="id"
        bindtap="selectAddress"
        data-id="{{item.id}}"
      >
        <view class="address-header">
          <text class="address-name">{{item.contactName || item.contact_name || ''}}</text>
          <text class="address-phone">{{item.contactPhone || item.contact_phone || ''}}</text>
        </view>
        <view class="address-detail">
          {{item.province}}{{item.city}}{{item.district}}{{item.detail || item.detail_address}}
        </view>
      </view>
    </view>
    <view class="add-address-btn" bindtap="addNewAddress">
      + 添加新地址
    </view>
  </view>

  <!-- 配送费用 -->
  <view class="section">
    <view class="section-title">配送费用</view>
    <view class="fee-input">
      <text class="currency">¥</text>
      <input
        class="input"
        type="digit"
        placeholder="0.00"
        value="{{deliveryFee}}"
        bindinput="onDeliveryFeeInput"
      />
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer-actions">
    <button class="back-btn" bindtap="goBack">返回</button>
    <button class="submit-btn" bindtap="submit" disabled="{{submitting}}" loading="{{submitting}}">确认分配</button>
  </view>
</view>
<confirm-modal id="confirmModal" />
