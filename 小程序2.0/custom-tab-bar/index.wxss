/* ========== 自定义底部导航栏 ========== */

/* 容器 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 20rpx;
  right: 20rpx;
  box-sizing: border-box;
  /* 内容区固定 118rpx，再额外加上底部安全区，避免刘海屏上内容被压扁/下沉 */
  height: 118rpx;
  height: calc(118rpx + constant(safe-area-inset-bottom));
  height: calc(118rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 10rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
  border: 1rpx solid rgba(222, 229, 236, 0.95);
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(92, 109, 129, 0.12);
  backdrop-filter: blur(16rpx);
}

/* ========== 滑动指示器（选中项背后的高亮阴影） ========== */
.slider {
  position: absolute;
  top: 14rpx;
  left: 0;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(79, 107, 132, 0.1);
  box-shadow: 0 4rpx 14rpx rgba(79, 107, 132, 0.16);
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  z-index: 0;
}

/* ========== 导航项 ========== */
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
  z-index: 1;
}

/* ========== 中间拍照按钮（凸起） ========== */
.center-btn-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  flex: 1;
  padding-top: 10rpx;
  position: relative;
  z-index: 2;
}

.center-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5a6e8a 0%, #6e85a5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 22rpx rgba(90, 110, 138, 0.36);
  margin-bottom: 4rpx;
  margin-top: -36rpx;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: 4rpx solid rgba(255,255,255,0.85);
}

.center-btn:active {
  transform: scale(0.88);
}

.center-btn-icon {
  width: 44rpx;
  height: 44rpx;
}

.center-btn-label {
  font-size: 20rpx;
  color: #5a6e8a;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1;
}

/* 图标容器 */
.icon-wrap {
  position: relative;
  width: 64rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
  border-radius: 16rpx;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 图标 */
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 文字标签 */
.tab-label {
  font-size: 20rpx;
  color: #98a5b3;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  line-height: 1;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ========== 弹跳动画 ========== */
@keyframes iconBounce {
  0%   { transform: scale(1); }
  30%  { transform: scale(0.78); }
  60%  { transform: scale(1.12); }
  100% { transform: scale(1); }
}

.bounce .icon-wrap {
  animation: iconBounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ========== 选中状态 ========== */
.tab-item.active .icon-wrap {
  transform: translateY(-2rpx);
}

.tab-item.active .tab-icon {
  transform: scale(1.08);
}

.tab-item.active .tab-label {
  color: #4f6b84;
  font-weight: 600;
  font-size: 21rpx;
}

/* 点击回弹 */
.tab-item:active .icon-wrap {
  transform: scale(0.85);
}

/* ========== 角标样式 ========== */
.tab-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #e15b64 0%, #f27a76 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 0 8rpx;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 10rpx rgba(225, 91, 100, 0.3);
  animation: badgePulse 2s ease-in-out infinite;
  z-index: 10;
}

@keyframes badgePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}
