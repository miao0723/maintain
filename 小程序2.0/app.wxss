@import './theme/dark-mode.wxss';

page {
  background: #f6f8fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", "Roboto", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 100vh;
}

.page-container,
.container {
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

view,
button,
scroll-view,
swiper,
input,
textarea,
image,
navigator {
  box-sizing: border-box;
  transition-duration: 260ms;
  transition-timing-function: ease-out;
}

button {
  min-height: 88rpx !important;
  min-width: 88rpx !important;
  padding: 0 24rpx !important;
  border-radius: 18rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  color: #ffffff !important;
  background: #4f6b84 !important;
  border: none !important;
  box-shadow: 0 10rpx 24rpx rgba(79, 107, 132, 0.14) !important;
  transition: transform 200ms ease-out, box-shadow 260ms ease-out, opacity 200ms ease-out !important;
}

button::after {
  border: none !important;
}

button:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(79, 107, 132, 0.14);
  background: #445e75 !important;
}

.action-btn,
.order-action-btn,
.detail-btn,
.review-btn,
.logout-btn,
.menu-item,
.tab-item,
.submit-btn,
.save-btn,
.add-btn,
.confirm-btn,
.contact-btn,
.send-btn,
.empty-btn,
.login-btn,
.auth-btn,
.btn-agree,
.btn-disagree {
  min-height: 88rpx !important;
  min-width: 88rpx !important;
  border-radius: 18rpx !important;
  transition: transform 200ms ease-out, box-shadow 260ms ease-out, background-color 260ms ease-out, opacity 200ms ease-out !important;
}

.action-btn,
.order-action-btn,
.detail-btn,
.review-btn,
.send-btn {
  min-height: 80rpx !important;
  font-size: 32rpx !important;
  font-weight: 500 !important;
}

.btn-group,
.bottom-action,
.modal-actions,
.unit-actions,
.order-actions {
  gap: 24rpx !important;
}

.form-item,
.menu-item,
.section-title,
.order-item,
.card,
.section {
  margin-bottom: 16rpx;
}

input,
textarea {
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #dde5ee;
  background: #ffffff;
  color: #1f2937;
  font-size: 30rpx;
  transition: border-color 200ms ease-out, box-shadow 200ms ease-out, background-color 260ms ease-out;
}

textarea {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

input:focus,
textarea:focus {
  border-color: #4f6b84;
  box-shadow: 0 0 0 4rpx rgba(79, 107, 132, 0.12);
}

.section,
.card,
.agreement-box,
.order-item,
.menu-item,
.form-section,
.modal-container,
.unit-item,
.address-item {
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(102, 118, 138, 0.08);
  background-color: #ffffff;
}

/* ====== 通用信息行（标签-值对齐规范） ======
 * 同一类数据尽量同行展示；值过长换行时左对齐、填满整行，与上方数据对齐。
 * 标签固定列宽，保证多行值的起始 x 一致（视觉"对满"）。
 */
.info-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}
.info-row.divided + .info-row.divided,
.info-row.divided ~ .info-row.divided {
  border-top: 1rpx solid #f0f3f7;
}
.info-label {
  flex: 0 0 160rpx;
  font-size: 26rpx;
  color: #8a96a3;
  line-height: 1.5;
  word-break: keep-all;
}
.info-value {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: 28rpx;
  color: #2b3440;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-word;
}
.info-value--price {
  color: #d97706;
  font-size: 32rpx;
  font-weight: 700;
}
.info-value--muted {
  color: #8a96a3;
  font-weight: 400;
}
.info-value--end {
  text-align: right;
}

/* ====== 区块标题左色条（统一各卡片标题视觉） ====== */
.section-title--accent,
.card-title--accent {
  position: relative;
  padding-left: 22rpx;
  border-left: 8rpx solid #4f6b84;
  border-bottom: none;
}

/* =====================================================================
 * 设计令牌（钢蓝精修 · 单一来源）
 * 所有页面共享，避免在 20+ 个 wxss 里重复硬编码颜色/圆角/阴影。
 * 用法：var(--c-primary) 等。
 * ===================================================================== */
page {
  --c-primary: #4f6b84;
  --c-primary-2: #6a9abb;
  --c-primary-deep: #2d465e;
  --c-accent-soft: #eef3f8;
  --c-bg: #f6f8fb;
  --c-bg-2: #eef2f6;
  --c-surface: #ffffff;
  --c-ink: #1f2f3d;
  --c-ink-2: #4e6279;
  --c-muted: #8a96a3;
  --c-line: rgba(224, 230, 236, 0.92);
  --c-danger: #c86060;
  --radius-xl: 34rpx;
  --radius-lg: 28rpx;
  --radius-md: 22rpx;
  --radius-sm: 16rpx;
  --shadow-card: 0 12rpx 30rpx rgba(102, 118, 138, 0.08);
  --shadow-card-lg: 0 18rpx 42rpx rgba(67, 89, 111, 0.14);
  --grad-primary: linear-gradient(135deg, #2d465e 0%, #4f708d 100%);
  --grad-primary-soft: linear-gradient(135deg, #436f95 0%, #6a9abb 100%);
}

/* =====================================================================
 * 可复用工具类（钢蓝精修）
 * ===================================================================== */

/* 通用图标芯片：把功能 emoji 包成有质感的设计元素，而非裸 emoji */
.icon-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  background: linear-gradient(160deg, #f3f7fb 0%, #e7eef5 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7), 0 4rpx 12rpx rgba(79, 107, 132, 0.1);
  color: var(--c-primary);
  flex-shrink: 0;
}

/* 主色实心图标芯片（用于强调入口） */
.icon-chip--solid {
  background: var(--grad-primary-soft);
  color: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(67, 111, 149, 0.22);
}

/* 卡片轻量按压反馈 */
.press {
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.press:active {
  transform: scale(0.975);
  box-shadow: var(--shadow-card);
}

/* 入场动画：轻微上浮淡入，用于卡片/区块 */
.fade-up {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 细分隔线 */
.hairline {
  height: 1rpx;
  background: var(--c-line);
}

/* 小药丸标签 */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: var(--c-accent-soft);
  color: var(--c-primary);
}
