  "preloadRule": {
    "pages/home/home": {
      "network": "all",
      "packages": ["recycle", "recycle-guide", "diagnose", "scan", "map-picker"]
    },
    "pages/repair/repair": {
      "network": "all",
      "packages": ["repair-records", "device-detail", "my-devices", "device-edit", "recycle"]
    },
    "pages/service/service": {
      "network": "all",
      "packages": ["adminservice", "my-orders", "my-devices", "recycle"]
    },
    "pages/mine/mine": {
      "network": "all",
      "packages": ["profile-edit", "my-orders", "order-detail", "address", "address-edit", "units", "unit-edit", "my-devices", "device-edit", "progress-apply-list"]
    }
  },
  "window": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "电子维修",
    "navigationBarBackgroundColor": "#5a6e8a"
  },
  "tabBar": {
    "custom": true,
    "color": "#9ca3af",
    "selectedColor": "#5a6e8a",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "/images/home.png",
        "selectedIconPath": "/images/home-active.png"
      },
      {
        "pagePath": "pages/repair/repair",
        "text": "维修",
        "iconPath": "/images/repair.png",
        "selectedIconPath": "/images/repair-active.png"
      },
      {
        "pagePath": "pages/service/service",
        "text": "客服",
        "iconPath": "/images/service.png",
        "selectedIconPath": "/images/service-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "/images/mine.png",
        "selectedIconPath": "/images/mine-active.png"
      }
    ]
  },
  "style": "v2",
  "darkmode": true,
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.record": {
      "desc": "你的麦克风将用于客服语音转文字输入"
    },
    "scope.userLocation": {
      "desc": "你的位置信息将用于小程序位置功能"
    },
    "scope.camera": {
      "desc": "你的摄像头将用于拍照识别设备型号"
    },
    "scope.writePhotosAlbum": {
      "desc": "你需要授权保存图片到相册"
    }
  },
  "requiredPrivateInfos": [
    "getLocation"
  ]
}
