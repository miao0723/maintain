# 后端真实使用的是本目录下的 .env；生产 docker-compose 也挂载这个文件。
# 复制为 backend/.env 后填写真实值，不要提交 .env 和 *.pem。

# ---------- 微信小程序 / 微信支付 ----------
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_MCH_ID=your_merchant_id
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://your-domain.com/api/pay/refund/notify
WECHAT_PAY_API_V3_KEY=your_32_char_apiv3_key
WECHAT_PAY_SERIAL_NO=your_merchant_cert_serial_no

# 商户 API 私钥：文件路径（相对 backend/）或直接填 PEM 文本（换行写 \n）。
WECHAT_PAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WECHAT_PAY_PRIVATE_KEY=

# 回调验签二选一：
# 1) 新商户公钥模式：商户平台下载微信支付公钥，并复制公钥ID
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY=

# 2) 旧平台证书模式：留空即可自动下载/轮换；也可固定配置。
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_PLATFORM_CERT_PATH=

# ---------- 数据库 / 服务 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=repair
DB_CONNECTION_LIMIT=10
PORT=3001
NODE_ENV=production
SERVER_HOST=0.0.0.0
