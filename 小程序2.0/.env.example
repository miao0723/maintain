# 小程序后端环境变量模板
# 使用方法：cp .env.example .env 并填入真实值
# 注意：.env 已被 .gitignore 排除，切勿提交

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name
DB_CONNECTION_LIMIT=10

# ---------- 服务端口 ----------
PORT=3000

# ---------- 第三方 API ----------
DEEPSEEK_API_KEY=your_deepseek_api_key
AMAP_API_KEY=your_amap_api_key

# ---------- 微信小程序 ----------
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_app_secret

# ---------- 微信支付 ----------
# 生产部署实际读取 backend/.env（docker-compose 挂载该文件）；
# 本文件仅作为项目级模板说明。
WECHAT_MCH_ID=your_merchant_id
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://your-domain.com/api/pay/refund/notify
WECHAT_PAY_API_V3_KEY=your_apiv3_key
WECHAT_PAY_SERIAL_NO=your_cert_serial_no

# 商户 API 私钥：路径方式（backend/.env 中相对路径以 backend/ 为基准）
WECHAT_PAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem

# 或者不落盘，直接填证书文本，换行写成 \n（更适合只改 .env 就上线）
WECHAT_PAY_PRIVATE_KEY=

# 回调验签二选一：
# 1) 新商户「微信支付公钥」模式：下载 pub_key.pem，并填写公钥ID（PUB_KEY_ID_...）
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY=

# 2) 旧「平台证书」模式：可以不配置，服务会自动调用微信接口下载并轮换平台证书；
#    如需固定证书，也可填写路径或 PEM 文本。
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_PLATFORM_CERT_PATH=

# ---------- 语音转写（阿里云通义千问 / DashScope）----------
VOICE_PROVIDER=dashscope
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_WORKSPACE_ID=your_workspace_id
